#Использовать autumn
#Использовать ".."
#Использовать asserts

// Контейнер приложения для тестов генератора.
Перем ОбщаяПоделка;
// Генератор спецификации OpenAPI.
Перем Генератор;
// Сформированная спецификация OpenAPI в виде соответствия.
Перем Спецификация;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	Если Генератор <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбщаяПоделка = Новый Поделка();
	ОбщаяПоделка.ЗапуститьПриложение();

	ИнициализацияНастроекСервера = ОбщаяПоделка.НайтиЖелудь("ИнициализацияНастроекСервера");
	ИнициализацияНастроекСервера.ИнициализацияКонтролов();

	Генератор = ОбщаяПоделка.НайтиЖелудь("ГенераторOpenApi");
	Спецификация = Генератор.СформироватьСпецификацию();

КонецПроцедуры

&Тест
Процедура Должен_ПроверитьБазовуюСтруктуруСпецификации() Экспорт

	Ожидаем.Что(Спецификация.Получить("openapi")).Равно("3.1.0");

	Информация = Спецификация.Получить("info");
	Ожидаем.Что(Информация).ИмеетТип("Соответствие");
	Ожидаем.Что(Информация.Получить("title")).Равно("winow API");
	Ожидаем.Что(Информация.Получить("version")).Равно("1.0.0");

	Ожидаем.Что(Спецификация.Получить("paths")).ИмеетТип("Соответствие");

КонецПроцедуры

&Тест
Процедура Должен_ПроверитьРегистрациюПростойТочкиМаршрута() Экспорт

	Операция = ПолучитьОперацию("/openapitest/ping", "get");

	Ожидаем.Что(Операция).ИмеетТип("Соответствие");
	Ожидаем.Что(Операция.Получить("summary")).Равно("Проверка доступности");
	Ожидаем.Что(Операция.Получить("operationId")).ИмеетТип("Строка");

	Ответы = Операция.Получить("responses");
	Ожидаем.Что(Ответы.Получить("200") <> Неопределено).Равно(Истина);

КонецПроцедуры

&Тест
Процедура Должен_ПроверитьПараметрПути() Экспорт

	Операция = ПолучитьОперацию("/openapitest/echo/{имя}", "get");
	Ожидаем.Что(Операция).ИмеетТип("Соответствие");

	Параметры = Операция.Получить("parameters");
	Ожидаем.Что(Параметры).ИмеетТип("Массив");
	Ожидаем.Что(Параметры.Количество()).Равно(1);

	Параметр = Параметры[0];
	Ожидаем.Что(Параметр.Получить("name")).Равно("имя");
	Ожидаем.Что(Параметр.Получить("in")).Равно("path");
	Ожидаем.Что(Параметр.Получить("required")).Равно(Истина);

КонецПроцедуры

&Тест
Процедура Должен_ПроверитьПараметрСтрокиЗапроса() Экспорт

	Операция = ПолучитьОперацию("/openapitest/search", "get");
	Ожидаем.Что(Операция).ИмеетТип("Соответствие");

	Параметры = Операция.Получить("parameters");
	Ожидаем.Что(Параметры).ИмеетТип("Массив");
	Ожидаем.Что(Параметры.Количество()).Равно(1);

	Параметр = Параметры[0];
	Ожидаем.Что(Параметр.Получить("name")).Равно("Фраза");
	Ожидаем.Что(Параметр.Получить("in")).Равно("query");
	Ожидаем.Что(Параметр.Получить("required")).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура Должен_ВыбратьМетодОтправкиПриТелеЗапроса() Экспорт

	Операция = ПолучитьОперацию("/openapitest/submit", "post");
	Ожидаем.Что(Операция).ИмеетТип("Соответствие");

	Содержимое = Операция.Получить("requestBody").Получить("content");
	Ожидаем.Что(Содержимое.Получить("application/json") <> Неопределено).Равно(Истина);

	// Точки маршрута с телом по умолчанию не считаются GET.
	Ожидаем.Что(ПолучитьПунктПути("/openapitest/submit").Получить("get")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура Должен_ОписатьДвоичноеТелоЗапроса() Экспорт

	Операция = ПолучитьОперацию("/openapitest/upload", "post");
	Ожидаем.Что(Операция).ИмеетТип("Соответствие");

	Содержимое = Операция.Получить("requestBody").Получить("content");
	Ожидаем.Что(Содержимое.Получить("application/octet-stream") <> Неопределено).Равно(Истина);

	// Сырые байты - не строка JSON, поэтому схемой не описываются вовсе:
	// произвольный двоичный файл в спецификации 3.1 показан пустым объектом.
	ДвоичноеСодержимое = Содержимое.Получить("application/octet-stream");
	Ожидаем.Что(ДвоичноеСодержимое.Количество(), "пустой объект типа содержимого").Равно(0);

КонецПроцедуры

// Единственное допустимое значение описывается через const, а не перечислением
// из одного элемента: в JSON Schema 2020-12 для этого есть отдельное слово.
&Тест
Процедура Должен_ОписатьЕдинственноеЗначениеЧерезConst() Экспорт

	Поле = ПолучитьСхему("ZayavkaOpenApiTest").Получить("properties").Получить("confirmed");

	Ожидаем.Что(Поле.Получить("type"), "тип").Равно("boolean");
	Ожидаем.Что(Поле.Получить("const"), "единственное значение").Равно(Истина);
	Ожидаем.Что(Поле.Получить("enum"), "перечисление из одного элемента").ЭтоНеопределено();

КонецПроцедуры

// Обязательность тела объявляет &Заполнено на параметре тела - та же аннотация,
// которой отмечают обязательные поля схемы.
&Тест
Процедура Должен_ПометитьТелоОбязательнымПоЗаполнено() Экспорт

	ТелоЗапроса = ПолучитьОперацию("/openapitest/typed", "post").Получить("requestBody");

	Ожидаем.Что(ТелоЗапроса.Получить("required"), "обязательность тела").Равно(Истина);

КонецПроцедуры

// Без аннотации тело необязательно, и ключ не пишется вовсе: по спецификации
// умолчание requestBody.required - ложь.
&Тест
Процедура Должен_НеПометитьТелоБезЗаполнено() Экспорт

	ТелоЗапроса = ПолучитьОперацию("/openapitest/optionalbody", "post").Получить("requestBody");

	Ожидаем.Что(ТелоЗапроса, "тело описано").ИмеетТип("Соответствие");
	Ожидаем.Что(ТелоЗапроса.Получить("required"), "необязательное тело без ключа").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура Должен_УчитыватьАннотациюМетод() Экспорт

	ПунктПути = ПолучитьПунктПути("/openapitest/custom");
	Ожидаем.Что(ПунктПути.Получить("put") <> Неопределено).Равно(Истина);
	Ожидаем.Что(ПунктПути.Получить("get")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура Должен_СделатьИдентификаторОперацииУникальным() Экспорт

	ОперацияПинг = ПолучитьОперацию("/openapitest/ping", "get");
	ОперацияОбновления = ПолучитьОперацию("/openapitest/custom", "put");

	Совпадают = ОперацияПинг.Получить("operationId") = ОперацияОбновления.Получить("operationId");
	Ожидаем.Что(Совпадают).Равно(Ложь);

КонецПроцедуры

// Кириллица транслитерируется, а не выбрасывается: иначе от адреса остаётся
// только его длина, и разные маршруты дают один идентификатор.
&Тест
Процедура Должен_ТранслитерироватьИдентификаторОперации() Экспорт

	Идентификатор = ПолучитьОперацию("/openapitest/кот", "get").Получить("operationId");

	Ожидаем.Что(Идентификатор, "идентификатор").Равно("get_openapitest_kot");

КонецПроцедуры

&Тест
Процедура Должен_РазвестиИдентификаторыКириллическихАдресов() Экспорт

	Кот = ПолучитьОперацию("/openapitest/кот", "get").Получить("operationId");
	Дом = ПолучитьОперацию("/openapitest/дом", "get").Получить("operationId");

	Ожидаем.Что(Кот, "идентификатор кота").ЭтоНе().Равно(Дом);

КонецПроцедуры

// Транслитерация уникальность не гарантирует: твёрдый знак отбрасывается,
// и два разных адреса дают одинаковую основу. Разводит их числовой суффикс.
&Тест
Процедура Должен_ДобавитьСуффиксПриСовпаденииОснов() Экспорт

	Съезд = ПолучитьОперацию("/openapitest/съезд", "get").Получить("operationId");
	Сезд = ПолучитьОперацию("/openapitest/сезд", "get").Получить("operationId");

	Ожидаем.Что(Съезд, "идентификатор съезда").ЭтоНе().Равно(Сезд);

	Основы = Новый Массив();
	Основы.Добавить(Съезд);
	Основы.Добавить(Сезд);

	Ожидаем.Что(Основы, "одна из основ без суффикса").Содержит("get_openapitest_sezd");
	Ожидаем.Что(Основы, "вторая с суффиксом").Содержит("get_openapitest_sezd_1");

КонецПроцедуры

&Тест
Процедура Должен_ЭкранироватьОсобыеСимволыВJson() Экспорт

	Текст = Генератор.СпецификацияТекстом();

	Ожидаем.Что(Текст).ИмеетТип("Строка");
	Ожидаем.Что(Лев(СокрЛП(Текст), 1)).Равно("{");
	Ожидаем.Что(Текст).Содержит("""openapi"":""3.1.0""");

	// Сводка "Спец " и \ конец" должна экранироваться как: Спец \" и \\ конец
	Ожидаем.Что(Текст).Содержит("Спец \"" и \\ конец");

КонецПроцедуры

// Тело с указанным типом описывается ссылкой на схему в components,
// а не безымянным объектом без свойств.
&Тест
Процедура Должен_ОписатьТелоЗапросаСсылкойНаСхему() Экспорт

	Операция = ПолучитьОперацию("/openapitest/typed", "post");

	Схема = Операция.Получить("requestBody").Получить("content")
		.Получить("application/json").Получить("schema");

	Ожидаем.Что(Схема.Получить("$ref"), "ссылка на схему тела")
		.Равно("#/components/schemas/ZayavkaOpenApiTest");

КонецПроцедуры

// Тип свойства берётся из аннотации &Тип, обязательность - из &Заполнено,
// границы - из &Минимум и &Максимум. Своих аннотаций генератор не требует.
&Тест
Процедура Должен_ПостроитьСхемуТипаПоАннотациямПолей() Экспорт

	Свойства = ПолучитьСхему("ZayavkaOpenApiTest").Получить("properties");

	Ожидаем.Что(Свойства.Получить("title").Получить("type"), "тип title").Равно("string");
	Ожидаем.Что(Свойства.Получить("Срочная").Получить("type"), "тип Срочная").Равно("boolean");

	Сумма = Свойства.Получить("amount");
	Ожидаем.Что(Сумма.Получить("type"), "тип amount").Равно("number");
	Ожидаем.Что(Сумма.Получить("minimum"), "minimum").Равно(0);
	Ожидаем.Что(Сумма.Получить("maximum"), "maximum").Равно(1000);

КонецПроцедуры

// Шаблон validate проверяется якорным, поэтому и в схему он переносится
// якорным: pattern из JSON Schema ищется в любой части строки.
&Тест
Процедура Должен_ПеренестиШаблонВPattern() Экспорт

	Код = ПолучитьСхему("ZayavkaOpenApiTest").Получить("properties").Получить("code");

	Ожидаем.Что(Код.Получить("pattern"), "pattern").Равно("^(?:[A-Z]{2}-\d{4})$");

КонецПроцедуры

// Размер меряет длину строки, а не её значение, поэтому у строкового поля
// ему соответствуют minLength и maxLength.
&Тест
Процедура Должен_ПеренестиРазмерСтрокиВДлину() Экспорт

	Код = ПолучитьСхему("ZayavkaOpenApiTest").Получить("properties").Получить("code");

	Ожидаем.Что(Код.Получить("minLength"), "minLength").Равно(4);
	Ожидаем.Что(Код.Получить("maxLength"), "maxLength").Равно(16);
	Ожидаем.Что(Код.Получить("minimum"), "minimum у строки не место").ЭтоНеопределено();

КонецПроцедуры

// У массива тот же &Размер означает уже количество элементов.
&Тест
Процедура Должен_ПеренестиРазмерМассиваВКоличествоЭлементов() Экспорт

	Метки = ПолучитьСхему("ZayavkaOpenApiTest").Получить("properties").Получить("tags");

	Ожидаем.Что(Метки.Получить("type"), "тип tags").Равно("array");
	Ожидаем.Что(Метки.Получить("minItems"), "minItems").Равно(1);
	Ожидаем.Что(Метки.Получить("maxItems"), "maxItems").Равно(10);
	Ожидаем.Что(Метки.Получить("minLength"), "minLength у массива не место").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура Должен_ПеренестиОдинИзВEnum() Экспорт

	Канал = ПолучитьСхему("ZayavkaOpenApiTest").Получить("properties").Получить("channel");
	Перечисление = Канал.Получить("enum");

	Ожидаем.Что(Перечисление, "enum").ИмеетТип("Массив");
	Ожидаем.Что(Перечисление.Количество(), "число вариантов").Равно(3);
	Ожидаем.Что(Перечисление, "варианты").Содержит("почта");
	Ожидаем.Что(Перечисление, "варианты").Содержит("сайт");

КонецПроцедуры

&Тест
Процедура Должен_ПеренестиКратноВMultipleOf() Экспорт

	Вес = ПолучитьСхему("ZayavkaOpenApiTest").Получить("properties").Получить("weight");

	Ожидаем.Что(Вес.Получить("multipleOf"), "multipleOf").Равно(5);

КонецПроцедуры

// Коды форматов validate совпадают с именами format из JSON Schema.
&Тест
Процедура Должен_ПеренестиФорматВFormat() Экспорт

	Контакт = ПолучитьСхему("ZayavkaOpenApiTest").Получить("properties").Получить("contact");

	Ожидаем.Что(Контакт.Получить("format"), "format").Равно("email");

КонецПроцедуры

&Тест
Процедура Должен_ОтнестиКОбязательнымПоляСАннотациейЗаполнено() Экспорт

	Обязательные = ПолучитьСхему("ZayavkaOpenApiTest").Получить("required");

	Ожидаем.Что(Обязательные, "список обязательных").Содержит("title");
	Ожидаем.Что(Обязательные.Найти("amount"), "amount не обязателен").ЭтоНеопределено();

КонецПроцедуры

// Поле с аннотацией &Несериализуемое в JSON не попадает, поэтому и в схеме
// его быть не должно.
&Тест
Процедура Должен_ИсключитьИзСхемыНесериализуемоеПоле() Экспорт

	Свойства = ПолучитьСхему("ZayavkaOpenApiTest").Получить("properties");

	Ожидаем.Что(Свойства.Получить("СлужебноеПоле"), "несериализуемое поле").ЭтоНеопределено();

КонецПроцедуры

// Вложенный пользовательский тип описывается отдельной схемой, на которую
// свойство ссылается, - иначе одинаковые типы дублировались бы в документе.
&Тест
Процедура Должен_ОписатьВложенныйТипОтдельнойСхемой() Экспорт

	Свойства = ПолучитьСхему("ZayavkaOpenApiTest").Получить("properties");

	Ожидаем.Что(Свойства.Получить("Адрес").Получить("$ref"), "ссылка на вложенный тип")
		.Равно("#/components/schemas/AdresOpenApiTest");

	СвойстваАдреса = ПолучитьСхему("AdresOpenApiTest").Получить("properties");
	Ожидаем.Что(СвойстваАдреса.Получить("city").Получить("type"), "тип city").Равно("string");

КонецПроцедуры

// Ключи components по спецификации обязаны совпадать с ^[a-zA-Z0-9._-]+$,
// поэтому кириллические имена классов транслитерируются.
&Тест
Процедура Должен_ТранслитерироватьИменаСхем() Экспорт

	Схемы = Спецификация.Получить("components").Получить("schemas");

	ДопустимыйКлюч = Новый РегулярноеВыражение("^[a-zA-Z0-9._-]+$");

	Для Каждого КлючИЗначение Из Схемы Цикл
		Ожидаем.Что(ДопустимыйКлюч.Совпадает(КлючИЗначение.Ключ),
			"ключ схемы " + КлючИЗначение.Ключ).Равно(Истина);
	КонецЦикла;

	Ожидаем.Что(Схемы.Получить("ЗаявкаOpenApiТест"), "кириллический ключ").ЭтоНеопределено();

КонецПроцедуры

// Реестры выданных имён принадлежат документу, а не желудю. Желудь один на
// приложение, и когда за спецификацией приходят одновременно, сборки не должны
// видеть имён друг друга: иначе операция получала бы суффикс от чужого
// документа - get_katalog_3 вместо get_katalog.
&Тест
Процедура Должен_ВестиРеестрИмёнОтдельноВКаждойСборке() Экспорт

	Имена = ОбщаяПоделка.НайтиЖелудь("ИменаOpenApi");

	ПерваяСборка = Новый СборкаСпецификации();
	ВтораяСборка = Новый СборкаСпецификации();

	Ожидаем.Что(Имена.ИдентификаторОперации(ПерваяСборка, "get", "/каталог"), "первая сборка")
		.Равно("get_katalog");

	// Другой документ - уникальность в нём считается заново.
	Ожидаем.Что(Имена.ИдентификаторОперации(ВтораяСборка, "get", "/каталог"), "вторая сборка")
		.Равно("get_katalog");

	// А в пределах одной сборки повтор суффикс получает.
	Ожидаем.Что(Имена.ИдентификаторОперации(ПерваяСборка, "get", "/каталог"), "повтор в первой")
		.Равно("get_katalog_1");

КонецПроцедуры

// Тот же вопрос со стороны собранного документа: сборка не должна оставлять
// следов, из-за которых следующая получилась бы другой.
&Тест
Процедура Должен_СобратьОдинаковыйДокументПриПовторнойСборке() Экспорт

	Первый = Генератор.СпецификацияТекстом();
	Второй = Генератор.СпецификацияТекстом();

	Ожидаем.Что(Второй, "повторная сборка").Равно(Первый);

КонецПроцедуры

// Транслитерация теряет исходное имя класса, поэтому оно сохраняется в
// description: иначе по документу нельзя было бы понять, какому типу
// отвечает схема.
&Тест
Процедура Должен_СохранитьИсходноеИмяТипаВОписанииСхемы() Экспорт

	Ожидаем.Что(ПолучитьСхему("ZayavkaOpenApiTest").Получить("description"), "описание схемы")
		.Равно("ЗаявкаOpenApiТест");

	Ожидаем.Что(ПолучитьСхему("AdresOpenApiTest").Получить("description"), "описание вложенной схемы")
		.Равно("АдресOpenApiТест");

КонецПроцедуры

// Без аннотации &Возвращает точка маршрута получает единственный ответ 200,
// а объявленные ответы его замещают: придуманный за автора код только мешал бы.
&Тест
Процедура Должен_ОписатьОбъявленныеОтветы() Экспорт

	Ответы = ПолучитьОперацию("/openapitest/returns", "get").Получить("responses");

	Ожидаем.Что(Ответы.Получить("200").Получить("description"), "описание 200")
		.Равно("Найденная заявка");
	Ожидаем.Что(Ответы.Получить("404").Получить("description"), "описание 404")
		.Равно("Заявка не найдена");

КонецПроцедуры

&Тест
Процедура Должен_ОписатьТелоОтветаСсылкойНаСхему() Экспорт

	Ответ200 = ПолучитьОперацию("/openapitest/returns", "get").Получить("responses").Получить("200");

	Схема = Ответ200.Получить("content").Получить("application/json").Получить("schema");

	Ожидаем.Что(Схема.Получить("$ref"), "ссылка на схему ответа")
		.Равно("#/components/schemas/ZayavkaOpenApiTest");

КонецПроцедуры

// Тип элементов коллекции нигде не хранится, поэтому его называют отдельно
// параметром Элемент. У массива он ложится в items.
&Тест
Процедура Должен_ОписатьТипЭлементовМассиваВОтвете() Экспорт

	Схема = СхемаОтвета("/openapitest/returnsarray", "200");

	Ожидаем.Что(Схема.Получить("type"), "тип ответа").Равно("array");
	Ожидаем.Что(Схема.Получить("items").Получить("$ref"), "ссылка на элемент")
		.Равно("#/components/schemas/ZayavkaOpenApiTest");

КонецПроцедуры

// А у соответствия - в additionalProperties: там элементы это значения полей.
&Тест
Процедура Должен_ОписатьТипЭлементовСоответствияВОтвете() Экспорт

	Схема = СхемаОтвета("/openapitest/returnsmap", "200");

	Ожидаем.Что(Схема.Получить("type"), "тип ответа").Равно("object");
	Ожидаем.Что(Схема.Получить("additionalProperties").Получить("$ref"), "ссылка на элемент")
		.Равно("#/components/schemas/ZayavkaOpenApiTest");

КонецПроцедуры

// Тип содержимого ответа объявляется аннотацией: вывести его неоткуда,
// winow задаёт его вызовом уже во время обработки запроса.
&Тест
Процедура Должен_ОписатьОбъявленныйТипСодержимогоОтвета() Экспорт

	Содержимое = ПолучитьОперацию("/openapitest/returnscsv", "get")
		.Получить("responses").Получить("200").Получить("content");

	Ожидаем.Что(Содержимое.Получить("text/csv"), "объявленный тип содержимого")
		.ИмеетТип("Соответствие");
	Ожидаем.Что(Содержимое.Получить("application/json"), "умолчание рядом с объявленным")
		.ЭтоНеопределено();

КонецПроцедуры

// Без объявления тип содержимого ответа - application/json.
&Тест
Процедура Должен_ВзятьJsonТипомСодержимогоОтветаПоУмолчанию() Экспорт

	Содержимое = ПолучитьОперацию("/openapitest/returns", "get")
		.Получить("responses").Получить("200").Получить("content");

	Ожидаем.Что(Содержимое.Получить("application/json"), "умолчание").ИмеетТип("Соответствие");

КонецПроцедуры

// Двоичный ответ схемой не описывается - по той же причине, что и двоичное
// тело запроса: это не строка JSON, а тип уже назван ключом.
&Тест
Процедура Должен_НеОписыватьСхемойДвоичныйОтвет() Экспорт

	Содержимое = ПолучитьОперацию("/openapitest/returnsbinary", "get")
		.Получить("responses").Получить("200").Получить("content");

	ДвоичноеСодержимое = Содержимое.Получить("application/octet-stream");

	Ожидаем.Что(ДвоичноеСодержимое, "двоичный ответ").ИмеетТип("Соответствие");
	Ожидаем.Что(ДвоичноеСодержимое.Количество(), "пустой объект типа содержимого").Равно(0);

КонецПроцедуры

// Без параметра Элемент коллекция описывается как прежде: элемент любого вида.
&Тест
Процедура Должен_ОставитьЭлементыЛюбымиБезТипаЭлемента() Экспорт

	Схема = СхемаОтвета("/openapitest/returnsanyarray", "200");

	Ожидаем.Что(Схема.Получить("type"), "тип ответа").Равно("array");
	Ожидаем.Что(Схема.Получить("items").Количество(), "пустая схема элемента").Равно(0);

КонецПроцедуры

// Ответ без объявленного типа описывается только текстом - придумывать
// содержимое за автора незачем.
&Тест
Процедура Должен_ОставитьОтветБезТипаБезСодержимого() Экспорт

	Ответ404 = ПолучитьОперацию("/openapitest/returns", "get").Получить("responses").Получить("404");

	Ожидаем.Что(Ответ404.Получить("content"), "содержимое ответа без типа").ЭтоНеопределено();

КонецПроцедуры

// Точка маршрута с ПараметрыЗапросаИменные принимает произвольные пары
// имя-значение. Перечислить их нельзя, но сказать, что они принимаются, - можно.
&Тест
Процедура Должен_ОписатьПроизвольныеПараметрыЗапроса() Экспорт

	Параметры = ПолучитьОперацию("/openapitest/bagnamed", "get").Получить("parameters");

	Параметр = НайтиПараметр(Параметры, "параметры");

	Ожидаем.Что(Параметр.Получить("in"), "размещение").Равно("query");
	Ожидаем.Что(Параметр.Получить("explode"), "explode").Равно(Истина);
	Ожидаем.Что(Параметр.Получить("schema").Получить("additionalProperties"), "свободный состав полей")
		.Заполнено();

КонецПроцедуры

// Позиционные сегменты нельзя описать параметром: по OpenAPI параметр с in=path
// обязан быть обязательным и присутствовать в шаблоне пути. Остаётся описание.
&Тест
Процедура Должен_УпомянутьПозиционныеСегментыВОписании() Экспорт

	Операция = ПолучитьОперацию("/openapitest/bagordered", "get");

	Ожидаем.Что(Операция.Получить("description"), "описание операции")
		.Содержит("позиционные сегменты");

КонецПроцедуры

// Схема параметра строится по тем же аннотациям, что и схема поля типа,
// поэтому размечать параметры отдельно ради документации не нужно.
&Тест
Процедура Должен_ВзятьТипПараметраПутиИзАннотации() Экспорт

	Параметры = ПолучитьОперацию("/openapitest/typedparams/{Возраст}", "get").Получить("parameters");

	Возраст = НайтиПараметр(Параметры, "Возраст");

	Ожидаем.Что(Возраст.Получить("in"), "размещение").Равно("path");
	Ожидаем.Что(Возраст.Получить("schema").Получить("type"), "тип").Равно("number");
	Ожидаем.Что(Возраст.Получить("schema").Получить("minimum"), "minimum").Равно(0);
	Ожидаем.Что(Возраст.Получить("schema").Получить("maximum"), "maximum").Равно(150);

КонецПроцедуры

&Тест
Процедура Должен_ВзятьТипПараметраЗапросаИзАннотации() Экспорт

	Параметры = ПолучитьОперацию("/openapitest/typedparams/{Возраст}", "get").Получить("parameters");

	Активен = НайтиПараметр(Параметры, "Активен");

	Ожидаем.Что(Активен.Получить("in"), "размещение").Равно("query");
	Ожидаем.Что(Активен.Получить("schema").Получить("type"), "тип").Равно("boolean");

КонецПроцедуры

// Без аннотации тип параметра неизвестен: из адреса и строки запроса значения
// приходят строками.
&Тест
Процедура Должен_ОставитьПараметрБезАннотацииСтрокой() Экспорт

	Параметры = ПолучитьОперацию("/openapitest/search", "get").Получить("parameters");

	Ожидаем.Что(НайтиПараметр(Параметры, "Фраза").Получить("schema").Получить("type"), "тип")
		.Равно("string");

КонецПроцедуры

// Без аннотации тегом остаётся адрес контроллера - так было и до появления &Тег.
&Тест
Процедура Должен_ВзятьТегомАдресКонтроллераБезАннотации() Экспорт

	Теги = ПолучитьОперацию("/openapitest/ping", "get").Получить("tags");

	Ожидаем.Что(Теги, "теги операции").Содержит("/openapitest");

КонецПроцедуры

// Тег контроллера относится ко всем его точкам маршрута.
&Тест
Процедура Должен_ОтнестиОперациюКТегуКонтроллера() Экспорт

	Теги = ПолучитьОперацию("/tagtest/plain", "get").Получить("tags");

	Ожидаем.Что(Теги, "теги операции").Содержит("Общий");
	Ожидаем.Что(Теги.Найти("/tagtest"), "адрес не подставляется при объявленном теге")
		.ЭтоНеопределено();

КонецПроцедуры

// Тег точки маршрута не вытесняет тег контроллера, а дополняет его.
&Тест
Процедура Должен_ДополнитьТегКонтроллераТегомОперации() Экспорт

	Теги = ПолучитьОперацию("/tagtest/own", "get").Получить("tags");

	Ожидаем.Что(Теги, "тег операции").Содержит("Особый");
	Ожидаем.Что(Теги, "тег контроллера").Содержит("Общий");

КонецПроцедуры

// Описания тегов собираются в раздел tags документа, чтобы Swagger UI показал
// их у групп.
&Тест
Процедура Должен_СобратьОписанияТеговВРазделДокумента() Экспорт

	Описания = Новый Соответствие();
	Для Каждого Тег Из Спецификация.Получить("tags") Цикл
		Описания.Вставить(Тег.Получить("name"), Тег.Получить("description"));
	КонецЦикла;

	Ожидаем.Что(Описания.Получить("Общий"), "описание общего тега")
		.Равно("Группа всего контроллера");
	Ожидаем.Что(Описания.Получить("Особый"), "описание особого тега")
		.Равно("Группа одной операции");

КонецПроцедуры

// Без раздела servers Swagger UI берёт адрес оттуда, откуда открыта страница,
// и промахивается, если документацию отдают отдельно или через прокси.
&Тест
Процедура Должен_ОписатьБазовыйАдресСервера() Экспорт

	Серверы = Спецификация.Получить("servers");

	Ожидаем.Что(Серверы, "раздел servers").ИмеетТип("Массив");
	Ожидаем.Что(Серверы.Количество(), "количество серверов").Равно(1);
	Ожидаем.Что(Серверы[0].Получить("url"), "адрес сервера").Равно("http://localhost:3333");

КонецПроцедуры

// Приложение бывает доступно не по тому адресу, который слушает: за обратным
// прокси, под доменным именем, по https. Тогда адрес задают настройкой.
&Тест
Процедура Должен_ВзятьАдресСервераИзНастройки() Экспорт

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("winow.openapi.АдресСервера", "https://api.example.com/v1/");

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);

	ПоделкаСАдресом = Новый Поделка(Совет);
	ПоделкаСАдресом.ЗапуститьПриложение();

	ГенераторСАдресом = ПоделкаСАдресом.НайтиЖелудь("ГенераторOpenApi");
	Серверы = ГенераторСАдресом.СформироватьСпецификацию().Получить("servers");

	// Завершающий слеш убирается: Swagger UI приписывает к адресу путь,
	// который сам начинается со слеша.
	Ожидаем.Что(Серверы[0].Получить("url"), "адрес из настройки")
		.Равно("https://api.example.com/v1");

КонецПроцедуры

// За обратным прокси приложение доступно не по тому адресу, который слушает.
// Прокси сообщает об этом заголовками, и nginx проставляет их штатно.
&Тест
Процедура Должен_ВзятьАдресСервераИзЗаголовковПрокси() Экспорт

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Host", "winow.local:3333");
	Заголовки.Вставить("x-forwarded-proto", "https");
	Заголовки.Вставить("X-Forwarded-Host", "api.example.com");
	Заголовки.Вставить("X-Forwarded-Prefix", "/winow");

	Серверы = Генератор.СформироватьСпецификацию(ЗапросСЗаголовками(Заголовки)).Получить("servers");

	Ожидаем.Что(Серверы[0].Получить("url"), "адрес из заголовков")
		.Равно("https://api.example.com/winow");

КонецПроцедуры

// Без заголовков прокси адрес собирается из заголовка Host: приложение
// доступно там же, откуда пришёл запрос.
&Тест
Процедура Должен_ВзятьАдресСервераИзЗаголовкаHost() Экспорт

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Host", "winow.local:8080");

	Серверы = Генератор.СформироватьСпецификацию(ЗапросСЗаголовками(Заголовки)).Получить("servers");

	Ожидаем.Что(Серверы[0].Получить("url"), "адрес из Host").Равно("http://winow.local:8080");

КонецПроцедуры

// Цепочка прокси накапливает значения через запятую, и ближайшее к клиенту
// стоит первым.
&Тест
Процедура Должен_ВзятьПервоеЗначениеИзЦепочкиПрокси() Экспорт

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Host", "winow.local:3333");
	Заголовки.Вставить("X-Forwarded-Proto", "https, http");
	Заголовки.Вставить("X-Forwarded-Host", "api.example.com, inner.local");

	Серверы = Генератор.СформироватьСпецификацию(ЗапросСЗаголовками(Заголовки)).Получить("servers");

	Ожидаем.Что(Серверы[0].Получить("url"), "адрес из первого звена")
		.Равно("https://api.example.com");

КонецПроцедуры

// Разбор заголовков запроса не должен портить настройки генератора: раньше
// переменная цикла по Запрос.Заголовки звалась так же, как настройка info.title,
// и после первой же генерации со запросом заголовок API подменялся на
// "КлючИЗначение". Без запроса цикл не выполняется, поэтому ловится это только
// повторной генерацией.
&Тест
Процедура Должен_СохранитьЗаголовокAPIПослеРазбораЗаголовковЗапроса() Экспорт

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Host", "winow.local:8080");

	Генератор.СформироватьСпецификацию(ЗапросСЗаголовками(Заголовки));
	ПовторнаяСпецификация = Генератор.СформироватьСпецификацию();

	Ожидаем.Что(ПовторнаяСпецификация.Получить("info").Получить("title"), "заголовок API")
		.Равно("winow API");

КонецПроцедуры

// Блок info описывает API целиком: кому писать, на каких условиях пользоваться,
// под какой лицензией. Всё необязательное и попадает в документ только заданным.
&Тест
Процедура Должен_ЗаполнитьБлокInfoИзНастроек() Экспорт

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("winow.openapi.УсловияИспользования", "https://example.com/terms");
	ЗначенияДеталек.Вставить("winow.openapi.Контакт.Имя", "Команда API");
	ЗначенияДеталек.Вставить("winow.openapi.Контакт.Почта", "api@example.com");
	ЗначенияДеталек.Вставить("winow.openapi.Лицензия.Имя", "MIT");
	ЗначенияДеталек.Вставить("winow.openapi.Лицензия.Адрес", "https://opensource.org/licenses/MIT");

	Информация = ИнформацияОСервисеСДетальками(ЗначенияДеталек);

	Ожидаем.Что(Информация.Получить("termsOfService"), "условия использования")
		.Равно("https://example.com/terms");

	Контакт = Информация.Получить("contact");
	Ожидаем.Что(Контакт.Получить("name"), "имя контакта").Равно("Команда API");
	Ожидаем.Что(Контакт.Получить("email"), "почта контакта").Равно("api@example.com");
	Ожидаем.Что(Контакт.Получить("url"), "адрес контакта не задан").ЭтоНеопределено();

	Лицензия = Информация.Получить("license");
	Ожидаем.Что(Лицензия.Получить("name"), "название лицензии").Равно("MIT");
	Ожидаем.Что(Лицензия.Получить("url"), "адрес лицензии")
		.Равно("https://opensource.org/licenses/MIT");

КонецПроцедуры

// Незаданные блоки в документ не попадают: пустой contact или license только
// засоряли бы спецификацию.
&Тест
Процедура Должен_ОпуститьНезаполненныеБлокиInfo() Экспорт

	Информация = Спецификация.Получить("info");

	Ожидаем.Что(Информация.Получить("contact"), "контакт").ЭтоНеопределено();
	Ожидаем.Что(Информация.Получить("license"), "лицензия").ЭтоНеопределено();
	Ожидаем.Что(Информация.Получить("termsOfService"), "условия").ЭтоНеопределено();

КонецПроцедуры

// Название лицензии по спецификации обязательно, поэтому один только адрес
// лицензией не считается.
&Тест
Процедура Должен_ОпуститьЛицензиюБезНазвания() Экспорт

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("winow.openapi.Лицензия.Адрес", "https://opensource.org/licenses/MIT");

	Информация = ИнформацияОСервисеСДетальками(ЗначенияДеталек);

	Ожидаем.Что(Информация.Получить("license"), "лицензия без названия").ЭтоНеопределено();

КонецПроцедуры

// info.summary появился в OpenAPI 3.1 и дополняет описание: сводка - одна
// строка, описание - сколько угодно текста.
&Тест
Процедура Должен_ЗаполнитьСводкуОСервисе() Экспорт

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("winow.openapi.Сводка", "Каталог товаров");
	ЗначенияДеталек.Вставить("winow.openapi.Описание", "Подробное описание API");

	Информация = ИнформацияОСервисеСДетальками(ЗначенияДеталек);

	Ожидаем.Что(Информация.Получить("summary"), "сводка").Равно("Каталог товаров");
	Ожидаем.Что(Информация.Получить("description"), "описание").Равно("Подробное описание API");

КонецПроцедуры

// license.identifier и license.url по спецификации взаимоисключающи, поэтому
// при заданном идентификаторе адрес в документ не попадает.
&Тест
Процедура Должен_ПредпочестьИдентификаторЛицензииАдресу() Экспорт

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("winow.openapi.Лицензия.Имя", "MIT");
	ЗначенияДеталек.Вставить("winow.openapi.Лицензия.Идентификатор", "MIT");
	ЗначенияДеталек.Вставить("winow.openapi.Лицензия.Адрес", "https://opensource.org/licenses/MIT");

	Лицензия = ИнформацияОСервисеСДетальками(ЗначенияДеталек).Получить("license");

	Ожидаем.Что(Лицензия.Получить("identifier"), "идентификатор").Равно("MIT");
	Ожидаем.Что(Лицензия.Получить("url"), "адрес рядом с идентификатором").ЭтоНеопределено();

КонецПроцедуры

// Без идентификатора адрес по-прежнему попадает в документ.
&Тест
Процедура Должен_ОставитьАдресЛицензииБезИдентификатора() Экспорт

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("winow.openapi.Лицензия.Имя", "MIT");
	ЗначенияДеталек.Вставить("winow.openapi.Лицензия.Адрес", "https://opensource.org/licenses/MIT");

	Лицензия = ИнформацияОСервисеСДетальками(ЗначенияДеталек).Получить("license");

	Ожидаем.Что(Лицензия.Получить("url"), "адрес").Равно("https://opensource.org/licenses/MIT");
	Ожидаем.Что(Лицензия.Получить("identifier"), "идентификатор").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура Должен_ПометитьУстаревшуюОперацию() Экспорт

	Операция = ПолучитьОперацию("/openapitest/oldroute", "get");

	Ожидаем.Что(Операция.Получить("deprecated"), "пометка операции").Равно(Истина);

КонецПроцедуры

// Пометка говорит, что операция устарела, но не говорит, куда переходить.
// Это добавляется текстом в описание.
&Тест
Процедура Должен_ДобавитьВОписаниеЧемЗаменитьУстаревшую() Экспорт

	Операция = ПолучитьОперацию("/openapitest/oldroute", "get");

	Ожидаем.Что(Операция.Получить("description"), "описание операции")
		.Содержит("Используйте /openapitest/ping");

КонецПроцедуры

&Тест
Процедура Должен_ПометитьУстаревшимОтдельныйПараметр() Экспорт

	Параметры = ПолучитьОперацию("/openapitest/oldroute", "get").Получить("parameters");

	Ожидаем.Что(НайтиПараметр(Параметры, "Старый").Получить("deprecated"), "устаревший параметр")
		.Равно(Истина);
	Ожидаем.Что(НайтиПараметр(Параметры, "Актуальный").Получить("deprecated"), "обычный параметр")
		.ЭтоНеопределено();

КонецПроцедуры

// Устаревший контроллер делает устаревшими все свои точки маршрута.
&Тест
Процедура Должен_УнаследоватьУстареваниеОтКонтроллера() Экспорт

	Операция = ПолучитьОперацию("/oldapi/plain", "get");

	Ожидаем.Что(Операция.Получить("deprecated"), "пометка операции").Равно(Истина);
	Ожидаем.Что(Операция.Получить("description"), "описание").Содержит("Используйте /openapitest");

КонецПроцедуры

// Своя пометка точки маршрута уточняет, чем её заменить: контроллер знает
// про замену вообще, а точка маршрута - про свою.
&Тест
Процедура Должен_ПредпочестьСвоюПометкуТочкиМаршрута() Экспорт

	Операция = ПолучитьОперацию("/oldapi/own", "get");

	Ожидаем.Что(Операция.Получить("description"), "описание")
		.Содержит("Используйте /openapitest/ping");

КонецПроцедуры

// Неустаревшая операция поля deprecated не получает: по спецификации оно
// необязательно и по умолчанию ложно, лишний ключ только шумит.
&Тест
Процедура Должен_НеПомечатьОбычнуюОперацию() Экспорт

	Операция = ПолучитьОперацию("/openapitest/ping", "get");

	Ожидаем.Что(Операция.Получить("deprecated"), "пометка обычной операции").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура Должен_СформироватьСтраницуSwaggerUI() Экспорт

	Страница = Генератор.СтраницаSwaggerUI();

	Ожидаем.Что(Страница).Содержит("swagger-ui");
	Ожидаем.Что(Страница).Содержит("SwaggerUIBundle");
	// Страница ссылается на канонический адрес спецификации, а он отдает JSON.
	Ожидаем.Что(Страница).Содержит("/v3/api-docs");

КонецПроцедуры

// Адреса документации по умолчанию совпадают с springdoc-openapi 2.x:
// канонический путь без расширения отдает JSON, он же плюс ".yaml" - YAML.
&Тест
Процедура Должен_ВыдатьАдресаДокументацииКакSpringdoc() Экспорт

	Ожидаем.Что(Генератор.АдресСпецификацииJson()).Равно("/v3/api-docs");
	Ожидаем.Что(Генератор.АдресСпецификацииYaml()).Равно("/v3/api-docs.yaml");
	Ожидаем.Что(Генератор.АдресСтраницыSwaggerUI()).Равно("/swagger-ui.html");

КонецПроцедуры

&Тест
Процедура Должен_ЗарегистрироватьСлужебныеМаршруты() Экспорт

	Поделка = Новый Поделка();
	Поделка.ЗапуститьПриложение();

	Регистратор = Поделка.НайтиЖелудь("РегистраторМаршрутовOpenApi");
	Регистратор.ЗарегистрироватьМаршруты();

	Маршрутизатор = Поделка.НайтиЖелудь("Маршрутизатор");

	ОбработчикJson = Маршрутизатор.НайтиОбработчикИПараметрыПоПолномуПути("/v3/api-docs");
	Ожидаем.Что(ЗначениеЗаполнено(ОбработчикJson.Действие), "обработчик JSON").Равно(Истина);

	ОбработчикYaml = Маршрутизатор.НайтиОбработчикИПараметрыПоПолномуПути("/v3/api-docs.yaml");
	Ожидаем.Что(ЗначениеЗаполнено(ОбработчикYaml.Действие), "обработчик YAML").Равно(Истина);

	ОбработчикСтраницы = Маршрутизатор.НайтиОбработчикИПараметрыПоПолномуПути("/swagger-ui.html");
	Ожидаем.Что(ЗначениеЗаполнено(ОбработчикСтраницы.Действие), "обработчик страницы").Равно(Истина);

КонецПроцедуры

&Тест
Процедура Должен_ОтклонитьПовторнуюРегистрациюМаршрутов() Экспорт

	Поделка = Новый Поделка();
	Поделка.ЗапуститьПриложение();

	Регистратор = Поделка.НайтиЖелудь("РегистраторМаршрутовOpenApi");
	Регистратор.ЗарегистрироватьМаршруты();

	ОшибкаВозникла = Ложь;
	Попытка
		Регистратор.ЗарегистрироватьМаршруты();
	Исключение
		ОшибкаВозникла = Истина;
	КонецПопытки;

	Ожидаем.Что(ОшибкаВозникла).Равно(Истина);

КонецПроцедуры

// Поднимает свою поделку с заданными детальками и возвращает блок info
// собранной в ней спецификации.
Функция ИнформацияОСервисеСДетальками(ЗначенияДеталек)

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);

	СвояПоделка = Новый Поделка(Совет);
	СвояПоделка.ЗапуститьПриложение();

	СвойГенератор = СвояПоделка.НайтиЖелудь("ГенераторOpenApi");

	Возврат СвойГенератор.СформироватьСпецификацию().Получить("info");

КонецФункции

// Генератору от запроса нужны только заголовки, поэтому поднимать настоящий
// ВходящийЗапрос ради этого незачем.
Функция ЗапросСЗаголовками(Заголовки)
	Возврат Новый Структура("Заголовки", Заголовки);
КонецФункции

Функция НайтиПараметр(Параметры, ИмяПараметра)

	Ожидаем.Что(Параметры <> Неопределено, "у операции отсутствуют параметры").Равно(Истина);

	Для Каждого Параметр Из Параметры Цикл
		Если Параметр.Получить("name") = ИмяПараметра Тогда
			Возврат Параметр;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("В операции отсутствует параметр %1", ИмяПараметра);

КонецФункции

Функция ПолучитьСхему(ИмяСхемы)

	Схемы = Спецификация.Получить("components").Получить("schemas");
	Ожидаем.Что(Схемы <> Неопределено, "в спецификации отсутствует раздел schemas").Равно(Истина);

	Схема = Схемы.Получить(ИмяСхемы);
	Ожидаем.Что(Схема <> Неопределено, СтрШаблон("В спецификации отсутствует схема %1", ИмяСхемы)).Равно(Истина);

	Возврат Схема;

КонецФункции

Функция ПолучитьПунктПути(Путь)
	ПунктПути = Спецификация.Получить("paths").Получить(Путь);
	Ожидаем.Что(ПунктПути <> Неопределено, СтрШаблон("В спецификации отсутствует путь %1", Путь)).Равно(Истина);
	Возврат ПунктПути;
КонецФункции

Функция ПолучитьОперацию(Путь, HTTPМетод)
	Возврат ПолучитьПунктПути(Путь).Получить(HTTPМетод);
КонецФункции

// Схема тела ответа с заданным кодом состояния.
Функция СхемаОтвета(Путь, КодСостояния, HTTPМетод = "get")
	Возврат ПолучитьОперацию(Путь, HTTPМетод)
		.Получить("responses")
		.Получить(КодСостояния)
		.Получить("content")
		.Получить("application/json")
		.Получить("schema");
КонецФункции

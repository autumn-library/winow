#Использовать autumn
#Использовать ".."
#Использовать asserts

// Контейнер приложения для тестов генератора.
Перем ОбщаяПоделка;
// Генератор спецификации OpenAPI.
Перем Генератор;
// Сформированная спецификация OpenAPI в виде соответствия.
Перем Спецификация;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	Если Генератор <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбщаяПоделка = Новый Поделка();
	ОбщаяПоделка.ЗапуститьПриложение();

	ИнициализацияНастроекСервера = ОбщаяПоделка.НайтиЖелудь("ИнициализацияНастроекСервера");
	ИнициализацияНастроекСервера.ИнициализацияКонтролов();

	Генератор = ОбщаяПоделка.НайтиЖелудь("ГенераторOpenApi");
	Спецификация = Генератор.СформироватьСпецификацию();

КонецПроцедуры

&Тест
Процедура Должен_ПроверитьБазовуюСтруктуруСпецификации() Экспорт

	Ожидаем.Что(Спецификация.Получить("openapi")).Равно("3.0.3");

	Информация = Спецификация.Получить("info");
	Ожидаем.Что(Информация).ИмеетТип("Соответствие");
	Ожидаем.Что(Информация.Получить("title")).Равно("winow API");
	Ожидаем.Что(Информация.Получить("version")).Равно("1.0.0");

	Ожидаем.Что(Спецификация.Получить("paths")).ИмеетТип("Соответствие");

КонецПроцедуры

&Тест
Процедура Должен_ПроверитьРегистрациюПростойТочкиМаршрута() Экспорт

	Операция = ПолучитьОперацию("/openapitest/ping", "get");

	Ожидаем.Что(Операция).ИмеетТип("Соответствие");
	Ожидаем.Что(Операция.Получить("summary")).Равно("Проверка доступности");
	Ожидаем.Что(Операция.Получить("operationId")).ИмеетТип("Строка");

	Ответы = Операция.Получить("responses");
	Ожидаем.Что(Ответы.Получить("200") <> Неопределено).Равно(Истина);

КонецПроцедуры

&Тест
Процедура Должен_ПроверитьПараметрПути() Экспорт

	Операция = ПолучитьОперацию("/openapitest/echo/{имя}", "get");
	Ожидаем.Что(Операция).ИмеетТип("Соответствие");

	Параметры = Операция.Получить("parameters");
	Ожидаем.Что(Параметры).ИмеетТип("Массив");
	Ожидаем.Что(Параметры.Количество()).Равно(1);

	Параметр = Параметры[0];
	Ожидаем.Что(Параметр.Получить("name")).Равно("имя");
	Ожидаем.Что(Параметр.Получить("in")).Равно("path");
	Ожидаем.Что(Параметр.Получить("required")).Равно(Истина);

КонецПроцедуры

&Тест
Процедура Должен_ПроверитьПараметрСтрокиЗапроса() Экспорт

	Операция = ПолучитьОперацию("/openapitest/search", "get");
	Ожидаем.Что(Операция).ИмеетТип("Соответствие");

	Параметры = Операция.Получить("parameters");
	Ожидаем.Что(Параметры).ИмеетТип("Массив");
	Ожидаем.Что(Параметры.Количество()).Равно(1);

	Параметр = Параметры[0];
	Ожидаем.Что(Параметр.Получить("name")).Равно("Фраза");
	Ожидаем.Что(Параметр.Получить("in")).Равно("query");
	Ожидаем.Что(Параметр.Получить("required")).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура Должен_ВыбратьМетодОтправкиПриТелеЗапроса() Экспорт

	Операция = ПолучитьОперацию("/openapitest/submit", "post");
	Ожидаем.Что(Операция).ИмеетТип("Соответствие");

	Содержимое = Операция.Получить("requestBody").Получить("content");
	Ожидаем.Что(Содержимое.Получить("application/json") <> Неопределено).Равно(Истина);

	// Точки маршрута с телом по умолчанию не считаются GET.
	Ожидаем.Что(ПолучитьПунктПути("/openapitest/submit").Получить("get")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура Должен_ОписатьДвоичноеТелоЗапроса() Экспорт

	Операция = ПолучитьОперацию("/openapitest/upload", "post");
	Ожидаем.Что(Операция).ИмеетТип("Соответствие");

	Содержимое = Операция.Получить("requestBody").Получить("content");
	Ожидаем.Что(Содержимое.Получить("application/octet-stream") <> Неопределено).Равно(Истина);

КонецПроцедуры

&Тест
Процедура Должен_УчитыватьАннотациюМетод() Экспорт

	ПунктПути = ПолучитьПунктПути("/openapitest/custom");
	Ожидаем.Что(ПунктПути.Получить("put") <> Неопределено).Равно(Истина);
	Ожидаем.Что(ПунктПути.Получить("get")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура Должен_СделатьИдентификаторОперацииУникальным() Экспорт

	ОперацияПинг = ПолучитьОперацию("/openapitest/ping", "get");
	ОперацияОбновления = ПолучитьОперацию("/openapitest/custom", "put");

	Совпадают = ОперацияПинг.Получить("operationId") = ОперацияОбновления.Получить("operationId");
	Ожидаем.Что(Совпадают).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура Должен_ЭкранироватьОсобыеСимволыВJson() Экспорт

	Текст = Генератор.СпецификацияТекстом();

	Ожидаем.Что(Текст).ИмеетТип("Строка");
	Ожидаем.Что(Лев(СокрЛП(Текст), 1)).Равно("{");
	Ожидаем.Что(Текст).Содержит("""openapi"":""3.0.3""");

	// Сводка "Спец " и \ конец" должна экранироваться как: Спец \" и \\ конец
	Ожидаем.Что(Текст).Содержит("Спец \"" и \\ конец");

КонецПроцедуры

// Тело с указанным типом описывается ссылкой на схему в components,
// а не безымянным объектом без свойств.
&Тест
Процедура Должен_ОписатьТелоЗапросаСсылкойНаСхему() Экспорт

	Операция = ПолучитьОперацию("/openapitest/typed", "post");

	Схема = Операция.Получить("requestBody").Получить("content")
		.Получить("application/json").Получить("schema");

	Ожидаем.Что(Схема.Получить("$ref"), "ссылка на схему тела")
		.Равно("#/components/schemas/ЗаявкаOpenApiТест");

КонецПроцедуры

// Тип свойства берётся из аннотации &Тип, обязательность - из &Заполнено,
// границы - из &Минимум и &Максимум. Своих аннотаций генератор не требует.
&Тест
Процедура Должен_ПостроитьСхемуТипаПоАннотациямПолей() Экспорт

	Свойства = ПолучитьСхему("ЗаявкаOpenApiТест").Получить("properties");

	Ожидаем.Что(Свойства.Получить("title").Получить("type"), "тип title").Равно("string");
	Ожидаем.Что(Свойства.Получить("Срочная").Получить("type"), "тип Срочная").Равно("boolean");

	Сумма = Свойства.Получить("amount");
	Ожидаем.Что(Сумма.Получить("type"), "тип amount").Равно("number");
	Ожидаем.Что(Сумма.Получить("minimum"), "minimum").Равно(0);
	Ожидаем.Что(Сумма.Получить("maximum"), "maximum").Равно(1000);

КонецПроцедуры

&Тест
Процедура Должен_ОтнестиКОбязательнымПоляСАннотациейЗаполнено() Экспорт

	Обязательные = ПолучитьСхему("ЗаявкаOpenApiТест").Получить("required");

	Ожидаем.Что(Обязательные, "список обязательных").Содержит("title");
	Ожидаем.Что(Обязательные.Найти("amount"), "amount не обязателен").ЭтоНеопределено();

КонецПроцедуры

// Поле с аннотацией &Несериализуемое в JSON не попадает, поэтому и в схеме
// его быть не должно.
&Тест
Процедура Должен_ИсключитьИзСхемыНесериализуемоеПоле() Экспорт

	Свойства = ПолучитьСхему("ЗаявкаOpenApiТест").Получить("properties");

	Ожидаем.Что(Свойства.Получить("СлужебноеПоле"), "несериализуемое поле").ЭтоНеопределено();

КонецПроцедуры

// Вложенный пользовательский тип описывается отдельной схемой, на которую
// свойство ссылается, - иначе одинаковые типы дублировались бы в документе.
&Тест
Процедура Должен_ОписатьВложенныйТипОтдельнойСхемой() Экспорт

	Свойства = ПолучитьСхему("ЗаявкаOpenApiТест").Получить("properties");

	Ожидаем.Что(Свойства.Получить("Адрес").Получить("$ref"), "ссылка на вложенный тип")
		.Равно("#/components/schemas/АдресOpenApiТест");

	СвойстваАдреса = ПолучитьСхему("АдресOpenApiТест").Получить("properties");
	Ожидаем.Что(СвойстваАдреса.Получить("city").Получить("type"), "тип city").Равно("string");

КонецПроцедуры

&Тест
Процедура Должен_СформироватьСтраницуSwaggerUI() Экспорт

	Страница = Генератор.СтраницаSwaggerUI();

	Ожидаем.Что(Страница).Содержит("swagger-ui");
	Ожидаем.Что(Страница).Содержит("SwaggerUIBundle");
	Ожидаем.Что(Страница).Содержит("/swagger/openapi.json");

КонецПроцедуры

&Тест
Процедура Должен_ЗарегистрироватьСлужебныеМаршруты() Экспорт

	Поделка = Новый Поделка();
	Поделка.ЗапуститьПриложение();

	Регистратор = Поделка.НайтиЖелудь("РегистраторМаршрутовOpenApi");
	Регистратор.ЗарегистрироватьМаршруты();

	Маршрутизатор = Поделка.НайтиЖелудь("Маршрутизатор");

	ОбработчикСпецификации = Маршрутизатор.НайтиОбработчикИПараметрыПоПолномуПути("/swagger/openapi.json");
	Ожидаем.Что(ЗначениеЗаполнено(ОбработчикСпецификации.Действие)).Равно(Истина);

	ОбработчикСтраницы = Маршрутизатор.НайтиОбработчикИПараметрыПоПолномуПути("/swagger");
	Ожидаем.Что(ЗначениеЗаполнено(ОбработчикСтраницы.Действие)).Равно(Истина);

КонецПроцедуры

&Тест
Процедура Должен_ОтклонитьПовторнуюРегистрациюМаршрутов() Экспорт

	Поделка = Новый Поделка();
	Поделка.ЗапуститьПриложение();

	Регистратор = Поделка.НайтиЖелудь("РегистраторМаршрутовOpenApi");
	Регистратор.ЗарегистрироватьМаршруты();

	ОшибкаВозникла = Ложь;
	Попытка
		Регистратор.ЗарегистрироватьМаршруты();
	Исключение
		ОшибкаВозникла = Истина;
	КонецПопытки;

	Ожидаем.Что(ОшибкаВозникла).Равно(Истина);

КонецПроцедуры

Функция ПолучитьСхему(ИмяСхемы)

	Схемы = Спецификация.Получить("components").Получить("schemas");
	Ожидаем.Что(Схемы <> Неопределено, "в спецификации отсутствует раздел schemas").Равно(Истина);

	Схема = Схемы.Получить(ИмяСхемы);
	Ожидаем.Что(Схема <> Неопределено, СтрШаблон("В спецификации отсутствует схема %1", ИмяСхемы)).Равно(Истина);

	Возврат Схема;

КонецФункции

Функция ПолучитьПунктПути(Путь)
	ПунктПути = Спецификация.Получить("paths").Получить(Путь);
	Ожидаем.Что(ПунктПути <> Неопределено, СтрШаблон("В спецификации отсутствует путь %1", Путь)).Равно(Истина);
	Возврат ПунктПути;
КонецФункции

Функция ПолучитьОперацию(Путь, HTTPМетод)
	Возврат ПолучитьПунктПути(Путь).Получить(HTTPМетод);
КонецФункции

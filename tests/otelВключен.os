#Использовать autumn
#Использовать opentelemetry
#Использовать ".."
#Использовать "поддержка"
#Использовать asserts

// Интеграция winow с OpenTelemetry при включённом otel.enabled.
//
// Набор работает в своей поделке: конфигурация задаётся советом, а не
// созданием поделки руками. Веб-сервер поднимается один раз на весь набор.
//
// Утверждения о трассировке делаются по ответам КонтролТрассировки,
// который отдаёт наружу состояние активного контекста, поэтому тестам
// не нужен доступ к внутренностям SDK.

Перем Поделка;
Перем Порт;
// СобирательСпанов - накапливает завершённые спаны, чтобы утверждать о серверном
// спане напрямую: снаружи его не видно, а контроллер видит свой внутренний спан.
Перем Собиратель;

// Число - сколько миллисекунд ждать готовности сервера.
Перем ПределОжиданияСервера;

// Число - с каким шагом в миллисекундах опрашивать сервер.
Перем ШагОжиданияСервера;

// Число - код состояния успешного ответа.
Перем КодУспешногоОтвета;

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Совет = "() -> СоветСТрассировкой()")
Процедура ПриСозданииОбъекта(&Пластилин("Поделка") _Поделка) Экспорт
	Поделка = _Поделка;
	Порт = 3335;
	ПределОжиданияСервера = 15000;
	ШагОжиданияСервера = 50;
	КодУспешногоОтвета = 200;
КонецПроцедуры

// Конфигурация изолированной поделки набора.
// Экспортёры отключены: тестам нужен работающий контекст трассировки,
// а не сетевые походы в несуществующий коллектор.
Функция СоветСТрассировкой() Экспорт

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("winow.ИспользоватьПрикладнойСервер", Истина);
	ЗначенияДеталек.Вставить("winow.Порт", 3335);
	ЗначенияДеталек.Вставить("otel.enabled", Истина);
	ЗначенияДеталек.Вставить("otel.traces.exporter", "none");
	ЗначенияДеталек.Вставить("otel.metrics.exporter", "none");
	ЗначенияДеталек.Вставить("otel.logs.exporter", "none");

	Совет = Новый СоветДругогоМастера();
	Совет.ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(ЗначенияДеталек, 3, "inline");

	Возврат Совет;

КонецФункции

&ПередВсеми
Процедура ЗапуститьСервер() Экспорт

	// SDK берётся из глобального реестра OTel, а не из поделки: желудь ОтелSdk
	// объявлен со спецификацией "Инициализация" и после старта приложения
	// из поделки уже не достаётся. Автоконфигурация регистрирует его глобально,
	// так что это тот же самый экземпляр, которым пользуется напильник.
	// Обработчик запросов сервера создаётся заранее: именно его создание
	// заставляет напильник поднять SDK и зарегистрировать его глобально.
	Поделка.НайтиЖелудь("ПрикладнойОбработчикЗапросов");

	// SDK берётся из глобального реестра OTel, а не из поделки: желудь ОтелSdk
	// объявлен со спецификацией "Инициализация" и после старта приложения
	// из поделки уже не достаётся. Это тот же экземпляр, что и у напильника.
	Собиратель = Новый СобирательСпанов();
	ОтелГлобальный.Получить().ПровайдерТрассировки()
		.ДобавитьПроцессор(Новый ОтелПростойПроцессорСпанов(Собиратель));

	ВебСервер = Поделка.НайтиЖелудь("ВебСервер");
	ФоновыеЗадания.Выполнить(ВебСервер, "Старт");
	ДождатьсяГотовностиСервера();

	Настройки = Поделка.НайтиЖелудь("Настройки");
	Настройки.ЗадержкаПередЧтениемСокета = 400;
	Настройки.ЗадержкаПередЗакрытиемСокета = 300;

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьСервер() Экспорт

	Попытка
		Поделка.НайтиЖелудь("ВебСервер").Стоп();
	Исключение
		// Сервер уже остановлен - ронять из-за этого прогон незачем.
	КонецПопытки;

КонецПроцедуры

// Шов обработки запроса лежит на каждой реализации сервера, и напильник находит
// их по прозвищу ОбработчикЗапросовВебСервера. Оборачиваться должны оба, иначе
// на одном из серверов серверного спана просто не будет.
&ПараметризованныйТест(Имя = "желудь={Параметры}")
&ИсточникЗначение("ПрикладнойОбработчикЗапросов")
&ИсточникЗначение("НативныйОбработчикЗапросов")
Процедура ЖелудьСоШвомОборачиваетсяДекоратором(ИмяЖелудя) Экспорт

	// Когда
	Желудь = Поделка.НайтиЖелудь(ИмяЖелудя);

	// Тогда
	Ожидаем.Что(Строка(ТипЗнч(Желудь)), "тип желудя " + ИмяЖелудя)
		.ЭтоНе().Равно(ИмяЖелудя);

КонецПроцедуры

&Тест
Процедура ЗапросыОбрабатываютсяКакОбычно() Экспорт

	// Когда
	Ответ = ГетЗапрос("/tests/checkup");

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния, "код состояния").Равно(200);

КонецПроцедуры

// Шаблон маршрута нужен трассировке как низкокардинальное имя операции,
// поэтому проверяется весь путь: регистрация маршрута, сопоставление запроса
// и проброс шаблона на ВходящийЗапрос.
&Тест
Процедура ЗапросПолучаетШаблонМаршрутаАНеКонкретныйПуть() Экспорт

	// Когда
	Ответ = ГетЗапрос("/tests/otel/route/5/mult/7");

	// Тогда
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), "шаблон маршрута")
		.Равно("/tests/otel/route/{Первый}/mult/{Второй}");

КонецПроцедуры

// Спан метода контроллера создаёт autumn-opentelemetry, а его родителем
// становится серверный спан от winow. Без серверного спана спан метода
// оказался бы корневым и родителя бы не имел.
&Тест
Процедура СерверныйСпанСтановитсяРодителемСпанаМетода() Экспорт

	// Когда
	Ответ = ГетЗапрос("/tests/otel/parent");

	// Тогда
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), "родительский спан")
		.ЭтоНе().Равно("нет");

КонецПроцедуры

&Тест
Процедура ВходящийTraceparentПродолжаетТрассировку() Экспорт

	// Дано
	ИдТрассировки = "4bf92f3577b34da6a3ce929d0e0e4736";
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("traceparent", "00-" + ИдТрассировки + "-00f067aa0ba902b7-01");

	// Когда
	Ответ = ГетЗапрос("/tests/otel/traceid", Заголовки);

	// Тогда
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), "идентификатор трассировки")
		.Равно(ИдТрассировки);

КонецПроцедуры

// Серверный спан помечается областью инструментирования winow, а не общей
// autumn-observed: имя области - это то, по чему в бэкенде отличают источник
// телеметрии, а в SDK - включают и выключают трассировщики по отдельности.
&Тест
Процедура СерверныйСпанПомеченОбластьюWinow() Экспорт

	// Когда
	Собиратель.Очистить();
	ГетЗапрос("/tests/checkup");

	// Тогда
	Область = СерверныйСпан().ОбластьИнструментирования();
	Ожидаем.Что(Область.Имя(), "имя области инструментирования").Равно("winow");

КонецПроцедуры

&Тест
Процедура ИмяСерверногоСпанаСодержитШаблонМаршрута() Экспорт

	// Когда
	Собиратель.Очистить();
	ГетЗапрос("/tests/otel/route/5/mult/7");

	// Тогда
	Спан = СерверныйСпан();
	Ожидаем.Что(Спан.Имя(), "имя серверного спана")
		.Равно("GET /tests/otel/route/{Первый}/mult/{Второй}");
	Ожидаем.Что(Спан.Атрибуты().Получить("http.route"), "http.route")
		.Равно("/tests/otel/route/{Первый}/mult/{Второй}");

КонецПроцедуры

&Тест
Процедура СерверныйСпанСодержитАтрибутыЗапроса() Экспорт

	// Когда
	Собиратель.Очистить();
	ГетЗапрос("/tests/checkup");

	// Тогда
	Атрибуты = СерверныйСпан().Атрибуты();
	Ожидаем.Что(Атрибуты.Получить("http.request.method"), "http.request.method").Равно("GET");
	Ожидаем.Что(Атрибуты.Получить("url.path"), "url.path").Равно("/tests/checkup");
	Ожидаем.Что(Атрибуты.Получить("url.scheme"), "url.scheme").Равно("http");
	Ожидаем.Что(Атрибуты.Получить("http.response.status_code"), "http.response.status_code").Равно(200);
	Ожидаем.Что(Атрибуты.Получить("server.port"), "server.port").Равно(Порт);

КонецПроцедуры

// Рукопожатие - короткий HTTP-запрос и получает обычный серверный спан. Соединение
// после него живёт долго, но спан на всё время жизни соединения не растягивается.
&Тест
Процедура РукопожатиеВебСокетаПолучаетСерверныйСпан() Экспорт

	// Дано
	Собиратель.Очистить();
	КодПереключенияПротокола = 101;

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/ws");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	Спан = Собиратель.ДождатьсяСпана("GET /socket/ws");
	Ожидаем.Что(Спан, "спан рукопожатия").Заполнено();
	Ожидаем.Что(Спан.ВидСпана(), "вид спана рукопожатия").Равно(ОтелВидСпана.Сервер());
	Ожидаем.Что(Спан.Атрибуты().Получить("http.response.status_code"), "http.response.status_code")
		.Равно(КодПереключенияПротокола);

КонецПроцедуры

// Каждое сообщение - своя трассировка со ссылкой на рукопожатие.
&Тест
Процедура СообщениеВебСокетаПолучаетСпанСЛинкомНаРукопожатие() Экспорт

	// Дано
	Собиратель.Очистить();

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/ws");
	Ответ = КлиентВебСокета.Обменяться(Клиент, "привет");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	СпанРукопожатия = Собиратель.ДождатьсяСпана("GET /socket/ws");
	СпанСообщения = Собиратель.ДождатьсяСпанаСобытия("process /socket/ws", СпанРукопожатия);
	Ожидаем.Что(Ответ, "ответ обработчика").Равно("привет 1");
	Ожидаем.Что(СпанСообщения, "спан сообщения с линком на рукопожатие").Заполнено();
	Ожидаем.Что(СпанСообщения.ВидСпана(), "вид спана сообщения").Равно(ОтелВидСпана.Потребитель());
	Ожидаем.Что(СпанСообщения.Линки().Количество(), "количество линков").Равно(1);

КонецПроцедуры

// Спан метода контроллера создаёт autumn-opentelemetry, и родителем ему
// становится спан сообщения, а не рукопожатия.
&Тест
Процедура СпанСообщенияСтановитсяРодителемСпанаМетода() Экспорт

	// Дано
	Собиратель.Очистить();

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/ws");
	КлиентВебСокета.Обменяться(Клиент, "привет");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	СпанРукопожатия = Собиратель.ДождатьсяСпана("GET /socket/ws");
	СпанСообщения = Собиратель.ДождатьсяСпанаСобытия("process /socket/ws", СпанРукопожатия);
	Ожидаем.Что(Собиратель.ДочернийСпан(СпанСообщения), "спан метода обработчика").Заполнено();

КонецПроцедуры

// Обработчик сообщения упал - клиент об этом не узнаёт, а спан помечается ошибкой.
&Тест
Процедура ОшибкаОбработчикаСообщенияПомечаетСпанОшибкой() Экспорт

	// Дано
	Собиратель.Очистить();

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/fail");
	Клиент.ОтправитьДвоичныеДанные(КлиентВебСокета.ТекстовыйКадр("упади"));
	Спан = Собиратель.ДождатьсяСпана("process /socket/fail");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	Ожидаем.Что(Спан, "спан сообщения").Заполнено();
	Ожидаем.Что(Спан.КодСтатуса(), "код статуса спана").Равно(ОтелКодСтатуса.Ошибка());

КонецПроцедуры

&ПараметризованныйТест(Имя = "{Параметры}")
&ИсточникЗначение("connect /socket/ws")
&ИсточникЗначение("disconnect /socket/ws")
Процедура СобытиеСоединенияПолучаетСпанСЛинкомНаРукопожатие(ИмяСпана) Экспорт

	// Дано
	Собиратель.Очистить();

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/ws");
	КлиентВебСокета.Обменяться(Клиент, "привет");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	СпанРукопожатия = Собиратель.ДождатьсяСпана("GET /socket/ws");
	Спан = Собиратель.ДождатьсяСпанаСобытия(ИмяСпана, СпанРукопожатия);
	Ожидаем.Что(Спан, "спан события с линком на рукопожатие").Заполнено();

КонецПроцедуры

// Входящий traceparent рукопожатия продолжает трассировку рукопожатия,
// а через линк связывает с ней и сообщения клиента.
&Тест
Процедура TraceparentРукопожатияСвязываетСообщения() Экспорт

	// Дано
	Собиратель.Очистить();
	ИдТрассировки = "4bf92f3577b34da6a3ce929d0e0e4737";
	Заголовок = "traceparent: 00-" + ИдТрассировки + "-00f067aa0ba902b7-01";

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/ws", Заголовок);
	КлиентВебСокета.Обменяться(Клиент, "привет");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	СпанРукопожатия = Собиратель.ДождатьсяСпана("GET /socket/ws");
	СпанСообщения = Собиратель.ДождатьсяСпанаСобытия("process /socket/ws", СпанРукопожатия);
	Ожидаем.Что(СпанСообщения.Линки()[0].КонтекстСпана().ИдТрассировки(), "трассировка рукопожатия")
		.Равно(ИдТрассировки);

КонецПроцедуры

// Топик серверных событий - зарегистрированный путь, поэтому в имени спана подключения он и стоит.
&Тест
Процедура ПодключениеКСервернымСобытиямПолучаетСерверныйСпан() Экспорт

	// Дано
	Собиратель.Очистить();
	КодУспеха = 200;

	// Когда
	Клиент = Новый ССЕКлиент("localhost", Порт, "/sse/test1");
	Спан = Собиратель.ДождатьсяСпана("GET /sse/test1");
	Клиент.Остановить();

	// Тогда
	Ожидаем.Что(Спан, "спан подключения").Заполнено();
	Ожидаем.Что(Спан.Атрибуты().Получить("http.response.status_code"), "http.response.status_code")
		.Равно(КодУспеха);

КонецПроцедуры

&ПараметризованныйТест(Имя = "{Параметры}")
&ИсточникЗначение("connect /sse/testsub")
&ИсточникЗначение("disconnect /sse/testsub")
Процедура СобытиеСоединенияСерверныхСобытийПолучаетСпанСЛинкомНаПодключение(ИмяСпана) Экспорт

	// Дано
	Собиратель.Очистить();

	// Когда
	Клиент = Новый ССЕКлиент("localhost", Порт, "/sse/testsub");
	СпанПодключения = Собиратель.ДождатьсяСпана("GET /sse/testsub");
	ПулСерверныхСобытий.ЗакрытьСоединенияТопика(Поделка, "/sse/testsub");
	Клиент.Остановить();

	// Тогда
	Спан = Собиратель.ДождатьсяСпанаСобытия(ИмяСпана, СпанПодключения);
	Ожидаем.Что(Спан, "спан события с линком на подключение").Заполнено();

КонецПроцедуры

// Событие отправляет обработчик HTTP-запроса: спан отправки - часть его трассировки
// и ссылается на подключение получателя.
&Тест
Процедура ОтправкаСерверногоСобытияПолучаетСпанСЛинкомНаПодключение() Экспорт

	// Дано
	Собиратель.Очистить();
	Клиент = Новый ССЕКлиент("localhost", Порт, "/sse/test1");
	СпанПодключения = Собиратель.ДождатьсяСпана("GET /sse/test1");

	// Когда
	ГетЗапрос("/sse/sendall/привет");
	Клиент.Остановить();

	// Тогда
	СпанЗапроса = Собиратель.ДождатьсяСпана("GET /sse/sendall/{Текст}");
	Спан = Собиратель.ДождатьсяСпанаСобытия("send /sse/test1", СпанПодключения);
	Ожидаем.Что(Спан, "спан отправки с линком на подключение").Заполнено();
	Ожидаем.Что(Спан.ВидСпана(), "вид спана отправки").Равно(ОтелВидСпана.Производитель());
	// родитель - спан метода контроллера, который сам дочерний серверному спану запроса
	Ожидаем.Что(Спан.КонтекстСпана().ИдТрассировки(), "трассировка спана отправки")
		.Равно(СпанЗапроса.КонтекстСпана().ИдТрассировки());

КонецПроцедуры

&Тест
Процедура ОшибкаОбработчикаПодключенияПомечаетСпанОшибкой() Экспорт

	// Дано
	Собиратель.Очистить();

	// Когда
	Клиент = Новый ССЕКлиент("localhost", Порт, "/sse/fail");
	СпанПодключения = Собиратель.ДождатьсяСпана("GET /sse/fail");
	Спан = Собиратель.ДождатьсяСпанаСобытия("connect /sse/fail", СпанПодключения);
	Клиент.Остановить();

	// Тогда
	Ожидаем.Что(Спан, "спан подключения").Заполнено();
	Ожидаем.Что(Спан.КодСтатуса(), "код статуса спана").Равно(ОтелКодСтатуса.Ошибка());

КонецПроцедуры

// Ждёт, пока сервер начнёт отвечать на запросы.
//
// Маршруты к этому моменту уже зарегистрированы: ЗапуститьПриложение отрабатывает
// рогатки и возвращает управление до того, как поднимется слушатель. Ждать нужно
// только сам сокет - Старт уходит в фоновое задание. Фиксированная пауза была бы
// гаданием, поэтому опрашиваем готовность.
Процедура ДождатьсяГотовностиСервера()

	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПределОжиданияСервера;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < КрайнийСрок Цикл

		Если СерверОтвечает() Тогда
			Возврат;
		КонецЕсли;

		Приостановить(ШагОжиданияСервера);

	КонецЦикла;

	ВызватьИсключение СтрШаблон("Сервер на порту %1 не ответил за %2 мс",
		Порт, ПределОжиданияСервера);

КонецПроцедуры

Функция СерверОтвечает()

	Попытка
		Возврат ГетЗапрос("/tests/checkup").КодСостояния = КодУспешногоОтвета;
	Исключение
		// Порт ещё не слушают - соединение не устанавливается.
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция СерверныйСпан()

	Спан = Собиратель.ПоследнийСпанВида(ОтелВидСпана.Сервер());
	Ожидаем.Что(Спан, "серверный спан").Заполнено();

	Возврат Спан;

КонецФункции

Функция ГетЗапрос(Адрес, Заголовки = Неопределено)

	Соединение = Новый HTTPСоединение("http://localhost", Порт, , , , 5);
	Запрос = Новый HTTPЗапрос(Адрес);

	Если Заголовки <> Неопределено Тогда
		Запрос.Заголовки = Заголовки;
	КонецЕсли;

	Возврат Соединение.Получить(Запрос);

КонецФункции

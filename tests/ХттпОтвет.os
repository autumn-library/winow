#Использовать ".."
#Использовать asserts

// Класс ХттпОтвет - fluent-обёртка над ответом нативного сервера:
// методы настраивают ответ и возвращают сам объект.

&Тест
Процедура Должен_ЗаписатьЗаголовкиВОтвет() Экспорт

	// Дано
	Ответ = Новый ХттпОтвет();

	// Когда
	Результат = Ответ.Заголовок("X-Test", "1");
	Ответ.Заголовок("X-Other", "2");

	// Тогда
	Ожидаем.Что(Результат, "метод возвращает сам ответ").Равно(Ответ);
	Ожидаем.Что(Ответ.ПолучитьЗаголовки().Количество(), "заголовки накапливаются").Равно(2);
	Ожидаем.Что(Ответ.ПолучитьЗаголовки()["X-Test"], "значение первого заголовка").Равно("1");

КонецПроцедуры

&Тест
Процедура Должен_ЗаписатьТелоИзСтроки() Экспорт

	// Дано
	Ответ = Новый ХттпОтвет();
	Текст = "Привет, мир";
	Эталон = ПолучитьБуферДвоичныхДанныхИзСтроки(Текст);

	// Когда
	Результат = Ответ.ТелоИзСтроки(Текст);

	// Тогда
	Тело = Ответ.ПолучитьТело();
	
	Ожидаем.Что(Результат, "метод возвращает сам ответ").Равно(Ответ);
	Ожидаем.Что(Тело.Размер, "размер тела в байтах UTF-8").Равно(20);

	Для Индекс = 0 По Эталон.Размер - 1 Цикл
		Ожидаем.Что(Тело.Получить(Индекс), "байт " + Индекс).Равно(Эталон.Получить(Индекс));
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура Должен_ЗаписатьТелоИзФайла() Экспорт

	// Дано
	Путь = ОбъединитьПути(ТекущийСценарий().Каталог, "app", "files", "textfile.txt");	Ответ = Новый ХттпОтвет();
	Эталон = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Новый ДвоичныеДанные(Путь));

	// Когда
	Результат = Ответ.ТелоИзФайла(Путь);

	// Тогда
	Тело = Ответ.ПолучитьТело();

	Ожидаем.Что(Результат, "метод возвращает сам ответ").Равно(Ответ);
	Ожидаем.Что(Эталон.Размер > 0, "тестовый файл не пустой").ЭтоИстина();
	Ожидаем.Что(Тело.Размер, "размер тела равен размеру файла").Равно(Эталон.Размер);

	Для Индекс = 0 По Эталон.Размер - 1 Цикл
		Ожидаем.Что(Тело.Получить(Индекс), "байт " + Индекс).Равно(Эталон.Получить(Индекс));
	КонецЦикла;

КонецПроцедуры
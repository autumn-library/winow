#Использовать autumn
#Использовать opentelemetry
#Использовать ".."
#Использовать "поддержка"
#Использовать asserts

// Содержимое спанов, которые winow заводит на события соединений серверных событий (SSE):
// подключение, отключение и отправку события клиентам.
//
// Соединение живёт долго, поэтому, как и у веб-сокетов, один спан на всё соединение
// не заводится: подключение - обычный короткий HTTP-спан, а каждое событие - свой спан
// со ссылкой линком на спан подключения.
//
// Веб-сервер не поднимается: содержимое спанов от реализации сервера не зависит.

Перем Трассировка; // ТрассировкаСерверныхСобытий - проверяемый желудь
Перем Трассировщик; // ОтелТрассировщик - создаёт спаны подключения и внешний спан
Перем Топик; // Строка - топик соединений

// Отдельный процесс по той же причине, что и у otelСерверныйСпан: SDK OTel
// регистрируется глобально один раз на процесс.
//
// Параметры:
//  _Трассировка - ТрассировкаСерверныхСобытий - Проверяемый желудь.
//  ОтелSdk      - ОтелSdk - SDK OpenTelemetry поделки набора.
//
&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс", Совет = "() -> НастройкиТрассировки.СоветСТрассировкой()")
Процедура ПриСозданииОбъекта(&Пластилин("ТрассировкаСерверныхСобытий") _Трассировка,
		&Пластилин("ОтелSdk") ОтелSdk) Экспорт
	Трассировка = _Трассировка;
	Трассировщик = ОтелSdk.ПолучитьТрассировщик("тест");
	Топик = "/sse/test1";
КонецПроцедуры

// Топик - зарегистрированный путь, а не шаблон: кардинальность имени и так низкая.
//
// Параметры:
//  ИмяМетода - Строка - Метод трассировки, открывающий спан события.
//  Операция  - Строка - Ожидаемая операция в имени спана.
//
&ПараметризованныйТест(Имя = "{Параметры}")
&ИсточникЗначение("НачатьПодключение", "connect")
&ИсточникЗначение("НачатьОтключение", "disconnect")
Процедура ИмяСпанаСобытияЭтоОперацияИТопик(ИмяМетода, Операция) Экспорт

	// Дано
	Подключение = НовоеПодключение(Топик);

	// Когда
	Состояние = НачатьСобытие(ИмяМетода, Подключение);
	Трассировка.Завершить(Состояние);

	// Тогда
	Ожидаем.Что(Состояние.Спан.Имя(), "имя спана").Равно(Операция + " /sse/test1");

КонецПроцедуры

// Подключение и отключение - внутренние события сервера, сообщений в них нет.
//
// Параметры:
//  ИмяМетода - Строка - Метод трассировки, открывающий спан события.
//
&ПараметризованныйТест(Имя = "{Параметры}")
&ИсточникЗначение("НачатьПодключение")
&ИсточникЗначение("НачатьОтключение")
Процедура СпанПодключенияИОтключенияВидаВнутренний(ИмяМетода) Экспорт

	// Дано
	Подключение = НовоеПодключение(Топик);

	// Когда
	Состояние = НачатьСобытие(ИмяМетода, Подключение);
	Трассировка.Завершить(Состояние);

	// Тогда
	Ожидаем.Что(Состояние.Спан.ВидСпана(), "вид спана").Равно(ОтелВидСпана.Внутренний());

КонецПроцедуры

&Тест
Процедура СпанСобытияСодержитАтрибутыТопика() Экспорт

	// Дано
	Подключение = НовоеПодключение(Топик);

	// Когда
	Состояние = Трассировка.НачатьПодключение(Подключение);
	Трассировка.Завершить(Состояние);

	// Тогда
	Атрибуты = Состояние.Спан.Атрибуты();
	Ожидаем.Что(Атрибуты.Получить("url.path"), "url.path").Равно(Топик);
	Ожидаем.Что(Атрибуты.Получить("http.route"), "http.route").Равно(Топик);

КонецПроцедуры

// Каждое событие - своя трассировка, иначе события долгого соединения попали бы
// в одну бесконечную трассировку подключения. Связь с подключением сохраняется линком.
&Тест
Процедура СпанСобытияНачинаетНовуюТрассировкуСЛинкомНаПодключение() Экспорт

	// Дано
	СпанПодключения = Трассировщик.НачатьСпан("GET /sse/test1", ОтелВидСпана.Сервер());
	Подключение = НовоеПодключение(Топик, СпанПодключения);
	СпанПодключения.Завершить();

	// Когда
	Состояние = Трассировка.НачатьОтключение(Подключение);
	Трассировка.Завершить(Состояние);

	// Тогда
	Спан = Состояние.Спан;
	Линки = Спан.Линки();
	Ожидаем.Что(Спан.КонтекстСпана().ИдТрассировки(), "новая трассировка")
		.ЭтоНе().Равно(СпанПодключения.КонтекстСпана().ИдТрассировки());
	Ожидаем.Что(Линки.Количество(), "количество линков").Равно(1);
	Ожидаем.Что(Линки[0].КонтекстСпана().ИдСпана(), "линк на спан подключения")
		.Равно(СпанПодключения.КонтекстСпана().ИдСпана());

КонецПроцедуры

// Обработчик события может вызываться внутри чужого активного спана,
// но событие соединения ему не дочернее.
&Тест
Процедура СпанСобытияНеНаследуетТекущийСпан() Экспорт

	// Дано
	ВнешнийСпан = Трассировщик.НачатьСпан("внешний");
	ОбластьВнешнего = ВнешнийСпан.СделатьТекущим();
	Подключение = НовоеПодключение(Топик);

	// Когда
	Состояние = Трассировка.НачатьПодключение(Подключение);
	Трассировка.Завершить(Состояние);

	ОбластьВнешнего.Закрыть();
	ВнешнийСпан.Завершить();

	// Тогда
	Ожидаем.Что(Состояние.Спан.ИдРодительскогоСпана(), "родитель спана").Равно("");

КонецПроцедуры

// Подключение могло пройти без трассировки: тогда и ссылаться не на что.
&Тест
Процедура БезКонтекстаПодключенияСпанБезЛинков() Экспорт

	// Дано
	Подключение = НовоеПодключение(Топик);

	// Когда
	Состояние = Трассировка.НачатьПодключение(Подключение);
	Трассировка.Завершить(Состояние);

	// Тогда
	Ожидаем.Что(Состояние.Спан.Линки().Количество(), "количество линков").Равно(0);

КонецПроцедуры

// Спан события текущий, пока работает обработчик: спаны, которые обработчик
// заводит сам, становятся его дочерними.
&Тест
Процедура СпанСобытияТекущийДоЗавершения() Экспорт

	// Дано
	Подключение = НовоеПодключение(Топик);

	// Когда
	Состояние = Трассировка.НачатьПодключение(Подключение);
	ТекущийВоВремяОбработки = ОтелКонтекст.ТекущийСпан();
	Трассировка.Завершить(Состояние);
	ТекущийПослеОбработки = ОтелКонтекст.ТекущийСпан();

	// Тогда
	Ожидаем.Что(ТекущийВоВремяОбработки, "текущий спан во время обработки").Равно(Состояние.Спан);
	Ожидаем.Что(ТекущийПослеОбработки, "текущий спан после обработки").ЭтоНе().Равно(Состояние.Спан);
	Ожидаем.Что(Состояние.Спан.Завершен(), "спан завершён").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИсключениеПомечаетСпанСобытияОшибкойИЗаписываетЕго() Экспорт

	// Дано
	Подключение = НовоеПодключение(Топик);
	Состояние = Трассировка.НачатьПодключение(Подключение);

	// Когда
	Попытка
		ВызватьИсключение "тестовая ошибка";
	Исключение
		Трассировка.ЗавершитьСОшибкой(Состояние, ИнформацияОбОшибке(), ОписаниеОшибки());
	КонецПопытки;

	// Тогда
	Ожидаем.Что(Состояние.Спан.КодСтатуса(), "код статуса спана").Равно(ОтелКодСтатуса.Ошибка());
	Ожидаем.Что(Состояние.Спан.События().Количество(), "количество событий спана").Больше(0);
	Ожидаем.Что(Состояние.Спан.Завершен(), "спан завершён").ЭтоИстина();
	Ожидаем.Что(ОтелКонтекст.ТекущийСпан(), "текущий спан после ошибки").ЭтоНе().Равно(Состояние.Спан);

КонецПроцедуры

// Отправка события - публикация сообщения, как в messaging semantic conventions.
&Тест
Процедура СпанОтправкиВидаПроизводитель() Экспорт

	// Когда
	Состояние = Трассировка.НачатьОтправку(Топик, Новый Массив());
	Трассировка.Завершить(Состояние);

	// Тогда
	Ожидаем.Что(Состояние.Спан.ВидСпана(), "вид спана").Равно(ОтелВидСпана.Производитель());
	Ожидаем.Что(Состояние.Спан.Имя(), "имя спана").Равно("send /sse/test1");
	Ожидаем.Что(Состояние.Спан.Атрибуты().Получить("url.path"), "url.path").Равно(Топик);
	Ожидаем.Что(Состояние.Спан.Атрибуты().Получить("http.route"), "http.route").Равно(Топик);

КонецПроцедуры

// Отправка по идентификатору соединения топика не знает, если соединения уже нет.
&Тест
Процедура БезТопикаИмяСпанаОтправкиЭтоТолькоОперация() Экспорт

	// Когда
	Состояние = Трассировка.НачатьОтправку("", Новый Массив());
	Трассировка.Завершить(Состояние);

	// Тогда
	Ожидаем.Что(Состояние.Спан.Имя(), "имя спана").Равно("send");
	Ожидаем.Что(Состояние.Спан.Атрибуты().Получить("url.path"), "url.path").ЭтоНеопределено();
	Ожидаем.Что(Состояние.Спан.Атрибуты().Получить("http.route"), "http.route").ЭтоНеопределено();

КонецПроцедуры

// Событие отправляет прикладной код, например обработчик HTTP-запроса:
// отправка - часть его трассировки.
&Тест
Процедура СпанОтправкиДочернийТекущему() Экспорт

	// Дано
	ВнешнийСпан = Трассировщик.НачатьСпан("POST /notify", ОтелВидСпана.Сервер());
	ОбластьВнешнего = ВнешнийСпан.СделатьТекущим();

	// Когда
	Состояние = Трассировка.НачатьОтправку(Топик, Новый Массив());
	ТекущийВоВремяОтправки = ОтелКонтекст.ТекущийСпан();
	Трассировка.Завершить(Состояние);

	ОбластьВнешнего.Закрыть();
	ВнешнийСпан.Завершить();

	// Тогда
	Ожидаем.Что(Состояние.Спан.ИдРодительскогоСпана(), "родитель спана")
		.Равно(ВнешнийСпан.КонтекстСпана().ИдСпана());
	Ожидаем.Что(ТекущийВоВремяОтправки, "текущий спан во время отправки").Равно(Состояние.Спан);

КонецПроцедуры

// Из трассировки отправки видно, каким соединениям ушло событие: на каждое -
// линк на спан его подключения. Соединение без трассировки ссылки не даёт.
&Тест
Процедура СпанОтправкиСсылаетсяНаПодключенияПолучателей() Экспорт

	// Дано
	СпанПервого = Трассировщик.НачатьСпан("GET /sse/test1", ОтелВидСпана.Сервер());
	СпанПервого.Завершить();
	СпанВторого = Трассировщик.НачатьСпан("GET /sse/test1", ОтелВидСпана.Сервер());
	СпанВторого.Завершить();

	Получатели = Новый Массив();
	Получатели.Добавить(НовоеПодключение(Топик, СпанПервого));
	Получатели.Добавить(НовоеПодключение(Топик));
	Получатели.Добавить(НовоеПодключение(Топик, СпанВторого));

	// Когда
	Состояние = Трассировка.НачатьОтправку(Топик, Получатели);
	Трассировка.Завершить(Состояние);

	// Тогда
	ПодключенийСТрассировкой = 2;
	Линки = Состояние.Спан.Линки();
	Ожидаем.Что(Линки.Количество(), "количество линков").Равно(ПодключенийСТрассировкой);
	Ожидаем.Что(Линки[0].КонтекстСпана().ИдСпана(), "линк на первое подключение")
		.Равно(СпанПервого.КонтекстСпана().ИдСпана());
	Ожидаем.Что(Линки[1].КонтекстСпана().ИдСпана(), "линк на второе подключение")
		.Равно(СпанВторого.КонтекстСпана().ИдСпана());

КонецПроцедуры

Функция НачатьСобытие(ИмяМетода, Подключение)

	Параметры = Новый Массив();
	Параметры.Добавить(Подключение);

	Возврат Новый Рефлектор().ВызватьМетод(Трассировка, ИмяМетода, Параметры);

КонецФункции

// Параметры:
//  ТопикПодключения - Строка - Топик соединения.
//  СпанПодключения - ОтелСпан, Неопределено - Спан подключения; Неопределено - подключение без трассировки.
//
// Возвращаемое значение:
//  Структура - Описание соединения, см. ОбработчикСерверныхСобытий.
//
Функция НовоеПодключение(ТопикПодключения, СпанПодключения = Неопределено)

	Подключение = Новый Структура("Идентификатор, Топик, ИдСоединения, КонтекстТрассировки");
	Подключение.Идентификатор = "клиент";
	Подключение.Топик = ТопикПодключения;
	Подключение.ИдСоединения = Строка(Новый УникальныйИдентификатор());
	Если СпанПодключения <> Неопределено Тогда
		Подключение.КонтекстТрассировки = СпанПодключения.КонтекстСпана();
	КонецЕсли;

	Возврат Подключение;

КонецФункции

// BSLLS:MagicNumber-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// Сквозные тесты трассировки долгоживущих соединений - веб-сокетов и серверных
// событий (SSE) - с LGTM-стеком.
//
// Поднимают контейнер grafana/otel-lgtm через testcontainers и нативный сервер winow,
// который отправляет спаны по OTLP HTTP. Спаны читаются обратно через API Tempo:
// так проверяется не только то, что спаны созданы, но и что они доходят до бэкенда
// с линками и родителями, по которым их связывает интерфейс трассировки.
#Использовать autumn
#Использовать opentelemetry
#Использовать "../.."
#Использовать "../поддержка"
#Использовать asserts
#Использовать 1connector
#Использовать testcontainers

Перем Контейнер; // ОбщийКонтейнер - контейнер grafana/otel-lgtm
Перем ПортOtlpHttp; // Число - порт приёма OTLP HTTP
Перем ПортTempo; // Число - порт API Tempo
Перем Поделка; // Поделка - приложение winow с включённой трассировкой
Перем Порт; // Число - порт веб-сервера winow

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Порт = 3338;
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт
	ЗапуститьКонтейнер();
	ЗапуститьСервер();
КонецПроцедуры

&ПослеВсех
Процедура ПослеВсех() Экспорт

	Попытка
		Поделка.НайтиЖелудь("ВебСервер").Стоп();
	Исключение
		// Сервер не поднялся - останавливать нечего, контейнер останавливается в любом случае.
		Сообщить("Не удалось остановить сервер: " + ОписаниеОшибки());
	КонецПопытки;

	Контейнер.Остановить();

КонецПроцедуры

Процедура ЗапуститьКонтейнер()
	Контейнер = Новый ОбщийКонтейнер("grafana/otel-lgtm")
		.ОткрытьПорт(4318)
		.ОткрытьПорт(3200);
	Контейнер.Запустить();

	ПортOtlpHttp = Контейнер.ПолучитьОткрытыйПорт(4318);
	ПортTempo = Контейнер.ПолучитьОткрытыйПорт(3200);

	ДождатьсяГотовности();
КонецПроцедуры

// Порт коллектора известен только после старта контейнера, поэтому поделка
// собирается здесь, а не советом изолированного набора.
Процедура ЗапуститьСервер()

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("winow.ИспользоватьПрикладнойСервер", Ложь);
	ЗначенияДеталек.Вставить("winow.Порт", Порт);
	ЗначенияДеталек.Вставить("otel.enabled", Истина);
	ЗначенияДеталек.Вставить("otel.service.name", "winow-e2e");
	ЗначенияДеталек.Вставить("otel.traces.exporter", "otlp");
	ЗначенияДеталек.Вставить("otel.exporter.otlp.endpoint", "http://localhost:" + ПортOtlpHttp);
	ЗначенияДеталек.Вставить("otel.exporter.otlp.protocol", "http/json");
	ЗначенияДеталек.Вставить("otel.bsp.schedule.delay", 100);
	ЗначенияДеталек.Вставить("otel.metrics.exporter", "none");
	ЗначенияДеталек.Вставить("otel.logs.exporter", "none");

	Совет = Новый СоветДругогоМастера();
	Совет.ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(ЗначенияДеталек, 3, "inline");

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	ВебСервер = Поделка.НайтиЖелудь("ВебСервер");
	ФоновыеЗадания.Выполнить(ВебСервер, "Старт");
	ДождатьсяСервера();

КонецПроцедуры

// ===== ТЕСТЫ =====

// Рукопожатие с traceparent продолжает трассировку клиента и попадает в неё
// обычным серверным спаном.
&Тест
Процедура РукопожатиеПопадаетВТрассировкуКлиента() Экспорт

	// Дано
	ИдТрассировкиКлиента = СлучайныйИдТрассировки();

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/traceid", Traceparent(ИдТрассировкиКлиента));
	КлиентВебСокета.Обменяться(Клиент, "привет");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	СпанРукопожатия = НайтиСпан(ПолучитьТрассировкуИзTempo(ИдТрассировкиКлиента), "GET /socket/traceid");
	Ожидаем.Что(СпанРукопожатия, "спан рукопожатия").Заполнено();
	Ожидаем.Что(СпанРукопожатия.kind, "вид спана рукопожатия").Равно("SPAN_KIND_SERVER");
	Атрибуты = АтрибутыВСоответствие(СпанРукопожатия.attributes);
	Ожидаем.Что(Атрибуты.Получить("http.response.status_code"), "http.response.status_code").Равно("101");
	Ожидаем.Что(Атрибуты.Получить("http.route"), "http.route").Равно("/socket/traceid");

КонецПроцедуры

// Сообщение - отдельная трассировка, которая доходит до бэкенда с линком
// на трассировку клиента и со спаном метода обработчика внутри.
&Тест
Процедура СообщениеПопадаетВСвоюТрассировкуСЛинкомНаРукопожатие() Экспорт

	// Дано
	ИдТрассировкиКлиента = СлучайныйИдТрассировки();

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/traceid", Traceparent(ИдТрассировкиКлиента));
	ИдТрассировкиСообщения = КлиентВебСокета.Обменяться(Клиент, "привет");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	ТрассировкаСообщения = ПолучитьТрассировкуИзTempo(ИдТрассировкиСообщения, 2);
	СпанСообщения = НайтиСпан(ТрассировкаСообщения, "process /socket/traceid");
	Ожидаем.Что(ИдТрассировкиСообщения, "своя трассировка сообщения").ЭтоНе().Равно(ИдТрассировкиКлиента);
	Ожидаем.Что(СпанСообщения, "спан сообщения").Заполнено();
	Ожидаем.Что(СпанСообщения.kind, "вид спана сообщения").Равно("SPAN_KIND_CONSUMER");
	Ожидаем.Что(СпанСообщения.links.Количество(), "количество линков").Равно(1);
	Ожидаем.Что(ИдВHex(СпанСообщения.links[0].traceId), "линк на трассировку клиента")
		.Равно(ИдТрассировкиКлиента);
	Ожидаем.Что(НайтиДочернийСпан(ТрассировкаСообщения, СпанСообщения), "спан метода обработчика").Заполнено();

КонецПроцедуры

// Подключение к серверным событиям с traceparent продолжает трассировку клиента
// серверным спаном, который закрывается, как только поток событий открыт.
&Тест
Процедура ПодключениеКСервернымСобытиямПопадаетВТрассировкуКлиента() Экспорт

	// Дано
	ИдТрассировкиКлиента = СлучайныйИдТрассировки();

	// Когда
	Клиент = Новый ССЕКлиент("localhost", Порт, "/sse/test1", Traceparent(ИдТрассировкиКлиента));
	СпанПодключения = НайтиСпан(ПолучитьТрассировкуИзTempo(ИдТрассировкиКлиента), "GET /sse/test1");
	Клиент.Остановить();

	// Тогда
	Ожидаем.Что(СпанПодключения, "спан подключения").Заполнено();
	Ожидаем.Что(СпанПодключения.kind, "вид спана подключения").Равно("SPAN_KIND_SERVER");
	Атрибуты = АтрибутыВСоответствие(СпанПодключения.attributes);
	Ожидаем.Что(Атрибуты.Получить("http.response.status_code"), "http.response.status_code").Равно("200");
	Ожидаем.Что(Атрибуты.Получить("http.route"), "http.route").Равно("/sse/test1");

КонецПроцедуры

// Событие отправляет обработчик HTTP-запроса: спан отправки доходит до бэкенда
// в трассировке запроса с линком на трассировку подключения получателя.
&Тест
Процедура ОтправкаСобытияПопадаетВТрассировкуЗапросаСЛинкомНаПодключение() Экспорт

	// Дано
	ИдТрассировкиПодключения = СлучайныйИдТрассировки();
	ИдТрассировкиЗапроса = СлучайныйИдТрассировки();
	Клиент = Новый ССЕКлиент("localhost", Порт, "/sse/test1", Traceparent(ИдТрассировкиПодключения));
	НайтиСпан(ПолучитьТрассировкуИзTempo(ИдТрассировкиПодключения), "GET /sse/test1");

	// Когда
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("traceparent", "00-" + ИдТрассировкиЗапроса + "-00f067aa0ba902b7-01");
	КоннекторHTTP.Get("http://localhost:" + Порт + "/sse/sendall/hello", ,
		Новый Структура("Заголовки", Заголовки));
	Клиент.Остановить();

	// Тогда
	ТрассировкаЗапроса = ПолучитьТрассировкуИзTempo(ИдТрассировкиЗапроса, 3);
	СпанОтправки = НайтиСпан(ТрассировкаЗапроса, "send /sse/test1");
	Ожидаем.Что(СпанОтправки, "спан отправки").Заполнено();
	Ожидаем.Что(СпанОтправки.kind, "вид спана отправки").Равно("SPAN_KIND_PRODUCER");
	Ожидаем.Что(ТрассировкиЛинков(СпанОтправки), "линк на трассировку подключения")
		.Содержит(ИдТрассировкиПодключения);

КонецПроцедуры

// ===== ВСПОМОГАТЕЛЬНЫЕ =====

Функция Traceparent(ИдТрассировки)
	Возврат "traceparent: 00-" + ИдТрассировки + "-00f067aa0ba902b7-01";
КонецФункции

Функция СлучайныйИдТрассировки()
	Возврат СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
КонецФункции

// Tempo отдаёт идентификаторы в OTLP JSON: base64 от байтов идентификатора.
Функция ИдВHex(ИдBase64)
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Base64Значение(ИдBase64)));
КонецФункции

Функция НайтиСпан(ДанныеТрассировки, Имя)
	Результат = Неопределено;
	Для Каждого Спан Из СобратьВсеСпаны(ДанныеТрассировки) Цикл
		Если Спан.name = Имя Тогда
			Результат = Спан;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Получателей у события может быть несколько, у каждого - свой линк.
Функция ТрассировкиЛинков(Спан)
	Результат = Новый Массив();
	Для Каждого Линк Из Спан.links Цикл
		Результат.Добавить(ИдВHex(Линк.traceId));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиДочернийСпан(ДанныеТрассировки, Родитель)
	Результат = Неопределено;
	Для Каждого Спан Из СобратьВсеСпаны(ДанныеТрассировки) Цикл
		Если ЗначениеСвойства(Спан, "parentSpanId") = Родитель.spanId Тогда
			Результат = Спан;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// У корневого спана в OTLP JSON поля parentSpanId нет вовсе.
Функция ЗначениеСвойства(Структура, Имя)
	Значение = Неопределено;
	Если Структура.Свойство(Имя) Тогда
		Значение = Структура[Имя];
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ПрочитатьОтветJSON(Ответ)
	Тело = Ответ.Текст();
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(Тело);
	Возврат ПрочитатьJSON(ЧтениеJSON);
КонецФункции

Функция АтрибутыВСоответствие(МассивАтрибутов)
	Результат = Новый Соответствие();
	Если МассивАтрибутов = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Атрибут Из МассивАтрибутов Цикл
		Результат.Вставить(Атрибут.key, ИзвлечьЗначениеАтрибута(Атрибут.value));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ИзвлечьЗначениеАтрибута(ЗначениеАтрибута)
	Если ТипЗнч(ЗначениеАтрибута) = Тип("Соответствие")
		ИЛИ ТипЗнч(ЗначениеАтрибута) = Тип("Структура") Тогда
		Для Каждого Пара Из ЗначениеАтрибута Цикл
			Возврат Пара.Значение;
		КонецЦикла;
		Возврат "";
	КонецЕсли;
	Возврат Строка(ЗначениеАтрибута);
КонецФункции

Функция СобратьВсеСпаны(ДанныеТрассировки)
	ВсеСпаны = Новый Массив();
	Для Каждого Пакет Из ДанныеТрассировки.batches Цикл
		Для Каждого ОбластьСпан Из Пакет.scopeSpans Цикл
			Для Каждого С Из ОбластьСпан.spans Цикл
				ВсеСпаны.Добавить(С);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат ВсеСпаны;
КонецФункции

Функция ПолучитьТрассировкуИзTempo(ИдТрассировки, ОжидаемоеКоличествоСпанов = 1)
	URL = "http://localhost:" + ПортTempo + "/api/traces/" + ИдТрассировки;
	МаксПопыток = 400;
	Для Сч = 1 По МаксПопыток Цикл // BSLLS:UnusedLocalVariable-off
		Результат = ПопробоватьПолучитьТрассировку(URL, ОжидаемоеКоличествоСпанов);
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		Приостановить(50);
	КонецЦикла;
	ВызватьИсключение "Трассировка " + ИдТрассировки + " не найдена в Tempo";
КонецФункции

Функция ПопробоватьПолучитьТрассировку(URL, ОжидаемоеКоличествоСпанов)
	Попытка
		Ответ = КоннекторHTTP.Get(URL);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные = ПрочитатьОтветJSON(Ответ);
	Попытка
		Если Данные.batches.Количество() > 0 Тогда
			ВсеСпаны = СобратьВсеСпаны(Данные);
			Если ВсеСпаны.Количество() >= ОжидаемоеКоличествоСпанов Тогда
				Возврат Данные;
			КонецЕсли;
		КонецЕсли;
	Исключение // BSLLS:MissingCodeTryCatchEx-off
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Процедура ДождатьсяГотовности()

	МаксимальноеКоличествоПопыток = 300;
	Для Сч = 1 По МаксимальноеКоличествоПопыток Цикл // BSLLS:UnusedLocalVariable-off
		Попытка
			URLГотовности = "http://localhost:" + ПортOtlpHttp + "/v1/traces";
			Заголовки = Новый Соответствие();
			Заголовки.Вставить("Content-Type", "application/json");
			ДополнительныеПараметры = Новый Структура("Заголовки", Заголовки);
			Ответ = КоннекторHTTP.Post(URLГотовности, "{}", , ДополнительныеПараметры);
			Если Ответ.КодСостояния = 200 Тогда
				Возврат;
			КонецЕсли;
		Исключение
			Приостановить(200);
		КонецПопытки;
	КонецЦикла;

	ВызватьИсключение "LGTM-стек не готов после " + МаксимальноеКоличествоПопыток + " попыток";

КонецПроцедуры

Процедура ДождатьсяСервера()

	МаксимальноеКоличествоПопыток = 300;
	Для Сч = 1 По МаксимальноеКоличествоПопыток Цикл // BSLLS:UnusedLocalVariable-off
		Попытка
			Ответ = КоннекторHTTP.Get("http://localhost:" + Порт + "/tests/checkup");
			Если Ответ.КодСостояния = 200 Тогда
				Возврат;
			КонецЕсли;
		Исключение
			Приостановить(50);
		КонецПопытки;
	КонецЦикла;

	ВызватьИсключение "Сервер winow не ответил после " + МаксимальноеКоличествоПопыток + " попыток";

КонецПроцедуры

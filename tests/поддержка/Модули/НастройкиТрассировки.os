// Конфигурация поделки для наборов, которым нужна включённая трассировка.
//
// Вынесено в модуль намеренно: при изоляции набора на уровне процесса лямбда
// совета исполняется без захвата объекта набора, если у его конструктора есть
// параметры. Модули, импортированные файлом набора, доступны в любом случае.

// Возвращает совет с включённой трассировкой и отключёнными экспортёрами.
//
// Экспортёры не нужны: утверждения делаются по объектам спанов, а сетевые походы
// в несуществующий коллектор только замедлят прогон.
//
// Возвращаемое значение:
//  СоветДругогоМастера - Конфигурация изолированной поделки.
//
Функция СоветСТрассировкой() Экспорт

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel.enabled", Истина);
	ЗначенияДеталек.Вставить("otel.traces.exporter", "none");
	ЗначенияДеталек.Вставить("otel.metrics.exporter", "none");
	ЗначенияДеталек.Вставить("otel.logs.exporter", "none");

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);

	Возврат Совет;

КонецФункции

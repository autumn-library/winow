// Конфигурация поделки для наборов, которым нужна включённая трассировка.
//
// Вынесено в модуль намеренно: при изоляции набора на уровне процесса лямбда
// совета исполняется без захвата объекта набора, если у его конструктора есть
// параметры. Модули, импортированные файлом набора, доступны в любом случае.

// Возвращает совет с включённой трассировкой и отключёнными экспортёрами.
//
// Экспортёры не нужны: утверждения делаются по объектам спанов, а сетевые походы
// в несуществующий коллектор только замедлят прогон.
//
// Возвращаемое значение:
//  СоветДругогоМастера - Конфигурация изолированной поделки.
//
Функция СоветСТрассировкой() Экспорт

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталекТрассировки());

	Возврат Совет;

КонецФункции

// Возвращает совет с включённой трассировкой на нативном веб-сервере.
//
// Нативный сервер обрабатывает запрос в потоке пула Kestrel, и конвейер обработки
// заворачивается в фоновое задание ради контекста трассировки, поэтому проверять
// его нужно на отдельной поделке с явно выключенным прикладным сервером.
//
// Деталька otel.enabled задаётся строкой - в том виде, в каком её отдаёт провайдер
// переменных среды.
//
// Возвращаемое значение:
//  СоветДругогоМастера - Конфигурация изолированной поделки.
//
Функция СоветСТрассировкойНаНативномСервере() Экспорт

	ЗначенияДеталек = ЗначенияДеталекТрассировки();
	ЗначенияДеталек.Вставить("winow.ИспользоватьПрикладнойСервер", Ложь);
	ЗначенияДеталек.Вставить("winow.Порт", ПортНативногоСервера());

	// Строкой, а не булевом: ровно так деталька приезжает из переменной среды
	// OTEL_ENABLED=true - провайдер ENV в configor не приводит значения к типу.
	ЗначенияДеталек.Вставить("otel.enabled", "true");

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);

	Возврат Совет;

КонецФункции

// Возвращает порт, на котором поднимается нативный сервер с трассировкой.
// Отдельный от остальных наборов, чтобы серверы не мешали друг другу.
//
// Возвращаемое значение:
//  Число - Номер порта.
//
Функция ПортНативногоСервера() Экспорт
	Возврат 3336;
КонецФункции

Функция ЗначенияДеталекТрассировки()

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel.enabled", Истина);
	ЗначенияДеталек.Вставить("otel.traces.exporter", "none");
	ЗначенияДеталек.Вставить("otel.metrics.exporter", "none");
	ЗначенияДеталек.Вставить("otel.logs.exporter", "none");

	Возврат ЗначенияДеталек;

КонецФункции

// Управление пулом соединений серверных событий из тестов.
//
// Вынесено в модуль, потому что пулом пользуются тесты трассировки обоих серверов,
// а набор с изоляцией на уровне процесса видит только модули, импортированные его файлом.

// Закрывает со стороны сервера все соединения топика, как при отключении клиента.
//
// Параметры:
//  Поделка - Поделка - Поделка с запущенным веб-сервером.
//  Топик   - Строка - Топик соединений.
//
Процедура ЗакрытьСоединенияТопика(Поделка, Топик) Экспорт

	Соединения = Поделка.НайтиЖелудь("СоединенияСерверныхСобытий");
	Для Каждого ДанныеСоединения Из Соединения.ПолучитьСоединенияПоТопику(Топик) Цикл
		Соединения.УдалитьСтрокуПула(ДанныеСоединения);
	КонецЦикла;

КонецПроцедуры

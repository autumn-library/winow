// Тестовый клиент веб-сокета поверх TCPСоединение: рукопожатие, кадры клиента
// и чтение кадров сервера по RFC 6455.
//
// Вынесен из набора, потому что веб-сокетами пользуются и функциональные тесты,
// и тесты трассировки, а набор с изоляцией на уровне процесса видит только модули,
// импортированные его файлом.

// Открывает веб-сокет: отправляет рукопожатие и ждёт ответа 101.
//
// Параметры:
//  НомерПорта - Число - Порт сервера.
//  Путь       - Строка - Путь веб-сокета.
//  ДополнительныйЗаголовок - Строка - Строка заголовка, которая добавляется к запросу; пустая - без неё.
//
// Возвращаемое значение:
//  TCPСоединение - Открытое соединение веб-сокета.
//
Функция Подключиться(НомерПорта, Путь, ДополнительныйЗаголовок = "") Экспорт

	Клиент = Новый TCPСоединение("localhost", НомерПорта);
	Клиент.ТаймаутЧтения = 5000;

	Попытка
		Клиент.ОтправитьСтроку(ЗапросРукопожатия(Путь, НомерПорта, ДополнительныйЗаголовок));
		ОтветРукопожатия = ПрочитатьЗаголовкиОтвета(Клиент);
	Исключение
		Клиент.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Если СтрНайти(ОтветРукопожатия, "HTTP/1.1 101") = 0 Тогда
		Клиент.Закрыть();
		ВызватьИсключение "Сервер не открыл веб-сокет: " + ОтветРукопожатия;
	КонецЕсли;

	Возврат Клиент;

КонецФункции

// Читает ответ на рукопожатие ровно до пустой строки, которой заканчиваются заголовки.
//
// Читать нужно побайтно: сразу за заголовками сервер может отправить первый кадр,
// и чтение порцией забрало бы его вместе с ними.
//
// Параметры:
//  Клиент - TCPСоединение - Соединение, в которое отправлено рукопожатие.
//
// Возвращаемое значение:
//  Строка - Строка статуса и заголовки ответа.
//
Функция ПрочитатьЗаголовкиОтвета(Клиент)

	КонецЗаголовков = Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС;
	Части = Новый Массив();
	Хвост = "";

	Пока Хвост <> КонецЗаголовков Цикл
		Байт = ПрочитатьРовно(Клиент, 1);
		Части.Добавить(Байт);
		Хвост = Прав(Хвост + ПолучитьСтрокуИзДвоичныхДанных(Байт), СтрДлина(КонецЗаголовков));
	КонецЦикла;

	Возврат ПолучитьСтрокуИзДвоичныхДанных(СоединитьДвоичныеДанные(Части));

КонецФункции

// Отправляет текстовое сообщение и ждёт ответный кадр сервера.
//
// Параметры:
//  Клиент    - TCPСоединение - Открытое соединение веб-сокета.
//  Сообщение - Строка - Текст сообщения.
//
// Возвращаемое значение:
//  Строка - Текст ответа сервера.
//
Функция Обменяться(Клиент, Сообщение) Экспорт
	Клиент.ОтправитьДвоичныеДанные(ТекстовыйКадр(Сообщение));
	Возврат ПрочитатьКадрСервера(Клиент).Текст;
КонецФункции

// Закрывает веб-сокет со стороны клиента: кадром закрытия, а затем и сам сокет.
//
// Параметры:
//  Клиент - TCPСоединение - Открытое соединение веб-сокета.
//
Процедура Отключиться(Клиент) Экспорт
	// Сервер мог уже закрыть соединение - тогда кадр закрытия отправлять некуда.
	Если Клиент.Активно Тогда
		Клиент.ОтправитьДвоичныеДанные(Кадр(КодЗакрытияКадра(), ""));
	КонецЕсли;
	Клиент.Закрыть();
КонецПроцедуры

// Запрос на переключение протокола для указанного пути.
//
// Параметры:
//  Путь       - Строка - Путь веб-сокета.
//  НомерПорта - Число - Порт сервера.
//  ДополнительныйЗаголовок - Строка - Строка заголовка, которая добавляется к запросу; пустая - без неё.
//
// Возвращаемое значение:
//  Строка - Запрос рукопожатия, готовый к отправке.
//
Функция ЗапросРукопожатия(Путь, НомерПорта, ДополнительныйЗаголовок = "") Экспорт

	СтрокаЗапросаИЗаголовки = СтрШаблон("GET %1 HTTP/1.1
					|Host: localhost:%2
					|Upgrade: websocket
					|Connection: keep-alive, Upgrade
					|Sec-WebSocket-Version: 13
					|Sec-WebSocket-Key: 8Nm7+HLTwID0n9ABpH5QGA==", Путь, НомерПорта);

	Если ЗначениеЗаполнено(ДополнительныйЗаголовок) Тогда
		СтрокаЗапросаИЗаголовки = СтрокаЗапросаИЗаголовки + Символы.ПС + ДополнительныйЗаголовок;
	КонецЕсли;

	Возврат ЗапросHTTP(СтрокаЗапросаИЗаголовки);

КонецФункции

// Строки заголовков разделяются CRLF, а заканчиваются пустой строкой (RFC 9112, 2.1):
// без неё Kestrel ждёт продолжения заголовков.
//
// Параметры:
//  СтрокаЗапросаИЗаголовки - Строка - Строка запроса и заголовки, разделённые переводом строки.
//
// Возвращаемое значение:
//  Строка - Запрос, готовый к отправке.
//
Функция ЗапросHTTP(СтрокаЗапросаИЗаголовки) Экспорт

	КонецСтроки = Символы.ВК + Символы.ПС;

	Возврат СтрЗаменить(СтрокаЗапросаИЗаголовки, Символы.ПС, КонецСтроки) + КонецСтроки + КонецСтроки;

КонецФункции

// Ждёт от сервера закрытия соединения: кадра закрытия, конца потока или сброса.
//
// Параметры:
//  Клиент - TCPСоединение - Соединение с сервером.
//
// Возвращаемое значение:
//  Булево - Истина, если сервер закрыл соединение; Ложь, если оно осталось открытым.
//
Функция ЗакрытоСервером(Клиент) Экспорт

	ПервыйБайтКадраЗакрытия = 136;

	Попытка
		Данные = Клиент.ПрочитатьДвоичныеДанные(1);
	Исключение
		// чтение падает и по таймауту, и по сбросу соединения; сброшенное соединение неактивно
		Возврат НЕ Клиент.Активно;
	КонецПопытки;

	Если Данные.Размер() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные)[0] = ПервыйБайтКадраЗакрытия;

КонецФункции

// Текстовый кадр с маской - такие кадры шлёт клиент (RFC 6455, 5.3).
//
// Параметры:
//  Сообщение - Строка - Текст сообщения.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Кадр, готовый к отправке.
//
Функция ТекстовыйКадр(Сообщение) Экспорт
	Возврат Кадр(КодТекстовогоКадра(), Сообщение);
КонецФункции

// Возвращаемое значение:
//  Число - Код операции текстового кадра.
//
Функция КодТекстовогоКадра() Экспорт
	Возврат 1;
КонецФункции

// Возвращаемое значение:
//  Число - Код операции кадра закрытия.
//
Функция КодЗакрытияКадра() Экспорт
	Возврат 8;
КонецФункции

// Последний кадр с маской и длиной до 65535 байт.
//
// Параметры:
//  КодОперации - Число - Код операции кадра, см. КодТекстовогоКадра, КодЗакрытияКадра.
//  Сообщение   - Строка - Полезные данные кадра.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Кадр, готовый к отправке.
//
Функция Кадр(КодОперации, Сообщение) Экспорт

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Сообщение);
	Данные = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныеДанные);
	ПризнакПоследнегоКадра = 128;
	ПризнакМаски = 128;
	НаибольшаяКороткаяДлина = 125;
	ПризнакДвухБайтовойДлины = 126;
	ДлинаКороткогоЗаголовка = 2;
	ДлинаРасширеннойДлины = 2;
	ДлинаМаски = 4;

	РасширеннаяДлина = Данные.Размер > НаибольшаяКороткаяДлина;
	Если РасширеннаяДлина Тогда
		НачалоМаски = ДлинаКороткогоЗаголовка + ДлинаРасширеннойДлины;
	Иначе
		НачалоМаски = ДлинаКороткогоЗаголовка;
	КонецЕсли;
	НачалоДанных = НачалоМаски + ДлинаМаски;

	Буфер = Новый БуферДвоичныхДанных(НачалоДанных + Данные.Размер);
	Буфер[0] = ПризнакПоследнегоКадра + КодОперации;

	Если РасширеннаяДлина Тогда
		Буфер[1] = ПризнакМаски + ПризнакДвухБайтовойДлины;
		Буфер.ЗаписатьЦелое16(ДлинаКороткогоЗаголовка, Данные.Размер, ПорядокБайтов.BigEndian);
	Иначе
		Буфер[1] = ПризнакМаски + Данные.Размер;
	КонецЕсли;

	Для Индекс = 0 По ДлинаМаски - 1 Цикл
		Буфер[НачалоМаски + Индекс] = Индекс + 1;
	КонецЦикла;

	Для Индекс = 0 По Данные.Размер - 1 Цикл
		Маска = Буфер[НачалоМаски + Индекс % ДлинаМаски];
		Буфер[НачалоДанных + Индекс] = ПобитовоеИсключительноеИли(Данные[Индекс], Маска);
	КонецЦикла;

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);

КонецФункции

// Читает один немаскированный кадр сервера длиной до 65535 байт.
//
// Параметры:
//  Клиент - TCPСоединение - Соединение с сервером.
//
// Возвращаемое значение:
//  Структура:
//   * ПервыйБайт - Число - Признак последнего кадра и код операции.
//   * Текст      - Строка - Полезные данные кадра.
//   * Данные     - ДвоичныеДанные - Полезные данные кадра как есть.
//
Функция ПрочитатьКадрСервера(Клиент) Экспорт

	ДлинаКороткогоЗаголовка = 2;
	ДлинаРасширеннойДлины = 2;
	МаскаДлины = 127;
	ПризнакДвухБайтовойДлины = 126;

	ДанныеЗаголовка = ПрочитатьРовно(Клиент, ДлинаКороткогоЗаголовка);
	Заголовок = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДанныеЗаголовка);
	Длина = ПобитовоеИ(Заголовок[1], МаскаДлины);

	Если Длина = ПризнакДвухБайтовойДлины Тогда
		ДанныеДлины = ПрочитатьРовно(Клиент, ДлинаРасширеннойДлины);
		РасширеннаяДлина = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДанныеДлины);
		Длина = РасширеннаяДлина.ПрочитатьЦелое16(0, ПорядокБайтов.BigEndian);
	КонецЕсли;

	Данные = ПрочитатьРовно(Клиент, Длина);
	Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные);

	Возврат Новый Структура("ПервыйБайт, Текст, Данные", Заголовок[0], Текст, Данные);

КонецФункции

// Сокет может отдать данные кадра в несколько приёмов.
//
// Параметры:
//  Клиент     - TCPСоединение - Соединение с сервером.
//  Количество - Число - Сколько байт прочитать.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Ровно Количество байт.
//
Функция ПрочитатьРовно(Клиент, Количество) Экспорт

	Части = Новый Массив();
	Прочитано = 0;

	Пока Прочитано < Количество Цикл
		Часть = Клиент.ПрочитатьДвоичныеДанные(Количество - Прочитано);
		Если Часть.Размер() = 0 Тогда
			ВызватьИсключение СтрШаблон("Соединение закрыто: прочитано %1 из %2 байт", Прочитано, Количество);
		КонецЕсли;
		Части.Добавить(Часть);
		Прочитано = Прочитано + Часть.Размер();
	КонецЦикла;

	Возврат СоединитьДвоичныеДанные(Части);

КонецФункции

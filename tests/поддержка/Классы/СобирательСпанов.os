// Экспортёр спанов, складывающий их в память.
//
// Нужен тестам, чтобы утверждать о серверном спане winow напрямую: снаружи
// его не видно, а контроллер видит только собственный внутренний спан.
// Подключается к провайдеру трассировки через ОтелПростойПроцессорСпанов.

Перем Спаны;

Процедура ПриСозданииОбъекта()
	Спаны = Новый Массив();
КонецПроцедуры

// Вызывается процессором спанов при завершении каждого сэмплированного спана.
//
// Параметры:
//  МассивСпанов - Массив - Завершённые спаны.
//  Таймаут      - Число  - Не используется.
//
// Возвращаемое значение:
//  Булево - Всегда Истина.
//
Функция Экспортировать(МассивСпанов, Таймаут = Неопределено) Экспорт // BSLLS:UnusedParameters-off

	Для Каждого Спан Из МассивСпанов Цикл
		Спаны.Добавить(Спан);
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
	Возврат Истина;
КонецФункции

Функция Закрыть() Экспорт
	Возврат Истина;
КонецФункции

// Возвращает последний собранный спан с указанным видом.
//
// Параметры:
//  ВидСпана - Число - Вид спана, см. ОтелВидСпана.
//
// Возвращаемое значение:
//  ОтелСпан, Неопределено - Найденный спан или Неопределено.
//
Функция ПоследнийСпанВида(ВидСпана) Экспорт

	Результат = Неопределено;

	Для Каждого Спан Из Спаны Цикл
		Если Спан.ВидСпана() = ВидСпана Тогда
			Результат = Спан;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ждёт спан с указанным именем: спаны событий веб-сокета завершаются в потоке
// сервера, и к моменту ответа клиенту спан может быть ещё открыт.
//
// Параметры:
//  Имя - Строка - Имя спана.
//
// Возвращаемое значение:
//  ОтелСпан, Неопределено - Последний спан с этим именем или Неопределено, если не дождались.
//
Функция ДождатьсяСпана(Имя) Экспорт

	ПределОжидания = 5000;
	ШагОжидания = 50;
	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПределОжидания;

	Найденный = ПоследнийСпанСИменем(Имя);
	Пока Найденный = Неопределено И ТекущаяУниверсальнаяДатаВМиллисекундах() < КрайнийСрок Цикл
		Приостановить(ШагОжидания);
		Найденный = ПоследнийСпанСИменем(Имя);
	КонецЦикла;

	Возврат Найденный;

КонецФункции

// Ждёт спан события веб-сокета, который ссылается линком на указанное рукопожатие.
//
// Спаны событий разных соединений называются одинаково, а спан отключения
// соединения из предыдущего теста может завершиться уже после очистки собирателя.
// Линк на рукопожатие отличает спаны своего соединения.
//
// Параметры:
//  Имя             - Строка - Имя спана события.
//  СпанРукопожатия - ОтелСпан - Серверный спан рукопожатия соединения.
//
// Возвращаемое значение:
//  ОтелСпан, Неопределено - Спан события или Неопределено, если не дождались.
//
Функция ДождатьсяСпанаСобытия(Имя, СпанРукопожатия) Экспорт

	ПределОжидания = 5000;
	ШагОжидания = 50;
	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПределОжидания;
	ИдРукопожатия = СпанРукопожатия.КонтекстСпана().ИдСпана();

	Найденный = СпанСобытия(Имя, ИдРукопожатия);
	Пока Найденный = Неопределено И ТекущаяУниверсальнаяДатаВМиллисекундах() < КрайнийСрок Цикл
		Приостановить(ШагОжидания);
		Найденный = СпанСобытия(Имя, ИдРукопожатия);
	КонецЦикла;

	Возврат Найденный;

КонецФункции

Функция СпанСобытия(Имя, ИдРукопожатия)

	Результат = Неопределено;

	Для Каждого Спан Из Новый ФиксированныйМассив(Спаны) Цикл
		Если Спан.Имя() = Имя И СсылаетсяНа(Спан, ИдРукопожатия) Тогда
			Результат = Спан;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СсылаетсяНа(Спан, ИдСпана)

	Результат = Ложь;

	Для Каждого Линк Из Спан.Линки() Цикл
		Если Линк.КонтекстСпана().ИдСпана() = ИдСпана Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Параметры:
//  Родитель - ОтелСпан - Родительский спан.
//
// Возвращаемое значение:
//  ОтелСпан, Неопределено - Собранный дочерний спан или Неопределено, если его нет.
//
Функция ДочернийСпан(Родитель) Экспорт

	ИдРодителя = Родитель.КонтекстСпана().ИдСпана();
	Результат = Неопределено;

	Для Каждого Спан Из Новый ФиксированныйМассив(Спаны) Цикл
		Если Спан.ИдРодительскогоСпана() = ИдРодителя Тогда
			Результат = Спан;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПоследнийСпанСИменем(Имя)

	Результат = Неопределено;

	// Спаны добавляются из потоков сервера, поэтому перебирается снимок
	Для Каждого Спан Из Новый ФиксированныйМассив(Спаны) Цикл
		Если Спан.Имя() = Имя Тогда
			Результат = Спан;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура Очистить() Экспорт
	Спаны.Очистить();
КонецПроцедуры

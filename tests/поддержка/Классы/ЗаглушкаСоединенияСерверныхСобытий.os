// Соединение серверных событий для тестов пула и рассылки: данные принимает, но никуда не шлёт.
//
// Сломанная заглушка падает на отправке события, но принимает ping контроля соединений:
// иначе фоновая проверка контроля убрала бы её из пула раньше, чем до неё дойдёт рассылка.

Перем Сломано; // Булево - падать ли на отправке события
Перем ОшибокОтправки; // Число - сколько раз отправка события упала

// Параметры:
//  ЭтоСломанное - Булево - Истина, если отправка события должна падать.
//
Процедура ПриСозданииОбъекта(ЭтоСломанное = Ложь)
	Сломано = ЭтоСломанное;
	ОшибокОтправки = 0;
КонецПроцедуры

// Параметры:
//  Данные - ДвоичныеДанные - Сформированное событие или ping контроля соединений.
//
Процедура ОтправитьДвоичныеДанные(Данные) Экспорт

	Если НЕ Сломано Или СтрНайти(ПолучитьСтрокуИзДвоичныхДанных(Данные), "event: ping") > 0 Тогда
		Возврат;
	КонецЕсли;

	ОшибокОтправки = ОшибокОтправки + 1;
	ВызватьИсключение "Соединение сломано";

КонецПроцедуры

Процедура Закрыть() Экспорт
	// закрывать нечего
КонецПроцедуры

// Возвращаемое значение:
//  Число - Сколько раз отправка события упала.
//
Функция ОшибокОтправки() Экспорт
	Возврат ОшибокОтправки;
КонецФункции

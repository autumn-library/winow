#Использовать autumn
#Использовать opentelemetry
#Использовать decorator
#Использовать ".."
#Использовать asserts

// Интеграция winow с OpenTelemetry.
//
// Проверяется поведение НапильникHttpСервер: инструментирование должно быть
// выключено по умолчанию и не поднимать SDK, а при включённом otel.enabled -
// оборачивать ОбработчикЗапросов и вести серверный спан вокруг запроса,
// продолжая входящую трассировку из заголовка traceparent.
//
// Утверждения о трассировке делаются по ответам КонтролТрассировки,
// который отдаёт наружу состояние активного контекста.

Перем ПоделкаСТрассировкой;
Перем Порт;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Порт = 3335;
КонецПроцедуры

&ПослеВсех
Процедура ОстановитьСервер() Экспорт

	Если ПоделкаСТрассировкой = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ПоделкаСТрассировкой.НайтиЖелудь("ВебСервер").Стоп();
	Исключение
		// Сервер уже остановлен - ронять из-за этого прогон незачем.
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ПоУмолчаниюОбработчикЗапросовНеОборачивается() Экспорт

	// Дано
	Поделка = Новый Поделка();

	// Когда
	Поделка.ЗапуститьПриложение();
	ОбработчикЗапросов = Поделка.НайтиЖелудь("ОбработчикЗапросов");

	// Тогда
	// Утверждение положительное намеренно: сравнение исходного типа с фактическим
	// прошло бы и в случае, когда желудь вообще не создался.
	Ожидаем.Что(Строка(ТипЗнч(ОбработчикЗапросов)), "тип обработчика")
		.Равно("ОбработчикЗапросов");

КонецПроцедуры

// Инструментирование выключено, поэтому SDK не должен подниматься вовсе:
// иначе у любого приложения на winow стартует фоновый экспорт в OTLP.
// Тест выполняется в отдельном процессе, потому что глобальный SDK OTel
// регистрируется один раз на процесс и другие тесты его уже поднимают.
&Тест
&Изолированный(Уровень = "Процесс")
Процедура ПоУмолчаниюSdkНеПоднимается() Экспорт

	// Дано
	Поделка = Новый Поделка();

	// Когда
	Поделка.ЗапуститьПриложение();
	Поделка.НайтиЖелудь("ОбработчикЗапросов");

	// Тогда
	Ожидаем.Что(ОтелГлобальный.Получить(), "глобальный SDK OTel").ЭтоНе().Заполнено();

КонецПроцедуры

&Тест
Процедура ПриВключённойТрассировкеОбработчикЗапросовОборачивается() Экспорт

	// Дано
	ВключитьСервер();

	// Когда
	ОбработчикЗапросов = ПоделкаСТрассировкой.НайтиЖелудь("ОбработчикЗапросов");

	// Тогда
	Ожидаем.Что(Строка(ОбработкаДекоратора.ИсходныйТип(ОбработчикЗапросов)),
			"исходный тип обработчика")
		.Равно("ОбработчикЗапросов");
	Ожидаем.Что(Строка(ТипЗнч(ОбработчикЗапросов)), "фактический тип обработчика")
		.ЭтоНе().Равно("ОбработчикЗапросов");

КонецПроцедуры

&Тест
Процедура ПриВключённойТрассировкеЗапросыОбрабатываютсяКакОбычно() Экспорт

	// Дано
	ВключитьСервер();

	// Когда
	Ответ = ГетЗапрос("/tests/checkup");

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния, "код состояния").Равно(200);

КонецПроцедуры

// Спан метода контроллера создаёт autumn-opentelemetry, а его родителем
// становится серверный спан от winow. Без серверного спана спан метода
// оказался бы корневым и родителя бы не имел.
&Тест
Процедура СерверныйСпанСтановитсяРодителемСпанаМетода() Экспорт

	// Дано
	ВключитьСервер();

	// Когда
	Ответ = ГетЗапрос("/tests/otel/parent");

	// Тогда
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), "родительский спан")
		.ЭтоНе().Равно("нет");

КонецПроцедуры

&Тест
Процедура ВходящийTraceparentПродолжаетТрассировку() Экспорт

	// Дано
	ВключитьСервер();
	ИдТрассировки = "4bf92f3577b34da6a3ce929d0e0e4736";
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("traceparent", "00-" + ИдТрассировки + "-00f067aa0ba902b7-01");

	// Когда
	Ответ = ГетЗапрос("/tests/otel/traceid", Заголовки);

	// Тогда
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), "идентификатор трассировки")
		.Равно(ИдТрассировки);

КонецПроцедуры

Процедура ВключитьСервер()

	Если ПоделкаСТрассировкой <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("winow.ИспользоватьПрикладнойСервер", Истина);
	ЗначенияДеталек.Вставить("winow.Порт", Порт);
	ЗначенияДеталек.Вставить("otel.enabled", Истина);
	// Экспортёры отключены: тестам нужен работающий контекст трассировки,
	// а не сетевые походы в несуществующий коллектор.
	ЗначенияДеталек.Вставить("otel.traces.exporter", "none");
	ЗначенияДеталек.Вставить("otel.metrics.exporter", "none");
	ЗначенияДеталек.Вставить("otel.logs.exporter", "none");

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);

	ПоделкаСТрассировкой = Новый Поделка(Совет);
	ПоделкаСТрассировкой.ЗапуститьПриложение();

	ВебСервер = ПоделкаСТрассировкой.НайтиЖелудь("ВебСервер");
	ФоновыеЗадания.Выполнить(ВебСервер, "Старт");
	// Подождем что бы сервер успел запустится и проинициализироваться.
	Приостановить(1000);

	Настройки = ПоделкаСТрассировкой.НайтиЖелудь("Настройки");
	Настройки.ЗадержкаПередЧтениемСокета = 400;
	Настройки.ЗадержкаПередЗакрытиемСокета = 300;

КонецПроцедуры

Функция ГетЗапрос(Адрес, Заголовки = Неопределено)

	Соединение = Новый HTTPСоединение("http://localhost", Порт, , , , 5);
	Запрос = Новый HTTPЗапрос(Адрес);

	Если Заголовки <> Неопределено Тогда
		Запрос.Заголовки = Заголовки;
	КонецЕсли;

	Возврат Соединение.Получить(Запрос);

КонецФункции

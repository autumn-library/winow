#Использовать autumn
#Использовать opentelemetry
#Использовать ".."
#Использовать asserts

// Поведение интеграции с OpenTelemetry по умолчанию, когда otel.enabled не задан.
//
// Набор работает в обычной поделке oneunit, без своей конфигурации: именно так
// выглядит приложение пользователя, который трассировку не включал.

Перем ОбработчикЗапросов;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта(&Пластилин("ОбработчикЗапросов") _ОбработчикЗапросов) Экспорт
	ОбработчикЗапросов = _ОбработчикЗапросов;
КонецПроцедуры

// Утверждение положительное намеренно: сравнение исходного типа с фактическим
// прошло бы и в случае, когда желудь вообще не создался.
&Тест
Процедура ОбработчикЗапросовНеОборачиваетсяДекоратором() Экспорт

	Ожидаем.Что(Строка(ТипЗнч(ОбработчикЗапросов)), "тип обработчика")
		.Равно("ОбработчикЗапросов");

КонецПроцедуры

// Инструментирование выключено, поэтому SDK не должен подниматься вовсе:
// иначе у любого приложения на winow стартует фоновый экспорт в OTLP.
// Отдельный процесс нужен потому, что глобальный SDK OTel регистрируется
// один раз на процесс и соседние наборы его поднимают.
&Тест
&Изолированный(Уровень = "Процесс")
Процедура SdkНеПоднимается() Экспорт

	Ожидаем.Что(ОтелГлобальный.Получить(), "глобальный SDK OTel").ЭтоНе().Заполнено();

КонецПроцедуры

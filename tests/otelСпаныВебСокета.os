#Использовать autumn
#Использовать opentelemetry
#Использовать ".."
#Использовать "поддержка"
#Использовать asserts

// Содержимое спанов, которые winow заводит на события веб-сокета: подключение,
// входящее сообщение и отключение.
//
// По рекомендациям OpenTelemetry долгоживущее соединение не держит один спан
// на всё время жизни: рукопожатие - обычный короткий HTTP-спан, а каждое событие
// начинает свою трассировку и ссылается линком на спан рукопожатия.
//
// Веб-сервер не поднимается: содержимое спанов от реализации сервера не зависит.

Перем Трассировка; // ТрассировкаВебСокетов - проверяемый желудь
Перем Трассировщик; // ОтелТрассировщик - создаёт спан рукопожатия и внешний спан

// Отдельный процесс по той же причине, что и у otelСерверныйСпан: SDK OTel
// регистрируется глобально один раз на процесс.
//
// Параметры:
//  _Трассировка - ТрассировкаВебСокетов - Проверяемый желудь.
//  ОтелSdk      - ОтелSdk - SDK OpenTelemetry поделки набора.
//
&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс", Совет = "() -> НастройкиТрассировки.СоветСТрассировкой()")
Процедура ПриСозданииОбъекта(&Пластилин("ТрассировкаВебСокетов") _Трассировка,
		&Пластилин("ОтелSdk") ОтелSdk) Экспорт
	Трассировка = _Трассировка;
	Трассировщик = ОтелSdk.ПолучитьТрассировщик("тест");
КонецПроцедуры

// Имя спана - операция и шаблон маршрута, а не конкретный путь:
// у имени должна быть низкая кардинальность.
//
// Параметры:
//  ИмяМетода - Строка - Метод трассировки, открывающий спан события.
//  Операция  - Строка - Ожидаемая операция в имени спана.
//
&ПараметризованныйТест(Имя = "{Параметры}")
&ИсточникЗначение("НачатьПодключение", "connect")
&ИсточникЗначение("НачатьСообщение", "process")
&ИсточникЗначение("НачатьОтключение", "disconnect")
Процедура ИмяСпанаСобытияЭтоОперацияИШаблонМаршрута(ИмяМетода, Операция) Экспорт

	// Дано
	Подключение = НовоеПодключение("/chat/42", "/chat/{Комната}");

	// Когда
	Состояние = НачатьСобытие(ИмяМетода, Подключение);
	Трассировка.Завершить(Состояние);

	// Тогда
	Ожидаем.Что(Состояние.Спан.Имя(), "имя спана").Равно(Операция + " /chat/{Комната}");

КонецПроцедуры

// Параметры:
//  ИмяМетода - Строка - Метод трассировки, открывающий спан события.
//  Операция  - Строка - Ожидаемое имя спана.
//
&ПараметризованныйТест(Имя = "{Параметры}")
&ИсточникЗначение("НачатьПодключение", "connect")
&ИсточникЗначение("НачатьСообщение", "process")
&ИсточникЗначение("НачатьОтключение", "disconnect")
Процедура БезШаблонаМаршрутаИмяСпанаЭтоТолькоОперация(ИмяМетода, Операция) Экспорт

	// Дано
	Подключение = НовоеПодключение("/socket/ws", "");

	// Когда
	Состояние = НачатьСобытие(ИмяМетода, Подключение);
	Трассировка.Завершить(Состояние);

	// Тогда
	Ожидаем.Что(Состояние.Спан.Имя(), "имя спана").Равно(Операция);
	Ожидаем.Что(Состояние.Спан.Атрибуты().Получить("http.route"), "http.route").ЭтоНеопределено();

КонецПроцедуры

// Сообщение клиента обрабатывается как входящее сообщение очереди.
&Тест
Процедура СпанСообщенияВидаПотребитель() Экспорт

	// Дано
	Подключение = НовоеПодключение("/socket/ws", "/socket/ws");

	// Когда
	Состояние = Трассировка.НачатьСообщение(Подключение);
	Трассировка.Завершить(Состояние);

	// Тогда
	Ожидаем.Что(Состояние.Спан.ВидСпана(), "вид спана").Равно(ОтелВидСпана.Потребитель());

КонецПроцедуры

// Подключение и отключение - внутренние события сервера, сообщений в них нет.
//
// Параметры:
//  ИмяМетода - Строка - Метод трассировки, открывающий спан события.
//
&ПараметризованныйТест(Имя = "{Параметры}")
&ИсточникЗначение("НачатьПодключение")
&ИсточникЗначение("НачатьОтключение")
Процедура СпанПодключенияИОтключенияВидаВнутренний(ИмяМетода) Экспорт

	// Дано
	Подключение = НовоеПодключение("/socket/ws", "/socket/ws");

	// Когда
	Состояние = НачатьСобытие(ИмяМетода, Подключение);
	Трассировка.Завершить(Состояние);

	// Тогда
	Ожидаем.Что(Состояние.Спан.ВидСпана(), "вид спана").Равно(ОтелВидСпана.Внутренний());

КонецПроцедуры

&Тест
Процедура СпанСобытияСодержитАтрибутыСоединения() Экспорт

	// Дано
	Подключение = НовоеПодключение("/chat/42", "/chat/{Комната}");

	// Когда
	Состояние = Трассировка.НачатьСообщение(Подключение);
	Трассировка.Завершить(Состояние);

	// Тогда
	Атрибуты = Состояние.Спан.Атрибуты();
	Ожидаем.Что(Атрибуты.Получить("network.protocol.name"), "network.protocol.name").Равно("websocket");
	Ожидаем.Что(Атрибуты.Получить("url.path"), "url.path").Равно("/chat/42");
	Ожидаем.Что(Атрибуты.Получить("http.route"), "http.route").Равно("/chat/{Комната}");

КонецПроцедуры

// Каждое событие - своя трассировка, иначе все сообщения долгого соединения
// попали бы в одну бесконечную трассировку рукопожатия. Связь с рукопожатием
// сохраняется линком.
&Тест
Процедура СпанСобытияНачинаетНовуюТрассировкуСЛинкомНаРукопожатие() Экспорт

	// Дано
	СпанРукопожатия = Трассировщик.НачатьСпан("GET /socket/ws", ОтелВидСпана.Сервер());
	Подключение = НовоеПодключение("/socket/ws", "/socket/ws");
	Подключение.КонтекстТрассировки = СпанРукопожатия.КонтекстСпана();
	СпанРукопожатия.Завершить();

	// Когда
	Состояние = Трассировка.НачатьСообщение(Подключение);
	Трассировка.Завершить(Состояние);

	// Тогда
	Спан = Состояние.Спан;
	Линки = Спан.Линки();
	Ожидаем.Что(Спан.КонтекстСпана().ИдТрассировки(), "новая трассировка")
		.ЭтоНе().Равно(СпанРукопожатия.КонтекстСпана().ИдТрассировки());
	Ожидаем.Что(Линки.Количество(), "количество линков").Равно(1);
	Ожидаем.Что(Линки[0].КонтекстСпана().ИдСпана(), "линк на спан рукопожатия")
		.Равно(СпанРукопожатия.КонтекстСпана().ИдСпана());

КонецПроцедуры

// Обработчик события может вызываться внутри чужого активного спана,
// но событие клиента ему не дочернее.
&Тест
Процедура СпанСобытияНеНаследуетТекущийСпан() Экспорт

	// Дано
	ВнешнийСпан = Трассировщик.НачатьСпан("внешний");
	ОбластьВнешнего = ВнешнийСпан.СделатьТекущим();
	Подключение = НовоеПодключение("/socket/ws", "/socket/ws");

	// Когда
	Состояние = Трассировка.НачатьСообщение(Подключение);
	Трассировка.Завершить(Состояние);

	ОбластьВнешнего.Закрыть();
	ВнешнийСпан.Завершить();

	// Тогда
	Ожидаем.Что(Состояние.Спан.ИдРодительскогоСпана(), "родитель спана").Равно("");

КонецПроцедуры

// Рукопожатие могло пройти без трассировки: тогда и ссылаться не на что.
&Тест
Процедура БезКонтекстаРукопожатияСпанБезЛинков() Экспорт

	// Дано
	Подключение = НовоеПодключение("/socket/ws", "/socket/ws");

	// Когда
	Состояние = Трассировка.НачатьСообщение(Подключение);
	Трассировка.Завершить(Состояние);

	// Тогда
	Ожидаем.Что(Состояние.Спан.Линки().Количество(), "количество линков").Равно(0);

КонецПроцедуры

// Спан события текущий, пока работает обработчик: спаны, которые обработчик
// заводит сам, становятся его дочерними.
&Тест
Процедура СпанСобытияТекущийДоЗавершения() Экспорт

	// Дано
	Подключение = НовоеПодключение("/socket/ws", "/socket/ws");

	// Когда
	Состояние = Трассировка.НачатьСообщение(Подключение);
	ТекущийВоВремяОбработки = ОтелКонтекст.ТекущийСпан();
	Трассировка.Завершить(Состояние);
	ТекущийПослеОбработки = ОтелКонтекст.ТекущийСпан();

	// Тогда
	Ожидаем.Что(ТекущийВоВремяОбработки, "текущий спан во время обработки").Равно(Состояние.Спан);
	Ожидаем.Что(ТекущийПослеОбработки, "текущий спан после обработки").ЭтоНе().Равно(Состояние.Спан);
	Ожидаем.Что(Состояние.Спан.Завершен(), "спан завершён").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИсключениеПомечаетСпанСобытияОшибкойИЗаписываетЕго() Экспорт

	// Дано
	Подключение = НовоеПодключение("/socket/fail", "/socket/fail");
	Состояние = Трассировка.НачатьСообщение(Подключение);

	// Когда
	Попытка
		ВызватьИсключение "тестовая ошибка";
	Исключение
		Трассировка.ЗавершитьСОшибкой(Состояние, ИнформацияОбОшибке(), ОписаниеОшибки());
	КонецПопытки;

	// Тогда
	Ожидаем.Что(Состояние.Спан.КодСтатуса(), "код статуса спана").Равно(ОтелКодСтатуса.Ошибка());
	Ожидаем.Что(Состояние.Спан.События().Количество(), "количество событий спана").Больше(0);
	Ожидаем.Что(Состояние.Спан.Завершен(), "спан завершён").ЭтоИстина();
	Ожидаем.Что(ОтелКонтекст.ТекущийСпан(), "текущий спан после ошибки").ЭтоНе().Равно(Состояние.Спан);

КонецПроцедуры

Функция НачатьСобытие(ИмяМетода, Подключение)

	Параметры = Новый Массив();
	Параметры.Добавить(Подключение);

	Возврат Новый Рефлектор().ВызватьМетод(Трассировка, ИмяМетода, Параметры);

КонецФункции

Функция НовоеПодключение(Топик, ШаблонМаршрута)

	Подключение = Новый Структура("Идентификатор, Топик, ШаблонМаршрута, КонтекстТрассировки");
	Подключение.Идентификатор = "клиент";
	Подключение.Топик = Топик;
	Подключение.ШаблонМаршрута = ШаблонМаршрута;

	Возврат Подключение;

КонецФункции

// Контроллер для проверки автогенерации спецификации OpenAPI.

&Контроллер("/openapitest")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ТочкаМаршрута("ping")
&Операция(Сводка = "Проверка доступности")
Процедура Пинг(Ответ) Экспорт
	Ответ.ТелоТекст = "pong";
КонецПроцедуры

// Богатая форма: всё об операции одной аннотацией, как @Operation в springdoc.
&ТочкаМаршрута("rich")
&Операция(Сводка = "Богатая форма",
	Описание = "Описание, объявленное автором.",
	Группы = "Особый, ЕщёОдин",
	Идентификатор = "своё имя операции")
Процедура БогатаяФорма(Ответ) Экспорт
	Ответ.ТелоТекст = "rich";
КонецПроцедуры

// Обе формы вместе: группа из параметра добавляется к объявленной отдельно,
// а устаревание срабатывает от любой из них.
&ТочкаМаршрута("mixed")
&Операция(Сводка = "Смешанная форма", Группы = "ИзПараметра", Устарело = Истина)
&Группа("ИзАннотации", Описание = "Группа, объявленная отдельной аннотацией")
Процедура СмешаннаяФорма(Ответ) Экспорт
	Ответ.ТелоТекст = "mixed";
КонецПроцедуры

&ТочкаМаршрута("echo/{имя}")
Процедура Эхо(Ответ, Имя) Экспорт
	Ответ.ТелоТекст = Имя;
КонецПроцедуры

&ТочкаМаршрута("search")
Процедура Поиск(Ответ, Фраза) Экспорт
	Ответ.ТелоТекст = Фраза;
КонецПроцедуры

&ТочкаМаршрута("submit")
Процедура Отправить(Ответ, ТелоЗапроса) Экспорт
	Ответ.ТелоТекст = ?(ЗначениеЗаполнено(ТелоЗапроса), "ok", "empty");
КонецПроцедуры

// Кириллические адреса одинаковой длины: до транслитерации давали один
// идентификатор, потому что от адреса оставалась только его длина.
&ТочкаМаршрута("кот")
Процедура Кот(Ответ) Экспорт
	Ответ.ТелоТекст = "кот";
КонецПроцедуры

&ТочкаМаршрута("дом")
Процедура Дом(Ответ) Экспорт
	Ответ.ТелоТекст = "дом";
КонецПроцедуры

// Твёрдый знак при транслитерации отбрасывается, поэтому оба адреса дают
// одинаковую основу идентификатора - различить их может только суффикс.
&ТочкаМаршрута("съезд")
Процедура Съезд(Ответ) Экспорт
	Ответ.ТелоТекст = "съезд";
КонецПроцедуры

&ТочкаМаршрута("сезд")
Процедура Сезд(Ответ) Экспорт
	Ответ.ТелоТекст = "сезд";
КонецПроцедуры

// Параметры размечены теми же аннотациями, что и поля типов: тип задаёт &Тип,
// границы - &Минимум и &Максимум.
&ТочкаМаршрута("typedparams/{Возраст}")
Процедура ТипизированныеПараметры(Ответ, &Тип("Число") &Минимум(0) &Максимум(150) Возраст,
		&Тип("Булево") Активен) Экспорт
	Ответ.ТелоТекст = Строка(Возраст) + "/" + Строка(Активен);
КонецПроцедуры

&ТочкаМаршрута("oldroute")
&Устарело("Используйте /openapitest/ping")
Процедура Устаревшая(Ответ, &Устарело Старый, Актуальный) Экспорт
	Ответ.ТелоТекст = Строка(Старый) + Строка(Актуальный);
КонецПроцедуры

&ТочкаМаршрута("returns")
&Возвращает(Тип = "ЗаявкаOpenApiТест", Описание = "Найденная заявка")
&Возвращает(Код = 404, Описание = "Заявка не найдена")
Процедура СОтветами(Ответ) Экспорт
	Ответ.ТелоТекст = "returns";
КонецПроцедуры

// Ответ-коллекция: тип элементов нигде не хранится, поэтому назван отдельно.
&ТочкаМаршрута("returnsarray")
&Возвращает(Тип = "Массив", Элемент = "ЗаявкаOpenApiТест", Описание = "Найденные заявки")
Процедура СМассивомВОтвете(Ответ) Экспорт
	Ответ.ТелоТекст = "returnsarray";
КонецПроцедуры

// Соответствие с объявленным типом значений: элементы ложатся
// в additionalProperties, а не в items.
&ТочкаМаршрута("returnsmap")
&Возвращает(Тип = "Соответствие", Элемент = "ЗаявкаOpenApiТест", Описание = "Заявки по ключам")
Процедура ССоответствиемВОтвете(Ответ) Экспорт
	Ответ.ТелоТекст = "returnsmap";
КонецПроцедуры

// Коллекция без объявленного типа элементов остаётся как была - items пустой.
&ТочкаМаршрута("returnsanyarray")
&Возвращает(Тип = "Массив", Описание = "Элементы любого вида")
Процедура СМассивомБезТипаЭлемента(Ответ) Экспорт
	Ответ.ТелоТекст = "returnsanyarray";
КонецПроцедуры

// Тип содержимого ответа объявляется: вывести его неоткуда, точка маршрута
// задаёт его вызовом уже во время обработки запроса.
&ТочкаМаршрута("returnscsv")
&Возвращает(Тип = "Строка", ТипСодержимого = "text/csv", Описание = "Выгрузка")
Процедура СВыгрузкойВОтвете(Ответ) Экспорт
	Ответ.ТелоТекст = "returnscsv";
КонецПроцедуры

// Двоичный ответ схемой не описывается - как и двоичное тело запроса.
&ТочкаМаршрута("returnsbinary")
&Возвращает(Тип = "ДвоичныеДанные", ТипСодержимого = "application/octet-stream",
	Описание = "Файл выгрузки")
Процедура СДвоичнымОтветом(Ответ) Экспорт
	Ответ.ТелоТекст = "returnsbinary";
КонецПроцедуры

&ТочкаМаршрута("bagnamed")
Процедура МешокИменованных(Ответ, ПараметрыЗапросаИменные) Экспорт
	Ответ.ТелоТекст = Строка(ПараметрыЗапросаИменные.Количество());
КонецПроцедуры

&ТочкаМаршрута("bagordered")
Процедура МешокПозиционных(Ответ, ПараметрыЗапросаПорядковые) Экспорт
	Ответ.ТелоТекст = Строка(ПараметрыЗапросаПорядковые.Количество());
КонецПроцедуры

&ТочкаМаршрута("typed")
&Операция(Сводка = "Приём типизированного тела")
Процедура Типизированный(Ответ, &Заполнено &Тип("ЗаявкаOpenApiТест") ТелоЗапросаОбъект) Экспорт
	Ответ.ТелоТекст = ?(ТелоЗапросаОбъект = Неопределено, "empty", "ok");
КонецПроцедуры

// Тело без &Заполнено необязательно: точка маршрута умеет работать и без него.
&ТочкаМаршрута("optionalbody")
&Операция(Сводка = "Приём необязательного тела")
Процедура НеобязательноеТело(Ответ, ТелоЗапросаОбъект) Экспорт
	Ответ.ТелоТекст = ?(ТелоЗапросаОбъект = Неопределено, "empty", "ok");
КонецПроцедуры

&ТочкаМаршрута("upload")
Процедура Загрузить(Ответ, ДвоичныеДанныеЗапроса) Экспорт
	Ответ.ТелоТекст = ?(ДвоичныеДанныеЗапроса = Неопределено, "empty", "ok");
КонецПроцедуры

&ТочкаМаршрута("custom", Метод = "put")
Процедура Кастомный(Ответ) Экспорт
	Ответ.ТелоТекст = "custom";
КонецПроцедуры

&ТочкаМаршрута("special")
&Операция(Сводка = "Спец "" и \ конец")
Процедура Спец(Ответ) Экспорт
	Ответ.ТелоТекст = "special";
КонецПроцедуры

#Использовать opentelemetry

&Пластилин Перем БрокерСообщенийВебСокетов;

Перем _Подключившиеся; // Массив Из Строка - идентификаторы из подписки на подключение
Перем _Отключившиеся; // Массив Из Строка - идентификаторы из подписки на отключение
Перем _ПадатьПриПодключении; // Булево - падать ли в подписке на подключение

&Контроллер("/socket")
Процедура ПриСозданииОбъекта()
	ИнициализироватьСостояния();
КонецПроцедуры

Процедура ИнициализироватьСостояния() Экспорт
	_Подключившиеся = Новый Массив;
	_Отключившиеся = Новый Массив;
	_ПадатьПриПодключении = Ложь;
КонецПроцедуры

Функция Подключившиеся() Экспорт
	Возврат _Подключившиеся;
КонецФункции

Функция Отключившиеся() Экспорт
	Возврат _Отключившиеся;
КонецФункции

Процедура ПадатьПриПодключении() Экспорт
	_ПадатьПриПодключении = Истина;
КонецПроцедуры

&ТочкаМаршрута("ws")
Процедура ДемонстрацияОтображения(Идентификатор, Топик, Сообщение) Экспорт

	БрокерСообщенийВебСокетов.ОтправитьСообщениеВсем(Топик, Сообщение + " 1");

КонецПроцедуры

&ТочкаМаршрута("one")
Процедура ОтветитьОдному(Идентификатор, Топик, Сообщение) Экспорт
	БрокерСообщенийВебСокетов.ОтправитьСообщение(Топик, Сообщение + " 1", Идентификатор);
КонецПроцедуры

&ТочкаМаршрута("list")
Процедура ОтветитьСписку(Идентификатор, Топик, Сообщение) Экспорт
	Получатели = Новый Массив;
	Получатели.Добавить(Идентификатор);
	БрокерСообщенийВебСокетов.ОтправитьСообщениеСписку(Топик, Сообщение + " 1", Получатели);
КонецПроцедуры

&ТочкаМаршрута("except")
Процедура ОтветитьВсемКроме(Топик, Сообщение) Экспорт
	Исключения = Новый Массив;
	Исключения.Добавить("другой клиент");
	БрокерСообщенийВебСокетов.ОтправитьСообщениеВсемКроме(Топик, Сообщение + " 1", Исключения);
КонецПроцедуры

&ТочкаМаршрута("fail")
Процедура ОтветитьИлиУпасть(Идентификатор, Топик, Сообщение) Экспорт
	Если Сообщение = "упади" Тогда
		ВызватьИсключение "Ошибка обработчика сообщения";
	КонецЕсли;
	БрокерСообщенийВебСокетов.ОтправитьСообщение(Топик, Сообщение + " 1", Идентификатор);
КонецПроцедуры

// Отвечает идентификатором трассировки, в которой обрабатывается сообщение:
// по нему сквозные тесты находят трассировку сообщения в бэкенде.
//
// Параметры:
//  Идентификатор - Строка - Идентификатор сессии клиента.
//  Топик         - Строка - Путь, по которому подключился клиент.
//
&ТочкаМаршрута("traceid")
Процедура ОтветитьИдТрассировки(Идентификатор, Топик) Экспорт
	ИдТрассировки = ОтелКонтекст.ТекущийСпан().КонтекстСпана().ИдТрассировки();
	БрокерСообщенийВебСокетов.ОтправитьСообщение(Топик, ИдТрассировки, Идентификатор);
КонецПроцедуры

&ПриПодключенииВебСокета("/socket/ws")
Процедура ПриПодключении(Идентификатор) Экспорт
	_Подключившиеся.Добавить(Идентификатор);
	Если _ПадатьПриПодключении Тогда
		ВызватьИсключение "Ошибка обработчика подключения";
	КонецЕсли;
КонецПроцедуры

&ПриОтключенииВебСокета("/socket/ws")
Процедура ПриОтключении(Идентификатор) Экспорт
	_Отключившиеся.Добавить(Идентификатор);
КонецПроцедуры

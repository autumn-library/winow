// Контроллер для проверки тегов спецификации OpenAPI.
//
// Тег контроллера относится ко всем его точкам маршрута, тег точки маршрута
// его дополняет.

&Контроллер("/tagtest")
&Тег("Общий", Описание = "Группа всего контроллера")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ТочкаМаршрута("plain")
Процедура Обычная(Ответ) Экспорт
	Ответ.ТелоТекст = "plain";
КонецПроцедуры

&ТочкаМаршрута("own")
&Тег("Особый", Описание = "Группа одной операции")
Процедура СоСвоимТегом(Ответ) Экспорт
	Ответ.ТелоТекст = "own";
КонецПроцедуры

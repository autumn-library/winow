&Пластилин
Перем МенеджерОтображений Экспорт;

&Пластилин
Перем МенеджерДоступа Экспорт;

&Пластилин
Перем Парсеры Экспорт;

// Поток тела, поставленный точкой маршрута, которая потом упала.
Перем ПотокУпавшейОтдачи Экспорт;

&Контроллер("/tests")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ТочкаМаршрута("checkup")
Процедура ПроверкаЗдоровья(Ответ) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = "ок";
КонецПроцедуры

// Отдаёт адрес запроса таким, каким его увидел winow. Нужно, чтобы тест мог
// сверить декодирование пути и строки параметров между реализациями серверов:
// прикладной разбирает сырой HTTP-текст сам, а нативному путь отдаёт Kestrel
// уже декодированным.
&ТочкаМаршрута("echourl/{Сегмент}")
Процедура ЭхоАдресаЗапроса(Ответ, Запрос, Сегмент) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = СтрШаблон("%1|%2|%3", Запрос.Путь, Запрос.ПолныйПуть, Сегмент);
КонецПроцедуры

&ТочкаМаршрута("getparams")
Процедура ПроверкаГетПараметров(Ответ, ПараметрыЗапросаИменные) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = СтрШаблон("%1 И %2", ПараметрыЗапросаИменные["animal1"], ПараметрыЗапросаИменные["animal2"]);
КонецПроцедуры

&ТочкаМаршрута("getorderedparams")
Процедура ПроверкаУпорядоченныхГетПараметров(Ответ, ПараметрыЗапросаПорядковые) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = СтрШаблон("%1 И %2", ПараметрыЗапросаПорядковые[0], ПараметрыЗапросаПорядковые[1]);
КонецПроцедуры

&ТочкаМаршрута("postparams")
Процедура ПроверкаПостТекста(Ответ, ТелоЗапроса) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	ПостПараметры = Парсеры.ПараметрыИзТекста(ТелоЗапроса);
	Ответ.ТелоТекст = СтрШаблон("%1 И %2", ПостПараметры["animal1"], ПостПараметры["animal2"]);
КонецПроцедуры

&ТочкаМаршрута("setcookie")
Процедура УстановитьКуку(Ответ, ПараметрыЗапросаИменные) Экспорт
	ИмяКуки = "pechenka";
	ЗначениеКуки = ПараметрыЗапросаИменные["pechenka"];
	ДатаИстечения = XMLЗначение(Тип("Дата"), ПараметрыЗапросаИменные["expires"]);
	НоваяКука = Ответ.Куки.Добавить(ИмяКуки, ЗначениеКуки);
	НоваяКука.ДатаИстечения = ДатаИстечения;
КонецПроцедуры

&ТочкаМаршрута("setsessiondata")
Процедура УстановитьДанныеСессии(Ответ, ДанныеСессии, ПараметрыЗапросаИменные) Экспорт
	ДанныеПользователя = ПараметрыЗапросаИменные["userdata"];
	ИмяПараметраСессии = "ДанныеПользователя";
	ДанныеСессии[ИмяПараметраСессии] = ДанныеПользователя;
КонецПроцедуры

&ТочкаМаршрута("readsessiondata")
Процедура ПрочитатьДанныеСессии(Ответ, ДанныеСессии) Экспорт
	ИмяПараметраСессии = "ДанныеПользователя";
	ЗначениеПараметраСессии  = ДанныеСессии[ИмяПараметраСессии];
	Ответ.ТелоТекст = ЗначениеПараметраСессии;
КонецПроцедуры

&ФинальныйШтрих
Процедура ПроинициализироватьРоли() Экспорт
	МенеджерДоступа.ДобавитьТокен("Пользователь", "111");
	МенеджерДоступа.ДобавитьРольЛогина("Пользователь", "Пользователи");
КонецПроцедуры

&ТочкаМаршрута("user")
&Роли("Пользователи")
Процедура Пользователь(Ответ) Экспорт

	Ответ.ТелоТекст = "Ок";

КонецПроцедуры

&ТочкаМаршрута("templateuri/{Ягода}/{Фрукт}/{Овощь}")
Процедура ШаблонныеПараметрыПути(Ответ, Фрукт, Овощь, Ягода) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = СтрШаблон("%1 %2 %3", Ягода, Фрукт, Овощь);
КонецПроцедуры

&ТочкаМаршрута("calc/plus/{Число1}/{Число2}")
Процедура ШаблонныеПараметрыСложение(Ответ, Число1, Число2) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = Число(Число1) + Число(Число2);
КонецПроцедуры

&ТочкаМаршрута("calc/minus/{Число1}/{Число2}")
Процедура ШаблонныеПараметрыВычитание(Ответ, Число1, Число2) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = Число(Число1) - Число(Число2);
КонецПроцедуры

&ТочкаМаршрута("calc/{Число1}/multiply/{Число2}")
Процедура ШаблонныеПараметрыУмножение(Ответ, Число1, Число2) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = Число(Число1) * Число(Число2);
КонецПроцедуры

&ТочкаМаршрута("calc/{Число1}/devide/{Число2}")
Процедура ШаблонныеПараметрыДеление(Ответ, Число1, Число2) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = Число(Число1) / Число(Число2);
КонецПроцедуры

&ТочкаМаршрута("getparamsbyname")
Процедура ПроверкаГетПараметровПоИмени(Ответ, ИмяКошки, ИмяСобаки) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = СтрШаблон("%1 И %2", "ИмяКошки=" + ИмяКошки, "ИмяСобаки=" + ИмяСобаки);
КонецПроцедуры

&ТочкаМаршрута("postjsonbody")
Процедура ПроверкаПостЗапросаКакОбъект(Ответ, ТелоЗапросаОбъект, ЗаголовкиЗапроса) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = СтрШаблон("%1 %2", ТелоЗапросаОбъект.Имя, ТелоЗапросаОбъект.Фамилия);
КонецПроцедуры

&ТочкаМаршрута("postjsontypedbody")
Процедура ПроверкаПостЗапросаКакТипизированныйОбъект(Ответ, &Тип("ТестовыйОбъект") ТелоЗапросаОбъект) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = СтрШаблон("%1 %2", ТелоЗапросаОбъект.Имя, ТелоЗапросаОбъект.Фамилия);
КонецПроцедуры

&ТочкаМаршрута("postformbody")
Процедура ПроверкаПостЗапросаКакФорма(Ответ, Имя, Фамилия) Экспорт
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = СтрШаблон("%1 %2", Имя, Фамилия);
КонецПроцедуры

// Большие файлы: тело ответа из файла и тело запроса потоком.
&ТочкаМаршрута("streamdownload")
Процедура ОтдатьФайлПотоком(Ответ) Экспорт
	ИмяФайла = ПолучитьИмяВременногоФайла();
	Данные = ПолучитьДвоичныеДанныеИзСтроки(ТестовоеТелоБольшогоФайла());
	Данные.Записать(ИмяФайла);
	Ответ.УстановитьТипКонтента("txt");
	Ответ.УстановитьТелоИзФайла(ИмяФайла);
КонецПроцедуры

&ТочкаМаршрута("streamupload")
Процедура ПринятьФайлПотоком(Ответ, ТелоЗапросаПоток) Экспорт
	ИмяФайла = ПолучитьИмяВременногоФайла();
	Файл = Новый ФайловыйПоток(ИмяФайла, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);
	ТелоЗапросаПоток.КопироватьВ(Файл);
	Размер = Файл.Размер();
	Файл.Закрыть();
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.ДобавитьФайл(ИмяФайла);
	УдалитьФайлы(ИмяФайла);
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = СтрШаблон("%1 %2", Формат(Размер, "ЧГ=0"), Хеширование.ХешСуммаСтрокой);
КонецПроцедуры

// Дописываемый файл: фоновое задание пишет его частями, отдача начинается сразу.
&ТочкаМаршрута("streamgrowing")
Процедура ОтдатьДописываемыйФайл(Ответ) Экспорт
	ИмяФайла = ПолучитьИмяВременногоФайла();
	Тело = ТестовоеТелоБольшогоФайла();
	Параметры = Новый Массив;
	Параметры.Добавить(ИмяФайла);
	Параметры.Добавить(Тело);
	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ДописыватьФайл", Параметры);
	Ответ.УстановитьТипКонтента("txt");
	Ответ.УстановитьТелоИзФайла(ИмяФайла, СтрДлина(Тело));
КонецПроцедуры

// Файл, который не будет дописан: отдача должна оборваться по таймауту.
&ТочкаМаршрута("streamstalled")
Процедура ОтдатьНедописанныйФайл(Ответ) Экспорт
	ИмяФайла = ПолучитьИмяВременногоФайла();
	Данные = ПолучитьДвоичныеДанныеИзСтроки("начало");
	Данные.Записать(ИмяФайла);
	Ответ.УстановитьТипКонтента("txt");
	Ответ.УстановитьТелоИзФайла(ИмяФайла, 1000000);
КонецПроцедуры

// Точка маршрута падает после того, как поставила тело из файла.
&ТочкаМаршрута("streamfailed")
Процедура УпастьПослеТелаИзФайла(Ответ) Экспорт
	Ответ.УстановитьТелоИзФайла("./tests/app/files/textfile.txt");
	ПотокУпавшейОтдачи = Ответ.ТелоПоток;
	ВызватьИсключение "Точка маршрута упала после тела из файла";
КонецПроцедуры

// Готовый файл, который дописывают, пока он уходит клиенту.
&ТочкаМаршрута("streamappended")
Процедура ОтдатьФайлКоторыйДописывают(Ответ) Экспорт
	ИмяФайла = ПолучитьИмяВременногоФайла();
	ПолучитьДвоичныеДанныеИзСтроки(ТелоФайлаКоторыйДописывают()).Записать(ИмяФайла);
	Ответ.УстановитьТипКонтента("txt");
	Ответ.УстановитьТелоИзФайла(ИмяФайла);
	Параметры = Новый Массив;
	Параметры.Добавить(ИмяФайла);
	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ДописыватьВКонец", Параметры);
	Приостановить(20);
КонецПроцедуры

// Дописывает в конец файла маленькими порциями около полусекунды.
Процедура ДописыватьВКонец(ИмяФайла) Экспорт
	Файл = Новый ФайловыйПоток(ИмяФайла, РежимОткрытияФайла.Дописать, ДоступКФайлу.Запись);
	Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки("tail");
	Для Сч = 1 По 250 Цикл
		Файл.Записать(Буфер, 0, Буфер.Размер);
		Файл.СброситьБуферы();
		Приостановить(2);
	КонецЦикла;
	Файл.Закрыть();
КонецПроцедуры

// Восемь мегабайт: копирование идёт дольше, чем дописывание начинается.
Функция ТелоФайлаКоторыйДописывают() Экспорт
	Части = Новый Массив;
	Для Сч = 1 По 32 Цикл
		Части.Добавить(ТестовоеТелоБольшогоФайла());
	КонецЦикла;
	Возврат СтрСоединить(Части);
КонецФункции

// Пишет текст в файл четырьмя частями с паузами; файл создаёт не сразу.
Процедура ДописыватьФайл(ИмяФайла, Текст) Экспорт
	Приостановить(50);
	Файл = Новый ФайловыйПоток(ИмяФайла, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);
	РазмерЧасти = СтрДлина(Текст) / 4;
	Для Часть = 0 По 3 Цикл
		Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки(Сред(Текст, Часть * РазмерЧасти + 1, РазмерЧасти));
		Файл.Записать(Буфер, 0, Буфер.Размер);
		Файл.СброситьБуферы();
		Приостановить(100);
	КонецЦикла;
	Файл.Закрыть();
КонецПроцедуры

// Несколько порций потока, чтобы отдача и приём шли в несколько шагов.
Функция ТестовоеТелоБольшогоФайла() Экспорт
	Части = Новый Массив;
	Для Сч = 1 По 8192 Цикл
		Части.Добавить("0123456789abcdef0123456789abcdef");
	КонецЦикла;
	Возврат СтрСоединить(Части);
КонецФункции

#Использовать logos

// Тестовый клиент Server-Sent Events поверх TCPСоединение.
//
// Тело ответа разбирается так же, как в браузере: нативный сервер (Kestrel) без длины
// контента отдаёт его порциями Transfer-Encoding: chunked, прикладной - как есть.
// Событие заканчивается пустой строкой; события ping отбрасываются.

Перем Сообщения; // Массив Из Строка - принятые события, кроме ping
Перем Соединение; // TCPСоединение - соединение с сервером
Перем ПервичныйОтвет; // Строка - строка статуса и заголовки ответа
Перем Слушать; // Булево - читать ли события дальше
Перем Порционно; // Булево - тело приходит порциями Transfer-Encoding: chunked
Перем Сырые; // ДвоичныеДанные - принятые байты, ещё не разобранные на порции
Перем Полезные; // ДвоичныеДанные - тело без обрамления порций, ещё не разобранное на события
Перем ЗакрытоСервером; // Булево - сервер закрыл соединение
Перем Лог;

// Параметры:
//  Хост  - Строка - Хост сервера.
//  Порт  - Число - Порт сервера.
//  Топик - Строка - Путь топика.
//  ДополнительныйЗаголовок - Строка - Строка заголовка, которая добавляется к запросу; пустая - без неё.
//
Процедура ПриСозданииОбъекта(Хост, Порт, Топик, ДополнительныйЗаголовок = "")
	Лог = Логирование.ПолучитьЛог("oscript.app.winow.test.sseclient");
	Сообщения = Новый Массив();
	ЗакрытоСервером = Ложь;
	Сырые = ПолучитьДвоичныеДанныеИзСтроки("");
	Полезные = ПолучитьДвоичныеДанныеИзСтроки("");
	Соединение = Новый TCPСоединение(Хост, Порт);
	Соединение.ТаймаутЧтения = 5000;
	УстановитьПодключение(Хост, Порт, Топик, ДополнительныйЗаголовок);
	Слушать = Истина;
	НачатьПрослушку();
КонецПроцедуры

Процедура Остановить() Экспорт
	Слушать = Ложь;
КонецПроцедуры

// Экспортная, потому что служит точкой входа для ФоновыеЗадания.Выполнить.
Процедура ЖдатьСообщения() Экспорт

	// короткий таймаут, чтобы вовремя заметить Остановить
	Соединение.ТаймаутЧтения = 200;

	Пока Слушать Цикл
		Попытка
			Порция = Соединение.ПрочитатьДвоичныеДанные();
		Исключение
			// Таймаут: данных пока нет. Неактивно соединение, которое закрыл сервер: клиент
			// сам его здесь не закрывает. Сервер мог закрыть его и сразу после таймаута,
			// тогда пустой порции уже не будет.
			Порция = Неопределено;
			Если НЕ Соединение.Активно Тогда
				Лог.Отладка("Сервер закрыл соединение");
				ЗакрытоСервером = Истина;
				Прервать;
			КонецЕсли;
		КонецПопытки;

		Если Порция = Неопределено Тогда
			Продолжить;
		ИначеЕсли Порция.Размер() = 0 Тогда
			Лог.Отладка("Сервер закрыл соединение");
			ЗакрытоСервером = Истина;
			Прервать;
		Иначе
			ОбработатьПринятое(Порция);
		КонецЕсли;
	КонецЦикла;

	Соединение.Закрыть();
	Соединение = Неопределено;
	Лог.Отладка("Соединение закрыто");

КонецПроцедуры

Процедура НачатьПрослушку()
	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЖдатьСообщения");
КонецПроцедуры

Функция ПервичныйОтвет() Экспорт
	Возврат ПервичныйОтвет;
КонецФункции

Функция Сообщения() Экспорт
	Возврат Сообщения;
КонецФункции

// Возвращаемое значение:
//  Булево - Истина, если сервер закрыл соединение или завершил ответ.
//
Функция ЗакрытоСервером() Экспорт
	Возврат ЗакрытоСервером;
КонецФункции

Процедура УстановитьПодключение(Хост, Порт, Топик, ДополнительныйЗаголовок)
	Лог.Отладка("Установка соединения");

	КонецСтроки = Символы.ВК + Символы.ПС;
	Дополнительно = ?(ЗначениеЗаполнено(ДополнительныйЗаголовок), ДополнительныйЗаголовок + КонецСтроки, "");
	Запрос = СтрШаблон("GET %1 HTTP/1.1%4Host: %2:%3%4Accept: text/event-stream%4Connection: keep-alive%4%5%4",
		Топик, Хост, Формат(Порт, "ЧГ=0"), КонецСтроки, Дополнительно);
	Соединение.ОтправитьСтроку(Запрос);

	ПервичныйОтвет = ПрочитатьЗаголовки();

	Если Не СтрНачинаетсяС(ПервичныйОтвет, "HTTP/1.1 200 OK") Тогда
		ВызватьИсключение "Не удалось подключиться к топику " + Топик + " по причине: " + ПервичныйОтвет;
	КонецЕсли;

	Порционно = СтрНайти(НРег(ПервичныйОтвет), "transfer-encoding: chunked") > 0;
	Лог.Отладка("Соединение установлено");
КонецПроцедуры

// Читает ответ побайтно ровно до пустой строки после заголовков:
// сразу за ними может прийти первое событие.
//
// Возвращаемое значение:
//  Строка - Строка статуса и заголовки ответа.
//
Функция ПрочитатьЗаголовки()

	КонецЗаголовков = Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС;
	Части = Новый Массив();
	Хвост = "";

	Пока Хвост <> КонецЗаголовков Цикл
		Байт = Соединение.ПрочитатьДвоичныеДанные(1);
		Если Байт.Размер() = 0 Тогда
			ВызватьИсключение "Соединение закрыто до конца заголовков ответа";
		КонецЕсли;
		Части.Добавить(Байт);
		Хвост = Прав(Хвост + ПолучитьСтрокуИзДвоичныхДанных(Байт), СтрДлина(КонецЗаголовков));
	КонецЦикла;

	Возврат ПолучитьСтрокуИзДвоичныхДанных(СоединитьДвоичныеДанные(Части));

КонецФункции

Процедура ОбработатьПринятое(Порция)

	Если Порционно Тогда
		Сырые = Соединить(Сырые, Порция);
		ИзвлечьПорции();
	Иначе
		Полезные = Соединить(Полезные, Порция);
	КонецЕсли;

	РазобратьСобытия();

КонецПроцедуры

// Порция chunked: размер в шестнадцатеричном виде, CRLF, данные, CRLF (RFC 9112, 7.1).
Процедура ИзвлечьПорции()

	ДлинаПереводаСтроки = 2;

	Пока Истина Цикл
		Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Сырые);
		КонецРазмера = НайтиПереводСтроки(Буфер, Истина);
		Если КонецРазмера < 0 Тогда
			Прервать;
		КонецЕсли;

		СтрокаРазмера = ПолучитьСтрокуИзДвоичныхДанных(
			ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер.Прочитать(0, КонецРазмера)));
		Размер = ЧислоИзШестнадцатеричной(СтрРазделить(СтрокаРазмера, ";")[0]);
		НачалоДанных = КонецРазмера + ДлинаПереводаСтроки;
		КонецПорции = НачалоДанных + Размер + ДлинаПереводаСтроки;
		Если Буфер.Размер < КонецПорции Тогда
			Прервать;
		КонецЕсли;

		Если Размер = 0 Тогда
			// последняя порция: сервер завершил ответ
			Слушать = Ложь;
			ЗакрытоСервером = Истина;
		Иначе
			Данные = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер.Прочитать(НачалоДанных, Размер));
			Полезные = Соединить(Полезные, Данные);
		КонецЕсли;
		Сырые = Остаток(Буфер, КонецПорции);
	КонецЦикла;

КонецПроцедуры

// Событие заканчивается пустой строкой. Перевод строки в UTF-8 не встречается внутри
// многобайтных символов, поэтому событие можно отрезать по байтам до раскодирования.
Процедура РазобратьСобытия()

	ДлинаРазделителя = 2;

	Пока Истина Цикл
		Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Полезные);
		КонецСобытия = НайтиПереводСтроки(Буфер, Ложь);
		Если КонецСобытия < 0 Тогда
			Прервать;
		КонецЕсли;

		ДанныеСобытия = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер.Прочитать(0, КонецСобытия));
		Текст = СокрЛП(ПолучитьСтрокуИзДвоичныхДанных(ДанныеСобытия));
		Полезные = Остаток(Буфер, КонецСобытия + ДлинаРазделителя);

		Если ЗначениеЗаполнено(Текст) И СтрНайти(Текст, "event: ping") = 0 Тогда
			Сообщения.Добавить(Текст);
			Лог.Отладка("Принято сообщение: " + Текст);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Ищет CRLF (конец строки размера порции) или два LF подряд (конец события).
//
// Параметры:
//  Буфер     - БуферДвоичныхДанных - Где искать.
//  ИскатьCRLF - Булево - Истина - искать CRLF, Ложь - два LF подряд.
//
// Возвращаемое значение:
//  Число - Позиция первого байта найденной пары, -1 - если её нет.
//
Функция НайтиПереводСтроки(Буфер, ИскатьCRLF)

	ВозвратКаретки = 13;
	ПереводСтроки = 10;
	ДлинаПары = 2;
	ПервыйБайт = ?(ИскатьCRLF, ВозвратКаретки, ПереводСтроки);

	Результат = -1;
	Для Индекс = 0 По Буфер.Размер - ДлинаПары Цикл
		Если Буфер[Индекс] = ПервыйБайт И Буфер[Индекс + 1] = ПереводСтроки Тогда
			Результат = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Остаток(Буфер, Начало)
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер.Прочитать(Начало, Буфер.Размер - Начало));
КонецФункции

Функция Соединить(Первые, Вторые)
	Части = Новый Массив();
	Части.Добавить(Первые);
	Части.Добавить(Вторые);
	Возврат СоединитьДвоичныеДанные(Части);
КонецФункции

Функция ЧислоИзШестнадцатеричной(Строка)

	Цифры = "0123456789abcdef";
	ОснованиеСистемы = 16;
	Результат = 0;

	Для Индекс = 1 По СтрДлина(СокрЛП(Строка)) Цикл
		Цифра = СтрНайти(Цифры, НРег(Сред(СокрЛП(Строка), Индекс, 1))) - 1;
		Результат = Результат * ОснованиеСистемы + Цифра;
	КонецЦикла;

	Возврат Результат;

КонецФункции

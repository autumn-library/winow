#Использовать autumn
#Использовать opentelemetry
#Использовать ".."
#Использовать "поддержка"
#Использовать asserts

// Содержимое серверного спана, который winow заводит вокруг HTTP-запроса.
//
// Веб-сервер не поднимается: имя спана, атрибуты по HTTP semantic conventions
// и статус при ошибке от реализации сервера не зависят, а поднимать его ради
// этого дорого. Набор работает в своей поделке с включённой трассировкой.

Перем Трассировка;

// Отдельный процесс, а не просто своя поделка: SDK OTel регистрируется глобально
// один раз на процесс, и в общем прогоне его успевает занять соседний набор -
// тогда ОтелSdk в этой поделке не создаётся и желудь приезжает пустым.
&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс", Совет = "() -> НастройкиТрассировки.СоветСТрассировкой()")
Процедура ПриСозданииОбъекта(&Пластилин("ТрассировкаHttpЗапросов") _Трассировка) Экспорт
	Трассировка = _Трассировка;
КонецПроцедуры

&Тест
Процедура ИмяСпанаСодержитШаблонМаршрутаАНеКонкретныйПуть() Экспорт

	// Дано
	Трассировка = НоваяТрассировка();
	Запрос = НовыйЗапрос("GET", "/calc/5/multiply/7");
	Запрос.ШаблонМаршрута = "/calc/{Число1}/multiply/{Число2}";

	// Когда
	Состояние = Трассировка.Начать(Запрос);
	Трассировка.Завершить(Состояние, Запрос, НовыйОтвет(200));

	// Тогда
	Ожидаем.Что(Состояние.Спан.Имя(), "имя спана").Равно("GET /calc/{Число1}/multiply/{Число2}");
	Ожидаем.Что(Состояние.Спан.Атрибуты().Получить("http.route"), "http.route")
		.Равно("/calc/{Число1}/multiply/{Число2}");

КонецПроцедуры

// Если маршрут не нашёлся, конкретный путь в имя подставлять нельзя:
// имён спанов стало бы столько же, сколько различных URL.
&Тест
Процедура БезМаршрутаИмяСпанаЭтоТолькоМетодЗапроса() Экспорт

	// Дано
	Трассировка = НоваяТрассировка();
	Запрос = НовыйЗапрос("GET", "/такого/маршрута/нет");

	// Когда
	Состояние = Трассировка.Начать(Запрос);
	Трассировка.Завершить(Состояние, Запрос, НовыйОтвет(404));

	// Тогда
	Ожидаем.Что(Состояние.Спан.Имя(), "имя спана").Равно("GET");
	Ожидаем.Что(Состояние.Спан.Атрибуты().Получить("http.route"), "http.route").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура СпанСодержитАтрибутыЗапросаПоСоглашениям() Экспорт

	// Дано
	Трассировка = НоваяТрассировка();
	Запрос = НовыйЗапрос("POST", "/заказы");
	Запрос.ПолныйПуть = "/заказы?страница=2&размер=10";
	Запрос.Заголовки.Вставить("host", "winow.example:8080");
	Запрос.Заголовки.Вставить("User-Agent", "Mozilla/5.0");

	// Когда
	Состояние = Трассировка.Начать(Запрос);
	Трассировка.Завершить(Состояние, Запрос, НовыйОтвет(201));

	// Тогда
	Атрибуты = Состояние.Спан.Атрибуты();
	Ожидаем.Что(Атрибуты.Получить("http.request.method"), "http.request.method").Равно("POST");
	Ожидаем.Что(Атрибуты.Получить("url.scheme"), "url.scheme").Равно("http");
	Ожидаем.Что(Атрибуты.Получить("url.path"), "url.path").Равно("/заказы");
	Ожидаем.Что(Атрибуты.Получить("url.query"), "url.query").Равно("страница=2&размер=10");
	Ожидаем.Что(Атрибуты.Получить("http.response.status_code"), "http.response.status_code").Равно(201);
	Ожидаем.Что(Атрибуты.Получить("client.address"), "client.address").Равно("192.0.2.10");
	Ожидаем.Что(Атрибуты.Получить("client.port"), "client.port").Равно(51234);

КонецПроцедуры

// Значения ключей из списка HTTP semantic conventions не должны уезжать в бэкенд
// трассировки. Имена ключей при этом сохраняются.
&ПараметризованныйТест(Имя = "ключ={Параметры}")
&ИсточникЗначение("X-Amz-Signature")
&ИсточникЗначение("X-Amz-Credential")
&ИсточникЗначение("X-Amz-Security-Token")
&ИсточникЗначение("sig")
&ИсточникЗначение("X-Goog-Signature")
Процедура ЗначенияЧувствительныхПараметровЗатираются(ИмяПараметра) Экспорт

	// Дано
	Трассировка = НоваяТрассировка();
	Запрос = НовыйЗапрос("GET", "/файл");
	Запрос.ПолныйПуть = "/файл?цвет=синий&" + ИмяПараметра + "=секрет";

	// Когда
	Состояние = Трассировка.Начать(Запрос);
	Трассировка.Завершить(Состояние, Запрос, НовыйОтвет(200));

	// Тогда
	Ожидаем.Что(Состояние.Спан.Атрибуты().Получить("url.query"), "url.query")
		.Равно("цвет=синий&" + ИмяПараметра + "=REDACTED");

КонецПроцедуры

// Соглашения предписывают сравнивать имена ключей с учётом регистра,
// поэтому параметр в другом регистре чувствительным не считается.
&Тест
Процедура СравнениеЧувствительныхПараметровУчитываетРегистр() Экспорт

	// Дано
	Трассировка = НоваяТрассировка();
	Запрос = НовыйЗапрос("GET", "/файл");
	Запрос.ПолныйПуть = "/файл?SIG=обычное";

	// Когда
	Состояние = Трассировка.Начать(Запрос);
	Трассировка.Завершить(Состояние, Запрос, НовыйОтвет(200));

	// Тогда
	Ожидаем.Что(Состояние.Спан.Атрибуты().Получить("url.query"), "url.query")
		.Равно("SIG=обычное");

КонецПроцедуры

// Заголовок Host приходит в произвольном регистре, поэтому ищется без учёта регистра
// и разбирается на адрес и порт.
&Тест
Процедура АдресСервераБерётсяИзЗаголовкаHost() Экспорт

	// Дано
	Трассировка = НоваяТрассировка();
	Запрос = НовыйЗапрос("GET", "/");
	Запрос.Заголовки.Вставить("host", "winow.example:8080");

	// Когда
	Состояние = Трассировка.Начать(Запрос);
	Трассировка.Завершить(Состояние, Запрос, НовыйОтвет(200));

	// Тогда
	Атрибуты = Состояние.Спан.Атрибуты();
	Ожидаем.Что(Атрибуты.Получить("server.address"), "server.address").Равно("winow.example");
	Ожидаем.Что(Атрибуты.Получить("server.port"), "server.port").Равно(8080);

КонецПроцедуры

&Тест
Процедура ЗаголовокUserAgentПопадаетВАтрибуты() Экспорт

	// Дано
	Трассировка = НоваяТрассировка();
	Запрос = НовыйЗапрос("GET", "/");
	Запрос.Заголовки.Вставить("user-agent", "curl/8.0.1");

	// Когда
	Состояние = Трассировка.Начать(Запрос);
	Трассировка.Завершить(Состояние, Запрос, НовыйОтвет(200));

	// Тогда
	Ожидаем.Что(Состояние.Спан.Атрибуты().Получить("user_agent.original"), "user_agent.original")
		.Равно("curl/8.0.1");

КонецПроцедуры

// Обработчик winow гасит исключения точки маршрута и отдаёт 500 обычным ответом,
// поэтому пометить спан ошибкой можно только по коду ответа.
&Тест
Процедура ОтветПятьсотПомечаетСпанОшибкой() Экспорт

	// Дано
	Трассировка = НоваяТрассировка();
	Запрос = НовыйЗапрос("GET", "/падает");

	// Когда
	Состояние = Трассировка.Начать(Запрос);
	Трассировка.Завершить(Состояние, Запрос, НовыйОтвет(500));

	// Тогда
	Ожидаем.Что(Состояние.Спан.КодСтатуса(), "код статуса спана").Равно(ОтелКодСтатуса.Ошибка());

КонецПроцедуры

// 4xx - ошибка вызывающей стороны, а не обработчика, и серверный спан ею не помечается.
&Тест
Процедура ОтветЧетырестаНеПомечаетСпанОшибкой() Экспорт

	// Дано
	Трассировка = НоваяТрассировка();
	Запрос = НовыйЗапрос("GET", "/нет-доступа");

	// Когда
	Состояние = Трассировка.Начать(Запрос);
	Трассировка.Завершить(Состояние, Запрос, НовыйОтвет(403));

	// Тогда
	Ожидаем.Что(Состояние.Спан.КодСтатуса(), "код статуса спана")
		.ЭтоНе().Равно(ОтелКодСтатуса.Ошибка());

КонецПроцедуры

&Тест
Процедура ИсключениеПомечаетСпанОшибкойИЗаписываетЕго() Экспорт

	// Дано
	Трассировка = НоваяТрассировка();
	Запрос = НовыйЗапрос("GET", "/падает");
	Состояние = Трассировка.Начать(Запрос);

	// Когда
	Попытка
		ВызватьИсключение "тестовая ошибка";
	Исключение
		Трассировка.ЗавершитьСОшибкой(Состояние, ИнформацияОбОшибке(), ОписаниеОшибки());
	КонецПопытки;

	// Тогда
	Ожидаем.Что(Состояние.Спан.КодСтатуса(), "код статуса спана").Равно(ОтелКодСтатуса.Ошибка());
	Ожидаем.Что(Состояние.Спан.События().Количество(), "количество событий спана").Больше(0);

КонецПроцедуры

Функция НоваяТрассировка()
	Возврат Трассировка;
КонецФункции

Функция НовыйЗапрос(Метод, Путь)

	Запрос = Новый Структура("Метод, Путь, ПолныйПуть, Заголовки,"
		+ " АдресУдаленногоУзла, ПортУдаленногоУзла, ШаблонМаршрута");

	Запрос.Метод = Метод;
	Запрос.Путь = Путь;
	Запрос.ПолныйПуть = Путь;
	Запрос.Заголовки = Новый Соответствие();
	Запрос.АдресУдаленногоУзла = "192.0.2.10";
	Запрос.ПортУдаленногоУзла = 51234;
	Запрос.ШаблонМаршрута = "";

	Возврат Запрос;

КонецФункции

Функция НовыйОтвет(КодСостояния)
	Возврат Новый Структура("СостояниеКод", КодСостояния);
КонецФункции

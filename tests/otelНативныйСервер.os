#Использовать autumn
#Использовать opentelemetry
#Использовать ".."
#Использовать "поддержка"
#Использовать asserts

// Интеграция winow с OpenTelemetry на нативном веб-сервере.
//
// Нативный сервер обрабатывает запрос прямо в потоке пула Kestrel, без обёртки
// в фоновое задание. Набор проверяет, что контекст трассировки при этом живой
// и не перемешивается между параллельными запросами.

Перем Поделка;
Перем Порт;
// СобирательСпанов - накапливает завершённые спаны, чтобы утверждать о спанах
// веб-сокета напрямую: снаружи их не видно.
Перем Собиратель;

// Отдельный процесс, а не просто своя поделка: SDK OTel регистрируется глобально
// один раз на процесс, и в общем прогоне его успевает занять соседний набор -
// тогда ОтелSdk в этой поделке не создаётся и желудь приезжает пустым.
&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс",
	Совет = "() -> НастройкиТрассировки.СоветСТрассировкойНаНативномСервере()")
Процедура ПриСозданииОбъекта(&Пластилин("Поделка") _Поделка) Экспорт
	Поделка = _Поделка;
	Порт = НастройкиТрассировки.ПортНативногоСервера();
КонецПроцедуры

&ПередВсеми
Процедура ЗапуститьСервер() Экспорт

	// Обработчик запросов создаётся заранее: именно его создание заставляет
	// напильник поднять SDK и зарегистрировать его глобально.
	Поделка.НайтиЖелудь("НативныйОбработчикЗапросов");

	// SDK берётся из глобального реестра OTel, см. otelВключен.ЗапуститьСервер.
	Собиратель = Новый СобирательСпанов();
	ОтелГлобальный.Получить().ПровайдерТрассировки()
		.ДобавитьПроцессор(Новый ОтелПростойПроцессорСпанов(Собиратель));

	ВебСервер = Поделка.НайтиЖелудь("ВебСервер");
	ФоновыеЗадания.Выполнить(ВебСервер, "Старт");
	// Подождем что бы сервер успел запустится и проинициализироваться.
	Приостановить(1000);

	// Первый запрос с traceparent идёт последовательно: модули его пути (пропагатор,
	// ОтелНезаписывающийСпан и другие) загружаются в одном потоке. Сбор покрытия
	// OneScript (CodeStatProcessor) не потокобезопасен, и одновременная первая загрузка
	// модуля в параллельных запросах роняет его на повторной регистрации строк.
	// Исправление в движке: https://github.com/EvilBeaver/OneScript/pull/1762
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("traceparent", "00-4bf92f3577b34da6a3ce929d0e0e4799-00f067aa0ba902b7-01");
	ГетЗапрос("/tests/otel/traceid/slow", Заголовки);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьСервер() Экспорт

	Попытка
		Поделка.НайтиЖелудь("ВебСервер").Стоп();
	Исключение
		// Сервер уже остановлен - ронять из-за этого прогон незачем.
	КонецПопытки;

КонецПроцедуры

// Деталька otel.enabled задана строкой "true" - в том виде, в каком её отдаёт
// провайдер переменных среды. Если бы её не приводили к булеву, напильник либо
// не нашёл бы шов, либо уронил бы старт приложения.
&Тест
Процедура ДеталькаСтрокойВключаетТрассировку() Экспорт

	// Когда
	Желудь = Поделка.НайтиЖелудь("НативныйОбработчикЗапросов");

	// Тогда - желудь обёрнут декоратором напильника, а значит трассировка включена
	Ожидаем.Что(Строка(ТипЗнч(Желудь)), "тип желудя НативныйОбработчикЗапросов")
		.ЭтоНе().Равно("НативныйОбработчикЗапросов");

КонецПроцедуры

&Тест
Процедура ЗапросыОбрабатываютсяКакОбычно() Экспорт

	// Когда
	Ответ = ГетЗапрос("/tests/checkup");

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния, "код состояния").Равно(200);

КонецПроцедуры

// Включённая трассировка не заворачивает обработку запроса в фоновое задание:
// контекст трассировки живёт и в потоке Kestrel.
&Тест
Процедура ЗапросОбрабатываетсяБезФоновогоЗадания() Экспорт

	// Когда
	Ответ = ГетЗапрос("/tests/otel/thread");

	// Тогда
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), "идентификатор фонового задания")
		.Равно("нет");

КонецПроцедуры

// Каждый из одновременно обрабатываемых запросов видит свой собственный
// контекст трассировки, а не контекст соседнего запроса.
&Тест
Процедура КонтекстыПараллельныхЗапросовНеПеремешиваются() Экспорт

	// Дано
	КоличествоЗапросов = 5;
	Результаты = Новый Массив();
	Задания = Новый Массив();

	// Когда
	Для Номер = 1 По КоличествоЗапросов Цикл

		Результат = Новый Структура("Ожидаемый, Полученный", ИдТрассировкиПоНомеру(Номер), "");
		Результаты.Добавить(Результат);

		Параметры = Новый Массив();
		Параметры.Добавить(Результат);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗапроситьИдТрассировкиПослеПаузы", Параметры));

	КонецЦикла;

	Для Каждого Задание Из Задания Цикл
		Задание.ОжидатьЗавершения();
	КонецЦикла;

	// Тогда
	Для Каждого Результат Из Результаты Цикл
		Ожидаем.Что(Результат.Полученный, "идентификатор трассировки запроса " + Результат.Ожидаемый)
			.Равно(Результат.Ожидаемый);
	КонецЦикла;

КонецПроцедуры

// Экспортная, потому что служит точкой входа для ФоновыеЗадания.Выполнить.
//
// Параметры:
//  Результат - Структура - Ожидаемый и полученный идентификаторы трассировки.
//
Процедура ЗапроситьИдТрассировкиПослеПаузы(Результат) Экспорт

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("traceparent", "00-" + Результат.Ожидаемый + "-00f067aa0ba902b7-01");

	Ответ = ГетЗапрос("/tests/otel/traceid/slow", Заголовки);
	Результат.Полученный = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

КонецПроцедуры

// Спан метода контроллера создаёт autumn-opentelemetry, а его родителем
// становится серверный спан от winow. Без живого контекста трассировки
// спан метода оказался бы корневым и родителя бы не имел.
&Тест
Процедура СерверныйСпанСтановитсяРодителемСпанаМетода() Экспорт

	// Когда
	Ответ = ГетЗапрос("/tests/otel/parent");

	// Тогда
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), "родительский спан")
		.ЭтоНе().Равно("нет");

КонецПроцедуры

&Тест
Процедура ВходящийTraceparentПродолжаетТрассировку() Экспорт

	// Дано
	ИдТрассировки = "4bf92f3577b34da6a3ce929d0e0e4736";
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("traceparent", "00-" + ИдТрассировки + "-00f067aa0ba902b7-01");

	// Когда
	Ответ = ГетЗапрос("/tests/otel/traceid", Заголовки);

	// Тогда
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), "идентификатор трассировки")
		.Равно(ИдТрассировки);

КонецПроцедуры

// Рукопожатие проходит через свой шов: серверный спан закрывается после ответа 101,
// хотя обработчик запроса Kestrel держит соединение открытым до его закрытия.
&Тест
Процедура РукопожатиеВебСокетаПолучаетСерверныйСпан() Экспорт

	// Дано
	Собиратель.Очистить();
	КодПереключенияПротокола = 101;

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/ws");
	Спан = Собиратель.ДождатьсяСпана("GET /socket/ws");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	Ожидаем.Что(Спан, "спан рукопожатия при открытом соединении").Заполнено();
	Ожидаем.Что(Спан.ВидСпана(), "вид спана рукопожатия").Равно(ОтелВидСпана.Сервер());
	Ожидаем.Что(Спан.Атрибуты().Получить("http.response.status_code"), "http.response.status_code")
		.Равно(КодПереключенияПротокола);

КонецПроцедуры

// В доступе отказано - рукопожатие всё равно получает серверный спан с кодом отказа.
&Тест
Процедура ОтказВРукопожатииВебСокетаПолучаетСерверныйСпан() Экспорт

	// Дано
	Собиратель.Очистить();
	КодТребованияАвторизации = 401;
	ЗащищенныйПуть = "/tests/user";

	// Когда
	Попытка
		КлиентВебСокета.Подключиться(Порт, ЗащищенныйПуть);
		Открыт = Истина;
	Исключение
		Открыт = Ложь;
	КонецПопытки;

	// Тогда
	Спан = Собиратель.ДождатьсяСпана("GET " + ЗащищенныйПуть);
	Ожидаем.Что(Открыт, "веб-сокет открыт без авторизации").ЭтоЛожь();
	Ожидаем.Что(Спан, "спан рукопожатия").Заполнено();
	Ожидаем.Что(Спан.Атрибуты().Получить("http.response.status_code"), "http.response.status_code")
		.Равно(КодТребованияАвторизации);

КонецПроцедуры

// Каждое сообщение - своя трассировка со ссылкой на рукопожатие.
&Тест
Процедура СообщениеВебСокетаПолучаетСпанСЛинкомНаРукопожатие() Экспорт

	// Дано
	Собиратель.Очистить();

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/ws");
	Ответ = КлиентВебСокета.Обменяться(Клиент, "привет");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	СпанРукопожатия = Собиратель.ДождатьсяСпана("GET /socket/ws");
	СпанСообщения = Собиратель.ДождатьсяСпанаСобытия("process /socket/ws", СпанРукопожатия);
	Ожидаем.Что(Ответ, "ответ обработчика").Равно("привет 1");
	Ожидаем.Что(СпанСообщения, "спан сообщения с линком на рукопожатие").Заполнено();
	Ожидаем.Что(СпанСообщения.ВидСпана(), "вид спана сообщения").Равно(ОтелВидСпана.Потребитель());
	Ожидаем.Что(СпанСообщения.Линки().Количество(), "количество линков").Равно(1);

КонецПроцедуры

// Спан метода контроллера создаёт autumn-opentelemetry, и родителем ему
// становится спан сообщения, а не рукопожатия.
&Тест
Процедура СпанСообщенияСтановитсяРодителемСпанаМетода() Экспорт

	// Дано
	Собиратель.Очистить();

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/ws");
	КлиентВебСокета.Обменяться(Клиент, "привет");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	СпанРукопожатия = Собиратель.ДождатьсяСпана("GET /socket/ws");
	СпанСообщения = Собиратель.ДождатьсяСпанаСобытия("process /socket/ws", СпанРукопожатия);
	Ожидаем.Что(Собиратель.ДочернийСпан(СпанСообщения), "спан метода обработчика").Заполнено();

КонецПроцедуры

// Обработчик сообщения упал - клиент об этом не узнаёт, а спан помечается ошибкой.
&Тест
Процедура ОшибкаОбработчикаСообщенияПомечаетСпанОшибкой() Экспорт

	// Дано
	Собиратель.Очистить();

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/fail");
	Клиент.ОтправитьДвоичныеДанные(КлиентВебСокета.ТекстовыйКадр("упади"));
	Спан = Собиратель.ДождатьсяСпана("process /socket/fail");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	Ожидаем.Что(Спан, "спан сообщения").Заполнено();
	Ожидаем.Что(Спан.КодСтатуса(), "код статуса спана").Равно(ОтелКодСтатуса.Ошибка());

КонецПроцедуры

&ПараметризованныйТест(Имя = "{Параметры}")
&ИсточникЗначение("connect /socket/ws")
&ИсточникЗначение("disconnect /socket/ws")
Процедура СобытиеСоединенияПолучаетСпанСЛинкомНаРукопожатие(ИмяСпана) Экспорт

	// Дано
	Собиратель.Очистить();

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/ws");
	КлиентВебСокета.Обменяться(Клиент, "привет");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	СпанРукопожатия = Собиратель.ДождатьсяСпана("GET /socket/ws");
	Спан = Собиратель.ДождатьсяСпанаСобытия(ИмяСпана, СпанРукопожатия);
	Ожидаем.Что(Спан, "спан события с линком на рукопожатие").Заполнено();

КонецПроцедуры

// Входящий traceparent рукопожатия продолжает трассировку рукопожатия,
// а через линк связывает с ней и сообщения клиента.
&Тест
Процедура TraceparentРукопожатияСвязываетСообщения() Экспорт

	// Дано
	Собиратель.Очистить();
	ИдТрассировки = "4bf92f3577b34da6a3ce929d0e0e4737";
	Заголовок = "traceparent: 00-" + ИдТрассировки + "-00f067aa0ba902b7-01";

	// Когда
	Клиент = КлиентВебСокета.Подключиться(Порт, "/socket/ws", Заголовок);
	КлиентВебСокета.Обменяться(Клиент, "привет");
	КлиентВебСокета.Отключиться(Клиент);

	// Тогда
	СпанРукопожатия = Собиратель.ДождатьсяСпана("GET /socket/ws");
	СпанСообщения = Собиратель.ДождатьсяСпанаСобытия("process /socket/ws", СпанРукопожатия);
	Ожидаем.Что(СпанСообщения.Линки()[0].КонтекстСпана().ИдТрассировки(), "трассировка рукопожатия")
		.Равно(ИдТрассировки);

КонецПроцедуры

// Подключение к серверным событиям проходит через свой шов: серверный спан закрывается
// после отправки заголовков, хотя обработчик запроса Kestrel держит соединение открытым.
// Топик - зарегистрированный путь, поэтому в имени спана он и стоит.
&Тест
Процедура ПодключениеКСервернымСобытиямПолучаетСерверныйСпан() Экспорт

	// Дано
	Собиратель.Очистить();
	КодУспеха = 200;

	// Когда
	Клиент = Новый ССЕКлиент("localhost", Порт, "/sse/test1");
	Спан = Собиратель.ДождатьсяСпана("GET /sse/test1");
	Клиент.Остановить();

	// Тогда
	Ожидаем.Что(Спан, "спан подключения при открытом соединении").Заполнено();
	Ожидаем.Что(Спан.ВидСпана(), "вид спана подключения").Равно(ОтелВидСпана.Сервер());
	Ожидаем.Что(Спан.Атрибуты().Получить("http.response.status_code"), "http.response.status_code")
		.Равно(КодУспеха);

КонецПроцедуры

&ПараметризованныйТест(Имя = "{Параметры}")
&ИсточникЗначение("connect /sse/testsub")
&ИсточникЗначение("disconnect /sse/testsub")
Процедура СобытиеСоединенияСерверныхСобытийПолучаетСпанСЛинкомНаПодключение(ИмяСпана) Экспорт

	// Дано
	Собиратель.Очистить();

	// Когда
	Клиент = Новый ССЕКлиент("localhost", Порт, "/sse/testsub");
	СпанПодключения = Собиратель.ДождатьсяСпана("GET /sse/testsub");
	ПулСерверныхСобытий.ЗакрытьСоединенияТопика(Поделка, "/sse/testsub");
	Клиент.Остановить();

	// Тогда
	Спан = Собиратель.ДождатьсяСпанаСобытия(ИмяСпана, СпанПодключения);
	Ожидаем.Что(Спан, "спан события с линком на подключение").Заполнено();

КонецПроцедуры

// Событие отправляет обработчик HTTP-запроса: спан отправки - часть его трассировки
// и ссылается на подключение получателя.
&Тест
Процедура ОтправкаСерверногоСобытияПолучаетСпанСЛинкомНаПодключение() Экспорт

	// Дано
	Собиратель.Очистить();
	Клиент = Новый ССЕКлиент("localhost", Порт, "/sse/test1");
	СпанПодключения = Собиратель.ДождатьсяСпана("GET /sse/test1");

	// Когда
	ГетЗапрос("/sse/sendall/привет");
	Клиент.Остановить();

	// Тогда
	СпанЗапроса = Собиратель.ДождатьсяСпана("GET /sse/sendall/{Текст}");
	Спан = Собиратель.ДождатьсяСпанаСобытия("send /sse/test1", СпанПодключения);
	Ожидаем.Что(Спан, "спан отправки с линком на подключение").Заполнено();
	Ожидаем.Что(Спан.ВидСпана(), "вид спана отправки").Равно(ОтелВидСпана.Производитель());
	// родитель - спан метода контроллера, который сам дочерний серверному спану запроса
	Ожидаем.Что(Спан.КонтекстСпана().ИдТрассировки(), "трассировка спана отправки")
		.Равно(СпанЗапроса.КонтекстСпана().ИдТрассировки());

КонецПроцедуры

&Тест
Процедура ОшибкаОбработчикаПодключенияПомечаетСпанОшибкой() Экспорт

	// Дано
	Собиратель.Очистить();

	// Когда
	Клиент = Новый ССЕКлиент("localhost", Порт, "/sse/fail");
	СпанПодключения = Собиратель.ДождатьсяСпана("GET /sse/fail");
	Спан = Собиратель.ДождатьсяСпанаСобытия("connect /sse/fail", СпанПодключения);
	Клиент.Остановить();

	// Тогда
	Ожидаем.Что(Спан, "спан подключения").Заполнено();
	Ожидаем.Что(Спан.КодСтатуса(), "код статуса спана").Равно(ОтелКодСтатуса.Ошибка());

КонецПроцедуры

Функция ИдТрассировкиПоНомеру(Номер)
	Возврат "4bf92f3577b34da6a3ce929d0e0e47" + Формат(Номер, "ЧЦ=2; ЧВН=; ЧГ=0");
КонецФункции

Функция ГетЗапрос(Адрес, Заголовки = Неопределено)

	Соединение = Новый HTTPСоединение("http://localhost", Порт, , , , 5);
	Запрос = Новый HTTPЗапрос(Адрес);

	Если Заголовки <> Неопределено Тогда
		Запрос.Заголовки = Заголовки;
	КонецЕсли;

	Возврат Соединение.Получить(Запрос);

КонецФункции

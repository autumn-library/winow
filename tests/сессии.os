#Использовать autumn
#Использовать ".."
#Использовать asserts

// Менеджер сессий забывает сессии, к которым не обращались дольше winow.СрокЖизниСессии.
//
// Срок и интервал уборки задаются прямо в настройках поделки: детальки экспортные,
// а менеджер читает их при каждом обращении.

Перем МенеджерСессий;
Перем Настройки;

Перем СрокЖизниБыл;
Перем ИнтервалУборкиБыл;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта(
		&Пластилин("МенеджерСессий") _МенеджерСессий,
		&Пластилин("Настройки") _Настройки) Экспорт
	МенеджерСессий = _МенеджерСессий;
	Настройки = _Настройки;
КонецПроцедуры

&ПередКаждым
Процедура ЗапомнитьНастройки() Экспорт
	СрокЖизниБыл = Настройки.СрокЖизниСессии;
	ИнтервалУборкиБыл = Настройки.ИнтервалУборкиСессий;
	Настройки.ИнтервалУборкиСессий = 0;
КонецПроцедуры

&ПослеКаждого
Процедура ВернутьНастройки() Экспорт
	Настройки.СрокЖизниСессии = СрокЖизниБыл;
	Настройки.ИнтервалУборкиСессий = ИнтервалУборкиБыл;
КонецПроцедуры

&Тест
Процедура ИзвестныйИдентификаторВозвращаетТуЖеСессию() Экспорт

	Сессия = МенеджерСессий.ПолучитьСессиюПоИдентификатору(Неопределено);
	Повторно = МенеджерСессий.ПолучитьСессиюПоИдентификатору(Сессия.Идентификатор());

	Ожидаем.Что(Повторно.Идентификатор(), "идентификатор повторно полученной сессии")
		.Равно(Сессия.Идентификатор());

КонецПроцедуры

&Тест
Процедура НеизвестныйИдентификаторДаётНовуюСессию() Экспорт

	Сессия = МенеджерСессий.ПолучитьСессиюПоИдентификатору("нет-такой-сессии");

	Ожидаем.Что(Сессия.Идентификатор(), "идентификатор новой сессии")
		.Заполнено()
		.ЭтоНе().Равно("нет-такой-сессии");

КонецПроцедуры

&Тест
Процедура СессияБезОбращенийЗабывается() Экспорт

	Настройки.СрокЖизниСессии = 1;

	Сессия = МенеджерСессий.ПолучитьСессиюПоИдентификатору(Неопределено);
	Приостановить(1100);

	Повторно = МенеджерСессий.ПолучитьСессиюПоИдентификатору(Сессия.Идентификатор());

	Ожидаем.Что(Повторно.Идентификатор(), "идентификатор сессии после срока жизни")
		.ЭтоНе().Равно(Сессия.Идентификатор());

КонецПроцедуры

&Тест
Процедура СрокЖизниИзПеременнойОкруженияПриходитСтрокой() Экспорт

	Настройки.СрокЖизниСессии = "1";
	Настройки.ИнтервалУборкиСессий = "0";

	Сессия = МенеджерСессий.ПолучитьСессиюПоИдентификатору(Неопределено);
	Приостановить(1100);

	Повторно = МенеджерСессий.ПолучитьСессиюПоИдентификатору(Сессия.Идентификатор());

	Ожидаем.Что(Повторно.Идентификатор(), "идентификатор сессии после срока жизни, заданного строкой")
		.ЭтоНе().Равно(Сессия.Идентификатор());

КонецПроцедуры

&Тест
Процедура ОбращениеПродлеваетСессию() Экспорт

	Настройки.СрокЖизниСессии = 2;

	Сессия = МенеджерСессий.ПолучитьСессиюПоИдентификатору(Неопределено);
	Приостановить(1100);
	МенеджерСессий.ПолучитьСессиюПоИдентификатору(Сессия.Идентификатор());
	Приостановить(1100);

	Повторно = МенеджерСессий.ПолучитьСессиюПоИдентификатору(Сессия.Идентификатор());

	Ожидаем.Что(Повторно.Идентификатор(), "идентификатор сессии, к которой обращались")
		.Равно(Сессия.Идентификатор());

КонецПроцедуры

&Тест
Процедура НулевойСрокХранитСессииДоОстановки() Экспорт

	Настройки.СрокЖизниСессии = 0;

	Сессия = МенеджерСессий.ПолучитьСессиюПоИдентификатору(Неопределено);
	Приостановить(1100);

	Ожидаем.Что(МенеджерСессий.УдалитьУстаревшие(), "забыто при нулевом сроке").Равно(0);
	Ожидаем.Что(МенеджерСессий.ПолучитьСессиюПоИдентификатору(Сессия.Идентификатор()).Идентификатор(),
		"идентификатор сессии при нулевом сроке").Равно(Сессия.Идентификатор());
	Приостановить(1100);

	Настройки.СрокЖизниСессии = 1;

	Ожидаем.Что(МенеджерСессий.УдалитьУстаревшие(), "забыто после включения срока").БольшеИлиРавно(1);
	Ожидаем.Что(МенеджерСессий.ПолучитьСессиюПоИдентификатору(Сессия.Идентификатор()).Идентификатор(),
		"идентификатор сессии после включения срока").ЭтоНе().Равно(Сессия.Идентификатор());

КонецПроцедуры

&Тест
Процедура ИнтервалУборкиСдерживаетПоискУстаревших() Экспорт

	Настройки.СрокЖизниСессии = 1;
	МенеджерСессий.УдалитьУстаревшие();
	Настройки.ИнтервалУборкиСессий = 3600;

	Сессия = МенеджерСессий.ПолучитьСессиюПоИдентификатору(Неопределено);
	Приостановить(1100);

	Ожидаем.Что(МенеджерСессий.ПолучитьСессиюПоИдентификатору(Сессия.Идентификатор()).Идентификатор(),
		"идентификатор устаревшей сессии до уборки").Равно(Сессия.Идентификатор());

	Приостановить(1100);
	Ожидаем.Что(МенеджерСессий.УдалитьУстаревшие(), "забыто уборкой по требованию").БольшеИлиРавно(1);
	Ожидаем.Что(МенеджерСессий.ПолучитьСессиюПоИдентификатору(Сессия.Идентификатор()).Идентификатор(),
		"идентификатор устаревшей сессии после уборки").ЭтоНе().Равно(Сессия.Идентификатор());

КонецПроцедуры

&Тест
Процедура СессияПомнитМоментОбращения() Экспорт

	Сессия = МенеджерСессий.ПолучитьСессиюПоИдентификатору(Неопределено);
	Было = Сессия.МоментПоследнегоОбращения();
	Приостановить(20);

	МенеджерСессий.ПолучитьСессиюПоИдентификатору(Сессия.Идентификатор());

	Ожидаем.Что(Сессия.МоментПоследнегоОбращения(), "момент обращения после повторного получения")
		.Больше(Было);

КонецПроцедуры

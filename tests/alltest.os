&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ОтдатьФайлПокаЕгоЧитаютДругие(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	Путь = "./tests/app/files/textfile.txt";
	Ожидаемое = ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь));
	ДругойЧитатель = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);

	// Когда
	Попытка
		Ответ = ГетЗапрос("textfile.txt");
		Чтение = Новый ЧтениеДанных(ДругойЧитатель);
		Прочитано = Чтение.Прочитать().ПолучитьДвоичныеДанные();
	Исключение
		ДругойЧитатель.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	ДругойЧитатель.Закрыть();

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку()).Равно(Ожидаемое);
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Прочитано)).Равно(Ожидаемое);

КонецПроцедуры


Процедура Должен_ПроверитьОбработкуПостЗапросаКакОбъект(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	АдресТеста = "postjsonbody";
	ТелоЗапроса = "{""Имя"": ""Иван"", ""Фамилия"": ""Пупкин""}";
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");

	// Когда
	Ответ = ПостЗапросТелоИзСтроки(АдресТеста, ТелоЗапроса, Заголовки);

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку()).Равно("Иван Пупкин");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьОбработкуПостЗапросаКакТипизированныйОбъект(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	АдресТеста = "postjsontypedbody";
	ТелоЗапроса = "{""name"": ""Иван"", ""surname"": ""Пупкин""}";
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");

	// Когда
	Ответ = ПостЗапросТелоИзСтроки(АдресТеста, ТелоЗапроса, Заголовки);

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку()).Равно("Иван Пупкин");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьОбработкуПостЗапросаКакФорма(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	АдресТеста = "postformbody";
	ТелоЗапроса = "Имя=ivan&Фамилия=pupkin";
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");

	// Когда
	Ответ = ПостЗапросТелоИзСтроки(АдресТеста, ТелоЗапроса, Заголовки);

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку()).Равно("ivan pupkin");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьРукопожатиеВебСокета(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	Клиент = Новый TCPСоединение("localhost", Порт);

	ТекстЗапроса = СтрШаблон("GET / HTTP/1.1
					|Host: localhost:%1
					|User-Agent: Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:107.0) Gecko/20100101 Firefox/107.0
					|Accept: */*
					|Accept-Language: ru-RU,ru;q=0.8,en-US;q=0.5,en;q=0.3
					|Accept-Encoding: gzip, deflate, br
					|Sec-WebSocket-Version: 13
					|Origin: null
					|Sec-WebSocket-Extensions: permessage-deflate
					|Sec-WebSocket-Key: 8Nm7+HLTwID0n9ABpH5QGA==
					|DNT: 1
					|Connection: keep-alive, Upgrade
					|Sec-Fetch-Dest: websocket
					|Sec-Fetch-Mode: websocket
					|Sec-Fetch-Site: cross-site
					|Pragma: no-cache
					|Cache-Control: no-cache
					|Upgrade: websocket", Порт);

	// Когда
	Клиент.ОтправитьСтроку(КлиентВебСокета.ЗапросHTTP(ТекстЗапроса));
	Ответ = Клиент.ПрочитатьСтроку();
	Приостановить(100);

	// Тогда

	Ожидаем.Что(Клиент.Активно, "Соединение активно").Равно(Истина);
	Ожидаем.Что(Ответ, "ответ содержит хендшейк").Содержит("Sec-WebSocket-Accept: hgGtYQoki4w7EXHvdkxAVu61+PI=");
	Ожидаем.Что(Ответ, "ответ содержит код 101").Содержит("HTTP/1.1 101");
	
КонецПроцедуры

// Сообщение вебсокета должно дойти до обработчика точки маршрута, а его ответ — до клиента.
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьОбменСообщениямиВебСокета(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	Клиент = Новый TCPСоединение("localhost", Порт);
	Клиент.ТаймаутЧтения = 5000;

	Попытка

		Клиент.ОтправитьСтроку(ЗапросРукопожатияВебСокета("/socket/ws"));
		ОтветРукопожатия = Клиент.ПрочитатьСтроку();

		// Когда
		Клиент.ОтправитьДвоичныеДанные(КлиентВебСокета.ТекстовыйКадр("привет"));
		// ответ сервера не маскируется, а длина у него короткая, поэтому читается ровно один кадр:
		// два байта заголовка и ровно столько полезных данных, сколько в них указано
		Заголовок = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Клиент.ПрочитатьДвоичныеДанные(2));
		ПолезныеДанные = Клиент.ПрочитатьДвоичныеДанные(ПобитовоеИ(Заголовок[1], 127));

	Исключение
		Клиент.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Клиент.Закрыть();

	// Тогда
	Ожидаем.Что(ОтветРукопожатия, "ответ содержит код 101").Содержит("HTTP/1.1 101");
	Ожидаем.Что(Заголовок[0], "последний текстовый кадр").Равно(129);
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(ПолезныеДанные), "обработчик ответил клиенту").Равно("привет 1");

КонецПроцедуры

// Запрос на переключение протокола для указанного пути.
//
// Параметры:
//  Путь       - Строка - Путь веб-сокета.
//  НомерПорта - Число - Порт сервера; Неопределено - порт сервера текущего теста.
//  ДополнительныйЗаголовок - Строка - Строка заголовка, которая добавляется к запросу; пустая - без неё.
//
// Возвращаемое значение:
//  Строка - Запрос рукопожатия, готовый к отправке.
//
Функция ЗапросРукопожатияВебСокета(Путь, Знач НомерПорта = Неопределено, ДополнительныйЗаголовок = "")

	Если НомерПорта = Неопределено Тогда
		НомерПорта = Порт;
	КонецЕсли;

	Возврат КлиентВебСокета.ЗапросРукопожатия(Путь, НомерПорта, ДополнительныйЗаголовок);

КонецФункции

// Сообщение длиннее 125 байт кодируется в кадре расширенной длиной (RFC 6455, 5.2),
// а нативный сервер должен собрать его из нескольких порций чтения.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьОбменДлиннымСообщениемВебСокета(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	ПервыйБайтТекстовогоКадра = 129;
	Сообщение = ДлинноеСообщение();
	Кадр = КлиентВебСокета.ТекстовыйКадр(Сообщение);

	Клиент = Новый TCPСоединение("localhost", Порт);
	Клиент.ТаймаутЧтения = 5000;

	Попытка

		Клиент.ОтправитьСтроку(ЗапросРукопожатияВебСокета("/socket/ws"));
		ОтветРукопожатия = Клиент.ПрочитатьСтроку();

		// Когда
		Клиент.ОтправитьДвоичныеДанные(Кадр);
		Ответ = КлиентВебСокета.ПрочитатьКадрСервера(Клиент);

	Исключение
		Клиент.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Клиент.Закрыть();

	// Тогда
	Ожидаем.Что(ОтветРукопожатия, "ответ содержит код 101").Содержит("HTTP/1.1 101");
	Ожидаем.Что(Ответ.ПервыйБайт, "последний текстовый кадр").Равно(ПервыйБайтТекстовогоКадра);
	Ожидаем.Что(Ответ.Текст, "обработчик получил сообщение целиком").Равно(Сообщение + " 1");

КонецПроцедуры

// Сообщение длиннее буфера чтения нативного сервера и короткой длины кадра.
//
// Возвращаемое значение:
//  Строка - Сообщение больше 4 КБ в UTF-8.
//
Функция ДлинноеСообщение()

	ДлинаСообщения = 2400;
	Сообщение = "";
	Пока СтрДлина(Сообщение) < ДлинаСообщения Цикл
		Сообщение = Сообщение + "длинное ";
	КонецЦикла;

	Возврат Сообщение;

КонецФункции

// Подписки на подключение и отключение получают идентификатор клиента,
// а закрытое соединение пропадает из пула.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ВызватьПодпискиНаПодключениеИОтключениеВебСокета(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	Топик = "/socket/ws";
	КонтролВебСокета = Поделка.НайтиЖелудь("КонтролВебСокета");
	КонтролВебСокета.ИнициализироватьСостояния();
	СоединенияВебСокетов = Поделка.НайтиЖелудь("СоединенияВебСокетов");

	Клиент = Новый TCPСоединение("localhost", Порт);
	Клиент.ТаймаутЧтения = 5000;

	// Когда
	Попытка
		Клиент.ОтправитьСтроку(ЗапросРукопожатияВебСокета(Топик));
		Клиент.ПрочитатьСтроку();
		Идентификатор = ДождатьсяЭлемента(КонтролВебСокета.Подключившиеся());
		Клиент.ОтправитьДвоичныеДанные(КлиентВебСокета.Кадр(КлиентВебСокета.КодЗакрытияКадра(), ""));
	Исключение
		Клиент.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Клиент.Закрыть();

	Отключившийся = ДождатьсяЭлемента(КонтролВебСокета.Отключившиеся(), Идентификатор);

	// Тогда
	Ожидаем.Что(Идентификатор, "подписка на подключение вызвана").Заполнено();
	Ожидаем.Что(Отключившийся, "подписка на отключение вызвана").Равно(Идентификатор);
	Ожидаем.Что(СоединенияВебСокетов.ПолучитьСоединениеПоИдентификатору(Топик, Идентификатор),
		"соединение удалено из пула").Равно(Неопределено);

КонецПроцедуры

// Соединение, которое получил обработчик подключения, получает и обработчик отключения
// и пропадает из пула, даже если обработчик подключения упал.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_УдалитьСоединениеВебСокетаПриОшибкеОбработчикаПодключения(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	Топик = "/socket/ws";
	КонтролВебСокета = Поделка.НайтиЖелудь("КонтролВебСокета");
	КонтролВебСокета.ИнициализироватьСостояния();
	КонтролВебСокета.ПадатьПриПодключении();
	СоединенияВебСокетов = Поделка.НайтиЖелудь("СоединенияВебСокетов");

	Клиент = Новый TCPСоединение("localhost", Порт);
	Клиент.ТаймаутЧтения = 5000;

	// Когда
	// контроллер общий для всех тестов сервера, поэтому падение обработчика выключается и при ошибке
	Попытка
		Клиент.ОтправитьСтроку(ЗапросРукопожатияВебСокета(Топик));
		Клиент.ПрочитатьСтроку();
		Идентификатор = ДождатьсяЭлемента(КонтролВебСокета.Подключившиеся());
		Отключившийся = ДождатьсяЭлемента(КонтролВебСокета.Отключившиеся(), Идентификатор);
	Исключение
		КонтролВебСокета.ИнициализироватьСостояния();
		Клиент.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	КонтролВебСокета.ИнициализироватьСостояния();
	Клиент.Закрыть();

	// Тогда
	Ожидаем.Что(Идентификатор, "подписка на подключение вызвана").Заполнено();
	Ожидаем.Что(Отключившийся, "подписка на отключение вызвана").Равно(Идентификатор);
	Ожидаем.Что(СоединенияВебСокетов.ПолучитьСоединениеПоИдентификатору(Топик, Идентификатор),
		"соединение удалено из пула").Равно(Неопределено);

КонецПроцедуры

// Нативный сервер собирает сообщение из фрагментов, поэтому без предела клиент мог бы
// слать фрагменты бесконечно. Сообщение больше предела закрывает соединение
// с кодом 1009 "сообщение слишком большое" (RFC 6455, 7.4.1).
// Прикладной сервер сообщения из фрагментов не собирает, поэтому тест только для нативного.
&Тест
Процедура Должен_ЗакрытьВебСокетПриПревышенииРазмераСообщения() Экспорт

	ВключитьСервер(Ложь);

	// Дано
	КодСлишкомБольшогоСообщения = 1009;
	ПервыйБайтКадраЗакрытия = 136;
	Предел = 1000;
	Кадр = КлиентВебСокета.ТекстовыйКадр(ДлинноеСообщение());

	Настройки = Поделка.НайтиЖелудь("Настройки");
	ПрежнийПредел = Настройки.МаксимальныйРазмерСообщенияВебСокета;
	Настройки.МаксимальныйРазмерСообщенияВебСокета = Предел;

	Клиент = Новый TCPСоединение("localhost", Порт);
	Клиент.ТаймаутЧтения = 5000;

	// Когда
	// настройки общие для всех тестов сервера, поэтому предел возвращается и при ошибке
	Попытка
		Клиент.ОтправитьСтроку(ЗапросРукопожатияВебСокета("/socket/ws"));
		Клиент.ПрочитатьСтроку();
		Клиент.ОтправитьДвоичныеДанные(Кадр);
		Ответ = КлиентВебСокета.ПрочитатьКадрСервера(Клиент);
	Исключение
		Настройки.МаксимальныйРазмерСообщенияВебСокета = ПрежнийПредел;
		Клиент.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Настройки.МаксимальныйРазмерСообщенияВебСокета = ПрежнийПредел;
	Клиент.Закрыть();

	// Тогда
	Ожидаем.Что(Ответ.ПервыйБайт, "сервер закрыл соединение").Равно(ПервыйБайтКадраЗакрытия);
	КодЗакрытия = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Ответ.Данные).ПрочитатьЦелое16(0, ПорядокБайтов.BigEndian);
	Ожидаем.Что(КодЗакрытия, "код закрытия").Равно(КодСлишкомБольшогоСообщения);

КонецПроцедуры

// Брокер отправляет ответ одному клиенту, списку клиентов и всем, кроме указанных.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//  Путь       - Строка - Точка маршрута, которая отвечает нужным методом брокера.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина, "/socket/one")
&ИсточникЗначение(Ложь, "/socket/one")
&ИсточникЗначение(Истина, "/socket/list")
&ИсточникЗначение(Ложь, "/socket/list")
&ИсточникЗначение(Истина, "/socket/except")
&ИсточникЗначение(Ложь, "/socket/except")
Процедура Должен_ОтправитьСообщениеВебСокетаВыбраннымКлиентам(Прикладной, Путь) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	Клиент = Новый TCPСоединение("localhost", Порт);
	Клиент.ТаймаутЧтения = 5000;

	// Когда
	Попытка
		Клиент.ОтправитьСтроку(ЗапросРукопожатияВебСокета(Путь));
		Клиент.ПрочитатьСтроку();
		Клиент.ОтправитьДвоичныеДанные(КлиентВебСокета.ТекстовыйКадр("привет"));
		Ответ = КлиентВебСокета.ПрочитатьКадрСервера(Клиент);
	Исключение
		Клиент.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Клиент.Закрыть();

	// Тогда
	Ожидаем.Что(Ответ.Текст, "обработчик ответил клиенту").Равно("привет 1");

КонецПроцедуры

// Клиент может молчать после рукопожатия сколько угодно: соединение не обрывается.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_СохранитьСоединениеВебСокетаПокаКлиентМолчит(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	ПаузаКлиента = 500;
	Клиент = Новый TCPСоединение("localhost", Порт);
	Клиент.ТаймаутЧтения = 5000;

	// Когда
	Попытка
		Клиент.ОтправитьСтроку(ЗапросРукопожатияВебСокета("/socket/ws"));
		Клиент.ПрочитатьСтроку();
		Приостановить(ПаузаКлиента);
		Клиент.ОтправитьДвоичныеДанные(КлиентВебСокета.ТекстовыйКадр("привет"));
		Ответ = КлиентВебСокета.ПрочитатьКадрСервера(Клиент);
	Исключение
		Клиент.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Клиент.Закрыть();

	// Тогда
	Ожидаем.Что(Ответ.Текст, "соединение пережило паузу").Равно("привет 1");

КонецПроцедуры

// Ошибка обработчика точки маршрута не обрывает соединение: следующее сообщение доходит.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_СохранитьСоединениеВебСокетаПриОшибкеОбработчикаСообщения(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	ПаузаМеждуСообщениями = 200;
	Клиент = Новый TCPСоединение("localhost", Порт);
	Клиент.ТаймаутЧтения = 5000;

	// Когда
	Попытка
		Клиент.ОтправитьСтроку(ЗапросРукопожатияВебСокета("/socket/fail"));
		Клиент.ПрочитатьСтроку();
		Клиент.ОтправитьДвоичныеДанные(КлиентВебСокета.ТекстовыйКадр("упади"));
		// кадры по отдельности: прикладной сервер разбирает один кадр за чтение
		Приостановить(ПаузаМеждуСообщениями);
		Клиент.ОтправитьДвоичныеДанные(КлиентВебСокета.ТекстовыйКадр("привет"));
		Ответ = КлиентВебСокета.ПрочитатьКадрСервера(Клиент);
	Исключение
		Клиент.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Клиент.Закрыть();

	// Тогда
	Ожидаем.Что(Ответ.Текст, "соединение пережило ошибку обработчика").Равно("привет 1");

КонецПроцедуры

// Сервер закрывает соединение клиента по идентификатору и топику.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ЗакрытьСоединениеВебСокетаПоИдентификатору(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	Топик = "/socket/ws";
	КонтролВебСокета = Поделка.НайтиЖелудь("КонтролВебСокета");
	КонтролВебСокета.ИнициализироватьСостояния();
	СоединенияВебСокетов = Поделка.НайтиЖелудь("СоединенияВебСокетов");

	Клиент = Новый TCPСоединение("localhost", Порт);
	Клиент.ТаймаутЧтения = 5000;

	// Когда
	Попытка
		Клиент.ОтправитьСтроку(ЗапросРукопожатияВебСокета(Топик));
		Клиент.ПрочитатьСтроку();
		Идентификатор = ДождатьсяЭлемента(КонтролВебСокета.Подключившиеся());
		СоединенияВебСокетов.НайтиИЗакрытьСоединениеПоИдентификаторуИТопику(Топик, Идентификатор);
		Закрыто = КлиентВебСокета.ЗакрытоСервером(Клиент);
	Исключение
		Клиент.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Клиент.Закрыть();

	Отключившийся = ДождатьсяЭлемента(КонтролВебСокета.Отключившиеся(), Идентификатор);

	// Тогда
	Ожидаем.Что(Идентификатор, "подписка на подключение вызвана").Заполнено();
	Ожидаем.Что(Закрыто, "сервер закрыл соединение").ЭтоИстина();
	Ожидаем.Что(Отключившийся, "подписка на отключение вызвана").Равно(Идентификатор);

КонецПроцедуры

// Отправка в соединение, которое уже прервано, не роняет отправляющего:
// иначе одно мёртвое соединение обрывало бы рассылку остальным клиентам.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_НеПадатьПриОтправкеВПрерванноеСоединениеВебСокета(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	Топик = "/socket/ws";
	КонтролВебСокета = Поделка.НайтиЖелудь("КонтролВебСокета");
	КонтролВебСокета.ИнициализироватьСостояния();
	СоединенияВебСокетов = Поделка.НайтиЖелудь("СоединенияВебСокетов");

	Клиент = Новый TCPСоединение("localhost", Порт);
	Клиент.ТаймаутЧтения = 5000;

	Попытка
		Клиент.ОтправитьСтроку(ЗапросРукопожатияВебСокета(Топик));
		Клиент.ПрочитатьСтроку();
		Идентификатор = ДождатьсяЭлемента(КонтролВебСокета.Подключившиеся());
		Подписка = СоединенияВебСокетов.ПолучитьСоединениеПоИдентификатору(Топик, Идентификатор).Подписка;
		Подписка.ПрерватьСоединение();
	Исключение
		Клиент.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	// Когда
	Попытка
		Подписка.ОтправитьСообщение("в прерванное соединение");
		ОшибкаОтправки = "";
	Исключение
		ОшибкаОтправки = ОписаниеОшибки();
	КонецПопытки;

	Клиент.Закрыть();

	// Тогда
	Ожидаем.Что(ОшибкаОтправки, "отправка не бросила исключение").Равно("");

КонецПроцедуры

// Соединения добавляются и удаляются из параллельных потоков - у нативного сервера
// из потоков Kestrel, у прикладного из фоновых заданий подписок, - а пул у них общий.
//
// Пул проверяется без сети: клиенты в фоновых заданиях того же процесса занимают
// потоки пула .NET, и Kestrel не успевает ответить на рукопожатия, а гонка от этого
// становится нестабильной. Подписка нативного сервера при подписке только запоминает
// соединение, поэтому вместо соединений годятся уникальные значения.
&Тест
Процедура Должен_СохранитьЦелостностьПулаВебСокетовПриПараллельнойРаботе() Экспорт

	ВключитьСервер(Ложь);

	// Дано
	Топик = "/socket/parallel";
	КоличествоПотоков = 8;
	Результаты = Новый Массив();
	Задания = Новый Массив();

	// Когда
	Для Номер = 1 По КоличествоПотоков Цикл
		Результат = Новый Структура("Топик, Номер, Ошибка", Топик, Номер, "");
		Результаты.Добавить(Результат);

		Параметры = Новый Массив();
		Параметры.Добавить(Результат);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ДобавитьИУдалитьСоединенияВебСокета", Параметры));
	КонецЦикла;

	Для Каждого Задание Из Задания Цикл
		Задание.ОжидатьЗавершения();
	КонецЦикла;

	// Тогда
	Для Каждого Результат Из Результаты Цикл
		Ожидаем.Что(Результат.Ошибка, "ошибка работы с пулом в потоке " + Результат.Номер).Равно("");
	КонецЦикла;
	Ожидаем.Что(Поделка.НайтиЖелудь("СоединенияВебСокетов").ПолучитьСоединенияПоТопику(Топик).Количество(),
		"соединения топика в пуле").Равно(0);

КонецПроцедуры

// Соединения Server-Sent Events нативного сервера тоже добавляются и удаляются
// из потоков Kestrel, пока рассылки и контроль соединений ищут в пуле получателей.
// Вместо соединений - структуры: пул только закрывает их и сравнивает по ссылке.
&Тест
Процедура Должен_СохранитьЦелостностьПулаСерверныхСобытийПриПараллельнойРаботе() Экспорт

	ВключитьСервер(Ложь);

	// Дано
	Топик = "/sse/parallel";
	КоличествоПотоков = 8;
	Результаты = Новый Массив();
	Задания = Новый Массив();

	// Когда
	Для Номер = 1 По КоличествоПотоков Цикл
		Результат = Новый Структура("Топик, Номер, Ошибка", Топик, Номер, "");
		Результаты.Добавить(Результат);

		Параметры = Новый Массив();
		Параметры.Добавить(Результат);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ДобавитьИУдалитьСоединенияСерверныхСобытий", Параметры));
	КонецЦикла;

	Для Каждого Задание Из Задания Цикл
		Задание.ОжидатьЗавершения();
	КонецЦикла;

	// Тогда
	Для Каждого Результат Из Результаты Цикл
		Ожидаем.Что(Результат.Ошибка, "ошибка работы с пулом в потоке " + Результат.Номер).Равно("");
	КонецЦикла;
	Ожидаем.Что(Поделка.НайтиЖелудь("СоединенияСерверныхСобытий").Количество(Топик),
		"соединения топика в пуле").Равно(0);

КонецПроцедуры

// Экспортная, потому что служит точкой входа для ФоновыеЗадания.Выполнить.
//
// Параметры:
//  Результат - Структура - Топик соединений; сюда же пишется ошибка.
//
Процедура ДобавитьИУдалитьСоединенияСерверныхСобытий(Результат) Экспорт

	КоличествоСоединений = 50;
	СоединенияСерверныхСобытий = Поделка.НайтиЖелудь("СоединенияСерверныхСобытий");

	Попытка
		Для Номер = 1 По КоличествоСоединений Цикл
			Соединение = Новый ЗаглушкаСоединенияСерверныхСобытий();
			СоединенияСерверныхСобытий.Добавить(Соединение, СтрШаблон("клиент %1.%2", Результат.Номер, Номер),
				Результат.Топик);
			СоединенияСерверныхСобытий.ПулСоединений();
			СоединенияСерверныхСобытий.ПолучитьСоединенияПоТопику(Результат.Топик);
			СоединенияСерверныхСобытий.УдалитьСоединение(Соединение);
		КонецЦикла;
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Экспортная, потому что служит точкой входа для ФоновыеЗадания.Выполнить.
//
// Параметры:
//  Результат - Структура - Топик соединений; сюда же пишется ошибка.
//
Процедура ДобавитьИУдалитьСоединенияВебСокета(Результат) Экспорт

	КоличествоСоединений = 50;
	СоединенияВебСокетов = Поделка.НайтиЖелудь("СоединенияВебСокетов");

	Запрос = Поделка.НайтиЖелудь("ВходящийЗапрос");
	Запрос.Путь = Результат.Топик;
	Запрос.Сессия = Поделка.НайтиЖелудь("МенеджерСессий").ПолучитьСессиюПоКукам(Запрос.Куки);

	Попытка
		Для Номер = 1 По КоличествоСоединений Цикл // BSLLS:UnusedLocalVariable-off
			Соединение = Новый УникальныйИдентификатор();
			СоединенияВебСокетов.Добавить(Соединение, Запрос);
			СоединенияВебСокетов.ПолучитьСоединенияПоТопику(Результат.Топик);
			СоединенияВебСокетов.УдалитьСоединение(Соединение);
		КонецЦикла;
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Веб-сокет на точку маршрута с ролями открывается только тому, кому точка доступна:
// иначе клиент вызывал бы защищённый обработчик в обход проверки ролей.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьРолиПриПодключенииВебСокета(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	ЗащищенныйПуть = "/tests/user";
	ЛогинИПароль = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки("Пользователь:111"));
	Авторизация = "Authorization: Basic " + ЛогинИПароль;
	ЛогинИПарольГостя = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки("Гость:222"));
	АвторизацияБезРоли = "Authorization: Basic " + ЛогинИПарольГостя;

	// Когда
	ОтветАнониму = ОтветНаРукопожатие(ЗапросРукопожатияВебСокета(ЗащищенныйПуть));
	ОтветПользователю = ОтветНаРукопожатие(ЗапросРукопожатияВебСокета(ЗащищенныйПуть, , Авторизация));
	ОтветГостю = ОтветНаРукопожатие(ЗапросРукопожатияВебСокета(ЗащищенныйПуть, , АвторизацияБезРоли));

	// Тогда
	Ожидаем.Что(ОтветАнониму, "аноним получил запрос авторизации").Содержит("HTTP/1.1 401");
	Ожидаем.Что(ОтветПользователю, "пользователю с ролью соединение открыто").Содержит("HTTP/1.1 101");
	Ожидаем.Что(ОтветГостю, "пользователю без роли отказано").Содержит("HTTP/1.1 403");

КонецПроцедуры

// Параметры:
//  ЗапросРукопожатия - Строка - Запрос рукопожатия, готовый к отправке.
//
// Возвращаемое значение:
//  Строка - Начало ответа сервера.
//
Функция ОтветНаРукопожатие(ЗапросРукопожатия)

	Клиент = Новый TCPСоединение("localhost", Порт);
	Клиент.ТаймаутЧтения = 5000;

	Попытка
		Клиент.ОтправитьСтроку(ЗапросРукопожатия);
		Ответ = Клиент.ПрочитатьСтроку();
	Исключение
		Клиент.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Клиент.Закрыть();

	Возврат Ответ;

КонецФункции

// Остановка сервера закрывает открытые веб-сокеты. Kestrel к тому же ждёт завершения
// обработчиков запросов, а обработчик веб-сокета не завершится, пока соединение открыто.
//
// Параметры:
//  Прикладной             - Булево - Истина для прикладного сервера, Ложь для нативного.
//  ПортОтдельногоСервера  - Число - Порт сервера, который поднимается только для этого теста.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина, 3336)
&ИсточникЗначение(Ложь, 3335)
Процедура Должен_ОстановитьСерверСОткрытымВебСокетом(Прикладной, ПортОтдельногоСервера) Экспорт

	// Дано
	КонтекстСервера = ПоднятьСервер(Прикладной, ПортОтдельногоСервера);
	ВебСервер = КонтекстСервера.Поделка.НайтиЖелудь("ВебСервер");
	КонтролВебСокета = КонтекстСервера.Поделка.НайтиЖелудь("КонтролВебСокета");
	ДопустимаяДлительностьОстановки = 5000;

	// сервер поднят только для этого теста, поэтому и при падении его останавливает сам тест
	Попытка
		Клиент = Новый TCPСоединение("localhost", КонтекстСервера.Порт);
		Клиент.ТаймаутЧтения = 5000;
		Клиент.ОтправитьСтроку(ЗапросРукопожатияВебСокета("/socket/ws", КонтекстСервера.Порт));
		ОтветРукопожатия = Клиент.ПрочитатьСтроку();
		// ответ на рукопожатие уходит раньше, чем соединение попадёт в пул
		Подключившийся = ДождатьсяЭлемента(КонтролВебСокета.Подключившиеся());
	Исключение
		ОстановитьСервер(КонтекстСервера);
		ВызватьИсключение;
	КонецПопытки;

	// Когда
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВебСервер.Стоп();
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Закрыто = КлиентВебСокета.ЗакрытоСервером(Клиент);
	Клиент.Закрыть();

	// Тогда
	Ожидаем.Что(ОтветРукопожатия, "ответ содержит код 101").Содержит("HTTP/1.1 101");
	// без открытого соединения остановка быстрая и без исправления
	Ожидаем.Что(Подключившийся, "соединение было открыто при остановке").Заполнено();
	Ожидаем.Что(Длительность, "сервер не ждёт закрытия веб-сокета").Меньше(ДопустимаяДлительностьОстановки);
	Ожидаем.Что(Закрыто, "сервер закрыл соединение клиента").ЭтоИстина();

КонецПроцедуры

// Остановка сервера закрывает соединения Server-Sent Events. Обработчик запроса нативного
// сервера держит такое соединение открытым, и Kestrel без этого ждал бы его завершения.
//
// Параметры:
//  Прикладной             - Булево - Истина для прикладного сервера, Ложь для нативного.
//  ПортОтдельногоСервера  - Число - Порт сервера, который поднимается только для этого теста.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина, 3336)
&ИсточникЗначение(Ложь, 3335)
Процедура Должен_ОстановитьСерверСОткрытымСоединениемСерверныхСобытий(Прикладной, ПортОтдельногоСервера) Экспорт

	// Дано
	КонтекстСервера = ПоднятьСервер(Прикладной, ПортОтдельногоСервера);
	ВебСервер = КонтекстСервера.Поделка.НайтиЖелудь("ВебСервер");
	КонтролССЕ = КонтекстСервера.Поделка.НайтиЖелудь("КонтролССЕ");
	ДопустимаяДлительностьОстановки = 5000;

	// сервер поднят только для этого теста, поэтому и при падении его останавливает сам тест
	Попытка
		Клиент = Новый ССЕКлиент("localhost", КонтекстСервера.Порт, "/sse/test1");
		// обработчик подключения вызывается после того, как соединение попало в пул
		Подключившийся = ДождатьсяЭлемента(КонтролССЕ.ИдПодключений);
	Исключение
		ОстановитьСервер(КонтекстСервера);
		ВызватьИсключение;
	КонецПопытки;

	// Когда
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВебСервер.Стоп();
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Закрыто = ДождатьсяЗакрытияСерверомССЕ(Клиент);
	Клиент.Остановить();

	// Тогда
	Ожидаем.Что(Подключившийся, "соединение было открыто при остановке").Заполнено();
	Ожидаем.Что(Длительность, "сервер не ждёт закрытия соединения").Меньше(ДопустимаяДлительностьОстановки);
	Ожидаем.Что(Закрыто, "сервер закрыл соединение клиента").ЭтоИстина();

КонецПроцедуры

// На незарегистрированный топик сервер отвечает 404, а не открывает соединение.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ОтказатьВСервернымСобытиямНаНезарегистрированныйТопик(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Когда
	Попытка
		Клиент = Новый ССЕКлиент("localhost", Порт, "/sse/unknown");
		Клиент.Остановить();
		ТекстОшибки = "";
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки, "ответ на подключение").Содержит("404");

КонецПроцедуры

// Обработчики подключения к серверным событиям вызываются в фоновых заданиях,
// поэтому массив, который они заполняют, ещё может быть неполным.
//
// Параметры:
//  Массив     - Массив - Массив, который заполняет сервер.
//  Количество - Число - Сколько элементов ждать.
//
Процедура ДождатьсяКоличества(Массив, Количество)

	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПределОжиданияСервера;

	Пока Массив.Количество() < Количество И ТекущаяУниверсальнаяДатаВМиллисекундах() < КрайнийСрок Цикл
		Приостановить(ШагОжиданияСервера);
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Клиент - ССЕКлиент - Подключённый клиент.
//
// Возвращаемое значение:
//  Булево - Истина, если сервер закрыл соединение клиента до истечения ожидания.
//
Функция ДождатьсяЗакрытияСерверомССЕ(Клиент)

	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПределОжиданияСервера;

	Закрыто = Клиент.ЗакрытоСервером();
	Пока НЕ Закрыто И ТекущаяУниверсальнаяДатаВМиллисекундах() < КрайнийСрок Цикл
		Приостановить(ШагОжиданияСервера);
		Закрыто = Клиент.ЗакрытоСервером();
	КонецЦикла;

	Возврат Закрыто;

КонецФункции

// Ждёт, пока сервер из своего потока добавит элемент в массив.
//
// Параметры:
//  Массив   - Массив - Массив, который заполняет сервер.
//  Значение - Произвольный - Ожидаемый элемент; Неопределено - любой.
//
// Возвращаемое значение:
//  Произвольный - Найденный элемент, Неопределено - если не дождались.
//
Функция ДождатьсяЭлемента(Массив, Значение = Неопределено)

	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПределОжиданияСервера;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < КрайнийСрок Цикл

		Найденный = НайденныйЭлемент(Массив, Значение);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;

		Приостановить(ШагОжиданияСервера);

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Параметры:
//  Массив   - Массив - Где искать.
//  Значение - Произвольный - Искомый элемент; Неопределено - любой.
//
// Возвращаемое значение:
//  Произвольный - Найденный элемент, Неопределено - если его нет.
//
Функция НайденныйЭлемент(Массив, Значение)

	Если Значение <> Неопределено Тогда
		Возврат ?(Массив.Найти(Значение) = Неопределено, Неопределено, Значение);
	ИначеЕсли Массив.Количество() > 0 Тогда
		Возврат Массив[0];
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// &Тест
Процедура Должен_ПроверитьВебСокета() Экспорт

	// Дано
	Клиент = Новый TCPСоединение("localhost", Порт);
	// Клиент.ТаймаутЧтения = 1000;

	Запрос1 = Новый ДвоичныеДанные("tests/features/server1");
	Запрос2 = Новый ДвоичныеДанные("tests/features/server2");

	// Результат1 = Новый ДвоичныеДанные("tests/features/client1");
	Результат2 = Новый ДвоичныеДанные("tests/features/client2");

	// Когда
	Клиент.ОтправитьДвоичныеДанные(Запрос1);
	Ответ1 = Клиент.ПрочитатьСтроку();

	Приостановить(100);

	Клиент.ОтправитьДвоичныеДанные(Запрос2);
	Ответ2 = Клиент.ПрочитатьДвоичныеДанные();

	// Тогда

	Ожидаем.Что(Клиент.Активно, "Соединение активно").Равно(Истина);
	Ожидаем.Что(Ответ1, "ответ содержит хендшейк").Содержит("Sec-WebSocket-Accept: LEHPu4/qNukG+0hW+UjpnJTeoc8=");
	Ожидаем.Что(Ответ1, "ответ содержит код 101").Содержит("HTTP/1.1 101");
	Ожидаем.Что(Ответ2, "Ответ веб сокета корректный").Равно(Результат2);
	
КонецПроцедуры


Процедура Должен_ПроверитьРаспаковкуСообщенийВебСокета() Экспорт
	// Дано
	Шифровальщик = Новый ШифрованиеВебСокета();

	Каталог = ТекущийСценарий().Каталог;
	
	Запрос2 = Новый ДвоичныеДанные(ОбъединитьПути(Каталог, "features/server2"));

	// Когда
	Сообщение = Шифровальщик.РаспаковатьСообщение(Запрос2);

	// Тогда
	Ожидаем.Что(Сообщение, "Распаковка удачно").Равно("hello");

КонецПроцедуры


Процедура Должен_ПроверитьУпаковкуСообщенийВебСокета() Экспорт
	// Дано
	Шифровальщик = Новый ШифрованиеВебСокета();

	Каталог = ТекущийСценарий().Каталог;
	
	УпакованноеСообщение = Новый ДвоичныеДанные(ОбъединитьПути(Каталог, "features/client2"));

	// Когда
	Сообщение = Шифровальщик.ЗапаковатьСообщениеТекстовоеСообщение("hello 1");

	// Тогда
	Ожидаем.Что(Сообщение, "Упаковка удачно").Равно(УпакованноеСообщение);

КонецПроцедуры

// Пул заполняется через Добавить, а не напрямую: его устройство - внутреннее дело
// СоединенияВебСокетов. Подписка нативного сервера при подписке только запоминает
// соединение, поэтому вместо соединений годятся уникальные значения, а пул один
// для обоих серверов.
&Тест
Процедура Должен_ПолучитьСоединенияСОтборами() Экспорт

	ВключитьСервер(Ложь);

	// Дано
	СоединенияВебСокетов = Поделка.НайтиЖелудь("СоединенияВебСокетов");
	Топик = "/socket/filter/1";
	ДругойТопик = "/socket/filter/2";
	Первая = Новый СессияПользователя();
	Вторая = Новый СессияПользователя();
	Третья = Новый СессияПользователя();

	Соединения = Новый Массив();
	Соединения.Добавить(ДобавитьСоединениеВебСокета(СоединенияВебСокетов, Топик, Первая));
	Соединения.Добавить(ДобавитьСоединениеВебСокета(СоединенияВебСокетов, Топик, Вторая));
	Соединения.Добавить(ДобавитьСоединениеВебСокета(СоединенияВебСокетов, Топик, Третья));
	Соединения.Добавить(ДобавитьСоединениеВебСокета(СоединенияВебСокетов, ДругойТопик, Первая));

	СписокИдентификаторов = Новый Массив();
	СписокИдентификаторов.Добавить(Первая.Идентификатор());
	СписокИдентификаторов.Добавить(Вторая.Идентификатор());

	// Когда
	ВсеСоединения = СоединенияВебСокетов.ПолучитьСоединенияПоТопику(Топик);
	СоединенияПоСписку = СоединенияВебСокетов.ПолучитьСоединенияПоТопикуСпискуИдентификаторов(Топик,
		СписокИдентификаторов);
	СоединенияКроме = СоединенияВебСокетов.ПолучитьСоединенияПоТопикуКромеСпискаИдентификаторов(Топик,
		СписокИдентификаторов);
	СоединениеПоИдентификатору = СоединенияВебСокетов.ПолучитьСоединениеПоИдентификатору(Топик,
		Первая.Идентификатор());
	СоединениеНеопределено = СоединенияВебСокетов.ПолучитьСоединениеПоИдентификатору(Топик, "9");

	Для Каждого Соединение Из Соединения Цикл
		СоединенияВебСокетов.УдалитьСоединение(Соединение);
	КонецЦикла;

	// Тогда
	Ожидаем.Что(ВсеСоединения.Количество(), "Все соединения").Равно(3);
	Ожидаем.Что(СоединенияПоСписку.Количество(), "Соединения по списку").Равно(2);
	Ожидаем.Что(СоединенияКроме.Количество(), "Соединения кроме").Равно(1);
	Ожидаем.Что(СоединениеПоИдентификатору.Идентификатор, "Конкретное соединение").Равно(Первая.Идентификатор());
	Ожидаем.Что(СоединениеНеопределено, "пустое соединение").Равно(Неопределено);
	Ожидаем.Что(СоединенияВебСокетов.ПолучитьСоединенияПоТопику(Топик).Количество(), "пул после удаления").Равно(0);

КонецПроцедуры

// Отборы пула Server-Sent Events, по которым брокер выбирает получателей рассылки.
// Вместо соединений - заглушки: пул только закрывает их и сравнивает по ссылке,
// а контроль соединений шлёт им ping.
&Тест
Процедура Должен_ПолучитьСоединенияСерверныхСобытийСОтборами() Экспорт

	ВключитьСервер(Ложь);

	// Дано
	СоединенияСерверныхСобытий = Поделка.НайтиЖелудь("СоединенияСерверныхСобытий");
	Топик = "/sse/filter/1";
	ДругойТопик = "/sse/filter/2";
	Первый = "первый";
	Клиенты = Новый Массив();
	Клиенты.Добавить(Первый);
	Клиенты.Добавить("второй");
	Клиенты.Добавить("третий");
	ВсегоВТопике = Клиенты.Количество();

	Для Каждого Клиент Из Клиенты Цикл
		СоединенияСерверныхСобытий.Добавить(Новый ЗаглушкаСоединенияСерверныхСобытий(), Клиент, Топик);
	КонецЦикла;
	СоединенияСерверныхСобытий.Добавить(Новый ЗаглушкаСоединенияСерверныхСобытий(), Первый, ДругойТопик);
	// контроль соединений работает в фоне: его проверка может прийтись на середину теста
	Поделка.НайтиЖелудь("КонтрольСоединенийСерверныхСобытий").НайтиИУдалитьСоединения();

	Соединения = СоединенияСерверныхСобытий.ПолучитьСоединенияПоТопику(Топик);
	СписокИдентификаторов = Новый Массив();
	СписокИдентификаторов.Добавить(Соединения[0].ИдСоединения);
	СписокИдентификаторов.Добавить(Соединения[1].ИдСоединения);

	// Когда
	СоединенияПоСписку = СоединенияСерверныхСобытий.ПолучитьСоединенияПоТопикуСпискуИдентификаторов(Топик,
		СписокИдентификаторов);
	СоединенияКроме = СоединенияСерверныхСобытий.ПолучитьСоединенияПоТопикуКромеСпискаИдентификаторов(Топик,
		СписокИдентификаторов);
	СоединенияКлиента = СоединенияСерверныхСобытий.ПолучитьСоединениеПоИдентификатору(Топик, Первый);

	СоединенияСерверныхСобытий.Удалить(Первый, Топик);
	ОсталосьПослеУдаления = СоединенияСерверныхСобытий.Количество(Топик);
	ДругойТопикПослеУдаления = СоединенияСерверныхСобытий.Количество(ДругойТопик);

	Для Каждого Клиент Из Клиенты Цикл
		СоединенияСерверныхСобытий.Удалить(Клиент, Топик);
	КонецЦикла;
	СоединенияСерверныхСобытий.Удалить(Первый, ДругойТопик);

	// Тогда
	Ожидаем.Что(Соединения.Количество(), "все соединения топика").Равно(ВсегоВТопике);
	Ожидаем.Что(СоединенияПоСписку.Количество(), "соединения по списку").Равно(СписокИдентификаторов.Количество());
	Ожидаем.Что(СоединенияКроме.Количество(), "соединения кроме списка").Равно(1);
	Ожидаем.Что(СоединенияКлиента.Количество(), "соединения клиента в топике").Равно(1);
	Ожидаем.Что(ОсталосьПослеУдаления, "соединения топика после удаления клиента").Равно(ВсегоВТопике - 1);
	Ожидаем.Что(ДругойТопикПослеУдаления, "соединения клиента в другом топике").Равно(1);
	Ожидаем.Что(СоединенияСерверныхСобытий.Количество(Топик), "пул после удаления").Равно(0);

КонецПроцедуры

// Параметры:
//  СоединенияВебСокетов - СоединенияВебСокетов - Пул соединений.
//  Топик                - Строка - Топик соединения.
//  Сессия               - СессияПользователя - Сессия клиента.
//
// Возвращаемое значение:
//  УникальныйИдентификатор - Значение, добавленное в пул вместо соединения.
//
Функция ДобавитьСоединениеВебСокета(СоединенияВебСокетов, Топик, Сессия)

	Запрос = Поделка.НайтиЖелудь("ВходящийЗапрос");
	Запрос.Путь = Топик;
	Запрос.Сессия = Сессия;

	Соединение = Новый УникальныйИдентификатор();
	СоединенияВебСокетов.Добавить(Соединение, Запрос);

	Возврат Соединение;

КонецФункции

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьШаблонныеУРЛЫИзКорневогоКонтрола(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано

	Соединение = Новый HTTPСоединение("http://localhost",Порт,,,,5);
	Запрос = Новый HTTPЗапрос("/api/некоторыйпараметр");

	Ответ = Соединение.Получить(Запрос);

	// Когда
	Ответ = Соединение.Получить(Запрос);

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку()).Равно("некоторыйпараметр");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ССЕКлиентПодключился(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	КонтролССЕ = Поделка.НайтиЖелудь("КонтролССЕ");
	КонтролССЕ.ИнициализироватьСостояния();
	ССЕКлиент = Новый ССЕКлиент("localhost", Порт, "/sse/test1");

	// Кода

	// Тогда

	Ожидаем.Что(ССЕКлиент.ПервичныйОтвет()).Содержит("200");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ССЕОтправитьВсем(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	КонтролССЕ = Поделка.НайтиЖелудь("КонтролССЕ");
	КонтролССЕ.ИнициализироватьСостояния();
	ССЕКлиент1 = Новый ССЕКлиент("localhost", Порт, "/sse/test1");
	ССЕКлиент2 = Новый ССЕКлиент("localhost", Порт, "/sse/test1");

	ТекстСообщения = "Привет";

	// Когда
	ПроизвольныйГетЗапрос("/sse/sendall/" + ТекстСообщения);

	Приостановить(1000);

	Сообщения1 = ССЕКлиент1.Сообщения();
	Сообщения2 = ССЕКлиент2.Сообщения();

	// Тогда
	Ожидаем.Что(Сообщения1.Количество(), "Сообщения1").Равно(1);
	Ожидаем.Что(Сообщения2.Количество(), "Сообщения2").Равно(1);

	Ожидаем.Что(Сообщения1[0], "Сообщение1").Равно("data: " + ТекстСообщения);
	Ожидаем.Что(Сообщения2[0], "Сообщение2").Равно("data: " + ТекстСообщения);

КонецПроцедуры

// Ошибка отправки одному клиенту не обрывает рассылку остальным.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ОтправитьСерверноеСобытиеОстальнымПриОшибкеОтправкиОдному(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	СоединенияСерверныхСобытий = Поделка.НайтиЖелудь("СоединенияСерверныхСобытий");
	// сломанное соединение в пуле раньше клиента, поэтому рассылка сначала падает на нём
	Сломанное = Новый ЗаглушкаСоединенияСерверныхСобытий(Истина);
	СоединенияСерверныхСобытий.Добавить(Сломанное, "сломанный", "/sse/test1");
	Клиент = Новый ССЕКлиент("localhost", Порт, "/sse/test1");
	// фоновая проверка контроля соединений не должна убрать сломанное до рассылки
	Поделка.НайтиЖелудь("КонтрольСоединенийСерверныхСобытий").НайтиИУдалитьСоединения();

	// Когда
	ПроизвольныйГетЗапрос("/sse/sendall/Привет");
	ДождатьсяКоличества(Клиент.Сообщения(), 1);
	Клиент.Остановить();
	СоединенияСерверныхСобытий.УдалитьСоединение(Сломанное);

	// Тогда
	Ожидаем.Что(Сломанное.ОшибокОтправки(), "ошибки отправки сломанному").Равно(1);
	Ожидаем.Что(Клиент.Сообщения(), "сообщения клиента").Содержит("data: Привет");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ССЕОтправитьВсемКастомныйТип(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	КонтролССЕ = Поделка.НайтиЖелудь("КонтролССЕ");
	КонтролССЕ.ИнициализироватьСостояния();
	ССЕКлиент1 = Новый ССЕКлиент("localhost", Порт, "/sse/test1");

	ТекстСообщения = "Привет";

	// Когда
	ПроизвольныйГетЗапрос("/sse/sendalltype/" + ТекстСообщения);

	Приостановить(1000);

	Сообщения1 = ССЕКлиент1.Сообщения();

	// Тогда
	Ожидаем.Что(Сообщения1.Количество(), "Сообщения1").Равно(1);

	Ожидаем.Что(Сообщения1[0], "Сообщение1").Равно("event: evnt" + Символы.ПС + "data: " + ТекстСообщения);

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ССЕОтправитьТолько(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	КонтролССЕ = Поделка.НайтиЖелудь("КонтролССЕ");
	КонтролССЕ.ИнициализироватьСостояния();
	ССЕКлиент1 = Новый ССЕКлиент("localhost", Порт, "/sse/test1");
	// обработчики подключения идут в фоновых заданиях: второй клиент подключается,
	// когда первый уже записан, иначе ИдПодключений[0] мог бы оказаться вторым
	ДождатьсяКоличества(КонтролССЕ.ИдПодключений, 1);
	ССЕКлиент2 = Новый ССЕКлиент("localhost", Порт, "/sse/test1");
	КоличествоКлиентов = 2;
	ДождатьсяКоличества(КонтролССЕ.ИдПодключений, КоличествоКлиентов);

	// Когда
	ПроизвольныйГетЗапрос("/sse/sendbyid/" + КонтролССЕ.ИдПодключений[0]);

	Приостановить(1000);

	Сообщения1 = ССЕКлиент1.Сообщения();
	Сообщения2 = ССЕКлиент2.Сообщения();

	// Тогда
	Ожидаем.Что(КонтролССЕ.ИдПодключений.Количество(), "Количество соединений").Равно(2);
	Ожидаем.Что(Сообщения1.Количество(), "Сообщения1").Равно(1);
	Ожидаем.Что(Сообщения2.Количество(), "Сообщения2").Равно(0);

	Ожидаем.Что(Сообщения1[0], "Сообщение1").Равно("data: привет");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ССЕОтправитьКроме(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	КонтролССЕ = Поделка.НайтиЖелудь("КонтролССЕ");
	КонтролССЕ.ИнициализироватьСостояния();
	ССЕКлиент1 = Новый ССЕКлиент("localhost", Порт, "/sse/test1");
	// см. ССЕОтправитьТолько: ИдПодключений[0] должен быть первым клиентом
	ДождатьсяКоличества(КонтролССЕ.ИдПодключений, 1);
	ССЕКлиент2 = Новый ССЕКлиент("localhost", Порт, "/sse/test1");
	ССЕКлиент3 = Новый ССЕКлиент("localhost", Порт, "/sse/test1");
	КоличествоКлиентов = 3;
	ДождатьсяКоличества(КонтролССЕ.ИдПодключений, КоличествоКлиентов);

	// Когда
	ПроизвольныйГетЗапрос("/sse/sendbut/" + КонтролССЕ.ИдПодключений[0]);

	Приостановить(1000);

	Сообщения1 = ССЕКлиент1.Сообщения();
	Сообщения2 = ССЕКлиент2.Сообщения();
	Сообщения3 = ССЕКлиент3.Сообщения();

	// Тогда
	Ожидаем.Что(КонтролССЕ.ИдПодключений.Количество(), "Количество соединений").Равно(3);
	Ожидаем.Что(Сообщения1.Количество(), "Сообщения1").Равно(0);
	Ожидаем.Что(Сообщения2.Количество(), "Сообщения2").Равно(1);
	Ожидаем.Что(Сообщения3.Количество(), "Сообщения3").Равно(1);

	Ожидаем.Что(Сообщения2[0], "Сообщение2").Равно("data: привет");
	Ожидаем.Что(Сообщения3[0], "Сообщение3").Равно("data: привет");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ССЕПодпискаНаЗакрытие(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	КонтролССЕ = Поделка.НайтиЖелудь("КонтролССЕ");
	КонтролССЕ.ИнициализироватьСостояния();
	ССЕКлиент1 = Новый ССЕКлиент("localhost", Порт, "/sse/testsub");
	ССЕКлиент2 = Новый ССЕКлиент("localhost", Порт, "/sse/testsub");
	ССЕКлиент3 = Новый ССЕКлиент("localhost", Порт, "/sse/testsub");

	// Когда

	ССЕКлиент1.Остановить();
	
	Приостановить(20000);

	// Тогда

#Использовать autumn
#Использовать ".."
#Использовать "поддержка"
#Использовать asserts

// Тесты выполняются для обеих реализаций веб-сервера winow.
// Обе поднимаются один раз на разных портах и живут до конца прогона,
// поэтому переключение реализации между тестами не требует перезапуска.
Перем КонтекстПрикладной;
Перем КонтекстНативный;

// Поделка и порт реализации, выбранной для текущего теста.
Перем Поделка;
Перем Порт;

// Число - сколько миллисекунд ждать готовности сервера.
Перем ПределОжиданияСервера;

// Число - с каким шагом в миллисекундах опрашивать сервер.
Перем ШагОжиданияСервера;

// Число - таймаут соединения при опросе готовности, секунды.
Перем ТаймаутОпросаСервера;

// Число - код состояния успешного ответа.
Перем КодУспешногоОтвета;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	ПределОжиданияСервера = 15000;
	ШагОжиданияСервера = 50;
	ТаймаутОпросаСервера = 5;
	КодУспешногоОтвета = 200;
КонецПроцедуры

&ПослеВсех
Процедура ОстановитьСерверы() Экспорт
	ОстановитьСервер(КонтекстПрикладной);
	ОстановитьСервер(КонтекстНативный);
КонецПроцедуры

// Выбирает реализацию веб-сервера для текущего теста,
// поднимая её при первом обращении.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
Процедура ВключитьСервер(Прикладной)

	Если Прикладной Тогда
		Если КонтекстПрикладной = Неопределено Тогда
			КонтекстПрикладной = ПоднятьСервер(Истина, 3333);
		КонецЕсли;
		Контекст = КонтекстПрикладной;
	Иначе
		Если КонтекстНативный = Неопределено Тогда
			КонтекстНативный = ПоднятьСервер(Ложь, 3334);
		КонецЕсли;
		Контекст = КонтекстНативный;
	КонецЕсли;

	Поделка = Контекст.Поделка;
	Порт = Контекст.Порт;

КонецПроцедуры

Функция ПоднятьСервер(Прикладной, НомерПорта)

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("winow.ИспользоватьПрикладнойСервер", Прикладной);
	ЗначенияДеталек.Вставить("winow.Порт", НомерПорта);

	Совет = Новый СоветДругогоМастера();
	Совет.ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(ЗначенияДеталек, 3, "inline");

	НоваяПоделка = Новый Поделка(Совет);
	НоваяПоделка.ЗапуститьПриложение();

	ВебСервер = НоваяПоделка.НайтиЖелудь("ВебСервер");
	ФоновыеЗадания.Выполнить(ВебСервер, "Старт");
	ДождатьсяГотовностиСервера(НомерПорта);

	Настройки = НоваяПоделка.НайтиЖелудь("Настройки");
	Настройки.ЗадержкаПередЧтениемСокета = 400;
	Настройки.ЗадержкаПередЗакрытиемСокета = 300;
	Настройки.ИнтервалПроверкиСоединенийСерверныхСобытий = 100;
	Настройки.ТаймаутОжиданияФайла = 500;

	Возврат Новый Структура("Поделка, Порт", НоваяПоделка, НомерПорта);

КонецФункции

// Ждёт, пока сервер начнёт отвечать на запросы.
//
// Маршруты к этому моменту уже зарегистрированы: ЗапуститьПриложение отрабатывает
// рогатки и возвращает управление до того, как поднимется слушатель. Ждать нужно
// только сам сокет - Старт уходит в фоновое задание, и когда оно доберётся до
// приёма соединений, заранее неизвестно.
//
// Фиксированная пауза тут была бы гаданием: на нагруженной машине мало, на
// свободной - потраченное впустую время. Поэтому опрашиваем готовность.
//
// Параметры:
//   НомерПорта - Число - порт, на котором поднимается сервер.
Процедура ДождатьсяГотовностиСервера(НомерПорта)

	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПределОжиданияСервера;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < КрайнийСрок Цикл

		Если СерверОтвечает(НомерПорта) Тогда
			Возврат;
		КонецЕсли;

		Приостановить(ШагОжиданияСервера);

	КонецЦикла;

	ВызватьИсключение СтрШаблон("Сервер на порту %1 не ответил за %2 мс",
		НомерПорта, ПределОжиданияСервера);

КонецПроцедуры

Функция СерверОтвечает(НомерПорта)

	Попытка
		Соединение = Новый HTTPСоединение("http://localhost", НомерПорта, , , , ТаймаутОпросаСервера);
		Возврат Соединение.Получить(Новый HTTPЗапрос("/tests/checkup")).КодСостояния = КодУспешногоОтвета;
	Исключение
		// Порт ещё не слушают - соединение не устанавливается.
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Процедура ОстановитьСервер(Контекст)

	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Контекст.Поделка.НайтиЖелудь("ВебСервер").Стоп();
	Исключение
		// Сервер уже остановлен - ронять из-за этого прогон незачем.
	КонецПопытки;

КонецПроцедуры

Функция ГетЗапрос(АдресТеста, Заголовки = Неопределено)
	Соединение = Новый HTTPСоединение("http://localhost",Порт,,,,5);
	Запрос = Новый HTTPЗапрос(СтрШаблон("/tests/%1", АдресТеста));
	Если Не Заголовки = Неопределено Тогда
		Запрос.Заголовки = Заголовки;
	КонецЕсли;
	Ответ = Соединение.Получить(Запрос);
	Возврат Ответ;
КонецФункции

Функция ПроизвольныйГетЗапрос(АдресТеста, Заголовки = Неопределено)
	Соединение = Новый HTTPСоединение("http://localhost",Порт,,,,5);
	Запрос = Новый HTTPЗапрос(АдресТеста);
	Если Не Заголовки = Неопределено Тогда
		Запрос.Заголовки = Заголовки;
	КонецЕсли;
	Ответ = Соединение.Получить(Запрос);
	Возврат Ответ;
КонецФункции

Функция ПостЗапросТелоИзСтроки(АдресТеста, ТелоЗапроса, Заголовки = Неопределено)
	Соединение = Новый HTTPСоединение("http://localhost",Порт,,,,5);
	Запрос = Новый HTTPЗапрос(СтрШаблон("/tests/%1", АдресТеста));
	Если Не Заголовки = Неопределено Тогда
		Запрос.Заголовки = Заголовки;
	КонецЕсли;
	Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Возврат Ответ;
КонецФункции

Функция ПостЗапросТелоИзДвоичныхДанных(АдресТеста, ТелоЗапроса)
	Соединение = Новый HTTPСоединение("http://localhost",Порт,,,,5);
	Запрос = Новый HTTPЗапрос(СтрШаблон("/tests/%1", АдресТеста));
	Запрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
	Возврат Соединение.ОтправитьДляОбработки(Запрос);
КонецФункции

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьЗапускСервере(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	АдресТеста = "checkup";

	// Когда
	Ответ = ГетЗапрос(АдресТеста);

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьОбработкуГетПараметров(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	АдресТеста = "getparams?animal1=Кошка&animal2=Собака";

	// Когда
	Ответ = ГетЗапрос(АдресТеста);

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку()).Равно("Кошка И Собака");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьОбработкуЗакодированныхРазделителейВГетПараметрах(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	АдресТеста = "getparams?animal1=Кошка&animal2=Собака%26Хомяк";

	// Когда
	Ответ = ГетЗапрос(АдресТеста);

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку()).Равно("Кошка И Собака&Хомяк");

КонецПроцедуры

// Реализации сервера обязаны разбирать адрес одинаково: прикладной разбирает сырой
// HTTP-текст сам, нативному путь отдаёт уже разобранным Kestrel, и разойтись они
// могут незаметно - достаточно поправить декодирование только у одной из них.
// Поэтому сверяется вся батарея адресов целиком, а не один известный случай.
&Тест
Процедура Должен_ПроверитьЧтоСерверыРазбираютАдресОдинаково() Экспорт

	// Дано
	Адреса = АдресаДляСверкиРазбора();

	// Когда
	ВключитьСервер(Истина);
	РазборПрикладного = РазборАдресов(Адреса);

	ВключитьСервер(Ложь);
	РазборНативного = РазборАдресов(Адреса);

	// Тогда
	Ожидаем.Что(РазборНативного, "разбор адресов нативным сервером").Равно(РазборПрикладного);

КонецПроцедуры

Функция АдресаДляСверкиРазбора()

	Адреса = Новый Массив;
	Адреса.Добавить("echourl/a%2Fb");         // закодированная косая черта
	Адреса.Добавить("echourl/a%2fb");         // и она же в нижнем регистре
	Адреса.Добавить("echourl/dbl%2520enc");   // декодирование ровно один раз
	Адреса.Добавить("echourl/a%20b");
	Адреса.Добавить("echourl/a+b");           // плюс в пути - обычный символ
	Адреса.Добавить("echourl/a.b~c");
	Адреса.Добавить("echourl/%D0%B0%D0%B1");  // кириллица
	Адреса.Добавить("echourl/%d0%b0%d0%b1");  // и она же в нижнем регистре
	Адреса.Добавить("echourl/раз?x=a%2Bb");   // строка параметров не декодируется
	Адреса.Добавить("echourl/раз?");          // пустая строка параметров
	Адреса.Добавить("echourl/раз?x=1&x=2");   // повторяющийся ключ

	Возврат Адреса;

КонецФункции

Функция РазборАдресов(Адреса)

	Разбор = Новый Массив;

	Для Каждого Адрес Из Адреса Цикл
		Ответ = ГетЗапрос(Адрес);
		Ожидаем.Что(Ответ.КодСостояния, "код состояния для " + Адрес).Равно(200);
		Разбор.Добавить(Адрес + " => " + Ответ.ПолучитьТелоКакСтроку());
	КонецЦикла;

	Возврат СтрСоединить(Разбор, Символы.ПС);

КонецФункции

// Закодированная косая черта - символ внутри сегмента, а не разделитель сегментов.
// Раскодируй её заранее - и маршрутизация увидит лишний сегмент, а отдача файлов
// получит протащенный разделитель пути.
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьЧтоЗакодированнаяКосаяЧертаНеРазделительСегментов(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Когда
	Ответ = ГетЗапрос("echourl/a%2Fb");

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Части = СтрРазделить(Ответ.ПолучитьТелоКакСтроку(), "|");
	Ожидаем.Что(Части[0], "путь запроса").Равно("/tests/echourl/a%2Fb");
	Ожидаем.Что(Части[2], "сегмент маршрута").Равно("a%2Fb");

КонецПроцедуры

// Путь декодируется ровно один раз, иначе %2520 схлопывается в пробел вместо %20.
// Прикладной сервер разбирает сырой HTTP-текст сам, нативному путь отдаёт Kestrel
// уже декодированным - обе реализации должны прийти к одному результату.
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьЧтоПутьДекодируетсяОдинРаз(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Когда
	Ответ = ГетЗапрос("echourl/dbl%2520enc");

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Части = СтрРазделить(Ответ.ПолучитьТелоКакСтроку(), "|");
	Ожидаем.Что(Части[0], "путь запроса").Равно("/tests/echourl/dbl%20enc");

КонецПроцедуры

// Строка параметров в полном пути остаётся такой, какой пришла: по HTTP semantic
// conventions url.query отдаётся в исходном виде, иначе %2B становится неотличим
// от литерального плюса.
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьЧтоСтрокаПараметровНеДекодируется(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Когда
	Ответ = ГетЗапрос("echourl/раз?x=a%2Bb");

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Части = СтрРазделить(Ответ.ПолучитьТелоКакСтроку(), "|");
	Ожидаем.Что(Части[1], "полный путь").Равно("/tests/echourl/раз?x=a%2Bb");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьОбработкуУпорядоченныхГетПараметров(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	АдресТеста = "getorderedparams/Кошка/Собака";

	// Когда
	Ответ = ГетЗапрос(АдресТеста);

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку()).Равно("Кошка И Собака");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьОбработкуПостЗапроса(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	АдресТеста = "postparams";
	ТелоЗапроса = "animal1=Кошка&animal2=Собака";

	// Когда
	Ответ = ПостЗапросТелоИзСтроки(АдресТеста, ТелоЗапроса);

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку()).Равно("Кошка И Собака");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьРаботуКук(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	ЗначениеКуки = Строка(Новый УникальныйИдентификатор());
	ДатаИстечения = МестноеВремя('19700101235959');
	АдресТеста = СтрШаблон("setcookie?pechenka=%1&expires=%2", ЗначениеКуки, XMLСтрока(ДатаИстечения));

	// Когда
	Ответ = ГетЗапрос(АдресТеста);
	ТекстКук = Ответ.Заголовки.Получить("Set-Cookie");


	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(ТекстКук).Содержит(ЗначениеКуки);
	Ожидаем.Что(ТекстКук).Содержит("Thu, 01 Jan 1970 23:59:59 GMT");

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьРаботуСессий(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	Значение = Строка(Новый УникальныйИдентификатор());
	АдресУстановки = СтрШаблон("setsessiondata?userdata=%1", Значение);
	АдресПолучения = "readsessiondata";

	// Когда
	ОтветУстановки = ГетЗапрос(АдресУстановки);
	ТекстКук = ОтветУстановки.Заголовки.Получить("Set-Cookie");
	МеткаСессии = "SessionID=";
	НачалоИдСессии = СтрНайти(ТекстКук,МеткаСессии);
	КонецИдСесии = СтрНайти(ТекстКук,";",,НачалоИдСессии);
	ИдСессии = СтрЗаменить(Сред(ТекстКук, НачалоИдСессии, КонецИдСесии - НачалоИдСессии), МеткаСессии, "");

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "SessionID=" + ИдСессии);
	ОтветПолучения = ГетЗапрос(АдресПолучения, Заголовки);

	// Тогда
	Ожидаем.Что(ОтветУстановки.КодСостояния).Равно(200);
	Ожидаем.Что(ОтветПолучения.КодСостояния).Равно(200);

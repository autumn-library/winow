	Ожидаем.Что(Ответ.ТелоПоток, "в ответе его больше нет").Равно(Неопределено);

КонецПроцедуры

Функция ПотокЗакрыт(Поток)
	Попытка
		Поток.Размер();
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция ДлинаКонтента(Ответ)
	Для Каждого Заголовок Из Ответ.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = "content-length" Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПринятьФайлПотоком(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	Тело = ПолучитьДвоичныеДанныеИзСтроки(Поделка.НайтиЖелудь("КонтролТестирования").ТестовоеТелоБольшогоФайла());
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Тело);
	Ожидаемое = СтрШаблон("%1 %2", Формат(Тело.Размер(), "ЧГ=0"), Хеширование.ХешСуммаСтрокой);

	// Когда
	Ответ = ПостЗапросТелоИзДвоичныхДанных("streamupload", Тело);

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку()).Равно(Ожидаемое);

КонецПроцедуры

&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПроверитьОграничениеДоступа(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	АдресТеста = "user";
	Логипас = "Пользователь:111";
	Заголовки = Новый Соответствие();
	ХешЛогипасов = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Логипас));
	Заголовки.Вставить("Authorization", "Basic " + ХешЛогипасов);

	ЗаголовкиНеКорректные = Новый Соответствие();
	ХешЛогипасовНеКорректные = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Логипас+"1"));
	ЗаголовкиНеКорректные.Вставить("Authorization", "Basic " + ХешЛогипасовНеКорректные);


	// Когда
	ОтветЗапросАвторизации = ГетЗапрос(АдресТеста);
	ОтветАвторизован = ГетЗапрос(АдресТеста, Заголовки);
	ОтветНеАвторизован = ГетЗапрос(АдресТеста, ЗаголовкиНеКорректные);

	// Тогда
	Ожидаем.Что(ОтветЗапросАвторизации.КодСостояния).Равно(401);
	Ожидаем.Что(ОтветАвторизован.КодСостояния).Равно(200);
	Ожидаем.Что(ОтветНеАвторизован.КодСостояния).Равно(401);

КонецПроцедуры

// Вошедший без нужной роли получает 403, а не повторный запрос авторизации.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ЗапретитьТочкуМаршрутаБезРоли(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	КодЗапрещено = 403;
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Authorization", "Basic " + Base64Строка(ПолучитьДвоичныеДанныеИзСтроки("Гость:222")));

	// Когда
	Ответ = ГетЗапрос("user", Заголовки);

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния).Равно(КодЗапрещено);

КонецПроцедуры

// После входа по токену логин хранится в сессии: следующий запрос с кукой сессии
// проходит без заголовка авторизации.
//
// Параметры:
//  Прикладной - Булево - Истина для прикладного сервера, Ложь для нативного.
//
&ПараметризованныйТест(Имя = "прикладной={Параметры}")
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура Должен_ПомнитьВходВСессии(Прикладной) Экспорт

	ВключитьСервер(Прикладной);

	// Дано
	Авторизация = Новый Соответствие();
	Авторизация.Вставить("Authorization", "Basic " + Base64Строка(ПолучитьДвоичныеДанныеИзСтроки("Пользователь:111")));
	ОтветВхода = ГетЗапрос("user", Авторизация);

	ТекстКук = ОтветВхода.Заголовки.Получить("Set-Cookie");
	МеткаСессии = "SessionID=";
	НачалоИдСессии = СтрНайти(ТекстКук, МеткаСессии);
	КонецИдСессии = СтрНайти(ТекстКук, ";", , НачалоИдСессии);
	ИдСессии = СтрЗаменить(Сред(ТекстКук, НачалоИдСессии, КонецИдСессии - НачалоИдСессии), МеткаСессии, "");

	Сессия = Новый Соответствие();
	Сессия.Вставить("Cookie", МеткаСессии + ИдСессии);

	// Когда
	Ответ = ГетЗапрос("user", Сессия);

	// Тогда
	Ожидаем.Что(ОтветВхода.КодСостояния).Равно(КодУспешногоОтвета);
	Ожидаем.Что(Ответ.КодСостояния).Равно(КодУспешногоОтвета);

КонецПроцедуры


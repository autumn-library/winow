#Использовать opentelemetry

&Пластилин
Перем СериализаторJson;

&Лог
Перем Лог;

// Контроллер микросервиса обработки.
// SERVER спан создается автоматически силами winow (НапильникHttpСервер).
// &Контроллер включает &Наблюдаемый - методы автоматически получают INTERNAL спаны.

&Контроллер("/tracing")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// POST /tracing/process - принимает JSON с автодесериализацией в ЗапросТрассировки.
// SERVER спан и контекст извлекаются автоматически через НапильникHttpСервер.
// INTERNAL спан метода создается через &Наблюдаемый на &Контроллер.
&ТочкаМаршрута("process")
Процедура ОбработатьЗапрос(Ответ, &Тип("ЗапросТрассировки") ТелоЗапросаОбъект) Экспорт

	Лог.Информация("Получен запрос: service=" + ТелоЗапросаОбъект.Сервис
		+ ", action=" + ТелоЗапросаОбъект.Действие
		+ ", value=" + ТелоЗапросаОбъект.Значение);

	ОтветТрассировки = Новый ОтветТрассировки();

	ОтветТрассировки.Статус = "ok";
	ОтветТрассировки.Сервис = ТелоЗапросаОбъект.Сервис;
	ОтветТрассировки.Действие = ТелоЗапросаОбъект.Действие;
	ОтветТрассировки.Значение = ТелоЗапросаОбъект.Значение * 2;

	Ответ.УстановитьТипКонтента("json");
	Ответ.ТелоТекст = СериализаторJson.Сериализовать(ОтветТрассировки);

КонецПроцедуры

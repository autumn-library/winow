// Конвейер обработки запроса прикладного веб-сервера: разбирает сырые данные
// соединения, достаёт сессию, разводит запрос по типу соединения и сериализует
// ответ обратно в двоичные данные.
//
// Парная реализация для нативного сервера - НативныйОбработчикЗапросов.
// У обоих одинаковая пара методов, РазобратьЗапрос и ОбработатьРазобранныйЗапрос,
// потому что напильник трассировки оборачивает второй из них у той реализации,
// которая выбрана в поделке.

&Пластилин Перем ПарсерЗапросов;
&Пластилин Перем ОбработчикЗапросов;
&Пластилин Перем ПодготовительОтветов;
&Пластилин Перем МенеджерСессий;
&Пластилин Перем ФабрикаОтветов;
&Пластилин Перем ТопикиСерверныхСобытий;

// Прозвище помечает желудь как конвейер запроса веб-сервера. По нему напильник
// трассировки находит шов, не зная конкретных классов: новой реализации сервера
// достаточно взять то же прозвище.
&Желудь
&Прозвище("ОбработчикЗапросовВебСервера")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

// Разбирает сырые данные соединения во ВходящийЗапрос.
//
// Разбор отделён от обработки, потому что вокруг обработки открывается серверный
// спан OpenTelemetry, а открыть его раньше нельзя: контекст трассировки
// извлекается из заголовков запроса, и до разбора их ещё нет.
//
// Параметры:
//  ДвоичныеДанныеЗапроса - ДвоичныеДанные - Сырые данные запроса.
//  УдаленныйУзел         - Строка         - Адрес и порт клиента.
//
// Возвращаемое значение:
//  ВходящийЗапрос - Разобранный запрос.
//
Функция РазобратьЗапрос(ДвоичныеДанныеЗапроса, УдаленныйУзел) Экспорт

	Возврат ПарсерЗапросов.РазобратьЗапрос(ДвоичныеДанныеЗапроса, УдаленныйУзел);

КонецФункции

// Обрабатывает запрос, у которого уже разобраны строка запроса и заголовки.
//
// Это шов для трассировки: серверный спан OpenTelemetry открывается вокруг
// этого вызова, поэтому под спан попадает всё, что winow делает с запросом, -
// получение сессии, ветвление по типу соединения, обработка и сериализация
// ответа. Снаружи остаётся только разбор сырого HTTP-текста.
//
// Вызывать метод изнутри класса нельзя: напильник оборачивает желудь
// декоратором, который делегирует вызовы исходному объекту, поэтому
// перехватчики срабатывают только на вызовах извне.
//
// Параметры:
//  Запрос - ВходящийЗапрос - Разобранный запрос с заполненными заголовками,
//                            куками и адресом удалённого узла.
//
// Возвращаемое значение:
//  Структура - Результат обработки, см. СтруктураРезультатаОбработки.
//
Функция ОбработатьРазобранныйЗапрос(Запрос) Экспорт

	УстановитьСессиюПоКукам(Запрос);

	Результат = СтруктураРезультатаОбработки();

	Если Запрос.ЭтоЗапросНаВебСокет() Тогда

		Результат.ТипСоединения = "ВС";

		Ответ = ФабрикаОтветов.ОтветРукопожатияВебСокета(Запрос);

		Результат.Идентификатор = Запрос.Сессия.Идентификатор();
		Результат.ЗакрыватьСоединение = Ложь;
		Результат.Топик = Запрос.Путь;

	ИначеЕсли Запрос.ЭтоЗапросНаСерверныеСобытия() Тогда

		Результат.ТипСоединения = "СС";
		Если ТопикиСерверныхСобытий.Существует(Запрос.Путь) = Ложь Тогда
			Ответ = ФабрикаОтветов.НовыйОтвет404();
		Иначе
			Результат.Идентификатор = Запрос.Сессия.Идентификатор();
			Результат.ЗакрыватьСоединение = Ложь;
			Результат.Топик = Запрос.Путь;
			Ответ = ФабрикаОтветов.ПустойОтвет();
			Ответ.УстановитьСостояниеОК();
			Ответ.Заголовки["Content-Type"] = "text/event-stream; charset=utf-8";
		КонецЕсли;

	Иначе
		Ответ = ОбработчикЗапросов.СформироватьОтвет(Запрос);
	КонецЕсли;

	Результат.СостояниеКод = Ответ.СостояниеКод;
	Результат.Ответ = ПодготовительОтветов.ДвоичныеДанныеОтвета(Ответ);

	Возврат Результат;

КонецФункции

Процедура УстановитьСессиюПоКукам(Запрос)
	Запрос.Сессия = МенеджерСессий.ПолучитьСессиюПоКукам(Запрос.Куки);
КонецПроцедуры

// Ответ в результате лежит уже двоичными данными, поэтому код состояния
// сохраняется отдельным полем: по нему трассировка заполняет атрибут
// http.response.status_code, не разбирая ответ обратно.
Функция СтруктураРезультатаОбработки()
	Возврат Новый Структура("ЗакрыватьСоединение, Ответ, Идентификатор, Топик, ТипСоединения, СостояниеКод",
		Истина);
КонецФункции

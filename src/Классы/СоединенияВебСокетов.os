#Использовать collectionos

&Пластилин Перем Поделка;

&ЛогВебСервера
Перем Лог;

// СписокКопированиеПриЗаписи Из Структура - соединения с полями Идентификатор, Топик,
// Соединение и Подписка. Соединения добавляются, удаляются и ищутся из параллельных
// потоков - потоков Kestrel у нативного сервера и фоновых заданий подписок у прикладного.
// Рассылки читают пул гораздо чаще, чем он меняется, поэтому список с копированием
// при записи: чтение идёт по снимку без блокировки, а изменение атомарно.
Перем ПулСоединений;

&Желудь
Процедура ПриСозданииОбъекта()
	Инициализация();
КонецПроцедуры

// Добавляет соединение в пул и подписывается на его сообщения.
//
// Клиент определяется сессией, а топик - путём запроса рукопожатия.
//
// Параметры:
//  Соединение - TCPСоединение, ВебСокет - Соединение прикладного или нативного сервера.
//  Запрос     - ВходящийЗапрос - Запрос рукопожатия с заполненной сессией.
//
// Возвращаемое значение:
//  ПодпискаНаВебСокетПрикладная, ПодпискаНаВебСокетНативная - Подписка, читающая сообщения соединения.
//
Функция Добавить(Соединение, Запрос) Экспорт
	Подключение = ОписаниеПодключения(Запрос);
	// Подписка попадает в пул раньше, чем начнёт читать: обработчик подключения
	// может сразу разослать сообщение всем, включая только что подключившегося.
	Подписка = Поделка.НайтиЖелудь("ПодпискаНаВебСокет");
	ДанныеСоединения = Новый Структура("Идентификатор, Топик, Соединение, Подписка");
	ДанныеСоединения.Идентификатор = Подключение.Идентификатор;
	ДанныеСоединения.Топик = Подключение.Топик;
	ДанныеСоединения.Соединение = Соединение;
	ДанныеСоединения.Подписка = Подписка;
	ПулСоединений.Добавить(ДанныеСоединения);
	Подписка.Подписаться(Соединение, Подключение);
	Возврат Подписка;
КонецФункции

// Запрос рукопожатия живёт недолго, поэтому подписке нужное из него копируется.
//
// Параметры:
//  Запрос - ВходящийЗапрос - Запрос рукопожатия с заполненной сессией.
//
// Возвращаемое значение:
//  Структура - Описание соединения, см. ОбработчикСобытийВебСокета.
//
Функция ОписаниеПодключения(Запрос)
	Подключение = Новый Структура("Идентификатор, Топик, ШаблонМаршрута, КонтекстТрассировки");
	Подключение.Идентификатор = Запрос.Сессия.Идентификатор();
	Подключение.Топик = Запрос.Путь;
	Подключение.ШаблонМаршрута = Запрос.ШаблонМаршрута;
	Подключение.КонтекстТрассировки = Запрос.КонтекстТрассировки;
	Возврат Подключение;
КонецФункции

Процедура Инициализация()
	ПулСоединений = Новый СписокКопированиеПриЗаписи();
КонецПроцедуры

Функция ПолучитьСоединенияПоТопику(Топик) Экспорт
	Возврат ПолучитьСоединенияСОтбором(Новый Структура("Топик", Топик));
КонецФункции

Функция ПолучитьСоединенияПоТопикуСпискуИдентификаторов(Топик, СписокИдентификаторов) Экспорт
	Соединения = ПолучитьСоединенияПоТопику(Топик);
	Результат = Новый Массив();
	Для Каждого ДанныеСоединения из Соединения Цикл
		Если НЕ СписокИдентификаторов.Найти(ДанныеСоединения.Идентификатор) = Неопределено Тогда
			Результат.Добавить(ДанныеСоединения);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьСоединенияПоТопикуКромеСпискаИдентификаторов(Топик, СписокИсключенийИдентификаторов) Экспорт
	Соединения = ПолучитьСоединенияПоТопику(Топик);
	Результат = Новый Массив();
	Для Каждого ДанныеСоединения из Соединения Цикл
		Если СписокИсключенийИдентификаторов.Найти(ДанныеСоединения.Идентификатор) = Неопределено Тогда
			Результат.Добавить(ДанныеСоединения);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьСоединениеПоИдентификатору(Топик, Идентификатор) Экспорт

	Соединения = ПолучитьСоединенияСОтбором(Новый Структура("Топик, Идентификатор", Топик, Идентификатор));

	Если Соединения.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат Соединения[0];
	КонецЕсли;
	
КонецФункции

// Параметры:
//  Отбор - Структура - Значения полей соединения, которым должны соответствовать найденные соединения.
//
// Возвращаемое значение:
//  Массив Из Структура - Соединения из снимка пула.
//
Функция ПолучитьСоединенияСОтбором(Отбор) Экспорт
	Соединения = Новый Массив();
	// обход идёт по снимку пула: без блокировки и без копирования
	Для Каждого ДанныеСоединения Из ПулСоединений Цикл
		Если СоответствуетОтбору(ДанныеСоединения, Отбор) Тогда
			Соединения.Добавить(ДанныеСоединения);
		КонецЕсли;
	КонецЦикла;
	Возврат Соединения;
КонецФункции

Функция СоответствуетОтбору(ДанныеСоединения, Отбор)
	Соответствует = Истина;
	Для Каждого Условие Из Отбор Цикл
		Соответствует = Соответствует И ДанныеСоединения[Условие.Ключ] = Условие.Значение;
	КонецЦикла;
	Возврат Соответствует;
КонецФункции

// Соединение могли уже удалить из другого потока - тогда удалять нечего.
//
// Параметры:
//  Соединение - TCPСоединение, ВебСокет - Удаляемое соединение.
//
Процедура УдалитьСоединение(Соединение) Экспорт
	Для Каждого ДанныеСоединения Из ПолучитьСоединенияСОтбором(Новый Структура("Соединение", Соединение)) Цикл
		ПулСоединений.Удалить(ДанныеСоединения);
	КонецЦикла;
КонецПроцедуры

Процедура НайтиИЗакрытьСоединениеПоИдентификаторуИТопику(Топик, Идентификатор) Экспорт
	ДанныеСоединения = ПолучитьСоединениеПоИдентификатору(Топик, Идентификатор);
	Если НЕ ДанныеСоединения = Неопределено Тогда
		// соединение закрывает подписка: только она знает, как закрыть соединение своего сервера
		ДанныеСоединения.Подписка.Отписаться();
	КонецЕсли;
КонецПроцедуры

// Прерывает все соединения, не дожидаясь ответа клиентов. Подписки сами
// удалят соединения из пула, поэтому обходится снимок пула.
Процедура ПрерватьВсеСоединения() Экспорт
	Для Каждого ДанныеСоединения Из ПулСоединений Цикл
		Попытка
			ДанныеСоединения.Подписка.ПрерватьСоединение();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Лог.Ошибка("Не удалось прервать WS соединение: " + ТекстОшибки);
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Процедура ЗакрытьСоединение(Соединение) Экспорт
	Попытка
		Соединение.Закрыть();	
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Лог.Ошибка("Не удалось закрыть WS соединение: " + ТекстОшибки);
	КонецПопытки;
КонецПроцедуры
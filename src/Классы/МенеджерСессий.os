#Использовать semaphore

Перем Сессии;
Перем Поделка;
Перем Настройки;
Перем БлокировкаСессий;

// Миллисекунды универсального времени последней уборки устаревших сессий.
Перем МоментПоследнейУборки;

&Желудь
&Наблюдаемый
Процедура ПриСозданииОбъекта(
							&Пластилин("Поделка") _Поделка,
							&Пластилин("Настройки") _Настройки
							)
	Поделка = _Поделка;
	Настройки = _Настройки;
	Сессии = Новый Соответствие();
	БлокировкаСессий = Новый Семафор();
	МоментПоследнейУборки = ТекущаяУниверсальнаяДатаВМиллисекундах();
КонецПроцедуры

Функция НоваяСессия()

	Возврат Поделка.НайтиЖелудь("СессияПользователя");
	
КонецФункции

// Возвращает сессию по идентификатору и отмечает обращение к ней.
// Неизвестный идентификатор даёт новую сессию. Попутно, не чаще winow.ИнтервалУборкиСессий,
// забываются сессии, к которым не обращались дольше winow.СрокЖизниСессии.
//
// Параметры:
//  Идентификатор - Строка - Идентификатор сессии из куки.
//
// Возвращаемое значение:
//  СессияПользователя - Сессия с этим идентификатором или новая.
//
Функция ПолучитьСессиюПоИдентификатору(Идентификатор) Экспорт

	БлокировкаСессий.Захватить();

	Попытка
		УдалитьУстаревшиеЕслиПора();

		ТекСессия = Сессии.Получить(Идентификатор);
		Если ТекСессия = Неопределено Тогда
			ТекСессия = НоваяСессия();
			Сессии.Вставить(ТекСессия.Идентификатор(), ТекСессия);
		КонецЕсли;
		ТекСессия.ОтметитьОбращение();
	Исключение
		БлокировкаСессий.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаСессий.Освободить();

	Возврат ТекСессия;
КонецФункции

Функция ПолучитьСессиюПоКукам(Куки) Экспорт
	ИдСессии = Куки.ПолучитьЗначениеПоИмени(ИмяКукаСессии());
	Возврат ПолучитьСессиюПоИдентификатору(ИдСессии);
КонецФункции

Функция ИмяКукаСессии() Экспорт
	Возврат "SessionID";
КонецФункции

// Забывает сессии, к которым не обращались дольше winow.СрокЖизниСессии.
// При сроке 0 ничего не делает.
//
// Возвращаемое значение:
//  Число - Сколько сессий забыто.
//
Функция УдалитьУстаревшие() Экспорт

	БлокировкаСессий.Захватить();

	Попытка
		Удалено = УдалитьУстаревшиеПодБлокировкой();
	Исключение
		БлокировкаСессий.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаСессий.Освободить();

	Возврат Удалено;
КонецФункции

// Возвращаемое значение:
//  Число - Сколько сессий хранит менеджер.
//
Функция Количество() Экспорт
	Возврат Сессии.Количество();
КонецФункции

Процедура УдалитьУстаревшиеЕслиПора()

	Если СрокЖизниСессии() <= 0 Тогда
		Возврат;
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Сейчас - МоментПоследнейУборки < Число(Настройки.ИнтервалУборкиСессий) * 1000 Тогда
		Возврат;
	КонецЕсли;

	УдалитьУстаревшиеПодБлокировкой();

КонецПроцедуры

Функция УдалитьУстаревшиеПодБлокировкой()

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МоментПоследнейУборки = Сейчас;

	Если СрокЖизниСессии() <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Порог = Сейчас - СрокЖизниСессии() * 1000;

	Устаревшие = Новый Массив();
	Для Каждого Элемент Из Сессии Цикл
		Если Элемент.Значение.МоментПоследнегоОбращения() < Порог Тогда
			Устаревшие.Добавить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Идентификатор Из Устаревшие Цикл
		Сессии.Удалить(Идентификатор);
	КонецЦикла;

	Возврат Устаревшие.Количество();

КонецФункции

// Настройка из переменной окружения приходит строкой.
Функция СрокЖизниСессии()
	Возврат Число(Настройки.СрокЖизниСессии);
КонецФункции

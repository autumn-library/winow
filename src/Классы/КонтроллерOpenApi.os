#Использовать autumn

&Пластилин
// Генератор спецификации OpenAPI и страницы Swagger UI.
Перем ГенераторOpenApi;

&Желудь
Процедура ПриСозданииОбъекта()

КонецПроцедуры

// Отдает JSON со спецификацией OpenAPI.
//
// Запрос нужен генератору для раздела servers: за обратным прокси приложение
// доступно не по тому адресу, который слушает, и об этом сообщают заголовки
// запроса.
//
// Параметры:
//   Ответ  - Ответ - формируемый ответ сервера.
//   Запрос - ВходящийЗапрос - запрос за спецификацией.
Процедура ОтдатьСпецификацию(Ответ, Запрос) Экспорт

	Ответ.УстановитьТипКонтента("json");
	Ответ.ТелоТекст = ГенераторOpenApi.СпецификацияТекстом(Запрос);

КонецПроцедуры

// Отдает HTML-страницу Swagger UI.
//
// Параметры:
//   Ответ - Ответ - формируемый ответ сервера.
Процедура ОтдатьSwaggerUI(Ответ) Экспорт

	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = ГенераторOpenApi.СтраницаSwaggerUI();

КонецПроцедуры

#Использовать autumn

&Пластилин
// Генератор спецификации OpenAPI и страницы Swagger UI.
Перем ГенераторOpenApi;

&Желудь
Процедура ПриСозданииОбъекта()

КонецПроцедуры

// Отдает спецификацию OpenAPI в JSON - это канонический адрес спецификации,
// на него же ссылается страница Swagger UI.
//
// Запрос нужен генератору для раздела servers: за обратным прокси приложение
// доступно не по тому адресу, который слушает, и об этом сообщают заголовки
// запроса.
//
// Параметры:
//   Ответ  - Ответ - формируемый ответ сервера.
//   Запрос - ВходящийЗапрос - запрос за спецификацией.
Процедура ОтдатьСпецификациюJson(Ответ, Запрос) Экспорт

	Ответ.УстановитьТипКонтента("json");
	Ответ.ТелоТекст = ГенераторOpenApi.СпецификацияТекстом(Запрос);

КонецПроцедуры

// Отдает ту же спецификацию OpenAPI в YAML.
//
// Параметры:
//   Ответ  - Ответ - формируемый ответ сервера.
//   Запрос - ВходящийЗапрос - запрос за спецификацией.
Процедура ОтдатьСпецификациюYaml(Ответ, Запрос) Экспорт

	// Своего типа контента у YAML в winow нет, поэтому ставится вручную.
	// application/yaml зарегистрирован IANA с 2024 года.
	Ответ.Заголовки["Content-Type"] = "application/yaml; charset=utf-8";
	Ответ.ТелоТекст = ГенераторOpenApi.СпецификацияYaml(Запрос);

КонецПроцедуры

// Отдает HTML-страницу Swagger UI.
//
// Параметры:
//   Ответ - Ответ - формируемый ответ сервера.
Процедура ОтдатьSwaggerUI(Ответ) Экспорт

	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = ГенераторOpenApi.СтраницаSwaggerUI();

КонецПроцедуры

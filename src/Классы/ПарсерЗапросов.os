// Разбирает сырые данные HTTP-запроса во ВходящийЗапрос.
//
// Только разбор: сессия, ветвление по типу соединения и сериализация ответа
// живут в ПрикладнойОбработчикЗапросов.

Перем Поделка;
Перем Перечисления;
Перем Парсеры;

&Желудь
Процедура ПриСозданииОбъекта(
							&Пластилин("Поделка") _Поделка,
							&Пластилин("Перечисления") _Перечисления,
							&Пластилин("Парсеры") _Парсеры
							)
	Поделка = _Поделка;
	Перечисления = _Перечисления;
	Парсеры = _Парсеры;
КонецПроцедуры

// Разбирает сырые данные соединения во ВходящийЗапрос.
//
// Параметры:
//  ДвоичныеДанныеЗапроса - ДвоичныеДанные - Сырые данные запроса.
//  УдаленныйУзел         - Строка         - Адрес и порт клиента.
//
// Возвращаемое значение:
//  ВходящийЗапрос - Разобранный запрос.
//
Функция РазобратьЗапрос(ДвоичныеДанныеЗапроса, УдаленныйУзел) Экспорт

	Запрос = ПолучитьЗапросИзДвоичныхДанных(ДвоичныеДанныеЗапроса);

	УстановитьАдресИПортУдаленногоУзла(Запрос, УдаленныйУзел);

	Возврат Запрос;

КонецФункции

Функция ПолучитьЗапросИзДвоичныхДанных(ДвоичныеДанныеЗапроса) Экспорт
	
	Запрос = Поделка.НайтиЖелудь("ВходящийЗапрос");

	ДанныеЗапроса = ДвоичныеДанныеЗапроса;

	РазделенныйЗапрос = Парсеры.РазделитьДвоичныеДанныеРазделителем(ДанныеЗапроса, 
																	Перечисления.ДвойнойРазделительДвоичнымиДанными);

	ТекстЗапроса = ПолучитьСтрокуИзДвоичныхДанных(РазделенныйЗапрос.Лево, "utf-8");

	СтруктураЗапроса = РазобратьТексЗапроса(ТекстЗапроса);

	Запрос.ТекстЗапроса = ТекстЗапроса;
	Запрос.ДвоичныеДанные = ДанныеЗапроса;
	Запрос.ТелоДвоичныеДанные = РазделенныйЗапрос.Право;
	Если Не Запрос.ТелоДвоичныеДанные = Неопределено Тогда
		Запрос.Тело = ПолучитьСтрокуИзДвоичныхДанных(Запрос.ТелоДвоичныеДанные);
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(Запрос, СтруктураЗапроса);

	Возврат Запрос;

КонецФункции

Функция РазобратьТексЗапроса(ТекстЗапроса)
	Результат = Новый Структура();

	МассивСтрок = СтрРазделить(ТекстЗапроса, Символы.ПС, Ложь);

	Если МассивСтрок.Количество() > 0 Тогда
		ПерваяСтрока = СтрРазделить(МассивСтрок[0], " ");
		Результат.Вставить("Метод", ПерваяСтрока[0]);

		ПутьИПараметры = Парсеры.РазделитьСтроку(ПерваяСтрока[1], "?");

		// Декодируется только путь. Строка параметров остаётся как пришла:
		// по HTTP semantic conventions url.query отдаётся в исходном виде,
		// иначе %2B становится неотличим от литерального плюса, а затирание
		// чувствительных параметров сверяется не с теми ключами.
		Путь = РаскодироватьПуть(ПутьИПараметры.Лево);

		Результат.Вставить("Путь", Путь);
		Результат.Вставить("ПараметрыИменные", Парсеры.ПараметрыИзТекста(ПутьИПараметры.Право));

		Если СтрНайти(ПерваяСтрока[1], "?") = 0 Тогда
			Результат.Вставить("ПолныйПуть", Путь);
		Иначе
			Результат.Вставить("ПолныйПуть", Путь + "?" + ПутьИПараметры.Право);
		КонецЕсли;


		Заголовки = Новый Соответствие();
		Результат.Вставить("Заголовки", Заголовки);

		Результат.Вставить("Куки", Поделка.НайтиЖелудь("Куки"));

		Для Сч = 1 По МассивСтрок.ВГраница() Цикл
			Если ПустаяСтрока(МассивСтрок[Сч]) Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеСтроки = РаспарситьСтрокуЗаголовка(МассивСтрок[Сч]);
			Имя = СокрЛП(ДанныеСтроки.Имя);
			Значение = СокрЛП(ДанныеСтроки.Значение);
			Если Имя = "Cookie" Тогда
				Для Каждого КукаСтрокой Из СтрРазделить(Значение, ";") Цикл
					Кука = Парсеры.РазделитьСтроку(КукаСтрокой, "=");
					Результат.Куки.Добавить(СокрЛП(Кука.Лево), СокрЛП(Кука.Право));
				КонецЦикла
			Иначе
				Заголовки.Вставить(Имя, Значение);
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	Возврат Результат;
КонецФункции

// Декодирует путь, обходя закодированную косую черту.
//
// Так же путь отдаёт Kestrel нативному серверу: %2F - это символ внутри сегмента,
// а не разделитель сегментов. Раскодируй её - и маршрутизация увидит лишний
// сегмент, а отдача файлов получит протащенный разделитель пути.
//
// Последовательность копируется из исходной строки как есть, поэтому %2f не
// превращается в %2F: реализации серверов обязаны отдавать одинаковый путь.
//
// Параметры:
//  СыройПуть - Строка - Путь из строки запроса, как он пришёл от клиента.
//
// Возвращаемое значение:
//  Строка - Декодированный путь.
//
Функция РаскодироватьПуть(СыройПуть)

	Результат = "";
	Остаток = СыройПуть;

	Пока Истина Цикл

		Позиция = ПозицияЗакодированнойКосойЧерты(Остаток);

		Если Позиция = 0 Тогда
			Возврат Результат + РаскодироватьСтроку(Остаток, СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;

		Результат = Результат
			+ РаскодироватьСтроку(Лев(Остаток, Позиция - 1), СпособКодированияСтроки.КодировкаURL)
			+ Сред(Остаток, Позиция, СтрДлина("%2F"));

		Остаток = Сред(Остаток, Позиция + СтрДлина("%2F"));

	КонецЦикла;

КонецФункции

// Позиция ближайшей закодированной косой черты в любом регистре, 0 - если её нет.
Функция ПозицияЗакодированнойКосойЧерты(Строка)

	ПозицияВерхнего = СтрНайти(Строка, "%2F");
	ПозицияНижнего = СтрНайти(Строка, "%2f");

	Если ПозицияВерхнего = 0 Тогда
		Возврат ПозицияНижнего;
	ИначеЕсли ПозицияНижнего = 0 Тогда
		Возврат ПозицияВерхнего;
	КонецЕсли;

	Возврат Мин(ПозицияВерхнего, ПозицияНижнего);

КонецФункции

Функция РаспарситьСтрокуЗаголовка(СтрокаЗаголовка)
	РазделеннаяСтрока = Парсеры.РазделитьСтроку(СтрокаЗаголовка, ":");
	Возврат Новый Структура("Имя, Значение", РазделеннаяСтрока.Лево, РазделеннаяСтрока.Право);
КонецФункции

Процедура УстановитьАдресИПортУдаленногоУзла(Запрос, УдаленныйУзел)

	Структура = Парсеры.СтруктураУзла(УдаленныйУзел);

	Запрос.АдресУдаленногоУзла = Структура.Адрес;
	Запрос.ПортУдаленногоУзла = Структура.Порт;

КонецПроцедуры
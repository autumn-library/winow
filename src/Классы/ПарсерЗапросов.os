Перем Поделка;
Перем Перечисления;
Перем Парсеры;
Перем Настройки;

&Пластилин Перем ОбработчикЗапросов;
&Пластилин Перем ПодготовительОтветов;
&Пластилин Перем МенеджерСессий;
&Пластилин Перем ФабрикаОтветов;
&Пластилин Перем ТопикиСерверныхСобытий;

&Желудь
Процедура ПриСозданииОбъекта(
							&Пластилин("Поделка") _Поделка,
							&Пластилин("Перечисления") _Перечисления,
							&Пластилин("Парсеры") _Парсеры,
							&Пластилин("Настройки") _Настройки
							)
	Поделка = _Поделка;
	Перечисления = _Перечисления;
	Парсеры = _Парсеры;
	Настройки = _Настройки;
КонецПроцедуры

// Разбирает сырые данные соединения во ВходящийЗапрос.
//
// Разбор отделён от обработки, потому что вокруг обработки открывается серверный
// спан OpenTelemetry, а открыть его раньше нельзя: контекст трассировки
// извлекается из заголовков запроса, и до разбора их ещё нет.
//
// Параметры:
//  ДвоичныеДанныеЗапроса - ДвоичныеДанные - Сырые данные запроса.
//  УдаленныйУзел         - Строка         - Адрес и порт клиента.
//
// Возвращаемое значение:
//  ВходящийЗапрос - Разобранный запрос.
//
Функция РазобратьЗапрос(ДвоичныеДанныеЗапроса, УдаленныйУзел) Экспорт

	Запрос = ПолучитьЗапросИзДвоичныхДанных(ДвоичныеДанныеЗапроса);

	УстановитьАдресИПортУдаленногоУзла(Запрос, УдаленныйУзел);

	Возврат Запрос;

КонецФункции

// Обрабатывает запрос, у которого уже разобраны строка запроса и заголовки.
//
// Это шов для трассировки: серверный спан OpenTelemetry открывается вокруг
// этого вызова, поэтому под спан попадает всё, что winow делает с запросом, -
// получение сессии, ветвление по типу соединения, обработка и сериализация
// ответа. Снаружи остаётся только разбор сырого HTTP-текста.
//
// Вызывать метод изнутри класса нельзя: напильник оборачивает желудь
// декоратором, который делегирует вызовы исходному объекту, поэтому
// перехватчики срабатывают только на вызовах извне.
//
// Параметры:
//  Запрос - ВходящийЗапрос - Разобранный запрос с заполненными заголовками,
//                            куками и адресом удалённого узла.
//
// Возвращаемое значение:
//  Структура - Результат парсинга, см. СтруктураРезультатаПарсинга.
//
Функция ОбработатьРазобранныйЗапрос(Запрос) Экспорт

	УстановитьСессиюПоКукам(Запрос);

	Результат = СтруктураРезультатаПарсинга();

	Если Запрос.ЭтоЗапросНаВебСокет() Тогда

		Результат.ТипСоединения = "ВС";

		Ответ = ФабрикаОтветов.ОтветРукопожатияВебСокета(Запрос);
	
		Результат.Идентификатор = Запрос.Сессия.Идентификатор();
		Результат.ЗакрыватьСоединение = Ложь;
		Результат.Топик = Запрос.Путь;

	ИначеЕсли Запрос.ЭтоЗапросНаСерверныеСобытия() Тогда

		Результат.ТипСоединения = "СС";
		Если ТопикиСерверныхСобытий.Существует(Запрос.Путь) = Ложь Тогда
			Ответ = ФабрикаОтветов.НовыйОтвет404();
		Иначе
			Результат.Идентификатор = Запрос.Сессия.Идентификатор();
			Результат.ЗакрыватьСоединение = Ложь;
			Результат.Топик = Запрос.Путь;
			Ответ = ФабрикаОтветов.ПустойОтвет();
			Ответ.УстановитьСостояниеОК();
			Ответ.Заголовки["Content-Type"] = "text/event-stream; charset=utf-8";
		КонецЕсли;

	Иначе
		Ответ = ОбработчикЗапросов.СформироватьОтвет(Запрос);
	КонецЕсли;

	Результат.СостояниеКод = Ответ.СостояниеКод;
	Результат.Ответ = ПодготовительОтветов.ДвоичныеДанныеОтвета(Ответ);

	Возврат Результат;

КонецФункции

Функция ПолучитьЗапросИзДвоичныхДанных(ДвоичныеДанныеЗапроса) Экспорт
	
	Запрос = Поделка.НайтиЖелудь("ВходящийЗапрос");

	ДанныеЗапроса = ДвоичныеДанныеЗапроса;

	РазделенныйЗапрос = Парсеры.РазделитьДвоичныеДанныеРазделителем(ДанныеЗапроса, 
																	Перечисления.ДвойнойРазделительДвоичнымиДанными);

	ТекстЗапроса = ПолучитьСтрокуИзДвоичныхДанных(РазделенныйЗапрос.Лево, "utf-8");

	СтруктураЗапроса = РазобратьТексЗапроса(ТекстЗапроса);

	Запрос.ТекстЗапроса = ТекстЗапроса;
	Запрос.ДвоичныеДанные = ДанныеЗапроса;
	Запрос.ТелоДвоичныеДанные = РазделенныйЗапрос.Право;
	Если Не Запрос.ТелоДвоичныеДанные = Неопределено Тогда
		Запрос.Тело = ПолучитьСтрокуИзДвоичныхДанных(Запрос.ТелоДвоичныеДанные);
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(Запрос, СтруктураЗапроса);

	Возврат Запрос;

КонецФункции

Функция РазобратьТексЗапроса(ТекстЗапроса)
	Результат = Новый Структура();

	МассивСтрок = СтрРазделить(ТекстЗапроса, Символы.ПС, Ложь);

	Если МассивСтрок.Количество() > 0 Тогда
		ПерваяСтрока = СтрРазделить(МассивСтрок[0], " ");
		Результат.Вставить("Метод", ПерваяСтрока[0]);
		Результат.Вставить("ПолныйПуть", РаскодироватьСтроку(ПерваяСтрока[1],СпособКодированияСтроки.КодировкаURL));
		
		ПутьИПараметры = Парсеры.РазделитьСтроку(ПерваяСтрока[1], "?");

		Результат.Вставить("ПараметрыИменные", Парсеры.ПараметрыИзТекста(ПутьИПараметры.Право));
		Результат.Вставить("Путь", РаскодироватьСтроку(ПутьИПараметры.Лево, СпособКодированияСтроки.КодировкаURL));
		
		Заголовки = Новый Соответствие();
		Результат.Вставить("Заголовки", Заголовки);

		Результат.Вставить("Куки", Поделка.НайтиЖелудь("Куки"));

		Для Сч = 1 По МассивСтрок.ВГраница() Цикл
			Если ПустаяСтрока(МассивСтрок[Сч]) Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеСтроки = РаспарситьСтрокуЗаголовка(МассивСтрок[Сч]);
			Имя = СокрЛП(ДанныеСтроки.Имя);
			Значение = СокрЛП(ДанныеСтроки.Значение);
			Если Имя = "Cookie" Тогда
				Для Каждого КукаСтрокой Из СтрРазделить(Значение, ";") Цикл
					Кука = Парсеры.РазделитьСтроку(КукаСтрокой, "=");
					Результат.Куки.Добавить(СокрЛП(Кука.Лево), СокрЛП(Кука.Право));
				КонецЦикла
			Иначе
				Заголовки.Вставить(Имя, Значение);
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	Возврат Результат;
КонецФункции

Функция РаспарситьСтрокуЗаголовка(СтрокаЗаголовка)
	РазделеннаяСтрока = Парсеры.РазделитьСтроку(СтрокаЗаголовка, ":");
	Возврат Новый Структура("Имя, Значение", РазделеннаяСтрока.Лево, РазделеннаяСтрока.Право);
КонецФункции

Процедура УстановитьСессиюПоКукам(Запрос)
	Запрос.Сессия = МенеджерСессий.ПолучитьСессиюПоКукам(Запрос.Куки);
КонецПроцедуры

Процедура УстановитьАдресИПортУдаленногоУзла(Запрос, УдаленныйУзел)

	Структура = Парсеры.СтруктураУзла(УдаленныйУзел);

	Запрос.АдресУдаленногоУзла = Структура.Адрес;
	Запрос.ПортУдаленногоУзла = Структура.Порт;

КонецПроцедуры

// Ответ в результате лежит уже двоичными данными, поэтому код состояния
// сохраняется отдельным полем: по нему трассировка заполняет атрибут
// http.response.status_code, не разбирая ответ обратно.
Функция СтруктураРезультатаПарсинга()
	Возврат Новый Структура("ЗакрыватьСоединение, Ответ, Идентификатор, Топик, ТипСоединения, СостояниеКод",
		Истина);
КонецФункции
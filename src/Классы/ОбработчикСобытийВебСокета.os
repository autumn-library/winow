// Передаёт события соединения веб-сокета брокеру: подключение, входящее
// текстовое сообщение и отключение клиента.
//
// Это шов для трассировки: напильник находит желудь по прозвищу и открывает
// спан вокруг каждого события. Подписки на соединения сами напильниками
// не обрабатываются, поэтому события идут через отдельный желудь.
//
// Исключения обработчиков не гасятся: их записывает в спан трассировка, а гасит
// подписка, чтобы ошибка обработчика не обрывала соединение клиента.
//
// Подключение - описание соединения, которое подписка передаёт в каждое событие:
//  Структура:
//   * Идентификатор       - Строка - Идентификатор сессии клиента.
//   * Топик               - Строка - Путь, по которому подключился клиент.
//   * ШаблонМаршрута      - Строка - Шаблон маршрута топика; пустой, если маршрут не нашёлся.
//   * КонтекстТрассировки - ОтелКонтекстСпана, Неопределено - Контекст спана рукопожатия.

&Пластилин Перем БрокерСообщенийВебСокетов; // вызывает обработчики точек маршрута и подписок

&Желудь
&Прозвище("ОбработчикСобытийВебСокета")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

// Параметры:
//  Подключение - Структура - Описание соединения, см. описание модуля.
//
Процедура ОбработатьПодключение(Подключение) Экспорт
	БрокерСообщенийВебСокетов.ПриПодключении(Подключение.Топик, Подключение.Идентификатор);
КонецПроцедуры

// Параметры:
//  Подключение - Структура - Описание соединения, см. описание модуля.
//  Сообщение   - Строка - Текст сообщения клиента.
//
Процедура ОбработатьСообщение(Подключение, Сообщение) Экспорт
	БрокерСообщенийВебСокетов.ВходящееТекстовоеСообщение(Подключение.Идентификатор, Подключение.Топик, Сообщение);
КонецПроцедуры

// Параметры:
//  Подключение - Структура - Описание соединения, см. описание модуля.
//
Процедура ОбработатьОтключение(Подключение) Экспорт
	БрокерСообщенийВебСокетов.ПриОтключении(Подключение.Топик, Подключение.Идентификатор);
КонецПроцедуры

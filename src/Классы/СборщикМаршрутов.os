#Использовать autumn
#Использовать autumn-logos

&Лог("winow.router")
Перем Лог;

&Пластилин Перем Маршрутизатор;
&Пластилин Перем МенеджерОтображений;
&Пластилин Перем МенеджерДоступа;
&Пластилин Перем Перечисления;

&Желудь
Процедура ПриСозданииОбъекта()

КонецПроцедуры

Процедура НайтиИЗарегистрироватьМаршруты(Желудь, ОпределениеЖелудя) Экспорт

	// Маршруты собираем из определения желудя: autumn уже разобрал его аннотации
	// по исходному типу. Рефлексия рантайм-экземпляра тут не годится - экземпляр
	// (Желудь) может быть обёрнут декоратором (например напильником &Валидно),
	// и тогда аннотации &Контроллер/&ТочкаМаршрута были бы не видны. Сам экземпляр
	// нужен только для вызова точек маршрута.

	КонструкторКонтроллера = ОпределениеЖелудя.Завязь().ДанныеМетода();
	АннотацияКонтроллер = РаботаСАннотациями.ПолучитьАннотацию(КонструкторКонтроллера, "Контроллер");

	Если АннотацияКонтроллер = Неопределено Тогда
		Возврат;
	КонецЕсли;

	АдресКонтроллера = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(АннотацияКонтроллер);

	МетодыТочекМаршрутов = ОпределениеЖелудя.НайтиМетодыСАннотациями("ТочкаМаршрута");

	Если МетодыТочекМаршрутов.Количество() = 0 Тогда
		ВызватьИсключение "Не определено ни одной точки маршрута в контроллере " + ОпределениеЖелудя.Имя();
	КонецЕсли;

	Лог.Отладка(СтрШаблон("Регистрация контрола %1 по адресу %2", ОпределениеЖелудя.Имя(), АдресКонтроллера));

	МетаданныеКонтроллера = МетаданныеКонтроллера(КонструкторКонтроллера);

	Для Каждого ТочкаМаршрута из МетодыТочекМаршрутов Цикл
		ЗарегистрироватьМаршрутКОбъекту(АдресКонтроллера, ТочкаМаршрута, Желудь, ОпределениеЖелудя,
			МетаданныеКонтроллера);
	КонецЦикла;

	НайтиПодпискиВебСокета(Желудь, ОпределениеЖелудя);

КонецПроцедуры

Процедура НайтиПодпискиВебСокета(Желудь, ОпределениеЖелудя)

	Для каждого ВидПодписки Из Перечисления.ВидыПодписокВебСокета Цикл
		ЗаполнитьПодпискиЖелудя(Желудь, ОпределениеЖелудя, ВидПодписки.Ключ);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПодпискиЖелудя(Желудь, ОпределениеЖелудя, Подписка)
	МетодыПодписки = ОпределениеЖелудя.НайтиМетодыСАннотациями(Подписка);
	Для Каждого Метод из МетодыПодписки Цикл
		Аннотация = РаботаСАннотациями.ПолучитьАннотацию(Метод, Подписка);
		Топик =  РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация);
		Если НЕ ЗначениеЗаполнено(Топик) Тогда
			ВызватьИсключение СтрШаблон("Для контроллера %1 не заполнено топик в подписке %2", Желудь, Метод.Имя);
		КонецЕсли;

		Маршрутизатор.ДобавитьПодписку(Подписка, Топик, Желудь, Метод.Имя, Метод.Параметры.ВыгрузитьКолонку("Имя"));

	КонецЦикла;
КонецПроцедуры

Процедура ЗарегистрироватьОтображениеКонтрола(Действие, ОпределениеЖелудя)

	КонструкторЖелудя = ОпределениеЖелудя.Завязь().ДанныеМетода();
	Аннотация = РаботаСАннотациями.ПолучитьАннотацию(КонструкторЖелудя, "Отображение");
	Если Аннотация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Аннотация.Параметры.Количество() = 2 Тогда
		ПутьДоШаблона = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Шаблон");
		Метод = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Метод");
		ПараметрыШаблона = НайтиПараметрыМетодаВТаблице(ОпределениеЖелудя.Методы(), Метод);
	Иначе
		ПутьДоШаблона = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Шаблон");
		Метод = Неопределено;
		ПараметрыШаблона = Новый Массив();
	КонецЕсли;

	Действие.Шаблон = ПутьДоШаблона;
	Действие.МетодШаблона = Метод;
	Действие.ПараметрыШаблона = ПараметрыШаблона;

КонецПроцедуры

Функция НайтиПараметрыМетодаВТаблице(ТаблицаМетодов, ИмяМетода)
	Для Каждого ТекМетод Из ТаблицаМетодов Цикл
		Если ВРег(ИмяМетода) = ВРег(ТекМетод.Имя) Тогда
			Возврат ТекМетод.Параметры.ВыгрузитьКолонку("Имя");
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Метод не найден " + ИмяМетода;
КонецФункции

Функция НайтиИЗаменитьПараметрыУРЛ(Урл)
	Урл = СтрЗаменить(Урл, "\", "/");
	МассивВсехПараметров = СтрРазделить(Урл, "/");
	ОчищенныйУРЛ = Новый Массив;
	ПараметрыУРЛ = Новый Соответствие;

	СчетчикПараметров = 0;

	Для каждого ТекущийПараметр Из МассивВсехПараметров Цикл

		Если ЭтоШаблонПараметраУрл(ТекущийПараметр) Тогда
			ПараметрыУРЛ.Вставить(СчетчикПараметров, Сред(ТекущийПараметр,2, СтрДлина(ТекущийПараметр) - 2));
			ОчищенныйУРЛ.Добавить(Маршрутизатор.СимволПараметраТочкиМаршрута());
		Иначе
			ОчищенныйУРЛ.Добавить(ТекущийПараметр);
		КонецЕсли;
		СчетчикПараметров = СчетчикПараметров + 1;
	КонецЦикла;
	Урл = СтрСоединить(ОчищенныйУРЛ, "/");
	Возврат ПараметрыУРЛ;
КонецФункции

Функция ЭтоШаблонПараметраУрл(ЧастьУрла)
	Возврат СтрНачинаетсяС(ЧастьУрла, "{") И СтрЗаканчиваетсяНа(ЧастьУрла, "}");
КонецФункции

Процедура ЗарегистрироватьМаршрутКОбъекту(АдресКонтроллера, ТочкаМаршрута, Желудь, ОпределениеЖелудя,
		МетаданныеКонтроллера)

	Действие = Маршрутизатор.ОписаниеТочкиМаршрута();
	Действие.АдресКонтроллера = АдресКонтроллера;
	Действие.Желудь = Желудь;
	Действие.ИмяМетода = ТочкаМаршрута.Имя;
	Действие.Параметры = ТочкаМаршрута.Параметры.ВыгрузитьКолонку("Имя");
	Действие.ОписанияПараметров = ОписанияПараметров(ТочкаМаршрута);
	Действие.ВыводитьШаблонКонтрола = РаботаСАннотациями.ПолучитьАннотацию(ТочкаМаршрута, "НеВыводитОтображениеКонтроллера") = Неопределено;

	ПараметрТелоЗапросаОбъект = ТочкаМаршрута.Параметры.Найти("ТелоЗапросаОбъект", "Имя");

	Если ПараметрТелоЗапросаОбъект <> Неопределено Тогда
		АннотацияТип = РаботаСАннотациями.ПолучитьАннотацию(ПараметрТелоЗапросаОбъект, "Тип");
		Если АннотацияТип <> Неопределено Тогда
			ТипРезультата = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(АннотацияТип);
			ТипРезультата = Тип(ТипРезультата);

			Действие.ТипТелаЗапроса = ТипРезультата;
		КонецЕсли;
	КонецЕсли;

	ЗаполнитьМетаданныеOpenApi(ТочкаМаршрута, Действие);
	ДополнитьМетаданнымиКонтроллера(Действие, МетаданныеКонтроллера);

	Аннотация = РаботаСАннотациями.ПолучитьАннотацию(ТочкаМаршрута, "ТочкаМаршрута");
	ИмяТочкиМаршута = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация);

	// HTTP-методы - часть маршрута, а не пометка поверх него, поэтому читаются
	// из той же аннотации, что и адрес.
	Действие.HTTPМетоды = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
		Аннотация, "Метод", "");

	// Запоминаем шаблон до того, как НайтиИЗаменитьПараметрыУРЛ заменит в нём
	// имена параметров на служебный символ: в таком виде он годится
	// как низкокардинальное имя маршрута для трассировки и логов.
	ИсходныйШаблонТочкиМаршрута = ИмяТочкиМаршута;

	Если СтрНайти(ИмяТочкиМаршута, "{") > 0
			ИЛИ СтрНайти(ИмяТочкиМаршута, "}") > 0 Тогда
			Действие.ПараметрыУРЛ = НайтиИЗаменитьПараметрыУРЛ(ИмяТочкиМаршута);
			Действие.УрлСодержитШаблон = Истина;
	КонецЕсли;

	ПутьКМетоду = СтрЗаменить(ОбъединитьПути(АдресКонтроллера, ИмяТочкиМаршута), "\", "/");
	Действие.ШаблонПути = СтрЗаменить(ОбъединитьПути(АдресКонтроллера, ИсходныйШаблонТочкиМаршрута), "\", "/");

	Лог.Отладка(СтрШаблон("Регистрация точки маршрута контрола %1 по адресу %2", Желудь, ПутьКМетоду));

	Маршрутизатор.ДобавитьМаршрут(ПутьКМетоду, Действие);

	ЗарегистрироватьОтображение(ТочкаМаршрута, Действие);

	ЗарегистрироватьРолиТочкиМаршрута(ТочкаМаршрута, Действие);

	ЗарегистрироватьОтображениеКонтрола(Действие, ОпределениеЖелудя);

КонецПроцедуры

// Считывает необязательные аннотации, обогащающие спецификацию OpenAPI:
//   &Операция("...", Описание = "...") - сводка и описание операции.
//   &Группа("...")   - группа, в которую попадает операция.
//   &Возвращает(...) - описание возможного ответа.
//   &Устарело("...") - пометка устаревания.
//
// HTTP-методы читаются не отсюда, а из самой &ТочкаМаршрута: метод - часть
// маршрута, а не пометка поверх него.
//
// Параметры:
//   ТочкаМаршрута - ДанныеМетода - метод точки маршрута с аннотациями.
//   Действие      - Структура - заполняемое описание точки маршрута.
Процедура ЗаполнитьМетаданныеOpenApi(ТочкаМаршрута, Действие)

	ЗаполнитьИзАннотацииОперация(ТочкаМаршрута, Действие);

	Действие.Ответы = ОписанныеОтветы(ТочкаМаршрута);
	Действие.Теги = ОбъявленныеГруппы(ТочкаМаршрута);

	ДополнитьГруппамиИзАннотацииОперация(ТочкаМаршрута, Действие);

	АннотацияУстарело = РаботаСАннотациями.ПолучитьАннотацию(ТочкаМаршрута, "Устарело");
	Если АннотацияУстарело <> Неопределено Тогда
		Действие.Устарело = Истина;
		Действие.ЧемЗаменить = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
			АннотацияУстарело, "Значение", "");
	КонецЕсли;

КонецПроцедуры

// Скалярные поля операции: сводка, описание и идентификатор. Отдельных
// аннотаций у них нет, поэтому и складывать не с чем.
Процедура ЗаполнитьИзАннотацииОперация(ТочкаМаршрута, Действие)

	Аннотация = РаботаСАннотациями.ПолучитьАннотацию(ТочкаМаршрута, "Операция");

	Если Аннотация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Действие.Сводка = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
		Аннотация, "Сводка", "");
	Действие.ОписаниеОперации = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
		Аннотация, "Описание", "");
	Действие.ИдентификаторОперации = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
		Аннотация, "Идентификатор", "");

	// Устаревание срабатывает от любой из двух форм, поэтому только взводится,
	// но не сбрасывается: &Устарело рядом не должна отменяться параметром.
	Если РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
			Аннотация, "Устарело", Ложь) = Истина Тогда
		Действие.Устарело = Истина;
	КонецЕсли;

КонецПроцедуры

// Группы, названные параметром аннотации, добавляются к объявленным отдельной
// &Группа. Описания у них нет: описание принадлежит группе, и задаётся там,
// где группа объявляется отдельной аннотацией.
Процедура ДополнитьГруппамиИзАннотацииОперация(ТочкаМаршрута, Действие)

	Аннотация = РаботаСАннотациями.ПолучитьАннотацию(ТочкаМаршрута, "Операция");

	Если Аннотация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СписокГрупп = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
		Аннотация, "Группы", "");

	Если НЕ ЗначениеЗаполнено(СписокГрупп) Тогда
		Возврат;
	КонецЕсли;

	ИменаОбъявленных = Новый Соответствие();
	Для Каждого Группа Из Действие.Теги Цикл
		ИменаОбъявленных.Вставить(Группа.Имя, Истина);
	КонецЦикла;

	Для Каждого ИмяГруппы Из СтрРазделить(СписокГрупп, ",", Ложь) Цикл

		ИмяГруппы = СокрЛП(ИмяГруппы);

		Если НЕ ЗначениеЗаполнено(ИмяГруппы) ИЛИ ИменаОбъявленных.Получить(ИмяГруппы) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Группа = Новый Структура("Имя, Описание", ИмяГруппы, "");
		Действие.Теги.Добавить(Группа);
		ИменаОбъявленных.Вставить(ИмяГруппы, Истина);

	КонецЦикла;

КонецПроцедуры

// Метаданные, объявленные на контроллере: они относятся ко всем его точкам
// маршрута.
//
// Параметры:
//   КонструкторКонтроллера - СтрокаТаблицыЗначений - конструктор желудя-контроллера.
//
// Возвращаемое значение:
//   Структура:
//     * Теги        - Массив Из Структура - группы, см. ОбъявленныеГруппы.
//     * Устарело    - Булево - контроллер помечен устаревшим.
//     * ЧемЗаменить - Строка - чем пользоваться вместо него.
Функция МетаданныеКонтроллера(КонструкторКонтроллера)

	Метаданные = Новый Структура("Теги, Устарело, ЧемЗаменить",
		ОбъявленныеГруппы(КонструкторКонтроллера), Ложь, "");

	АннотацияУстарело = РаботаСАннотациями.ПолучитьАннотацию(КонструкторКонтроллера, "Устарело");

	Если АннотацияУстарело <> Неопределено Тогда
		Метаданные.Устарело = Истина;
		Метаданные.ЧемЗаменить = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
			АннотацияУстарело, "Значение", "");
	КонецЕсли;

	Возврат Метаданные;

КонецФункции

// Теги контроллера относятся ко всем его точкам маршрута. Теги операции их
// не вытесняют, а дополняют: контроллер задаёт общую группу, а точка маршрута
// может входить дополнительно в свою.
//
// Устаревание же не дополняется, а наследуется: устаревший контроллер делает
// устаревшими все свои точки маршрута, а собственная пометка точки маршрута
// уточняет, чем её заменить.
Процедура ДополнитьМетаданнымиКонтроллера(Действие, МетаданныеКонтроллера)

	ИменаТегов = Новый Соответствие();

	Для Каждого Тег Из Действие.Теги Цикл
		ИменаТегов.Вставить(Тег.Имя, Истина);
	КонецЦикла;

	Для Каждого Тег Из МетаданныеКонтроллера.Теги Цикл
		Если ИменаТегов.Получить(Тег.Имя) = Неопределено Тогда
			Действие.Теги.Добавить(Тег);
		КонецЕсли;
	КонецЦикла;

	Если НЕ МетаданныеКонтроллера.Устарело Тогда
		Возврат;
	КонецЕсли;

	Действие.Устарело = Истина;

	Если НЕ ЗначениеЗаполнено(Действие.ЧемЗаменить) Тогда
		Действие.ЧемЗаменить = МетаданныеКонтроллера.ЧемЗаменить;
	КонецЕсли;

КонецПроцедуры

// Собирает группы, объявленные аннотацией &Группа.
//
// Аннотация повторяемая: и контроллер, и точка маршрута могут входить сразу
// в несколько групп, поэтому читаются все её вхождения.
//
// Параметры:
//   Размеченный - СтрокаТаблицыЗначений - метод контроллера или его конструктор.
//
// Возвращаемое значение:
//   Массив Из Структура - описания групп:
//     * Имя      - Строка - имя группы.
//     * Описание - Строка - описание группы, пустое - если не задано.
Функция ОбъявленныеГруппы(Размеченный)

	Группы = Новый Массив();

	Для Каждого Аннотация Из РаботаСАннотациями.ПолучитьАннотации(Размеченный, "Группа") Цикл

		Группа = Новый Структура("Имя, Описание");
		Группа.Имя = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Значение", "");
		Группа.Описание = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Описание", "");

		Если ЗначениеЗаполнено(Группа.Имя) Тогда
			Группы.Добавить(Группа);
		КонецЕсли;

	КонецЦикла;

	Возврат Группы;

КонецФункции

// Сохраняет параметры точки маршрута вместе с их аннотациями.
//
// Действие.Параметры хранит только имена - этого хватает, чтобы подставить
// значения при вызове. Аннотации нужны отдельно: по ним генератор OpenAPI
// строит схему параметра, как строит её по полям типа.
//
// Параметры:
//   ТочкаМаршрута - СтрокаТаблицыЗначений - описание метода контроллера.
//
// Возвращаемое значение:
//   Соответствие Из СтрокаТаблицыЗначений - параметры по их именам.
Функция ОписанияПараметров(ТочкаМаршрута)

	Описания = Новый Соответствие();

	Для Каждого Параметр Из ТочкаМаршрута.Параметры Цикл
		Описания.Вставить(Параметр.Имя, Параметр);
	КонецЦикла;

	Возврат Описания;

КонецФункции

// Собирает объявленные ответы точки маршрута.
//
// Аннотация &Возвращает повторяемая - по одной на код состояния, поэтому
// читаются все её вхождения, а не первое.
//
// Параметры:
//   ТочкаМаршрута - СтрокаТаблицыЗначений - описание метода контроллера.
//
// Возвращаемое значение:
//   Массив Из Структура - описания ответов:
//     * Код      - Число  - код состояния HTTP.
//     * Тип      - Строка - имя типа тела ответа, пустое - если не объявлен.
//     * Описание - Строка - описание ответа.
//     * Элемент  - Строка - имя типа элементов коллекции, пустое - если не объявлен.
//     * ТипСодержимого - Строка - MIME-тип тела ответа.
Функция ОписанныеОтветы(ТочкаМаршрута)

	Ответы = Новый Массив();

	Для Каждого Аннотация Из РаботаСАннотациями.ПолучитьАннотации(ТочкаМаршрута, "Возвращает") Цикл

		Ответ = Новый Структура("Код, Тип, Описание, Элемент, ТипСодержимого");
		Ответ.Код = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Код", 200);
		Ответ.Тип = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Тип", "");
		Ответ.Описание = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Описание", "");
		Ответ.Элемент = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Элемент", "");
		Ответ.ТипСодержимого = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
			Аннотация, "ТипСодержимого", "application/json");

		Ответы.Добавить(Ответ);

	КонецЦикла;

	Возврат Ответы;

КонецФункции

Процедура ЗарегистрироватьОтображение(ТочкаМаршрута, Действие)
	Аннотация = РаботаСАннотациями.ПолучитьАннотацию(ТочкаМаршрута, "Отображение");
	Если НЕ Аннотация = Неопределено Тогда
		РасположениеОтображения = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация);
		МенеджерОтображений.ДобавитьОтображениеДействия(Действие, РасположениеОтображения);
	КонецЕсли;
КонецПроцедуры

Процедура ЗарегистрироватьРолиТочкиМаршрута(ТочкаМаршрута, Действие)
	Аннотация = РаботаСАннотациями.ПолучитьАннотацию(ТочкаМаршрута, "Роли");
	Если НЕ Аннотация = Неопределено Тогда
		СписокРолей = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация);
		МенеджерДоступа.ДобавитьРолиТочкиДоступаСписком(Действие, СписокРолей);
	КонецЕсли;
КонецПроцедуры

// Соединение Server-Sent Events нативного веб-сервера.
//
// Kestrel завершает ответ, как только обработчик запроса вернёт управление, поэтому поток
// запроса ждёт в ОжидатьЗакрытия, пока соединение не закроет сервер или клиент. События
// тем временем пишутся в тело ответа из других потоков: обработчиков, рассылающих
// сообщения, и контроля соединений.
//
// Для пула соединений объект выглядит так же, как TCPСоединение прикладного сервера:
// у него есть ОтправитьДвоичныеДанные и Закрыть.

Перем _Контекст; // КонтекстЗапроса - контекст запроса, в тело ответа которого пишутся события
Перем _СоединенияСерверныхСобытий; // СоединенияСерверныхСобытий - пул, из которого соединение удаляется
Перем _Лог; // Лог - лог веб-сервера
Перем _Закрыто; // Булево - соединение закрыто сервером или из-за ошибки записи
Перем _Блокировка; // БлокировкаРесурса - сериализует запись: тело ответа не допускает параллельной записи
Перем _ШагОжидания; // Число - как часто поток запроса проверяет, не закрыто ли соединение, мс

// Поток запроса Kestrel завершился - соединения больше нет, даже если ожидание
// прервалось исключением. Обработчик не бросает исключений: движок обходит
// подписчиков завершения потока одним циклом и до остальных бы не дошёл.
//
// Объявлен до конструктора: имя обработчика движок разрешает в один проход.
// Вызов через ДобавитьОбработчик статический анализ не видит, отсюда подавление диагностики.
//
// BSLLS:UnusedLocalMethod-off
Процедура ПриЗавершенииПотока()
	_Закрыто = Истина;
	Попытка
		_СоединенияСерверныхСобытий.УдалитьСоединение(ЭтотОбъект);
	Исключение
		_Лог.Ошибка("Не удалось удалить SSE соединение из пула: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры
// BSLLS:UnusedLocalMethod-on

// Создаётся в потоке запроса Kestrel и подписывается на его завершение.
//
// Параметры:
//  Контекст                   - КонтекстЗапроса - Контекст запроса на серверные события.
//  СоединенияСерверныхСобытий - СоединенияСерверныхСобытий - Пул соединений.
//
Процедура ПриСозданииОбъекта(Контекст, СоединенияСерверныхСобытий)
	_Контекст = Контекст;
	_СоединенияСерверныхСобытий = СоединенияСерверныхСобытий;
	_Лог = Логирование.ПолучитьЛог("oscript.lib.winow");
	_Закрыто = Ложь;
	_Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	// Опрос, а не ожидание сигнала: в движке нет примитива, который один поток ждёт,
	// а другой освобождает. Шаг влияет только на то, как быстро освобождается поток
	// после закрытия, на доставку событий он не влияет.
	_ШагОжидания = 100;

	ДобавитьОбработчик ТекущийПоток().ПриЗавершении, ПриЗавершенииПотока;
КонецПроцедуры

// Пишет событие в тело ответа и сразу отправляет его клиенту.
//
// Параметры:
//  Данные - ДвоичныеДанные - Сформированное событие.
//
Процедура ОтправитьДвоичныеДанные(Данные) Экспорт

	_Блокировка.Заблокировать();
	Попытка
		Если _Закрыто Тогда
			ВызватьИсключение "SSE соединение закрыто";
		КонецЕсли;
		Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
		_Контекст.Ответ.Тело.Записать(Буфер, 0, Буфер.Размер);
		_Контекст.Ответ.Тело.СброситьБуферы();
	Исключение
		_Закрыто = Истина;
		_Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_Блокировка.Разблокировать();

КонецПроцедуры

// Закрывает соединение со стороны сервера: поток запроса выходит из ожидания,
// и Kestrel завершает ответ.
Процедура Закрыть() Экспорт
	_Закрыто = Истина;
КонецПроцедуры

// Ждёт, пока соединение не закроет сервер или клиент.
Процедура ОжидатьЗакрытия() Экспорт
	Пока НЕ _Закрыто И НЕ _Контекст.ЗапросПрерван Цикл
		Приостановить(_ШагОжидания);
	КонецЦикла;
КонецПроцедуры

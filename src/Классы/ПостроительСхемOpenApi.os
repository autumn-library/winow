#Использовать autumn

#Область ОписаниеПеременных

// Рефлектор - перечисление свойств типа.
Перем Рефлектор;

// Соответствие Из Строка - имена простых типов OneScript и их типы в OpenAPI.
Перем ПростыеТипы;

// Строка - префикс ссылки на схему в документе спецификации.
Перем ПрефиксСсылки;

// Строка - имя строкового типа схемы. Имена трёх типов вынесены в переменные,
// потому что построитель на них ветвится: от типа схемы зависит и то, куда
// ложится схема элементов, и то, какой парой ключевых слов пишется размер.
// Остальные имена типов только записываются в схему и нигде не сравниваются.
Перем ТипСхемыСтрока;

// Строка - имя массивного типа схемы.
Перем ТипСхемыМассив;

// Строка - имя объектного типа схемы.
Перем ТипСхемыОбъект;

&Пластилин
// Контейнер определений аннотаций. Autumn при сканировании типов складывает
// в него все классы с методом &Аннотация, то есть и аннотации validate тоже.
Перем КонтейнерАннотаций;

&Пластилин
// Выдаёт имена схем: ключи components обязаны быть латинскими.
Перем ИменаOpenApi;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Строит схемы OpenAPI по пользовательским типам.
//
// Источник сведений о полях - те же аннотации, по которым работают соседние
// библиотеки: jason описывает представление поля в JSON, validate - его тип
// и ограничения. Своих аннотаций построитель не вводит: если тип уже размечен
// для сериализации и валидации, он размечен и для документации.
//
// Соответствие аннотаций ключевым словам схемы:
//   `&Сериализуемое("имя")` - имя свойства в JSON
//   `&Сериализуемое(Обязательное = Истина)`, `&Заполнено` - попадает в required
//   `&Сериализуемое(Обязательное = Истина)` без `&Заполнено` - тип допускает null:
//                            такое поле при пустом значении и выдаётся как null
//   `&Несериализуемое`     - свойство исключается из схемы
//   `&Тип("Строка")`       - type, а для пользовательского типа - $ref
//   `&Минимум(N)`, `&Максимум(N)` - minimum/maximum
//   `&Истина`, `&Ложь`     - boolean с единственным допустимым значением
//   `&Размер(Минимум = N, Максимум = N)` - minLength/maxLength, minItems/maxItems
//                            либо minProperties/maxProperties - смотря какого типа схема
//   `&Шаблон("рег.выр.")`  - pattern
//   `&ОдинИз(А, Б, В)`     - enum
//   `&Кратно(N)`           - multipleOf
//   `&Формат("email")`     - format
//   `&ДляКаждого("Значение")` - последующие ограничения относятся к элементам:
//                            items у массива, additionalProperties у объекта
//   `&ДляКаждого("Ключ")`  - последующие ограничения относятся к ключам объекта:
//                            propertyNames
&Желудь
Процедура ПриСозданииОбъекта()

	Рефлектор = Новый Рефлектор();
	ПрефиксСсылки = "#/components/schemas/";

	ТипСхемыСтрока = "string";
	ТипСхемыМассив = "array";
	ТипСхемыОбъект = "object";

	// Ключи справочника - сами типы, а не их имена: строковое представление типа
	// зависит от контекста выполнения и приходит то на русском, то на английском.
	ПростыеТипы = Новый Соответствие();
	ПростыеТипы.Вставить(Тип("Строка"), СхемаЗначения(ТипСхемыСтрока));
	ПростыеТипы.Вставить(Тип("Число"), СхемаЗначения("number"));
	ПростыеТипы.Вставить(Тип("Булево"), СхемаЗначения("boolean"));
	ПростыеТипы.Вставить(Тип("Дата"), СхемаДаты());
	ПростыеТипы.Вставить(Тип("Массив"), СхемаМассива());
	ПростыеТипы.Вставить(Тип("ФиксированныйМассив"), СхемаМассива());
	ПростыеТипы.Вставить(Тип("Структура"), ОбъектнаяСхема());
	ПростыеТипы.Вставить(Тип("ФиксированнаяСтруктура"), ОбъектнаяСхема());
	ПростыеТипы.Вставить(Тип("Соответствие"), ОбъектнаяСхема());
	ПростыеТипы.Вставить(Тип("ФиксированноеСоответствие"), ОбъектнаяСхема());

КонецПроцедуры

// Регистрирует схему типа в сборке и возвращает ссылку на неё.
//
// Параметры:
//   Сборка      - СборкаСпецификации - состояние собираемого документа.
//   ТипЗначения - Тип - пользовательский тип.
//
// Возвращаемое значение:
//   Соответствие - объект схемы OpenAPI: ссылка на зарегистрированную схему
//                  либо схема простого типа, если ссылаться не на что.
Функция СхемаТипа(Сборка, ТипЗначения) Экспорт

	Если ТипЗначения = Неопределено Тогда
		Возврат Новый Соответствие();
	КонецЕсли;

	ОбразецСхемы = ПростыеТипы.Получить(ТипЗначения);

	Если ОбразецСхемы <> Неопределено Тогда
		Возврат КопияСхемы(ОбразецСхемы);
	КонецЕсли;

	ИмяСхемы = ИменаOpenApi.ИмяСхемы(Сборка, ТипЗначения);
	ЗарегистрироватьТип(Сборка, ТипЗначения, ИмяСхемы);

	Возврат Ссылка(ИмяСхемы);

КонецФункции

// Схема коллекции с объявленным типом элементов.
//
// Тип элементов в OneScript нигде не хранится, поэтому его называют снаружи -
// например, аннотацией &Возвращает(Тип = "Массив", Элемент = "Товар").
//
// Параметры:
//   Сборка       - СборкаСпецификации - состояние собираемого документа.
//   ТипЗначения  - Тип - тип самой коллекции.
//   ТипЭлементов - Тип, Неопределено - тип элементов; Неопределено - не объявлен.
//
// Возвращаемое значение:
//   Соответствие - объект схемы OpenAPI.
Функция СхемаКоллекции(Сборка, ТипЗначения, ТипЭлементов) Экспорт

	Схема = СхемаТипа(Сборка, ТипЗначения);

	Если ТипЭлементов <> Неопределено Тогда
		РазместитьСхемуЭлементов(Схема, СхемаТипа(Сборка, ТипЭлементов));
	КонецЕсли;

	Возврат Схема;

КонецФункции

// Строит схему по аннотациям размеченного элемента.
//
// Элементом может быть и свойство типа, и параметр метода: аннотации на них
// одни и те же, поэтому и схема строится одинаково. Без аннотации &Тип схема
// остаётся пустой - это значение любого вида.
//
// Параметры:
//   Сборка  - СборкаСпецификации - состояние собираемого документа.
//   Элемент - СтрокаТаблицыЗначений - свойство типа или параметр метода.
//
// Возвращаемое значение:
//   Соответствие - объект схемы OpenAPI.
Функция СхемаПоАннотациям(Сборка, Элемент) Экспорт
	Возврат СхемаСвойства(Сборка, Элемент);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Схема значения объявленного типа.
//
// Параметры:
//   ТипOpenApi - Строка - имя типа схемы.
//
// Возвращаемое значение:
//   Соответствие - объект схемы OpenAPI.
Функция СхемаЗначения(ТипOpenApi)
	Схема = Новый Соответствие();
	Схема.Вставить("type", ТипOpenApi);
	Возврат Схема;
КонецФункции

// Схема даты.
//
// Возвращаемое значение:
//   Соответствие - объект схемы OpenAPI.
Функция СхемаДаты()
	Схема = СхемаЗначения(ТипСхемыСтрока);
	Схема.Вставить("format", "date-time");
	Возврат Схема;
КонецФункции

// Схема массива.
//
// Тип элементов массива в OneScript нигде не объявлен, поэтому items остаётся
// пустым: по JSON Schema это значит "элемент любого вида".
//
// Возвращаемое значение:
//   Соответствие - объект схемы OpenAPI.
Функция СхемаМассива()
	Схема = СхемаЗначения(ТипСхемыМассив);
	Схема.Вставить("items", Новый Соответствие());
	Возврат Схема;
КонецФункции

// Строит схему типа и кладёт её в сборку под выданным именем.
//
// Схема помещается в справочник до обхода полей: тип, ссылающийся сам на себя
// напрямую или через цепочку полей, иначе увёл бы обход в бесконечную рекурсию.
//
// Параметры:
//   Сборка      - СборкаСпецификации - состояние собираемого документа.
//   ТипЗначения - Тип - пользовательский тип.
//   ИмяСхемы    - Строка - имя, выданное типу в components/schemas.
Процедура ЗарегистрироватьТип(Сборка, ТипЗначения, ИмяСхемы)

	Если Сборка.Схемы().Получить(ИмяСхемы) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сборка.Схемы().Вставить(ИмяСхемы, ОбъектнаяСхема());

	Схема = ПостроитьСхемуТипа(Сборка, ТипЗначения);
	ДополнитьИсходнымИменемТипа(Схема, ТипЗначения, ИмяСхемы);

	Сборка.Схемы().Вставить(ИмяСхемы, Схема);

КонецПроцедуры

// Дописывает в схему исходное имя типа.
//
// Ключом схемы может быть только латиница, поэтому кириллическое имя типа
// в нём не сохраняется. Чтобы оно не пропало совсем, исходное имя попадает
// в description: по документу видно, какому классу отвечает схема.
//
// Если имя и так пригодно в качестве ключа, повторять его незачем.
//
// Параметры:
//   Схема       - Соответствие - объект схемы OpenAPI.
//   ТипЗначения - Тип - пользовательский тип.
//   ИмяСхемы    - Строка - имя, выданное типу в components/schemas.
Процедура ДополнитьИсходнымИменемТипа(Схема, ТипЗначения, ИмяСхемы)

	ИсходноеИмя = Строка(ТипЗначения);

	Если ИсходноеИмя = ИмяСхемы Тогда
		Возврат;
	КонецЕсли;

	Схема.Вставить("description", ИсходноеИмя);

КонецПроцедуры

// Строит объектную схему по свойствам типа.
//
// Параметры:
//   Сборка      - СборкаСпецификации - состояние собираемого документа.
//   ТипЗначения - Тип - пользовательский тип.
//
// Возвращаемое значение:
//   Соответствие - объект схемы OpenAPI.
Функция ПостроитьСхемуТипа(Сборка, ТипЗначения)

	Свойства = Новый Соответствие();
	Обязательные = Новый Массив();

	Для Каждого Свойство Из СвойстваТипа(ТипЗначения) Цикл

		Если Аннотация(Свойство, "Несериализуемое") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИмяПоля = ИмяПоляВJson(Свойство);
		Свойства.Вставить(ИмяПоля, СхемаСвойства(Сборка, Свойство));

		Если СвойствоОбязательно(Свойство) Тогда
			Обязательные.Добавить(ИмяПоля);
		КонецЕсли;

	КонецЦикла;

	Схема = ОбъектнаяСхема();
	Схема.Вставить("properties", Свойства);

	Если Обязательные.Количество() > 0 Тогда
		Схема.Вставить("required", Обязательные);
	КонецЕсли;

	Возврат Схема;

КонецФункции

// Свойства типа, доступные для перечисления.
//
// Тип может не поддерживать перечисление свойств - например, если он объявлен
// не пользовательским классом. Документацию из-за этого ронять незачем:
// такой тип описывается пустым объектом.
//
// Параметры:
//   ТипЗначения - Тип - пользовательский тип.
//
// Возвращаемое значение:
//   ТаблицаЗначений, Массив - свойства типа либо пустой массив.
Функция СвойстваТипа(ТипЗначения)

	Попытка
		Возврат Рефлектор.ПолучитьТаблицуСвойств(ТипЗначения, Истина);
	Исключение
		Возврат Новый Массив();
	КонецПопытки;

КонецФункции

// Схема одного свойства типа или параметра метода.
//
// Параметры:
//   Сборка   - СборкаСпецификации - состояние собираемого документа.
//   Свойство - СтрокаТаблицыЗначений - свойство типа или параметр метода.
//
// Возвращаемое значение:
//   Соответствие - объект схемы OpenAPI.
Функция СхемаСвойства(Сборка, Свойство)

	Разобранные = РазобратьАннотации(Свойство);

	Схема = СхемаПоОграничениям(Сборка, Разобранные.Значения);

	ДополнитьВложеннымиСхемами(Сборка, Схема, Разобранные.Элементы, Разобранные.Ключи);

	// Последним: до этого места тип схемы читают и размер, и вложенные схемы,
	// а обнуляемость превращает его в список, с которым им работать незачем.
	Если СвойствоОбнуляемо(Свойство, Разобранные.Значения) Тогда
		Схема = ДопуститьПустоеЗначение(Схема);
	КонецЕсли;

	Возврат Схема;

КонецФункции

// Допускает ли свойство пустое значение.
//
// Поле с &Сериализуемое(Обязательное) при пустом значении попадает в JSON как
// null - в этом весь смысл флага, он на то и нужен, чтобы ключ не исчезал.
// Значит схема обязана допускать null, иначе документ отвергал бы ровно то,
// что winow сам и выдаёт.
//
// &Заполнено это отменяет: validate требует непустого значения, и null ему не
// подходит. Отменяют и &Истина с &Ложь - они называют конкретное значение.
//
// Параметры:
//   Свойство           - СтрокаТаблицыЗначений - свойство типа или параметр метода.
//   ОграниченияЗначения - Массив - объекты аннотаций, ограничивающих само значение.
//
// Возвращаемое значение:
//   Булево - Истина, если значением поля может оказаться null.
Функция СвойствоОбнуляемо(Свойство, ОграниченияЗначения)

	АннотацияСериализуемое = Аннотация(Свойство, "Сериализуемое");

	Если АннотацияСериализуемое = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Обязательное = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
		АннотацияСериализуемое, "Обязательное", Ложь) = Истина;

	Если НЕ Обязательное Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НайтиОграничение(ОграниченияЗначения, Тип("АннотацияЗаполнено")) = Неопределено
		И НайтиОграничение(ОграниченияЗначения, Тип("АннотацияИстина")) = Неопределено
		И НайтиОграничение(ОграниченияЗначения, Тип("АннотацияЛожь")) = Неопределено;

КонецФункции

// Дополняет схему допущением пустого значения.
//
// В OpenAPI 3.1 отдельного nullable нет: null становится ещё одним членом
// списка типов. Со ссылкой так не выйдет - соседние с $ref ключи применяются
// вместе со ссылкой, и значение должно было бы удовлетворять и ей, и null
// разом. Обнуляемая ссылка выражается только выбором из двух схем.
//
// Параметры:
//   Схема - Соответствие - объект схемы OpenAPI.
//
// Возвращаемое значение:
//   Соответствие - схема, допускающая null.
Функция ДопуститьПустоеЗначение(Схема)

	Если Схема.Получить("$ref") <> Неопределено Тогда
		Возврат СхемаВыбораСПустым(Схема);
	КонецЕсли;

	ТипСхемы = Схема.Получить("type");

	// Схема без объявленного типа и так допускает любое значение, включая null.
	Если ТипСхемы = Неопределено Тогда
		Возврат Схема;
	КонецЕсли;

	Типы = Новый Массив();
	Типы.Добавить(ТипСхемы);
	Типы.Добавить("null");
	Схема.Вставить("type", Типы);

	Возврат Схема;

КонецФункции

// Выбор из исходной схемы и пустого значения.
//
// Параметры:
//   Схема - Соответствие - объект схемы OpenAPI.
//
// Возвращаемое значение:
//   Соответствие - схема anyOf из исходной схемы и null.
Функция СхемаВыбораСПустым(Схема)

	ПустоеЗначение = Новый Соответствие();
	ПустоеЗначение.Вставить("type", "null");

	Варианты = Новый Массив();
	Варианты.Добавить(Схема);
	Варианты.Добавить(ПустоеЗначение);

	Выбор = Новый Соответствие();
	Выбор.Вставить("anyOf", Варианты);

	Возврат Выбор;

КонецФункции

// Раскладывает аннотации свойства на три набора: ограничения самого значения,
// ограничения элементов коллекции и ограничения её ключей.
//
// Обход идёт в порядке написания, потому что &ДляКаждого - это переключатель:
// он не ограничивает ничего сам, а переадресует последующие ограничения
// элементам или ключам. Ровно так же аннотации читает validate, и порядок
// значим и там.
//
// Параметры:
//   Свойство - СтрокаТаблицыЗначений - свойство типа или параметр метода.
//
// Возвращаемое значение:
//   Структура - наборы ограничений:
//     * Значения - Массив - объекты аннотаций, ограничивающих само значение.
//     * Элементы - Массив - объекты аннотаций после &ДляКаждого("Значение").
//     * Ключи    - Массив - объекты аннотаций после &ДляКаждого("Ключ").
Функция РазобратьАннотации(Свойство)

	Разобранные = Новый Структура("Значения, Элементы, Ключи",
		Новый Массив(), Новый Массив(), Новый Массив());

	Приемник = Разобранные.Значения;

	Для Каждого Аннотация Из Свойство.Аннотации Цикл

		Ограничение = ОбъектАннотации(Аннотация);

		Если Ограничение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(Ограничение) = Тип("АннотацияДляКаждого") Тогда
			Если НРег(Ограничение.Режим()) = "ключ" Тогда
				Приемник = Разобранные.Ключи;
			Иначе
				Приемник = Разобранные.Элементы;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Приемник.Добавить(Ограничение);

	КонецЦикла;

	Возврат Разобранные;

КонецФункции

// Строит схему по набору ограничений.
//
// Параметры:
//   Сборка      - СборкаСпецификации - состояние собираемого документа.
//   Ограничения - Массив - объекты аннотаций validate.
//
// Возвращаемое значение:
//   Соответствие - объект схемы OpenAPI.
Функция СхемаПоОграничениям(Сборка, Ограничения)

	ОграничениеТипа = НайтиОграничение(Ограничения, Тип("АннотацияТип"));

	Если ОграничениеТипа = Неопределено Тогда
		Схема = Новый Соответствие();
	Иначе
		Схема = СхемаТипа(Сборка, ОграничениеТипа.ТипЗначения());
	КонецЕсли;

	// Ограничения дописываются и рядом со ссылкой: в OpenAPI 3.1 схемы -
	// полноценный JSON Schema 2020-12, где соседние с $ref ключи применяются
	// наравне со ссылкой. В 3.0 их полагалось игнорировать, и ограничения поля
	// со ссылочным типом пропадали.
	ДополнитьОграничениями(Схема, Ограничения);

	Возврат Схема;

КонецФункции

// Дописывает в схему схемы элементов коллекции и её ключей.
//
// Тип элементов коллекции в OneScript нигде не объявлен, поэтому без &ДляКаждого
// про содержимое массива или соответствия сказать нечего. Объявленный же им тип
// ложится прямо в схему: в JSON Schema 2020-12 для этого есть items у массива,
// additionalProperties у объекта и propertyNames для его ключей.
//
// Параметры:
//   Сборка              - СборкаСпецификации - состояние собираемого документа.
//   Схема               - Соответствие - объект схемы OpenAPI.
//   ОграниченияЭлементов - Массив - объекты аннотаций после &ДляКаждого("Значение").
//   ОграниченияКлючей   - Массив - объекты аннотаций после &ДляКаждого("Ключ").
Процедура ДополнитьВложеннымиСхемами(Сборка, Схема, ОграниченияЭлементов, ОграниченияКлючей)

	ТипСхемы = Схема.Получить("type");

	Если ОграниченияЭлементов.Количество() > 0 Тогда
		РазместитьСхемуЭлементов(Схема, СхемаПоОграничениям(Сборка, ОграниченияЭлементов));
	КонецЕсли;

	Если ОграниченияКлючей.Количество() > 0 И ТипСхемы = ТипСхемыОбъект Тогда
		Схема.Вставить("propertyNames", СхемаПоОграничениям(Сборка, ОграниченияКлючей));
	КонецЕсли;

КонецПроцедуры

// Кладёт схему элементов туда, где её ждут по виду коллекции.
//
// Куда класть схему элементов, зависит от вида коллекции: у массива это items,
// у объекта - additionalProperties. Для схемы без известного типа класть некуда.
//
// Параметры:
//   Схема          - Соответствие - объект схемы OpenAPI.
//   СхемаЭлементов - Соответствие - объект схемы элементов коллекции.
Процедура РазместитьСхемуЭлементов(Схема, СхемаЭлементов)

	ТипСхемы = Схема.Получить("type");

	Если ТипСхемы = ТипСхемыМассив Тогда
		Схема.Вставить("items", СхемаЭлементов);
	ИначеЕсли ТипСхемы = ТипСхемыОбъект Тогда
		Схема.Вставить("additionalProperties", СхемаЭлементов);
	Иначе
		// Тип схемы неизвестен - подходящего ключевого слова нет.
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Ищет в наборе ограничение заданного вида.
//
// Параметры:
//   Ограничения   - Массив - объекты аннотаций validate.
//   ТипАннотации  - Тип - искомый тип объекта аннотации.
//
// Возвращаемое значение:
//   Произвольный, Неопределено - найденный объект аннотации либо Неопределено.
Функция НайтиОграничение(Ограничения, ТипАннотации)

	Для Каждого Ограничение Из Ограничения Цикл
		Если ТипЗнч(Ограничение) = ТипАннотации Тогда
			Возврат Ограничение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Переносит ограничения validate в схему.
//
// Ограничения переносятся как есть.
//
// &Минимум и &Максимум сравнивают само значение оператором сравнения, а не его
// длину, поэтому им соответствуют minimum и maximum, а не minLength/maxLength.
// По JSON Schema эти ключевые слова применимы только к числам и для значений
// других типов просто игнорируются - ровно та же область действия, что и у
// исходного ограничения.
//
// Параметры:
//   Схема       - Соответствие - объект схемы OpenAPI.
//   Ограничения - Массив - объекты аннотаций validate.
Процедура ДополнитьОграничениями(Схема, Ограничения)

	ОграничениеМинимума = НайтиОграничение(Ограничения, Тип("АннотацияМинимум"));
	Если ОграничениеМинимума <> Неопределено Тогда
		Схема.Вставить("minimum", ОграничениеМинимума.Минимум());
	КонецЕсли;

	ОграничениеМаксимума = НайтиОграничение(Ограничения, Тип("АннотацияМаксимум"));
	Если ОграничениеМаксимума <> Неопределено Тогда
		Схема.Вставить("maximum", ОграничениеМаксимума.Максимум());
	КонецЕсли;

	ДополнитьРазмером(Схема, Ограничения);
	ДополнитьШаблоном(Схема, Ограничения);
	ДополнитьПеречислением(Схема, Ограничения);
	ДополнитьКратностью(Схема, Ограничения);
	ДополнитьФорматом(Схема, Ограничения);

	// Последними: &Истина и &Ложь задают и type, и enum целиком, а значит
	// должны перекрывать всё, что могли бы написать соседние ограничения.
	Если НайтиОграничение(Ограничения, Тип("АннотацияИстина")) <> Неопределено Тогда
		УстановитьЕдинственноеЗначение(Схема, Истина);
	ИначеЕсли НайтиОграничение(Ограничения, Тип("АннотацияЛожь")) <> Неопределено Тогда
		УстановитьЕдинственноеЗначение(Схема, Ложь);
	Иначе
		// Значение поля ничем из двух не закреплено - перекрывать нечего.
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Дописывает в схему ограничение размера.
//
// &Размер ограничивает размер значения: Количество() у коллекций, иначе длину
// строкового представления. В JSON Schema для этого три разные пары ключевых
// слов, и какая из них подходит, видно по типу схемы.
//
// Ноль у обеих границ означает "не задано": нижняя граница нулю равна и так,
// а Максимум = 0 сам валидатор трактует как отсутствие верхней границы.
//
// Параметры:
//   Схема       - Соответствие - объект схемы OpenAPI.
//   Ограничения - Массив - объекты аннотаций validate.
Процедура ДополнитьРазмером(Схема, Ограничения)

	ОграничениеРазмера = НайтиОграничение(Ограничения, Тип("АннотацияРазмер"));

	Если ОграничениеРазмера = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КлючиРазмера = КлючиРазмераДляСхемы(Схема);

	Если КлючиРазмера = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ОграничениеРазмера.Минимум() > 0 Тогда
		Схема.Вставить(КлючиРазмера.Минимум, ОграничениеРазмера.Минимум());
	КонецЕсли;

	Если ОграничениеРазмера.Максимум() > 0 Тогда
		Схема.Вставить(КлючиРазмера.Максимум, ОграничениеРазмера.Максимум());
	КонецЕсли;

КонецПроцедуры

// Пара ключевых слов размера, подходящая типу схемы.
//
// Тип схемы бывает неизвестен - например, у поля без аннотации &Тип или у поля
// со ссылкой на другую схему. Гадать, какую пару ключевых слов писать, незачем:
// неподходящая пара молча не сработала бы.
//
// Параметры:
//   Схема - Соответствие - объект схемы OpenAPI.
//
// Возвращаемое значение:
//   Структура, Неопределено - имена ключевых слов либо Неопределено, если
//                             подходящей пары нет:
//     * Минимум  - Строка - ключевое слово нижней границы.
//     * Максимум - Строка - ключевое слово верхней границы.
Функция КлючиРазмераДляСхемы(Схема)

	ТипСхемы = Схема.Получить("type");

	Если ТипСхемы = ТипСхемыСтрока Тогда
		Возврат КлючиРазмера("minLength", "maxLength");
	ИначеЕсли ТипСхемы = ТипСхемыМассив Тогда
		Возврат КлючиРазмера("minItems", "maxItems");
	ИначеЕсли ТипСхемы = ТипСхемыОбъект Тогда
		Возврат КлючиРазмера("minProperties", "maxProperties");
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Пара ключевых слов размера.
//
// Параметры:
//   ИмяМинимума  - Строка - ключевое слово нижней границы.
//   ИмяМаксимума - Строка - ключевое слово верхней границы.
//
// Возвращаемое значение:
//   Структура - имена ключевых слов:
//     * Минимум  - Строка - ключевое слово нижней границы.
//     * Максимум - Строка - ключевое слово верхней границы.
Функция КлючиРазмера(ИмяМинимума, ИмяМаксимума)
	Возврат Новый Структура("Минимум, Максимум", ИмяМинимума, ИмяМаксимума);
КонецФункции

// Дописывает в схему шаблон значения.
//
// Валидатор проверяет шаблон якорным - РегулярноеВыражение("^(?:" + Шаблон + ")$").
// В JSON Schema pattern, наоборот, ищется в любой части строки, поэтому в схему
// пишется та же якорная форма: иначе документация оказалась бы мягче проверки.
//
// Параметры:
//   Схема       - Соответствие - объект схемы OpenAPI.
//   Ограничения - Массив - объекты аннотаций validate.
Процедура ДополнитьШаблоном(Схема, Ограничения)

	ОграничениеШаблона = НайтиОграничение(Ограничения, Тип("АннотацияШаблон"));

	Если ОграничениеШаблона <> Неопределено Тогда
		Схема.Вставить("pattern", "^(?:" + ОграничениеШаблона.Шаблон() + ")$");
	КонецЕсли;

КонецПроцедуры

// Дописывает в схему перечисление допустимых значений.
//
// Параметры:
//   Схема       - Соответствие - объект схемы OpenAPI.
//   Ограничения - Массив - объекты аннотаций validate.
Процедура ДополнитьПеречислением(Схема, Ограничения)

	ОграничениеПеречисления = НайтиОграничение(Ограничения, Тип("АннотацияОдинИз"));

	Если ОграничениеПеречисления = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Схема.Вставить("enum", ОграничениеПеречисления.ДопустимыеЗначения());

КонецПроцедуры

// Дописывает в схему кратность значения.
//
// Параметры:
//   Схема       - Соответствие - объект схемы OpenAPI.
//   Ограничения - Массив - объекты аннотаций validate.
Процедура ДополнитьКратностью(Схема, Ограничения)

	ОграничениеКратности = НайтиОграничение(Ограничения, Тип("АннотацияКратно"));

	Если ОграничениеКратности <> Неопределено Тогда
		Схема.Вставить("multipleOf", ОграничениеКратности.Кратность());
	КонецЕсли;

КонецПроцедуры

// Дописывает в схему формат значения.
//
// Коды форматов validate совпадают с именами format из JSON Schema - email,
// uuid, uri, date, date-time, ipv4 - и переносятся как есть. Регистр приводится
// так же, как в самом валидаторе, чтобы код в схеме и код в проверке совпадали.
//
// Параметры:
//   Схема       - Соответствие - объект схемы OpenAPI.
//   Ограничения - Массив - объекты аннотаций validate.
Процедура ДополнитьФорматом(Схема, Ограничения)

	ОграничениеФормата = НайтиОграничение(Ограничения, Тип("АннотацияФормат"));

	Если ОграничениеФормата <> Неопределено Тогда
		Схема.Вставить("format", НРег(СокрЛП(ОграничениеФормата.КодФормата())));
	КонецЕсли;

КонецПроцедуры

// Создаёт объект аннотации по её описанию.
//
// Ограничение читается объектом аннотации, а не разбором её параметров вручную:
// определение аннотации само знает имена параметров, их значения по умолчанию и
// повторяемость. Ровно так же ограничения читает validate, поэтому описанное в
// схеме и проверяемое на самом деле разойтись не могут.
//
// Создание объекта может не удаться - скажем, &Тип называет незарегистрированный
// тип. Ронять из-за этого сборку всей спецификации незачем: поле просто останется
// без ограничения.
//
// Параметры:
//   Аннотация - СтрокаТаблицыЗначений - строка таблицы аннотаций размеченного
//               элемента: Имя аннотации и её Параметры.
//
// Возвращаемое значение:
//   Произвольный, Неопределено - объект аннотации либо Неопределено, если
//                                создать его не удалось.
Функция ОбъектАннотации(Аннотация)

	ОпределениеАннотации = КонтейнерАннотаций.ПолучитьОпределениеАннотации(Аннотация.Имя);

	Если ОпределениеАннотации = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ОпределениеАннотации.СоздатьОбъектАннотации(Аннотация);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Закрепляет за схемой единственное допустимое значение.
//
// Единственное допустимое значение описывается через const, а не перечислением
// из одного элемента: в JSON Schema 2020-12 для этого есть отдельное ключевое
// слово, и оно прямо говорит, что значение ровно одно.
//
// Параметры:
//   Схема    - Соответствие - объект схемы OpenAPI.
//   Значение - Булево - единственное допустимое значение.
Процедура УстановитьЕдинственноеЗначение(Схема, Значение)

	Схема.Вставить("type", "boolean");
	Схема.Вставить("const", Значение);

КонецПроцедуры

// Обязательно ли свойство в объекте.
//
// Обязательность берётся только из ограничений самого значения: &Заполнено
// после &ДляКаждого требует заполненности элементов коллекции, а не наличия
// самого поля, и в required попадать не должно.
//
// Аннотации jason - чистые маркеры: их классы не хранят переданных параметров,
// и объект аннотации ничего бы не сообщил. Поэтому только они и читаются
// разбором параметров напрямую.
//
// Параметры:
//   Свойство - СтрокаТаблицыЗначений - свойство типа или параметр метода.
//
// Возвращаемое значение:
//   Булево - Истина, если свойство попадает в required.
Функция СвойствоОбязательно(Свойство)

	ОграниченияЗначения = РазобратьАннотации(Свойство).Значения;

	Если НайтиОграничение(ОграниченияЗначения, Тип("АннотацияЗаполнено")) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	АннотацияСериализуемое = Аннотация(Свойство, "Сериализуемое");

	Если АннотацияСериализуемое = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
		АннотацияСериализуемое, "Обязательное", Ложь) = Истина;

КонецФункции

// Имя поля в JSON.
//
// Имя задаётся аннотацией jason, иначе совпадает с именем свойства.
//
// Параметры:
//   Свойство - СтрокаТаблицыЗначений - свойство типа или параметр метода.
//
// Возвращаемое значение:
//   Строка - имя поля в JSON.
Функция ИмяПоляВJson(Свойство)

	АннотацияСериализуемое = Аннотация(Свойство, "Сериализуемое");

	Если АннотацияСериализуемое = Неопределено Тогда
		Возврат Свойство.Имя;
	КонецЕсли;

	Возврат РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
		АннотацияСериализуемое, "Значение", Свойство.Имя);

КонецФункции

// Копия образца схемы.
//
// Образец схемы отдаётся копией: вызывающая сторона дополняет её ограничениями
// поля, и правка образца досталась бы всем остальным полям того же типа.
//
// Параметры:
//   ОбразецСхемы - Соответствие - образец схемы простого типа.
//
// Возвращаемое значение:
//   Соответствие - копия образца.
Функция КопияСхемы(ОбразецСхемы)

	Копия = Новый Соответствие();

	Для Каждого КлючИЗначение Из ОбразецСхемы Цикл
		Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

	Возврат Копия;

КонецФункции

// Схема объекта без свойств.
//
// Возвращаемое значение:
//   Соответствие - объект схемы OpenAPI.
Функция ОбъектнаяСхема()
	Схема = Новый Соответствие();
	Схема.Вставить("type", ТипСхемыОбъект);
	Возврат Схема;
КонецФункции

// Ссылка на схему в components.
//
// Параметры:
//   ИмяТипа - Строка - имя схемы в components/schemas.
//
// Возвращаемое значение:
//   Соответствие - объект схемы OpenAPI со ссылкой $ref.
Функция Ссылка(ИмяТипа)
	Ссылка = Новый Соответствие();
	Ссылка.Вставить("$ref", ПрефиксСсылки + ИмяТипа);
	Возврат Ссылка;
КонецФункции

// Аннотация свойства по её имени.
//
// Параметры:
//   Свойство      - СтрокаТаблицыЗначений - свойство типа или параметр метода.
//   ИмяАннотации  - Строка - имя искомой аннотации.
//
// Возвращаемое значение:
//   СтрокаТаблицыЗначений, Неопределено - строка таблицы аннотаций либо
//                                         Неопределено, если такой аннотации нет.
Функция Аннотация(Свойство, ИмяАннотации)
	Возврат РаботаСАннотациями.ПолучитьАннотацию(Свойство, ИмяАннотации);
КонецФункции

#КонецОбласти

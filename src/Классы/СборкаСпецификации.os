#Область ОписаниеПеременных

// Выданные идентификаторы операций.
// Соответствие из КлючИЗначение:
//  * Ключ - Строка - идентификатор.
//  * Значение - Число - сколько раз он был выдан.
Перем _ВыданныеИдентификаторы;

// Выданные имена схем.
// Соответствие из КлючИЗначение:
//  * Ключ - Строка - имя схемы.
//  * Значение - Число - сколько раз оно было выдано.
Перем _ВыданныеИменаСхем;

// Имена схем, уже выданные типам. Одному типу - одно имя на весь документ:
// иначе ссылка $ref разъехалась бы со схемой.
// Соответствие из КлючИЗначение:
//  * Ключ - Тип - пользовательский тип.
//  * Значение - Строка - выданное ему имя схемы.
Перем _ИменаТипов;

// Собранные схемы. Отдаётся наружу как объект components/schemas документа.
// Соответствие из КлючИЗначение:
//  * Ключ - Строка - имя схемы.
//  * Значение - Соответствие - объект схемы OpenAPI.
Перем _Схемы;

// Описания групп, собранные при обходе операций.
// Соответствие из КлючИЗначение:
//  * Ключ - Строка - имя группы.
//  * Значение - Строка - её описание.
Перем _ОписанияГрупп;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Состояние одной сборки документа OpenAPI.
//
// Спецификация требует уникальности operationId и ключей components в пределах
// одного документа - значит, ровно столько и должны жить реестры выданных имён
// и собранные схемы.
//
// Держать их на желудях нельзя: желудь один на приложение, а документов
// одновременно собирается столько, сколько пришло запросов за спецификацией.
// Реестры разъезжались бы, и операции получали бы числовые суффиксы от чужой
// сборки: get_catalog вместо себя становился get_catalog_3.
//
// Объект создаётся в начале сборки и передаётся по вызовам, поэтому желудям
// собственного состояния не нужно, а сборка получается повторно входимой.
//
// Наружу отдаются не сами переменные, а коллекции: сборка их только заводит,
// а наполняют вызывающие. Заменять коллекцию целиком некому, поэтому и
// экспортных переменных не нужно - хватает функций доступа.
Процедура ПриСозданииОбъекта()

	_ВыданныеИдентификаторы = Новый Соответствие();
	_ВыданныеИменаСхем = Новый Соответствие();
	_ИменаТипов = Новый Соответствие();
	_Схемы = Новый Соответствие();
	_ОписанияГрупп = Новый Соответствие();

КонецПроцедуры

// Реестр выданных идентификаторов операций.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//     * Ключ - Строка - идентификатор.
//     * Значение - Число - сколько раз он был выдан.
Функция ВыданныеИдентификаторы() Экспорт

	Возврат _ВыданныеИдентификаторы;

КонецФункции

// Реестр выданных имён схем.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//     * Ключ - Строка - имя схемы.
//     * Значение - Число - сколько раз оно было выдано.
Функция ВыданныеИменаСхем() Экспорт

	Возврат _ВыданныеИменаСхем;

КонецФункции

// Имена схем, уже выданные типам.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//     * Ключ - Тип - пользовательский тип.
//     * Значение - Строка - выданное ему имя схемы.
Функция ИменаТипов() Экспорт

	Возврат _ИменаТипов;

КонецФункции

// Схемы, собранные при обходе типов.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - объект components/schemas документа:
//     * Ключ - Строка - имя схемы.
//     * Значение - Соответствие - объект схемы OpenAPI.
Функция Схемы() Экспорт

	Возврат _Схемы;

КонецФункции

// Описания групп, собранные при обходе операций.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//     * Ключ - Строка - имя группы.
//     * Значение - Строка - её описание.
Функция ОписанияГрупп() Экспорт

	Возврат _ОписанияГрупп;

КонецФункции

#КонецОбласти

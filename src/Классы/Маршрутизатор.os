#Использовать semaphore

Перем ДеревоМаршрутов;
Перем ПодпискиВебСокетов;

// Семафор - сериализует изменения ДеревоМаршрутов и ПодпискиВебСокетов.
//
// Рогатки запускаются autumn параллельно в фоновых заданиях, и любая из них
// может регистрировать маршруты: winow собирает маршруты контроллеров, а
// приложение может регистрировать свои файлы через РегистраторКаталогаФайлов.
// Без синхронизации одновременная запись в дерево теряет строки, и маршрут
// молча пропадает - в рантайме это выглядит как 404 на существующем адресе.
Перем Семафор;

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин Перечисления)

	Семафор = Новый Семафор();

	ДеревоМаршрутов = Новый ДеревоЗначений();
	ДеревоМаршрутов.Колонки.Добавить("ТочкаМаршрута");
	ДеревоМаршрутов.Колонки.Добавить("Действие");
	ДеревоМаршрутов.Колонки.Добавить("ПолныйПуть");

	ПодпискиВебСокетов = Новый Соответствие();

	Для Каждого КиЗ из Перечисления.ВидыПодписокВебСокета Цикл
		ПодпискиВебСокетов.Вставить(КиЗ.Ключ, Новый Соответствие());
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьМаршрут(ПолныйПуть, Действие) Экспорт

	Семафор.Захватить();

	Попытка
		ЗаписатьМаршрут(ПолныйПуть, Действие);
	Исключение
		Семафор.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	Семафор.Освободить();

КонецПроцедуры

// Занимает путь, если он ещё свободен.
//
// Проверка и запись идут под одним захватом семафора: порознь между ними
// успевала бы вклиниться другая рогатка, и маршрут, зарегистрированный первым,
// молча затирался бы вторым.
//
// Параметры:
//   ПолныйПуть - Строка - путь точки маршрута.
//   Действие   - Структура - описание точки маршрута, см. ОписаниеТочкиМаршрута.
//
// Возвращаемое значение:
//   Булево - Истина, если путь был свободен и маршрут добавлен.
Функция ДобавитьМаршрутЕслиСвободен(ПолныйПуть, Действие) Экспорт

	Семафор.Захватить();

	Попытка

		// Занятость проверяется тем же поиском, что и обработка запроса: путь
		// может быть перекрыт не только точным совпадением, но и шаблоном.
		Занят = ЗначениеЗаполнено(НайтиОбработчикИПараметрыПоПолномуПути(ПолныйПуть).Действие);

		Если НЕ Занят Тогда
			ЗаписатьМаршрут(ПолныйПуть, Действие);
		КонецЕсли;

	Исключение
		Семафор.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	Семафор.Освободить();

	Возврат НЕ Занят;

КонецФункции

// Записывает маршрут в дерево. Вызывается только под захваченным семафором.
//
// Параметры:
//   ПолныйПуть - Строка - путь точки маршрута.
//   Действие   - Структура - описание точки маршрута, см. ОписаниеТочкиМаршрута.
Процедура ЗаписатьМаршрут(ПолныйПуть, Действие)

	СтрокиМаршрута = ДеревоМаршрутов.Строки;

	Для Каждого ТекТочка Из МассивТочекИзПути(ПолныйПуть) Цикл
		СтрокаМаршрута = НайтиИлиСоздатьСтрокуВСтроках(СтрокиМаршрута, ТекТочка);
		СтрокиМаршрута = СтрокаМаршрута.Строки;
	КонецЦикла;

	СтрокаМаршрута.Действие = Действие;
	СтрокаМаршрута.ПолныйПуть = ПолныйПуть;

КонецПроцедуры

Процедура ДобавитьПодписку(ВидПодписки, Топик, Объект, Метод, Параметры) Экспорт

	Семафор.Захватить();

	Попытка
		ПодпискиВебСокетов[ВидПодписки].Вставить(Топик,
							Новый Структура("Объект, Метод, Параметры", Объект, Метод, Параметры));
	Исключение
		Семафор.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	Семафор.Освободить();

КонецПроцедуры

Функция ПолучитьПодписки(ВидПодписки) Экспорт
	Возврат ПодпискиВебСокетов[ВидПодписки];
КонецФункции

Функция НайтиИлиСоздатьСтрокуВСтроках(Строки, ТочкаМаршрута)

	ИскомаяСтрока = Строки.Найти(ТочкаМаршрута, "ТочкаМаршрута");

	Если ИскомаяСтрока = Неопределено Тогда
		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.ТочкаМаршрута = ТочкаМаршрута;
		Возврат НоваяСтрока;
	Иначе
		Возврат ИскомаяСтрока;
	КонецЕсли;
	
КонецФункции

Функция МассивТочекИзПути(ПолныйПуть)

	Массив = Новый Массив();
	Массив.Добавить("/");
	Для Каждого ТекТочка из СтрРазделить(ПолныйПуть, "/", Ложь) Цикл
		Массив.Добавить(ТекТочка);
	КонецЦикла;

	Возврат Массив;

КонецФункции

Функция НайтиОбработчикИПараметрыПоПолномуПути(ПолныйПуть) Экспорт

	Структура = Новый Структура("Действие, Параметры", Неопределено, Новый Массив());

	ТочкиМаршрута = МассивТочекИзПути(ПолныйПуть);

	СтрокиМаршрута = ДеревоМаршрутов.Строки;

	СчетчикПути = 0;

	ИскомоеДействие = НайтиОбработчикРекурсивно(СтрокиМаршрута, ТочкиМаршрута, СчетчикПути);

	Если СчетчикПути = 0 И ТочкиМаршрута.Количество() > 1 Тогда
		Возврат Структура;
	КонецЕсли;

	Структура.Действие = ИскомоеДействие;

	Для Сч = СчетчикПути + 1 По ТочкиМаршрута.ВГраница() Цикл
		Структура.Параметры.Добавить(ТочкиМаршрута[Сч]);
	КонецЦикла;

	Возврат Структура;
	
КонецФункции

Функция НайтиОбработчикРекурсивно(Строки, ТочкиМаршрута, СчетчикПути)

	Если СчетчикПути >= ТочкиМаршрута.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТекущаяТочка = ТочкиМаршрута[СчетчикПути];

	НайденнаяСтрока = Строки.Найти(ТекущаяТочка, "ТочкаМаршрута");

	Если НайденнаяСтрока = Неопределено Тогда
		НайденнаяСтрока = Строки.Найти(СимволПараметраТочкиМаршрута(), "ТочкаМаршрута");
	КонецЕсли;

	Если НайденнаяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДействиеНаЭтомУровне = Неопределено;
	СчетчикПутиНаЭтомУромне = СчетчикПути;

	Если ЗначениеЗаполнено(НайденнаяСтрока.Действие) Тогда
		ДействиеНаЭтомУровне = НайденнаяСтрока.Действие;
	КонецЕсли;

	Если НЕ НайденнаяСтрока.Строки.Количество() = 0 Тогда

		СчетчикПути = СчетчикПути + 1;
		ДействиеНаСледующемУровне = НайтиОбработчикРекурсивно(НайденнаяСтрока.Строки, ТочкиМаршрута, СчетчикПути);

		Если Не ДействиеНаСледующемУровне = Неопределено Тогда
			ДействиеНаЭтомУровне = ДействиеНаСледующемУровне;
		Иначе
			СчетчикПути = СчетчикПутиНаЭтомУромне;
		КонецЕсли;

	КонецЕсли;

	Возврат ДействиеНаЭтомУровне;

КонецФункции

Функция СимволПараметраТочкиМаршрута() Экспорт
	Возврат "%*anyparam*%";
КонецФункции

// Возвращает плоский список всех зарегистрированных маршрутов.
//
// Возвращаемое значение:
//   Массив из Структура - каждая структура содержит:
//     * ПолныйПуть - Строка - путь маршрута с шаблонами параметров вида {имя}.
//     * Действие    - Структура - описание точки маршрута.
Функция ПолучитьВсеМаршруты() Экспорт

	Результат = Новый Массив();
	СобратьМаршрутыРекурсивно(ДеревоМаршрутов.Строки, Результат);
	Возврат Результат;

КонецФункции

Процедура СобратьМаршрутыРекурсивно(Строки, Результат)

	Для Каждого Строка Из Строки Цикл

		Если ЗначениеЗаполнено(Строка.Действие) Тогда
			Результат.Добавить(Новый Структура("ПолныйПуть, Действие", Строка.ПолныйПуть, Строка.Действие));
		КонецЕсли;

		СобратьМаршрутыРекурсивно(Строка.Строки, Результат);

	КонецЦикла;

КонецПроцедуры

Функция ОписаниеТочкиМаршрута() Экспорт

	Действие = Новый Структура("УрлСодержитШаблон, АдресКонтроллера, Желудь, ИмяМетода, Параметры, ПараметрыУРЛ, Шаблон, МетодШаблона, ПараметрыШаблона, ВыводитьШаблонКонтрола, ТипТелаЗапроса, ШаблонПути"
								, Ложь, "");
	Действие.Вставить("HTTPМетоды");
	Действие.Вставить("Сводка");
	Действие.Вставить("ОписаниеОперации", "");
	Действие.Вставить("ИдентификаторОперации", "");
	Действие.Вставить("Ответы", Новый Массив());
	Действие.Вставить("ОписанияПараметров", Новый Соответствие());
	Действие.Вставить("Группы", Новый Массив());
	Действие.Вставить("Устарело", Ложь);
	Действие.Вставить("ЧемЗаменить", "");
	Возврат Действие;

КонецФункции
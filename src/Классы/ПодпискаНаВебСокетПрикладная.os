Перем _БрокерСообщенийВебСокетов; // получает сообщения и события подключения
Перем _СоединенияВебСокетов; // пул, из которого соединение удаляется при отключении
Перем _ШифрованиеВебСокета; // упаковывает исходящие сообщения в кадры
Перем _Лог; // лог веб-сервера

// Число - таймаут чтения без ограничения. Таймаут, оставшийся от разбора HTTP-запроса,
// обрывал соединение, если клиент молчал после рукопожатия.
Перем _ЧтениеБезТаймаута;

Перем _Идентификатор; // Строка - идентификатор сессии клиента
Перем _Соединение; // TCPСоединение - соединение после рукопожатия
Перем _Топик; // Строка - путь, по которому подключился клиент
Перем _Включена; // Булево - читать ли сообщения дальше

&Желудь
&Характер("Компанейский")
&ОсобоеОбращение(ОтключитьВсеНапильники = Истина)
Процедура ПриСозданииОбъекта(&Пластилин БрокерСообщенийВебСокетов,
							&Пластилин СоединенияВебСокетов,
							&Пластилин ШифрованиеВебСокета)
	_СоединенияВебСокетов = СоединенияВебСокетов;
	_БрокерСообщенийВебСокетов = БрокерСообщенийВебСокетов;
	_ШифрованиеВебСокета = ШифрованиеВебСокета;
	_Лог = Логирование.ПолучитьЛог("oscript.lib.winow");
	_Включена = Ложь;
	_ЧтениеБезТаймаута = -1;
КонецПроцедуры

Процедура Подписаться(Соединение, Идентификатор, Топик) Экспорт
	_Идентификатор = Идентификатор;
	_Соединение = Соединение;
	_Топик = Топик;
	_Включена = Истина;
	_Соединение.ТаймаутЧтения = _ЧтениеБезТаймаута;

	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗапуститьОбработкуСообщений");
КонецПроцедуры

Процедура Отписаться() Экспорт
	_Включена = Ложь;
	Если _Соединение.Активно Тогда
		_СоединенияВебСокетов.ЗакрытьСоединение(_Соединение);
	КонецЕсли;
КонецПроцедуры

// TCP-соединение закрывается без ответа клиента, поэтому прерывание не отличается от отписки.
Процедура ПрерватьСоединение() Экспорт
	Отписаться();
КонецПроцедуры

// Ошибка отправки не бросается дальше: иначе одно мёртвое соединение обрывало бы рассылку остальным.
//
// Параметры:
//  Сообщение - Строка - Текст сообщения.
//
Процедура ОтправитьСообщение(Сообщение) Экспорт
	Кадр = _ШифрованиеВебСокета.ЗапаковатьСообщениеТекстовоеСообщение(Сообщение);
	Попытка
		_Соединение.ОтправитьДвоичныеДанные(Кадр);
	Исключение
		_Лог.Ошибка("Не удалось отправить сообщение в WS соединение: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура ЗапуститьОбработкуСообщений() Экспорт
	ОбработкаСообщений();
КонецПроцедуры

// Соединение уже в пуле, поэтому и после ошибки обработчика подключения его нужно отключить.
Процедура ОбработкаСообщений()
	Попытка
		_БрокерСообщенийВебСокетов.ПриПодключении(_Топик, _Идентификатор);
		Пока _Включена И _Соединение.Активно Цикл
			ДвоичныеДанные = _Соединение.ПрочитатьДвоичныеДанные();
			_БрокерСообщенийВебСокетов.ВходящееСообщение(_Идентификатор, _Топик, ДвоичныеДанные);
		КонецЦикла;
	Исключение
		// Упал обработчик подключения, клиент закрыл соединение или его закрыл сервер.
		_Лог.Отладка("WS соединение прервано: " + ОписаниеОшибки());
	КонецПопытки;
	Отключить();
КонецПроцедуры

Процедура Отключить()
	_СоединенияВебСокетов.УдалитьСоединение(_Соединение);
	_БрокерСообщенийВебСокетов.ПриОтключении(_Топик, _Идентификатор);
КонецПроцедуры
#Использовать opentelemetry

// Ведёт серверный спан OpenTelemetry вокруг обработки HTTP-запроса.
//
// Соглашения об именовании и атрибутах - HTTP semantic conventions:
// https://opentelemetry.io/docs/specs/semconv/http/http-spans/

// ОтелТрассировщик - создаёт серверные спаны. Получается лениво из табакерки:
// жадное обращение подняло бы SDK даже при выключенной трассировке.
Перем Трассировщик;
// Пропагаторы - извлекают входящий контекст трассировки из заголовков.
Перем Пропагаторы;
// Табакерка - отложенное получение SDK OTel.
Перем ТабакеркаSdk;
// Парсеры - разбор заголовка Host.
Перем Парсеры;

// Строка - схема URL. Собственного TLS у winow нет, поэтому всегда http.
Перем СхемаURL;

// Массив Из Строка - имена query-параметров в нижнем регистре, значения которых
// затираются в атрибуте url.query. Список из HTTP semantic conventions.
Перем ЧувствительныеПараметры;
// Строка - чем заменяется значение чувствительного параметра.
Перем ЗначениеЗатёрто;

// Параметры:
//  ОтелSdk  - Табакерка - Табакерка для отложенного получения SDK OTel.
//  _Парсеры - Парсеры   - Разбор заголовка Host.
//
&Желудь
Процедура ПриСозданииОбъекта(
		&Табакерка &Пластилин("ОтелSdk") ОтелSdk,
		&Пластилин("Парсеры") _Парсеры)

	ТабакеркаSdk = ОтелSdk;
	Парсеры = _Парсеры;
	СхемаURL = "http";
	ЗначениеЗатёрто = "REDACTED";

	ЧувствительныеПараметры = Новый Массив();
	ЧувствительныеПараметры.Добавить("awsaccesskeyid");
	ЧувствительныеПараметры.Добавить("signature");
	ЧувствительныеПараметры.Добавить("sig");
	ЧувствительныеПараметры.Добавить("x-goog-signature");
КонецПроцедуры

// Открывает серверный спан вокруг обработки запроса.
//
// Имя спана на этом этапе - только метод запроса: шаблон маршрута ещё неизвестен,
// а подставлять в имя конкретный путь нельзя, иначе имён спанов станет столько же,
// сколько различных URL. Имя уточняется в Завершить, когда маршрут уже определён.
//
// Параметры:
//  Запрос - ВходящийЗапрос - Обрабатываемый запрос.
//
// Возвращаемое значение:
//  Структура - Состояние трассировки запроса, которое нужно передать в Завершить:
//   * Спан            - ОтелСпан - Серверный спан.
//   * ОбластьСпана    - ОтелТокенКонтекста - Токен активности серверного спана.
//   * ОбластьРодителя - ОтелТокенКонтекста - Токен активности входящего контекста.
//
Функция Начать(Запрос) Экспорт

	ОбеспечитьТрассировщик();

	ВходящийКонтекст = Пропагаторы.Извлечь(ОтелКонтекст.Текущий(), Запрос.Заголовки);
	РодительскийСпан = ОтелКонтекст.СпанИзКонтекста(ВходящийКонтекст);
	ОбластьРодителя = ОтелКонтекст.СделатьСпанТекущим(РодительскийСпан);

	Спан = Трассировщик.НачатьСпан(Запрос.Метод, ОтелВидСпана.Сервер());

	ЗаполнитьАтрибутыЗапроса(Спан, Запрос);

	Состояние = Новый Структура("Спан, ОбластьСпана, ОбластьРодителя");
	Состояние.Спан = Спан;
	Состояние.ОбластьРодителя = ОбластьРодителя;
	Состояние.ОбластьСпана = Спан.СделатьТекущим();

	Возврат Состояние;

КонецФункции

// Завершает серверный спан после успешной обработки запроса.
//
// Параметры:
//  Состояние - Структура - Результат вызова Начать.
//  Запрос    - ВходящийЗапрос - Обработанный запрос.
//  Ответ     - Ответ - Сформированный ответ.
//
Процедура Завершить(Состояние, Запрос, Ответ) Экспорт

	Спан = Состояние.Спан;

	Если ЗначениеЗаполнено(Запрос.ШаблонМаршрута) Тогда
		Спан.УстановитьАтрибут("http.route", Запрос.ШаблонМаршрута);
		Спан.ИзменитьИмя(Запрос.Метод + " " + Запрос.ШаблонМаршрута);
	КонецЕсли;

	КодСостояния = Ответ.СостояниеКод;
	Спан.УстановитьАтрибут("http.response.status_code", КодСостояния);

	// По семантическим соглашениям серверный спан помечается ошибкой только на 5xx:
	// 4xx - это ошибка вызывающей стороны, а не обработчика.
	Если ЭтоОшибкаСервера(КодСостояния) Тогда
		Спан.УстановитьСтатус(ОтелКодСтатуса.Ошибка(), "HTTP " + КодСостояния);
	КонецЕсли;

	ЗакрытьОбласти(Состояние);

КонецПроцедуры

// Завершает серверный спан после исключения в обработке запроса.
//
// Параметры:
//  Состояние         - Структура - Результат вызова Начать.
//  ИнформацияОбОшибке - ИнформацияОбОшибке - Информация о возникшем исключении.
//  ОписаниеОшибки    - Строка - Краткое описание ошибки.
//
Процедура ЗавершитьСОшибкой(Состояние, ИнформацияОбОшибке, ОписаниеОшибки) Экспорт

	Спан = Состояние.Спан;
	Спан.ЗаписатьИсключение(ИнформацияОбОшибке);
	Спан.УстановитьСтатус(ОтелКодСтатуса.Ошибка(), ОписаниеОшибки);

	ЗакрытьОбласти(Состояние);

КонецПроцедуры

// Достаёт трассировщик и пропагаторы при первом обращении.
//
// Область инструментирования - winow, а не общая autumn-observed: серверные
// спаны создаёт winow, и по имени области их отличают от спанов методов
// и включают или выключают по отдельности.
Процедура ОбеспечитьТрассировщик()

	Если Трассировщик <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сдк = ТабакеркаSdk.Достать();
	Трассировщик = Сдк.ПолучитьТрассировщик("winow");
	Пропагаторы = Сдк.Пропагаторы();

КонецПроцедуры

// Закрывает области активности и завершает спан.
// Порядок обратен открытию: сначала область спана, затем сам спан,
// и только потом область входящего контекста.
Процедура ЗакрытьОбласти(Состояние)

	Состояние.ОбластьСпана.Закрыть();
	Состояние.Спан.Завершить();
	Состояние.ОбластьРодителя.Закрыть();

КонецПроцедуры

Процедура ЗаполнитьАтрибутыЗапроса(Спан, Запрос)

	Спан.УстановитьАтрибут("http.request.method", Запрос.Метод);
	Спан.УстановитьАтрибут("url.scheme", СхемаURL);
	Спан.УстановитьАтрибут("url.path", Запрос.Путь);

	СтрокаЗапроса = СтрокаПараметровЗапроса(Запрос);
	Если ЗначениеЗаполнено(СтрокаЗапроса) Тогда
		Спан.УстановитьАтрибут("url.query", СтрокаЗапроса);
	КонецЕсли;

	УстановитьАтрибутИзЗаголовка(Спан, Запрос, "User-Agent", "user_agent.original");

	УзелСервера = РазобратьУзел(ЗаголовокЗапроса(Запрос, "Host"));
	Если ЗначениеЗаполнено(УзелСервера.Адрес) Тогда
		Спан.УстановитьАтрибут("server.address", УзелСервера.Адрес);
	КонецЕсли;
	Если ЗначениеЗаполнено(УзелСервера.Порт) Тогда
		Спан.УстановитьАтрибут("server.port", УзелСервера.Порт);
	КонецЕсли;

	Спан.УстановитьАтрибут("client.address", Запрос.АдресУдаленногоУзла);
	Спан.УстановитьАтрибут("client.port", Запрос.ПортУдаленногоУзла);

КонецПроцедуры

Функция ЭтоОшибкаСервера(КодСостояния)

	Попытка
		Возврат Число(КодСостояния) >= 500;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция СтрокаПараметровЗапроса(Запрос)

	ПозицияРазделителя = СтрНайти(Запрос.ПолныйПуть, "?");

	Если ПозицияРазделителя = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ЗатеретьЧувствительныеПараметры(Сред(Запрос.ПолныйПуть, ПозицияРазделителя + 1));

КонецФункции

// Заменяет значения параметров, которые семантические соглашения предписывают
// затирать по умолчанию: подписи и ключи доступа не должны уезжать в бэкенд
// трассировки вместе со спаном. Имена параметров сохраняются.
Функция ЗатеретьЧувствительныеПараметры(СтрокаЗапроса)

	Части = СтрРазделить(СтрокаЗапроса, "&", Истина);

	Для Индекс = 0 По Части.ВГраница() Цикл

		Часть = Части[Индекс];
		ПозицияРавно = СтрНайти(Часть, "=");

		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;

		ИмяПараметра = Лев(Часть, ПозицияРавно - 1);

		Если ЧувствительныеПараметры.Найти(НРег(ИмяПараметра)) <> Неопределено Тогда
			Части[Индекс] = ИмяПараметра + "=" + ЗначениеЗатёрто;
		КонецЕсли;

	КонецЦикла;

	Возврат СтрСоединить(Части, "&");

КонецФункции

Процедура УстановитьАтрибутИзЗаголовка(Спан, Запрос, ИмяЗаголовка, ИмяАтрибута)

	Значение = ЗаголовокЗапроса(Запрос, ИмяЗаголовка);

	Если ЗначениеЗаполнено(Значение) Тогда
		Спан.УстановитьАтрибут(ИмяАтрибута, Значение);
	КонецЕсли;

КонецПроцедуры

// Заголовки приходят от клиента в произвольном регистре, поэтому ищем без учёта регистра.
Функция ЗаголовокЗапроса(Запрос, ИмяЗаголовка)

	ИскомоеИмя = НРег(ИмяЗаголовка);

	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = ИскомоеИмя Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Разбирает значение заголовка Host на адрес и порт.
//
// Разбор делегируется Парсеры.СтруктураУзла: он уже умеет обе формы IPv6 -
// и [::1], и [::1]:8080 - и снимает квадратные скобки, чего наивный поиск
// последнего двоеточия не делает.
Функция РазобратьУзел(ЗначениеЗаголовка)

	Если НЕ ЗначениеЗаполнено(ЗначениеЗаголовка) Тогда
		Возврат Новый Структура("Адрес, Порт", "", 0);
	КонецЕсли;

	Возврат Парсеры.СтруктураУзла(СокрЛП(ЗначениеЗаголовка));

КонецФункции

#Использовать autumn

&Пластилин Перем Маршрутизатор;
&Пластилин Перем МенеджерДоступа;
&Пластилин Перем Настройки;

Перем ИменаСлужебныхПараметров;
Перем ИменаПараметровТела;

&Желудь
Процедура ПриСозданииОбъекта()
	ИнициализироватьСправочникиПараметров();
КонецПроцедуры

// Формирует документ спецификации OpenAPI 3.0 по зарегистрированным маршрутам.
//
// Возвращаемое значение:
//   Соответствие - структура документа OpenAPI, готовая к сериализации в JSON.
Функция СформироватьСпецификацию() Экспорт

	Спецификация = Новый Соответствие();
	Спецификация.Вставить("openapi", "3.0.3");
	Спецификация.Вставить("info", ИнформацияОСервисе());

	ЕстьЗащищенныеМаршруты = Новый Массив();
	Спецификация.Вставить("paths", СобратьПути(ЕстьЗащищенныеМаршруты));

	Если ЕстьЗащищенныеМаршруты.Количество() > 0 Тогда
		Спецификация.Вставить("components", Компоненты());
	КонецЕсли;

	Возврат Спецификация;

КонецФункции

// Формирует спецификацию OpenAPI и возвращает ее в виде строки JSON.
//
// Возвращаемое значение:
//   Строка - JSON-представление спецификации OpenAPI.
Функция СпецификацияТекстом() Экспорт
	Возврат ВJson(СформироватьСпецификацию());
КонецФункции

// Формирует HTML-страницу Swagger UI, ссылающуюся на спецификацию OpenAPI.
//
// Возвращаемое значение:
//   Строка - готовая HTML-страница.
Функция СтраницаSwaggerUI() Экспорт

	Шаблон = "<!DOCTYPE html>
	|<html lang=""ru"">
	|<head>
	|    <meta charset=""UTF-8"">
	|    <meta name=""viewport"" content=""width=device-width, initial-scale=1"">
	|    <title>@Заголовок</title>
	|    <link rel=""stylesheet"" href=""@Ресурсы/swagger-ui.css"">
	|    <link rel=""icon"" type=""image/png"" href=""@Ресурсы/favicon-32x32.png"" sizes=""32x32"">
	|</head>
	|<body>
	|    <div id=""swagger-ui""></div>
	|    <script src=""@Ресурсы/swagger-ui-bundle.js"" charset=""UTF-8""></script>
	|    <script src=""@Ресурсы/swagger-ui-standalone-preset.js"" charset=""UTF-8""></script>
	|    <script>
	|        window.onload = function () {
	|            window.ui = SwaggerUIBundle({
	|                url: ""@ПутьСпецификации"",
	|                dom_id: ""#swagger-ui"",
	|                deepLinking: true,
	|                presets: [SwaggerUIBundle.presets.apis, SwaggerUIStandalonePreset],
	|                layout: ""StandaloneLayout""
	|            });
	|        };
	|    </script>
	|</body>
	|</html>";

	Шаблон = СтрЗаменить(Шаблон, "@Заголовок", ЭкранироватьHTML(Настройки.OpenApiЗаголовок));
	Шаблон = СтрЗаменить(Шаблон, "@Ресурсы", УбратьЗавершающийСлеш(Настройки.OpenApiРесурсыSwaggerUI));
	Шаблон = СтрЗаменить(Шаблон, "@ПутьСпецификации", Настройки.OpenApiПутьСпецификации);

	Возврат Шаблон;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура ИнициализироватьСправочникиПараметров()

	// Имена параметров, которые winow подставляет в точку маршрута автоматически.
	// Они не являются параметрами строки запроса и не попадают в спецификацию.
	ИменаСлужебныхПараметров = Новый Соответствие();
	СписокСлужебных = "Запрос,ТекстЗапроса,ЗаголовкиЗапроса,ТелоЗапроса,ТелоЗапросаСоответствие,ТелоЗапросаДвоичныеДанные,"
		+ "ТелоЗапросОбъект,ТелоЗапросаОбъект,МетодЗапроса,ПолныйПутьЗапроса,ПутьЗапроса,ПараметрыЗапросаИменные,"
		+ "ПараметрыЗапросаПорядковые,ДатаПолученияЗапроса,ДвоичныеДанныеЗапроса,КукиЗапроса,ДанныеФормы,"
		+ "АдресУдаленногоУзла,ПортУдаленногоУзла,Ответ,Сессия,Логин,ДанныеСессии";
	Для Каждого Имя Из СтрРазделить(СписокСлужебных, ",", Ложь) Цикл
		ИменаСлужебныхПараметров.Вставить(ВРег(СокрЛП(Имя)), Истина);
	КонецЦикла;

	// Наличие любого из этих параметров означает, что точка маршрута читает тело запроса,
	// то есть по умолчанию считается методом POST.
	ИменаПараметровТела = Новый Соответствие();
	СписокТела = "ТелоЗапроса,ТелоЗапросаСоответствие,ТелоЗапросаДвоичныеДанные,ТелоЗапросОбъект,"
		+ "ТелоЗапросаОбъект,ДвоичныеДанныеЗапроса,ДанныеФормы";
	Для Каждого Имя Из СтрРазделить(СписокТела, ",", Ложь) Цикл
		ИменаПараметровТела.Вставить(ВРег(СокрЛП(Имя)), Истина);
	КонецЦикла;

КонецПроцедуры

Функция ИнформацияОСервисе()
	Информация = Новый Соответствие();
	Информация.Вставить("title", Настройки.OpenApiЗаголовок);
	Информация.Вставить("version", Настройки.OpenApiВерсия);
	Если ЗначениеЗаполнено(Настройки.OpenApiОписание) Тогда
		Информация.Вставить("description", Настройки.OpenApiОписание);
	КонецЕсли;
	Возврат Информация;
КонецФункции

Функция Компоненты()
	СхемыБезопасности = Новый Соответствие();
	СхемаBasic = Новый Соответствие();
	СхемаBasic.Вставить("type", "http");
	СхемаBasic.Вставить("scheme", "basic");
	СхемыБезопасности.Вставить("basicAuth", СхемаBasic);

	Компоненты = Новый Соответствие();
	Компоненты.Вставить("securitySchemes", СхемыБезопасности);
	Возврат Компоненты;
КонецФункции

Функция СобратьПути(ЕстьЗащищенныеМаршруты)

	Пути = Новый Соответствие();

	Для Каждого Маршрут Из Маршрутизатор.ПолучитьВсеМаршруты() Цикл

		Действие = Маршрут.Действие;
		Путь = ПостроитьПутьOpenApi(Маршрут.ПолныйПуть, Действие);

		Если ЭтоСлужебныйПуть(Путь) Тогда
			Продолжить;
		КонецЕсли;

		Операция = ОписаниеОперации(Путь, Действие);

		Если МенеджерДоступа.ТочкаМаршрутаИмеетРоли(Действие) Тогда
			ЕстьЗащищенныеМаршруты.Добавить(Путь);
		КонецЕсли;

		ПунктПути = Пути.Получить(Путь);
		Если ПунктПути = Неопределено Тогда
			ПунктПути = Новый Соответствие();
			Пути.Вставить(Путь, ПунктПути);
		КонецЕсли;

		Для Каждого HTTPМетод Из ОпределитьHTTPМетоды(Действие) Цикл
			ПунктПути.Вставить(HTTPМетод, Операция);
		КонецЦикла;

	КонецЦикла;

	Возврат Пути;

КонецФункции

Функция ОписаниеОперации(Путь, Действие)

	Операция = Новый Соответствие();

	Если ЗначениеЗаполнено(Действие.Сводка) Тогда
		Операция.Вставить("summary", Действие.Сводка);
	Иначе
		Операция.Вставить("summary", Действие.ИмяМетода);
	КонецЕсли;

	Операция.Вставить("operationId", СформироватьOperationId(Путь, Действие));

	Теги = Новый Массив();
	Теги.Добавить(?(ЗначениеЗаполнено(Действие.АдресКонтроллера), Действие.АдресКонтроллера, "/"));
	Операция.Вставить("tags", Теги);

	Параметры = СобратьПараметры(Действие);
	Если Параметры.Количество() > 0 Тогда
		Операция.Вставить("parameters", Параметры);
	КонецЕсли;

	Если ИмеетТелоЗапроса(Действие) Тогда
		Операция.Вставить("requestBody", ОписаниеТелаЗапроса());
	КонецЕсли;

	Операция.Вставить("responses", ОписаниеОтветов(Действие));

	Если МенеджерДоступа.ТочкаМаршрутаИмеетРоли(Действие) Тогда
		Операция.Вставить("security", ТребованиеБезопасности());
		Роли = МенеджерДоступа.ПолучитьРолиТочкиМаршрута(Действие);
		Если Роли.Количество() > 0 Тогда
			Операция.Вставить("description", "Требуемые роли: " + СтрСоединить(Роли, ", "));
		КонецЕсли;
	КонецЕсли;

	Возврат Операция;

КонецФункции

Функция СобратьПараметры(Действие)

	Параметры = Новый Массив();

	ИменаПараметровУРЛ = УпорядоченныеИменаПараметровУРЛ(Действие);

	// Множество имен параметров пути в верхнем регистре для регистронезависимого сравнения.
	ИсключаемыеИмена = Новый Соответствие();
	Для Каждого ИмяПараметра Из ИменаПараметровУРЛ Цикл
		ИсключаемыеИмена.Вставить(ВРег(ИмяПараметра), Истина);
		// Параметры пути (path).
		Параметры.Добавить(ОписаниеПараметра(ИмяПараметра, "path", Истина));
	КонецЦикла;

	// Оставшиеся именованные параметры считаем параметрами строки запроса (query).
	Для Каждого ИмяПараметра Из Действие.Параметры Цикл

		Если ИменаСлужебныхПараметров.Получить(ВРег(ИмяПараметра)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ИсключаемыеИмена.Получить(ВРег(ИмяПараметра)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Параметры.Добавить(ОписаниеПараметра(ИмяПараметра, "query", Ложь));

	КонецЦикла;

	Возврат Параметры;

КонецФункции

Функция ОписаниеПараметра(Имя, Размещение, Обязательный)
	Схема = Новый Соответствие();
	Схема.Вставить("type", "string");

	Параметр = Новый Соответствие();
	Параметр.Вставить("name", Имя);
	Параметр.Вставить("in", Размещение);
	Параметр.Вставить("required", Обязательный);
	Параметр.Вставить("schema", Схема);
	Возврат Параметр;
КонецФункции

Функция ОписаниеТелаЗапроса()
	Схема = Новый Соответствие();
	Схема.Вставить("type", "object");

	СодержимоеJson = Новый Соответствие();
	СодержимоеJson.Вставить("schema", Схема);

	Содержимое = Новый Соответствие();
	Содержимое.Вставить("application/json", СодержимоеJson);

	ТелоЗапроса = Новый Соответствие();
	ТелоЗапроса.Вставить("required", Истина);
	ТелоЗапроса.Вставить("content", Содержимое);
	Возврат ТелоЗапроса;
КонецФункции

Функция ОписаниеОтветов(Действие)

	Ответы = Новый Соответствие();

	Успех = Новый Соответствие();
	Успех.Вставить("description", "Успешный ответ");
	Ответы.Вставить("200", Успех);

	Если МенеджерДоступа.ТочкаМаршрутаИмеетРоли(Действие) Тогда
		Не401 = Новый Соответствие();
		Не401.Вставить("description", "Требуется авторизация");
		Ответы.Вставить("401", Не401);

		Не403 = Новый Соответствие();
		Не403.Вставить("description", "Доступ запрещен");
		Ответы.Вставить("403", Не403);
	КонецЕсли;

	Возврат Ответы;

КонецФункции

Функция ТребованиеБезопасности()
	Требование = Новый Соответствие();
	Требование.Вставить("basicAuth", Новый Массив());

	Требования = Новый Массив();
	Требования.Добавить(Требование);
	Возврат Требования;
КонецФункции

// Имена параметров пути в порядке их появления в адресе точки маршрута.
Функция УпорядоченныеИменаПараметровУРЛ(Действие)

	Имена = Новый Массив();

	Если Действие.ПараметрыУРЛ = Неопределено ИЛИ Действие.ПараметрыУРЛ.Количество() = 0 Тогда
		Возврат Имена;
	КонецЕсли;

	МаксимальныйИндекс = -1;
	Для Каждого ПараметрУРЛ Из Действие.ПараметрыУРЛ Цикл
		Если ПараметрУРЛ.Ключ > МаксимальныйИндекс Тогда
			МаксимальныйИндекс = ПараметрУРЛ.Ключ;
		КонецЕсли;
	КонецЦикла;

	Для Индекс = 0 По МаксимальныйИндекс Цикл
		Имя = Действие.ПараметрыУРЛ.Получить(Индекс);
		Если Имя <> Неопределено Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Восстанавливает путь для спецификации, заменяя служебные символы параметров маршрута
// на шаблоны вида {имяПараметра}.
Функция ПостроитьПутьOpenApi(ПолныйПуть, Действие)

	Путь = НормализоватьПуть(ПолныйПуть);

	Если Действие.ПараметрыУРЛ = Неопределено ИЛИ Действие.ПараметрыУРЛ.Количество() = 0 Тогда
		Возврат Путь;
	КонецЕсли;

	УпорядоченныеИмена = УпорядоченныеИменаПараметровУРЛ(Действие);
	СимволПараметра = Маршрутизатор.СимволПараметраТочкиМаршрута();

	Сегменты = СтрРазделить(Путь, "/");
	Результат = Новый Массив();
	ИндексПараметра = 0;

	Для Каждого Сегмент Из Сегменты Цикл
		Если Сегмент = СимволПараметра И ИндексПараметра < УпорядоченныеИмена.Количество() Тогда
			Результат.Добавить("{" + УпорядоченныеИмена[ИндексПараметра] + "}");
			ИндексПараметра = ИндексПараметра + 1;
		Иначе
			Результат.Добавить(Сегмент);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Результат, "/");

КонецФункции

Функция ОпределитьHTTPМетоды(Действие)

	Методы = Новый Массив();

	Если ЗначениеЗаполнено(Действие.HTTPМетоды) Тогда
		Для Каждого Метод Из СтрРазделить(Действие.HTTPМетоды, ",", Ложь) Цикл
			Метод = НРег(СокрЛП(Метод));
			Если ЗначениеЗаполнено(Метод) Тогда
				Методы.Добавить(Метод);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Методы.Количество() = 0 Тогда
		Методы.Добавить(?(ИмеетТелоЗапроса(Действие), "post", "get"));
	КонецЕсли;

	Возврат Методы;

КонецФункции

Функция ИмеетТелоЗапроса(Действие)

	Если Действие.ТипТелаЗапроса <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого ИмяПараметра Из Действие.Параметры Цикл
		Если ИменаПараметровТела.Получить(ВРег(ИмяПараметра)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СформироватьOperationId(Путь, Действие)
	Основа = Путь + "_" + Действие.ИмяМетода;
	Результат = "";
	Для Индекс = 1 По СтрДлина(Основа) Цикл
		Символ = Сред(Основа, Индекс, 1);
		Если ЭтоДопустимыйСимволИдентификатора(Символ) Тогда
			Результат = Результат + Символ;
		Иначе
			Результат = Результат + "_";
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЭтоДопустимыйСимволИдентификатора(Символ)
	Возврат (Символ >= "a" И Символ <= "z")
		ИЛИ (Символ >= "A" И Символ <= "Z")
		ИЛИ (Символ >= "0" И Символ <= "9")
		ИЛИ Символ = "_";
КонецФункции

Функция НормализоватьПуть(Путь)
	Результат = СтрЗаменить(Путь, "\", "/");
	Если НЕ СтрНачинаетсяС(Результат, "/") Тогда
		Результат = "/" + Результат;
	КонецЕсли;
	// Схлопываем повторяющиеся слеши.
	Пока СтрНайти(Результат, "//") > 0 Цикл
		Результат = СтрЗаменить(Результат, "//", "/");
	КонецЦикла;
	// Убираем завершающий слеш, кроме корня.
	Если СтрДлина(Результат) > 1 И СтрЗаканчиваетсяНа(Результат, "/") Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЭтоСлужебныйПуть(Путь)
	Возврат Путь = НормализоватьПуть(Настройки.OpenApiБазовыйПуть)
		ИЛИ Путь = НормализоватьПуть(Настройки.OpenApiПутьСпецификации);
КонецФункции

Функция УбратьЗавершающийСлеш(Строка)
	Если СтрЗаканчиваетсяНа(Строка, "/") Тогда
		Возврат Лев(Строка, СтрДлина(Строка) - 1);
	КонецЕсли;
	Возврат Строка;
КонецФункции

Функция ЭкранироватьHTML(Строка)
	Результат = СтрЗаменить(Строка, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СериализацияJson

// Минималистичный сериализатор JSON для документа OpenAPI.
// Поддерживает Соответствие, Структуру, Массив, Строку, Булево, Число и Неопределено.
// Реализован внутри winow, чтобы не зависеть от особенностей внешних библиотек.
Функция ВJson(Значение)

	Если Значение = Неопределено Тогда
		Возврат "null";

	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");

	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат ЧислоВJson(Значение);

	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СтрокаВJson(Значение);

	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат МассивВJson(Значение);

	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат СоответствиеВJson(Значение);

	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		Возврат СтруктураВJson(Значение);

	Иначе
		Возврат СтрокаВJson(Строка(Значение));

	КонецЕсли;

КонецФункции

Функция МассивВJson(Массив)
	Элементы = Новый Массив();
	Для Каждого Элемент Из Массив Цикл
		Элементы.Добавить(ВJson(Элемент));
	КонецЦикла;
	Возврат "[" + СтрСоединить(Элементы, ",") + "]";
КонецФункции

Функция СоответствиеВJson(Соответствие)
	Элементы = Новый Массив();
	Для Каждого КиЗ Из Соответствие Цикл
		Элементы.Добавить(СтрокаВJson(Строка(КиЗ.Ключ)) + ":" + ВJson(КиЗ.Значение));
	КонецЦикла;
	Возврат "{" + СтрСоединить(Элементы, ",") + "}";
КонецФункции

Функция СтруктураВJson(Структура)
	Элементы = Новый Массив();
	Для Каждого КиЗ Из Структура Цикл
		Элементы.Добавить(СтрокаВJson(КиЗ.Ключ) + ":" + ВJson(КиЗ.Значение));
	КонецЦикла;
	Возврат "{" + СтрСоединить(Элементы, ",") + "}";
КонецФункции

Функция ЧислоВJson(Число)
	// ЧГ=0 отключает группировку разрядов, ЧРД=. задает точку как разделитель дробной части.
	Возврат СокрЛП(Формат(Число, "ЧГ=0; ЧРД=."));
КонецФункции

Функция СтрокаВJson(Строка)

	Результат = "";

	Для Индекс = 1 По СтрДлина(Строка) Цикл

		Символ = Сред(Строка, Индекс, 1);
		КодТекущегоСимвола = КодСимвола(Символ);

		Если Символ = """" Тогда
			Результат = Результат + "\""";
		ИначеЕсли Символ = "\" Тогда
			Результат = Результат + "\\";
		ИначеЕсли КодТекущегоСимвола = 8 Тогда
			Результат = Результат + "\b";
		ИначеЕсли КодТекущегоСимвола = 9 Тогда
			Результат = Результат + "\t";
		ИначеЕсли КодТекущегоСимвола = 10 Тогда
			Результат = Результат + "\n";
		ИначеЕсли КодТекущегоСимвола = 12 Тогда
			Результат = Результат + "\f";
		ИначеЕсли КодТекущегоСимвола = 13 Тогда
			Результат = Результат + "\r";
		ИначеЕсли КодТекущегоСимвола < 32 Тогда
			Результат = Результат + "\u" + Прав("000" + НРег(ЧислоВHex(КодТекущегоСимвола)), 4);
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;

	КонецЦикла;

	Возврат """" + Результат + """";

КонецФункции

Функция ЧислоВHex(Число)
	ЦифрыHex = "0123456789ABCDEF";
	Результат = "";
	Остаток = Число;
	Если Остаток = 0 Тогда
		Возврат "0";
	КонецЕсли;
	Пока Остаток > 0 Цикл
		Разряд = Остаток % 16;
		Результат = Сред(ЦифрыHex, Разряд + 1, 1) + Результат;
		Остаток = Цел(Остаток / 16);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

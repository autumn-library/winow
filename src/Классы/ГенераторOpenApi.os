#Использовать autumn

&Пластилин
// Маршрутизатор веб-сервера.
Перем Маршрутизатор;

&Пластилин
// Менеджер контроля доступа к точкам маршрута.
Перем МенеджерДоступа;

&Пластилин
// Построитель схем OpenAPI по пользовательским типам.
Перем ПостроительСхемOpenApi;

&Пластилин
// Построитель уникальных идентификаторов операций.
Перем ИдентификаторыОперацийOpenApi;

&Пластилин
// Настройки веб-сервера: из них собирается базовый адрес API.
Перем Настройки;

&Деталька(Значение = "winow.openapi.АдресСервера", ЗначениеПоУмолчанию = "")
// Базовый адрес API в разделе servers. Пустое значение - собрать из имени хоста
// и порта. Задаётся явно, когда приложение доступно не по тому адресу, который
// слушает: за обратным прокси, под доменным именем, по https.
Перем АдресСервера;

&Деталька(Значение = "winow.openapi.Заголовок", ЗначениеПоУмолчанию = "winow API")
// Заголовок API в блоке info спецификации.
Перем Заголовок;

&Деталька(Значение = "winow.openapi.Версия", ЗначениеПоУмолчанию = "1.0.0")
// Версия API в блоке info спецификации.
Перем Версия;

&Деталька(Значение = "winow.openapi.Описание", ЗначениеПоУмолчанию = "")
// Описание API в блоке info спецификации.
Перем Описание;

&Деталька(Значение = "winow.openapi.БазовыйПуть", ЗначениеПоУмолчанию = "/swagger")
// Путь, по которому отдается страница Swagger UI (исключается из спецификации).
Перем БазовыйПуть;

&Деталька(Значение = "winow.openapi.ПутьСпецификации", ЗначениеПоУмолчанию = "/swagger/openapi.json")
// Путь, по которому отдается JSON спецификации (исключается из спецификации).
Перем ПутьСпецификации;

&Деталька(Значение = "winow.openapi.РесурсыSwaggerUI",
	ЗначениеПоУмолчанию = "https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14")
// Базовый URL, откуда страница Swagger UI берет статические ресурсы (js/css).
Перем АдресРесурсов;

// Имена параметров точки маршрута, которые winow подставляет автоматически (не query-параметры).
Перем СлужебныеПараметры;
// Имена параметров, наличие которых означает, что точка маршрута читает тело запроса.
Перем ПараметрыТелаЗапроса;
// Допустимые HTTP-методы Path Item Object в спецификации OpenAPI.
Перем ДопустимыеМетоды;
// Соответствие символов их экранированному представлению в JSON-строке.
Перем ТаблицаЭкранирования;
// Максимальный код управляющего символа, который требует экранирования в JSON-строке.
Перем КодПоследнегоУправляющегоСимвола;
// Основание шестнадцатеричной системы счисления для \u-экранирования.
Перем ОснованиеШестнадцатеричной;
// Длина шестнадцатеричного кода символа в \u-экранировании.
Перем ДлинаКодаСимвола;
// Имя поля описания в объектах спецификации OpenAPI.
Перем КлючОписания;
// Соответствие Из Строка - описания тегов, собранные при обходе операций.
Перем ОписанияТегов;

&Желудь
Процедура ПриСозданииОбъекта()
	ИнициализироватьСправочники();
КонецПроцедуры

// Формирует документ спецификации OpenAPI 3.0 по зарегистрированным маршрутам.
//
// Параметры:
//   Запрос - ВходящийЗапрос - запрос за спецификацией. По его заголовкам
//            определяется базовый адрес API. Неопределено - собрать адрес
//            из настроек.
//
// Возвращаемое значение:
//   Соответствие - структура документа OpenAPI, готовая к сериализации в JSON.
Функция СформироватьСпецификацию(Запрос = Неопределено) Экспорт

	ПостроительСхемOpenApi.Очистить();
	ИдентификаторыОперацийOpenApi.Очистить();
	ОписанияТегов = Новый Соответствие();

	Спецификация = Новый Соответствие();
	Спецификация.Вставить("openapi", "3.0.3");
	Спецификация.Вставить("info", ИнформацияОСервисе());
	Спецификация.Вставить("servers", Серверы(Запрос));

	ЕстьЗащищенныеМаршруты = Новый Массив();
	Спецификация.Вставить("paths", СобратьПути(ЕстьЗащищенныеМаршруты));

	// Описания тегов известны только после обхода путей: их объявляют операции.
	РазделТегов = РазделТегов();
	Если РазделТегов.Количество() > 0 Тогда
		Спецификация.Вставить("tags", РазделТегов);
	КонецЕсли;

	// Схемы становятся известны только после обхода путей: их регистрирует
	// описание тела запроса, когда у точки маршрута указан тип.
	Компоненты = Компоненты(ЕстьЗащищенныеМаршруты.Количество() > 0);

	Если Компоненты.Количество() > 0 Тогда
		Спецификация.Вставить("components", Компоненты);
	КонецЕсли;

	Возврат Спецификация;

КонецФункции

// Формирует спецификацию OpenAPI и возвращает ее в виде строки JSON.
//
// Параметры:
//   Запрос - ВходящийЗапрос - запрос за спецификацией, см. СформироватьСпецификацию.
//
// Возвращаемое значение:
//   Строка - JSON-представление спецификации OpenAPI.
Функция СпецификацияТекстом(Запрос = Неопределено) Экспорт
	Возврат ПреобразоватьВJson(СформироватьСпецификацию(Запрос));
КонецФункции

// Формирует HTML-страницу Swagger UI, ссылающуюся на спецификацию OpenAPI.
//
// Возвращаемое значение:
//   Строка - готовая HTML-страница.
Функция СтраницаSwaggerUI() Экспорт

	Шаблон = "<!DOCTYPE html>
	|<html lang=""ru"">
	|<head>
	|    <meta charset=""UTF-8"">
	|    <meta name=""viewport"" content=""width=device-width, initial-scale=1"">
	|    <title>@Заголовок</title>
	|    <link rel=""stylesheet"" href=""@Ресурсы/swagger-ui.css"">
	|    <link rel=""icon"" type=""image/png"" href=""@Ресурсы/favicon-32x32.png"" sizes=""32x32"">
	|</head>
	|<body>
	|    <div id=""swagger-ui""></div>
	|    <script src=""@Ресурсы/swagger-ui-bundle.js"" charset=""UTF-8""></script>
	|    <script src=""@Ресурсы/swagger-ui-standalone-preset.js"" charset=""UTF-8""></script>
	|    <script>
	|        window.onload = function () {
	|            window.ui = SwaggerUIBundle({
	|                url: ""@ПутьСпецификации"",
	|                dom_id: ""#swagger-ui"",
	|                deepLinking: true,
	|                presets: [SwaggerUIBundle.presets.apis, SwaggerUIStandalonePreset],
	|                layout: ""StandaloneLayout""
	|            });
	|        };
	|    </script>
	|</body>
	|</html>";

	Шаблон = СтрЗаменить(Шаблон, "@Заголовок", ЭкранироватьРазметку(Заголовок));
	Шаблон = СтрЗаменить(Шаблон, "@Ресурсы", УбратьЗавершающийСлеш(АдресРесурсов));
	Шаблон = СтрЗаменить(Шаблон, "@ПутьСпецификации", ПутьСпецификации);

	Возврат Шаблон;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура ИнициализироватьСправочники()

	СлужебныеПараметры = МножествоИмен(
		"Запрос,ТекстЗапроса,ЗаголовкиЗапроса,ТелоЗапроса,ТелоЗапросаСоответствие,ТелоЗапросаДвоичныеДанные,"
		+ "ТелоЗапросОбъект,ТелоЗапросаОбъект,МетодЗапроса,ПолныйПутьЗапроса,ПутьЗапроса,ПараметрыЗапросаИменные,"
		+ "ПараметрыЗапросаПорядковые,ДатаПолученияЗапроса,ДвоичныеДанныеЗапроса,КукиЗапроса,ДанныеФормы,"
		+ "АдресУдаленногоУзла,ПортУдаленногоУзла,Ответ,Сессия,Логин,ДанныеСессии");

	ПараметрыТелаЗапроса = МножествоИмен(
		"ТелоЗапроса,ТелоЗапросаСоответствие,ТелоЗапросаДвоичныеДанные,ТелоЗапросОбъект,"
		+ "ТелоЗапросаОбъект,ДвоичныеДанныеЗапроса,ДанныеФормы");

	ДопустимыеМетоды = МножествоИмен("get,put,post,delete,options,head,patch,trace");

	ТаблицаЭкранирования = Новый Соответствие();
	ТаблицаЭкранирования.Вставить("""", "\""");
	ТаблицаЭкранирования.Вставить("\", "\\");
	ТаблицаЭкранирования.Вставить(Символы.ВК, "\r");
	ТаблицаЭкранирования.Вставить(Символы.ПС, "\n");
	ТаблицаЭкранирования.Вставить(Символы.Таб, "\t");
	ТаблицаЭкранирования.Вставить(Символы.ПФ, "\f");

	КодПоследнегоУправляющегоСимвола = 31;
	ОснованиеШестнадцатеричной = 16;
	ДлинаКодаСимвола = 4;
	КлючОписания = "description";
	ОписанияТегов = Новый Соответствие();

КонецПроцедуры

// Строит множество имен в верхнем регистре из строки, разделенной запятыми.
//
// Параметры:
//   СписокИмен - Строка - имена через запятую.
//
// Возвращаемое значение:
//   Соответствие - ключи это имена в верхнем регистре, значения Истина.
Функция МножествоИмен(СписокИмен)
	Множество = Новый Соответствие();
	Для Каждого Имя Из СтрРазделить(СписокИмен, ",", Ложь) Цикл
		Множество.Вставить(ВРег(СокрЛП(Имя)), Истина);
	КонецЦикла;
	Возврат Множество;
КонецФункции

Функция ИнформацияОСервисе()
	Информация = Новый Соответствие();
	Информация.Вставить("title", Заголовок);
	Информация.Вставить("version", Версия);
	Если ЗначениеЗаполнено(Описание) Тогда
		Информация.Вставить(КлючОписания, Описание);
	КонецЕсли;
	Возврат Информация;
КонецФункции

// Собирает объект components спецификации.
//
// Параметры:
//   ЕстьЗащищенныеМаршруты - Булево - требуется ли описывать схему авторизации.
//
// Возвращаемое значение:
//   Соответствие - объект components, пустой, если описывать нечего.
// Раздел servers - базовый адрес, к которому Swagger UI приписывает пути,
// когда выполняет запрос по кнопке "Try it out".
//
// Без раздела адрес берётся из того, откуда открыта страница документации.
// Обычно это то же приложение, но не всегда: спецификацию отдают и отдельно,
// и через обратный прокси, - тогда запросы уходят не туда.
//
// Адрес выбирается по убыванию достоверности: явная настройка, затем заголовки
// запроса, затем настройки веб-сервера.
Функция Серверы(Запрос)

	Если ЗначениеЗаполнено(АдресСервера) Тогда
		Адрес = АдресСервера;
	Иначе
		Адрес = АдресИзЗапроса(Запрос);
	КонецЕсли;

	Сервер = Новый Соответствие();
	Сервер.Вставить("url", УбратьЗавершающийСлеш(Адрес));

	Серверы = Новый Массив();
	Серверы.Добавить(Сервер);
	Возврат Серверы;

КонецФункции

// Собирает адрес по заголовкам запроса.
//
// За обратным прокси приложение доступно не по тому адресу, который слушает:
// меняются и схема, и хост, и порт, и может добавиться префикс пути. Прокси
// сообщает об этом заголовками X-Forwarded-*, и nginx проставляет их штатно.
//
// Подмена заголовка тут ничего не даёт: спецификация формируется на каждый
// запрос заново и не кэшируется, поэтому подделавший заголовок получит
// изменённый адрес только в своём же ответе.
Функция АдресИзЗапроса(Запрос)

	Если Запрос = Неопределено Тогда
		Возврат АдресИзНастроек();
	КонецЕсли;

	Узел = ПервоеЗначениеЗаголовка(Запрос, "X-Forwarded-Host");
	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		Узел = ПервоеЗначениеЗаголовка(Запрос, "Host");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		Возврат АдресИзНастроек();
	КонецЕсли;

	Схема = ПервоеЗначениеЗаголовка(Запрос, "X-Forwarded-Proto");
	Если НЕ ЗначениеЗаполнено(Схема) Тогда
		// Своего TLS у winow нет, поэтому без указания прокси схема http.
		Схема = "http";
	КонецЕсли;

	Возврат Схема + "://" + Узел + ПервоеЗначениеЗаголовка(Запрос, "X-Forwarded-Prefix");

КонецФункции

// Заголовки X-Forwarded-* накапливаются цепочкой прокси через запятую,
// и первым в ней стоит значение, ближайшее к клиенту.
Функция ПервоеЗначениеЗаголовка(Запрос, ИмяЗаголовка)

	Значение = ЗначениеЗаголовка(Запрос, ИмяЗаголовка);

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(СтрРазделить(Значение, ",", Истина)[0]);

КонецФункции

// Заголовки приходят от клиента в произвольном регистре, поэтому ищем без учёта регистра.
Функция ЗначениеЗаголовка(Запрос, ИмяЗаголовка)

	ИскомоеИмя = НРег(ИмяЗаголовка);

	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = ИскомоеИмя Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция АдресИзНастроек()
	Возврат СтрШаблон("http://%1:%2", Настройки.ИмяХоста, Формат(Настройки.Порт, "ЧГ=0; ЧН=0"));
КонецФункции

Функция Компоненты(ЕстьЗащищенныеМаршруты)

	Компоненты = Новый Соответствие();

	Если ЕстьЗащищенныеМаршруты Тогда
		СхемаАвторизации = Новый Соответствие();
		СхемаАвторизации.Вставить("type", "http");
		СхемаАвторизации.Вставить("scheme", "basic");

		СхемыБезопасности = Новый Соответствие();
		СхемыБезопасности.Вставить("basicAuth", СхемаАвторизации);

		Компоненты.Вставить("securitySchemes", СхемыБезопасности);
	КонецЕсли;

	СхемыТипов = ПостроительСхемOpenApi.Схемы();

	Если СхемыТипов.Количество() > 0 Тогда
		Компоненты.Вставить("schemas", СхемыТипов);
	КонецЕсли;

	Возврат Компоненты;

КонецФункции

// Собирает объект paths спецификации по всем зарегистрированным маршрутам.
//
// Параметры:
//   ЕстьЗащищенныеМаршруты - Массив - заполняется путями точек маршрута, требующих авторизации.
//
// Возвращаемое значение:
//   Соответствие - объект paths спецификации OpenAPI.
Функция СобратьПути(ЕстьЗащищенныеМаршруты)

	Пути = Новый Соответствие();

	Для Каждого Маршрут Из Маршрутизатор.ПолучитьВсеМаршруты() Цикл

		Действие = Маршрут.Действие;
		Путь = ПостроитьПутьOpenApi(Маршрут.ПолныйПуть, Действие);

		Если ЭтоСлужебныйПуть(Путь) Тогда
			Продолжить;
		КонецЕсли;

		Если МенеджерДоступа.ТочкаМаршрутаИмеетРоли(Действие) Тогда
			ЕстьЗащищенныеМаршруты.Добавить(Путь);
		КонецЕсли;

		ПунктПути = Пути.Получить(Путь);
		Если ПунктПути = Неопределено Тогда
			ПунктПути = Новый Соответствие();
			Пути.Вставить(Путь, ПунктПути);
		КонецЕсли;

		Для Каждого HTTPМетод Из ОпределитьМетоды(Действие) Цикл
			ПунктПути.Вставить(HTTPМетод, ОписаниеОперации(Путь, Действие, HTTPМетод));
		КонецЦикла;

	КонецЦикла;

	Возврат Пути;

КонецФункции

Функция ОписаниеОперации(Путь, Действие, HTTPМетод)

	Операция = Новый Соответствие();

	Если ЗначениеЗаполнено(Действие.Сводка) Тогда
		Операция.Вставить("summary", Действие.Сводка);
	Иначе
		Операция.Вставить("summary", Действие.ИмяМетода);
	КонецЕсли;

	Операция.Вставить("operationId", ИдентификаторыОперацийOpenApi.Идентификатор(HTTPМетод, Путь));

	Операция.Вставить("tags", ТегиОперации(Действие));

	Параметры = СобратьПараметры(Действие);
	Если Параметры.Количество() > 0 Тогда
		Операция.Вставить("parameters", Параметры);
	КонецЕсли;

	Если ИмеетТелоЗапроса(Действие) Тогда
		Операция.Вставить("requestBody", ОписаниеТелаЗапроса(Действие));
	КонецЕсли;

	Операция.Вставить("responses", ОписаниеОтветов(Действие));

	Если МенеджерДоступа.ТочкаМаршрутаИмеетРоли(Действие) Тогда
		Операция.Вставить("security", ТребованиеБезопасности());
	КонецЕсли;

	ТекстОписания = ОписаниеОперацииТекстом(Действие);
	Если ЗначениеЗаполнено(ТекстОписания) Тогда
		Операция.Вставить(КлючОписания, ТекстОписания);
	КонецЕсли;

	Возврат Операция;

КонецФункции

// Собирает текст описания операции из того, что не выражается структурой
// спецификации.
//
// Позиционные сегменты пути описать параметром нельзя: по OpenAPI параметр
// с in=path обязан быть обязательным и присутствовать в шаблоне пути, а этих
// сегментов в шаблоне нет и быть не может - их количество заранее неизвестно.
Функция ОписаниеОперацииТекстом(Действие)

	Части = Новый Массив();

	Если МенеджерДоступа.ТочкаМаршрутаИмеетРоли(Действие) Тогда
		Роли = МенеджерДоступа.ПолучитьРолиТочкиМаршрута(Действие);
		Если Роли.Количество() > 0 Тогда
			Части.Добавить("Требуемые роли: " + СтрСоединить(Роли, ", "));
		КонецЕсли;
	КонецЕсли;

	Если СодержитПараметр(Действие, "ПараметрыЗапросаПорядковые") Тогда
		Части.Добавить("Принимает позиционные сегменты пути после адреса маршрута.");
	КонецЕсли;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Теги операции.
//
// Объявленные аннотацией &Тег имеют приоритет. Без объявления тегом служит
// адрес контроллера - группировка по контроллеру лучше, чем её отсутствие,
// но всё, что висит на корневом, сваливается в одну группу "/".
Функция ТегиОперации(Действие)

	Теги = Новый Массив();

	Для Каждого Тег Из Действие.Теги Цикл
		Теги.Добавить(Тег.Имя);
		ЗапомнитьОписаниеТега(Тег);
	КонецЦикла;

	Если Теги.Количество() = 0 Тогда
		Теги.Добавить(?(ЗначениеЗаполнено(Действие.АдресКонтроллера), Действие.АдресКонтроллера, "/"));
	КонецЕсли;

	Возврат Теги;

КонецФункции

// Описание достаточно задать при одном упоминании тега: первое непустое
// и попадает в документ.
Процедура ЗапомнитьОписаниеТега(Тег)

	Если НЕ ЗначениеЗаполнено(Тег.Описание) Тогда
		Возврат;
	КонецЕсли;

	Если ОписанияТегов.Получить(Тег.Имя) = Неопределено Тогда
		ОписанияТегов.Вставить(Тег.Имя, Тег.Описание);
	КонецЕсли;

КонецПроцедуры

// Раздел tags документа. В него попадают только теги с описанием: тег без
// описания и так виден в операциях, отдельная запись о нём ничего не добавит.
Функция РазделТегов()

	Теги = Новый Массив();

	Для Каждого КлючИЗначение Из ОписанияТегов Цикл
		Тег = Новый Соответствие();
		Тег.Вставить("name", КлючИЗначение.Ключ);
		Тег.Вставить(КлючОписания, КлючИЗначение.Значение);
		Теги.Добавить(Тег);
	КонецЦикла;

	Возврат Теги;

КонецФункции

Функция СобратьПараметры(Действие)

	Параметры = Новый Массив();

	ИменаПараметровУРЛ = УпорядоченныеИменаПараметровУРЛ(Действие);

	ИсключаемыеИмена = Новый Соответствие();
	Для Каждого ИмяПараметра Из ИменаПараметровУРЛ Цикл
		ИсключаемыеИмена.Вставить(ВРег(ИмяПараметра), Истина);
		Параметры.Добавить(ОписаниеПараметра(ИмяПараметра, "path", Истина, Действие));
	КонецЦикла;

	Если СодержитПараметр(Действие, "ПараметрыЗапросаИменные") Тогда
		Параметры.Добавить(ОписаниеПроизвольныхПараметровЗапроса());
	КонецЕсли;

	Для Каждого ИмяПараметра Из Действие.Параметры Цикл

		Если СлужебныеПараметры.Получить(ВРег(ИмяПараметра)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ИсключаемыеИмена.Получить(ВРег(ИмяПараметра)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Параметры.Добавить(ОписаниеПараметра(ИмяПараметра, "query", Ложь, Действие));

	КонецЦикла;

	Возврат Параметры;

КонецФункции

// Точка маршрута с параметром ПараметрыЗапросаИменные принимает произвольные
// пары имя-значение, и перечислить их поимённо нельзя. В OpenAPI это выражается
// объектом со свободным составом полей: style=form с explode=true как раз
// раскладывает такой объект в отдельные параметры строки запроса.
Функция ОписаниеПроизвольныхПараметровЗапроса()

	СхемаПараметров = Новый Соответствие();
	СхемаПараметров.Вставить("type", "object");
	СхемаПараметров.Вставить("additionalProperties", СхемаСтроки());

	Параметр = Новый Соответствие();
	Параметр.Вставить("name", "параметры");
	Параметр.Вставить("in", "query");
	Параметр.Вставить(КлючОписания, "Произвольные параметры строки запроса");
	Параметр.Вставить("required", Ложь);
	Параметр.Вставить("style", "form");
	Параметр.Вставить("explode", Истина);
	Параметр.Вставить("schema", СхемаПараметров);

	Возврат Параметр;

КонецФункции

Функция СхемаСтроки()
	Схема = Новый Соответствие();
	Схема.Вставить("type", "string");
	Возврат Схема;
КонецФункции

// Описание параметра операции.
//
// Схема строится по аннотациям параметра метода - тем же, что описывают поля
// типа: &Тип задаёт тип, &Минимум и &Максимум - границы. Без аннотаций тип
// параметра неизвестен, и остаётся строка: из адреса и строки запроса значения
// приходят строками, пока их явно не объявили иначе.
Функция ОписаниеПараметра(Имя, Размещение, Обязательный, Действие)

	ОписаниеПараметраМетода = Действие.ОписанияПараметров.Получить(Имя);

	Если ОписаниеПараметраМетода = Неопределено Тогда
		Схема = СхемаСтроки();
	Иначе
		Схема = ПостроительСхемOpenApi.СхемаПоАннотациям(ОписаниеПараметраМетода);
		Если Схема.Количество() = 0 Тогда
			Схема.Вставить("type", "string");
		КонецЕсли;
	КонецЕсли;

	Параметр = Новый Соответствие();
	Параметр.Вставить("name", Имя);
	Параметр.Вставить("in", Размещение);
	Параметр.Вставить("required", Обязательный);
	Параметр.Вставить("schema", Схема);
	Возврат Параметр;

КонецФункции

Функция ОписаниеТелаЗапроса(Действие)

	ТипСодержимого = ОпределитьТипТелаЗапроса(Действие);

	СодержимоеТипа = Новый Соответствие();
	СодержимоеТипа.Вставить("schema", СхемаТелаЗапроса(ТипСодержимого, Действие));

	Содержимое = Новый Соответствие();
	Содержимое.Вставить(ТипСодержимого, СодержимоеТипа);

	ТелоЗапроса = Новый Соответствие();
	ТелоЗапроса.Вставить("required", Истина);
	ТелоЗапроса.Вставить("content", Содержимое);
	Возврат ТелоЗапроса;

КонецФункции

// Определяет MIME-тип тела запроса по параметрам точки маршрута.
//
// Параметры:
//   Действие - Структура - описание точки маршрута.
//
// Возвращаемое значение:
//   Строка - MIME-тип тела запроса.
Функция ОпределитьТипТелаЗапроса(Действие)
	Если СодержитПараметр(Действие, "ДанныеФормы") Тогда
		Возврат "multipart/form-data";
	ИначеЕсли СодержитПараметр(Действие, "ДвоичныеДанныеЗапроса")
			ИЛИ СодержитПараметр(Действие, "ТелоЗапросаДвоичныеДанные") Тогда
		Возврат "application/octet-stream";
	Иначе
		Возврат "application/json";
	КонецЕсли;
КонецФункции

// Схема тела запроса.
//
// Если у точки маршрута указан тип тела - аннотацией &Тип на параметре
// ТелоЗапросаОбъект, - схема строится по этому типу и попадает в components,
// а тело ссылается на неё. Без указания типа описать состав тела нечем,
// и остаётся объект без свойств.
//
// Параметры:
//   ТипСодержимого - Строка - MIME-тип тела запроса.
//   Действие       - Структура - описание точки маршрута.
//
// Возвращаемое значение:
//   Соответствие - объект схемы OpenAPI.
Функция СхемаТелаЗапроса(ТипСодержимого, Действие)

	Если ТипСодержимого = "application/octet-stream" Тогда
		Схема = Новый Соответствие();
		Схема.Вставить("type", "string");
		Схема.Вставить("format", "binary");
		Возврат Схема;
	КонецЕсли;

	Если ЗначениеЗаполнено(Действие.ТипТелаЗапроса) Тогда
		Возврат ПостроительСхемOpenApi.СхемаТипа(Действие.ТипТелаЗапроса);
	КонецЕсли;

	Схема = Новый Соответствие();
	Схема.Вставить("type", "object");
	Возврат Схема;

КонецФункции

// Собирает объект responses операции.
//
// Ответы, объявленные аннотацией &Возвращает, замещают ответ по умолчанию:
// если точка маршрута описала свои коды, придуманный за неё 200 только мешал бы.
// Ответы про авторизацию добавляются по ролям в любом случае - их объявляет
// не точка маршрута, а менеджер доступа.
Функция ОписаниеОтветов(Действие)

	Ответы = Новый Соответствие();

	Для Каждого ОписанныйОтвет Из Действие.Ответы Цикл
		Ответы.Вставить(Строка(ОписанныйОтвет.Код), ОтветИзОписания(ОписанныйОтвет));
	КонецЦикла;

	Если Ответы.Количество() = 0 Тогда
		Ответы.Вставить("200", ОтветСОписанием("Успешный ответ"));
	КонецЕсли;

	Если МенеджерДоступа.ТочкаМаршрутаИмеетРоли(Действие) Тогда
		ДобавитьЕслиОтсутствует(Ответы, "401", ОтветСОписанием("Требуется авторизация"));
		ДобавитьЕслиОтсутствует(Ответы, "403", ОтветСОписанием("Доступ запрещен"));
	КонецЕсли;

	Возврат Ответы;

КонецФункции

Функция ОтветИзОписания(ОписанныйОтвет)

	Ответ = ОтветСОписанием(?(ЗначениеЗаполнено(ОписанныйОтвет.Описание),
		ОписанныйОтвет.Описание, "Ответ " + ОписанныйОтвет.Код));

	Если НЕ ЗначениеЗаполнено(ОписанныйОтвет.Тип) Тогда
		Возврат Ответ;
	КонецЕсли;

	СодержимоеТипа = Новый Соответствие();
	СодержимоеТипа.Вставить("schema", ПостроительСхемOpenApi.СхемаТипа(ТипПоИмени(ОписанныйОтвет.Тип)));

	Содержимое = Новый Соответствие();
	Содержимое.Вставить("application/json", СодержимоеТипа);

	Ответ.Вставить("content", Содержимое);

	Возврат Ответ;

КонецФункции

// Имя типа приходит из аннотации, то есть написано человеком: несуществующий
// тип не должен ронять выдачу спецификации, поэтому такой ответ остаётся
// без описания содержимого.
Функция ТипПоИмени(ИмяТипа)

	Попытка
		Возврат Тип(ИмяТипа);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура ДобавитьЕслиОтсутствует(Ответы, Код, Ответ)
	Если Ответы.Получить(Код) = Неопределено Тогда
		Ответы.Вставить(Код, Ответ);
	КонецЕсли;
КонецПроцедуры

Функция ОтветСОписанием(Текст)
	Ответ = Новый Соответствие();
	Ответ.Вставить(КлючОписания, Текст);
	Возврат Ответ;
КонецФункции

Функция ТребованиеБезопасности()
	Требование = Новый Соответствие();
	Требование.Вставить("basicAuth", Новый Массив());

	Требования = Новый Массив();
	Требования.Добавить(Требование);
	Возврат Требования;
КонецФункции

Функция СодержитПараметр(Действие, ИмяПараметра)
	Возврат Действие.Параметры.Найти(ИмяПараметра) <> Неопределено
		ИЛИ Действие.Параметры.Найти(НРег(ИмяПараметра)) <> Неопределено;
КонецФункции

// Возвращает имена параметров пути в порядке их появления в адресе точки маршрута.
//
// Параметры:
//   Действие - Структура - описание точки маршрута.
//
// Возвращаемое значение:
//   Массив из Строка - имена параметров пути.
Функция УпорядоченныеИменаПараметровУРЛ(Действие)

	Имена = Новый Массив();

	Если Действие.ПараметрыУРЛ = Неопределено ИЛИ Действие.ПараметрыУРЛ.Количество() = 0 Тогда
		Возврат Имена;
	КонецЕсли;

	МаксимальныйИндекс = -1;
	Для Каждого ПараметрУРЛ Из Действие.ПараметрыУРЛ Цикл
		Если ПараметрУРЛ.Ключ > МаксимальныйИндекс Тогда
			МаксимальныйИндекс = ПараметрУРЛ.Ключ;
		КонецЕсли;
	КонецЦикла;

	Для Индекс = 0 По МаксимальныйИндекс Цикл
		Имя = Действие.ПараметрыУРЛ.Получить(Индекс);
		Если Имя <> Неопределено Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Восстанавливает путь для спецификации, заменяя служебные символы параметров
// маршрута на шаблоны вида {имяПараметра}.
//
// Параметры:
//   ПолныйПуть - Строка - путь маршрута с внутренними символами параметров.
//   Действие   - Структура - описание точки маршрута.
//
// Возвращаемое значение:
//   Строка - путь в формате OpenAPI.
Функция ПостроитьПутьOpenApi(ПолныйПуть, Действие)

	Путь = НормализоватьПуть(ПолныйПуть);

	Если Действие.ПараметрыУРЛ = Неопределено ИЛИ Действие.ПараметрыУРЛ.Количество() = 0 Тогда
		Возврат Путь;
	КонецЕсли;

	УпорядоченныеИмена = УпорядоченныеИменаПараметровУРЛ(Действие);
	СимволПараметра = Маршрутизатор.СимволПараметраТочкиМаршрута();

	Сегменты = СтрРазделить(Путь, "/");
	Результат = Новый Массив();
	ИндексПараметра = 0;

	Для Каждого Сегмент Из Сегменты Цикл
		Если Сегмент = СимволПараметра И ИндексПараметра < УпорядоченныеИмена.Количество() Тогда
			Результат.Добавить("{" + УпорядоченныеИмена[ИндексПараметра] + "}");
			ИндексПараметра = ИндексПараметра + 1;
		Иначе
			Результат.Добавить(Сегмент);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Результат, "/");

КонецФункции

// Возвращает список HTTP-методов точки маршрута.
//
// Параметры:
//   Действие - Структура - описание точки маршрута.
//
// Возвращаемое значение:
//   Массив из Строка - HTTP-методы в нижнем регистре.
Функция ОпределитьМетоды(Действие)

	Методы = Новый Массив();

	Если ЗначениеЗаполнено(Действие.HTTPМетоды) Тогда
		Для Каждого Метод Из СтрРазделить(Действие.HTTPМетоды, ",", Ложь) Цикл
			Метод = НРег(СокрЛП(Метод));
			Если НЕ ЗначениеЗаполнено(Метод) Тогда
				Продолжить;
			КонецЕсли;
			Если ДопустимыеМетоды.Получить(ВРег(Метод)) = Неопределено Тогда
				ВызватьИсключение СтрШаблон(
					"Недопустимый HTTP-метод ""%1"" в аннотации &Метод точки маршрута %2",
					Метод, Действие.ИмяМетода);
			КонецЕсли;
			Методы.Добавить(Метод);
		КонецЦикла;
	КонецЕсли;

	Если Методы.Количество() = 0 Тогда
		Методы.Добавить(?(ИмеетТелоЗапроса(Действие), "post", "get"));
	КонецЕсли;

	Возврат Методы;

КонецФункции

Функция ИмеетТелоЗапроса(Действие)

	Если Действие.ТипТелаЗапроса <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого ИмяПараметра Из Действие.Параметры Цикл
		Если ПараметрыТелаЗапроса.Получить(ВРег(ИмяПараметра)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НормализоватьПуть(Путь)
	Результат = СтрЗаменить(Путь, "\", "/");
	Если НЕ СтрНачинаетсяС(Результат, "/") Тогда
		Результат = "/" + Результат;
	КонецЕсли;
	Пока СтрНайти(Результат, "//") > 0 Цикл
		Результат = СтрЗаменить(Результат, "//", "/");
	КонецЦикла;
	Если СтрДлина(Результат) > 1 И СтрЗаканчиваетсяНа(Результат, "/") Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЭтоСлужебныйПуть(Путь)
	Возврат Путь = НормализоватьПуть(БазовыйПуть)
		ИЛИ Путь = НормализоватьПуть(ПутьСпецификации);
КонецФункции

Функция УбратьЗавершающийСлеш(Адрес)
	Если СтрЗаканчиваетсяНа(Адрес, "/") Тогда
		Возврат Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЕсли;
	Возврат Адрес;
КонецФункции

Функция ЭкранироватьРазметку(Текст)
	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СериализацияJson

// Минималистичный сериализатор JSON для документа OpenAPI.
// Поддерживает Соответствие, Структуру, Массив, Строку, Булево, Число и Неопределено.
// Реализован внутри winow, чтобы не зависеть от особенностей внешних библиотек.
//
// Параметры:
//   Значение - Произвольный - сериализуемое значение.
//
// Возвращаемое значение:
//   Строка - JSON-представление значения.
Функция ПреобразоватьВJson(Значение)

	Если Значение = Неопределено Тогда
		Возврат "null";

	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");

	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат ЧислоВJson(Значение);

	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СтрокаВJson(Значение);

	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат МассивВJson(Значение);

	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат СоответствиеВJson(Значение);

	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		Возврат СтруктураВJson(Значение);

	Иначе
		Возврат СтрокаВJson(Строка(Значение));

	КонецЕсли;

КонецФункции

Функция МассивВJson(Значение)
	Элементы = Новый Массив();
	Для Каждого Элемент Из Значение Цикл
		Элементы.Добавить(ПреобразоватьВJson(Элемент));
	КонецЦикла;
	Возврат "[" + СтрСоединить(Элементы, ",") + "]";
КонецФункции

Функция СоответствиеВJson(Значение)
	Элементы = Новый Массив();
	Для Каждого КлючЗначение Из Значение Цикл
		Элементы.Добавить(СтрокаВJson(Строка(КлючЗначение.Ключ)) + ":" + ПреобразоватьВJson(КлючЗначение.Значение));
	КонецЦикла;
	Возврат "{" + СтрСоединить(Элементы, ",") + "}";
КонецФункции

Функция СтруктураВJson(Значение)
	Элементы = Новый Массив();
	Для Каждого КлючЗначение Из Значение Цикл
		Элементы.Добавить(СтрокаВJson(КлючЗначение.Ключ) + ":" + ПреобразоватьВJson(КлючЗначение.Значение));
	КонецЦикла;
	Возврат "{" + СтрСоединить(Элементы, ",") + "}";
КонецФункции

Функция ЧислоВJson(Значение)
	// ЧГ=0 отключает группировку разрядов, ЧРД=. задает точку как разделитель
	// дробной части, ЧН=0 выводит ноль нулём: по умолчанию Формат отдаёт для нуля
	// пустую строку, и число пропадает из документа, ломая JSON.
	Возврат СокрЛП(Формат(Значение, "ЧГ=0; ЧРД=.; ЧН=0"));
КонецФункции

Функция СтрокаВJson(Значение)

	Результат = "";

	Для Индекс = 1 По СтрДлина(Значение) Цикл

		Символ = Сред(Значение, Индекс, 1);
		Экранированный = ЭкранированиеСимвола(Символ);

		Если Экранированный <> Неопределено Тогда
			Результат = Результат + Экранированный;
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;

	КонецЦикла;

	Возврат """" + Результат + """";

КонецФункции

// Возвращает экранированное представление символа для JSON-строки
// или Неопределено, если символ можно записать как есть.
//
// Параметры:
//   Символ - Строка - один символ.
//
// Возвращаемое значение:
//   Строка, Неопределено - экранированная последовательность либо Неопределено.
Функция ЭкранированиеСимвола(Символ)

	Экранирование = ТаблицаЭкранирования.Получить(Символ);
	Если Экранирование <> Неопределено Тогда
		Возврат Экранирование;
	КонецЕсли;

	ТекущийКод = КодСимвола(Символ);
	Если ТекущийКод <= КодПоследнегоУправляющегоСимвола Тогда
		Возврат "\u" + Прав("0000" + НРег(ВШестнадцатеричную(ТекущийКод)), ДлинаКодаСимвола);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ВШестнадцатеричную(Число)
	Цифры = "0123456789ABCDEF";
	Результат = "";
	Остаток = Число;
	Если Остаток = 0 Тогда
		Возврат "0";
	КонецЕсли;
	Пока Остаток > 0 Цикл
		Разряд = Остаток % ОснованиеШестнадцатеричной;
		Результат = Сред(Цифры, Разряд + 1, 1) + Результат;
		Остаток = Цел(Остаток / ОснованиеШестнадцатеричной);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

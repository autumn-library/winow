
&Пластилин
Перем Настройки;

&Пластилин
Перем НативныйОбработчикЗапросов;

Перем ВебСервер;

// Булево - признак включения инструментирования OpenTelemetry (otel.enabled).
// От него зависит, обрабатывается ли запрос в фоновом задании, см. FIXME ниже.
Перем ОтелВключен;

// Параметры:
//  ОтелВключенДеталька - Булево - Признак включения инструментирования (otel.enabled)
//
&Желудь
Процедура ПриСозданииОбъекта(
		&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) ОтелВключенДеталька)

	ОтелВключен = ОтелВключенДеталька;

КонецПроцедуры

Процедура Старт() Экспорт

	ЗапуститьСинхронно();

КонецПроцедуры

Процедура Стоп() Экспорт

	Если Не ВебСервер = Неопределено Тогда
		ВебСервер.Остановить();
	КонецЕсли;

КонецПроцедуры

Процедура ЗапуститьСинхронно() Экспорт
	СоздатьСервер();
	ВебСервер.Запустить();
КонецПроцедуры

Функция ПолучитьНативныйСервер() Экспорт
	СоздатьСервер();
	Возврат ВебСервер;
КонецФункции

Процедура СоздатьСервер()
	Если ВебСервер = Неопределено Тогда
		ВебСервер = Новый ВебСервер(Настройки.Порт);
		ВебСервер.ДобавитьОбработчикЗапросов(ЭтотОбъект, "ОбработатьЗапрос");
	КонецЕсли;
КонецПроцедуры

Процедура ОбработатьЗапрос(Контекст, СледующийОбработчик) Экспорт // BSLLS:UnusedParameters-off

	Если ОтелВключен Тогда
		ВыполнитьКонвейерВФоновомЗадании(Контекст);
	Иначе
		ВыполнитьКонвейер(Контекст);
	КонецЕсли;

КонецПроцедуры

// Разбор и обработка - два отдельных вызова к соседнему желудю: вокруг обработки
// открывается серверный спан OpenTelemetry, а открыть его раньше нельзя, потому
// что контекст трассировки извлекается из заголовков запроса winow.
//
// Экспортный, потому что служит точкой входа для ФоновыеЗадания.Выполнить.
//
// Параметры:
//  Контекст - КонтекстЗапроса - Контекст обрабатываемого запроса.
//
Процедура ВыполнитьКонвейер(Контекст) Экспорт

	Запрос = НативныйОбработчикЗапросов.РазобратьЗапрос(Контекст);

	НативныйОбработчикЗапросов.ОбработатьРазобранныйЗапрос(Запрос, Контекст);

КонецПроцедуры

// FIXME: временная затычка, пока OneScript не умеет отдавать идентификатор текущего потока.
//
// Kestrel обрабатывает запрос в потоке пула, а не в фоновом задании, поэтому
// ФоновыеЗадания.ПолучитьТекущее() возвращает Неопределено: Task.CurrentId такого
// потока нет в списке заданий. ОтелКонтекст ключует стеки контекстов именно
// идентификатором текущего задания, и все потоки Kestrel сваливаются в один стек
// основного потока - контексты параллельных запросов перемешиваются.
//
// Обработка в фоновом задании даёт валидный УИД потока и чинит контекст, но цена
// высокая: лишний поток пула на каждый запрос, поток Kestrel блокируется до конца
// обработки, а список заданий OneScript растёт неограниченно - он не чистится сам,
// и поиск текущего задания идёт по нему линейно.
//
// Убрать целиком, как только в OneScript появится метод получения идентификатора
// текущего потока (https://github.com/EvilBeaver/OneScript - задача ещё не заведена):
// тогда ОтелКонтекст сможет ключевать стеки реальным потоком, и оборачивать
// обработку в задание не понадобится.
//
// Параметры:
//  Контекст - КонтекстЗапроса - Контекст обрабатываемого запроса.
//
Процедура ВыполнитьКонвейерВФоновомЗадании(Контекст)

	Параметры = Новый Массив();
	Параметры.Добавить(Контекст);

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ВыполнитьКонвейер", Параметры);
	Задание.ОжидатьЗавершения();

	// Фоновое задание не выбрасывает ошибку наружу, а складывает её в свойство.
	// Пробрасываем дальше, чтобы поведение при ошибке не зависело от того, обёрнут
	// конвейер в задание или нет.
	Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		ВызватьИсключение Задание.ИнформацияОбОшибке;
	КонецЕсли;

КонецПроцедуры


&Пластилин
Перем Настройки;

&Пластилин
Перем НативныйОбработчикЗапросов;

&Пластилин
Перем СоединенияВебСокетов; // прерываются при остановке сервера

Перем ВебСервер;

&Желудь
Процедура ПриСозданииОбъекта()

КонецПроцедуры

Процедура Старт() Экспорт

	ЗапуститьСинхронно();

КонецПроцедуры

Процедура Стоп() Экспорт

	Если Не ВебСервер = Неопределено Тогда
		// Kestrel ждёт завершения обработчиков запросов, а обработчик веб-сокета
		// завершится только после закрытия соединения.
		СоединенияВебСокетов.ПрерватьВсеСоединения();
		ВебСервер.Остановить();
	КонецЕсли;

КонецПроцедуры

Процедура ЗапуститьСинхронно() Экспорт
	СоздатьСервер();
	ВебСервер.Запустить();
КонецПроцедуры

Функция ПолучитьНативныйСервер() Экспорт
	СоздатьСервер();
	Возврат ВебСервер;
КонецФункции

Процедура СоздатьСервер()
	Если ВебСервер = Неопределено Тогда
		УстановитьПределТелаЗапроса();
		ВебСервер = Новый ВебСервер(Настройки.Порт);
		ВебСервер.ИспользоватьВебСокеты();
		ВебСервер.ДобавитьОбработчикЗапросов(ЭтотОбъект, "ОбработатьЗапрос");
	КонецЕсли;
КонецПроцедуры

// Kestrel берёт предел из переменной среды при создании сервера.
Процедура УстановитьПределТелаЗапроса()
	Предел = Число(Настройки.МаксимальныйРазмерТелаЗапроса);
	Если Предел > 0 Тогда
		УстановитьПеременнуюСреды("Kestrel__Limits__MaxRequestBodySize", Формат(Предел, "ЧГ=0"));
	КонецЕсли;
КонецПроцедуры

// Разбор и обработка - два отдельных вызова к соседнему желудю: вокруг обработки
// открывается серверный спан OpenTelemetry, а открыть его раньше нельзя, потому
// что контекст трассировки извлекается из заголовков запроса winow.
//
// Kestrel обрабатывает запрос в потоке пула, и движок выделяет такому запросу
// собственный поток исполнения, в данных которого ОтелКонтекст держит стек
// контекстов. Поэтому заворачивать обработку в фоновое задание не нужно:
// контексты параллельных запросов не перемешиваются.
//
// Запрос на веб-сокет проходит через свой шов: серверный спан закрывается после
// рукопожатия, а сообщения читаются уже за его пределами. Kestrel закрывает
// веб-сокет, как только обработчик запроса вернёт управление, поэтому чтение
// возвращает управление только после закрытия соединения.
//
Процедура ОбработатьЗапрос(Контекст, СледующийОбработчик) Экспорт // BSLLS:UnusedParameters-off

	Запрос = НативныйОбработчикЗапросов.РазобратьЗапрос(Контекст);

	Если Контекст.ВебСокеты.ЭтоВебСокетЗапрос Тогда
		Рукопожатие = НативныйОбработчикЗапросов.ПринятьВебСокет(Запрос, Контекст);
		Если Рукопожатие.Подписка <> Неопределено Тогда
			Рукопожатие.Подписка.ЗапуститьОбработкуСообщений();
		КонецЕсли;
	Иначе
		НативныйОбработчикЗапросов.ОбработатьРазобранныйЗапрос(Запрос, Контекст);
	КонецЕсли;

КонецПроцедуры

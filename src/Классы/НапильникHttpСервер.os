// Напильник для автоматического создания серверных спанов OpenTelemetry
// при обработке входящих HTTP-запросов в winow.
// Оборачивает ОбработатьРазобранныйЗапрос() декоратором, который извлекает
// контекст трассировки из заголовков запроса, создает SERVER спан
// с HTTP semantic conventions и устанавливает код ответа после обработки.

#Использовать autumn-opentelemetry
#Использовать decorator

// Табакерка - отложенное получение ТрассировкаHttpЗапросов. Без табакерки желудь
// создавался бы при старте и тянул бы за собой SDK даже с выключенной трассировкой.
Перем ТабакеркаТрассировки;
// Рефлектор для установки полей в сгенерированный декоратор.
Перем ЛокальныйРефлектор;
// Признак включения инструментирования напильниками OTel.
Перем Включен;
// Строка - прозвище, которым помечены конвейеры обработки запроса веб-серверов.
// Отбор идёт по прозвищу, а не по именам классов: реализаций сервера несколько,
// и новой достаточно взять то же прозвище, чтобы получить серверный спан.
Перем ПрозвищеШва;

Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт

	Если НЕ Включен Тогда
		Возврат Желудь;
	КонецЕсли;

	Если ОпределениеЖелудя.Прозвища().Найти(ПрозвищеШва) = Неопределено Тогда
		Возврат Желудь;
	КонецЕсли;

	// Вся семантика спана живёт в ТрассировкаHttpЗапросов: в теле декоратора,
	// которое задаётся строкой, её не отладить и не покрыть тестами.
	ТелоПеред =
		"Декоратор_СостояниеТрассировки = Декоратор_Трассировка.Начать(Запрос);";

	ТелоПосле =
		"Декоратор_Трассировка.Завершить(Декоратор_СостояниеТрассировки,"
		+ " Запрос, Декоратор_ВозвращаемоеИзМетодаЗначение);";

	ТелоИсключения =
		"Декоратор_Трассировка.ЗавершитьСОшибкой(Декоратор_СостояниеТрассировки,"
		+ " ИнформацияОбОшибке(), ОписаниеОшибки());";

	ИмяМетода = "ОбработатьРазобранныйЗапрос";
	ПерехватчикПеред = Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
		.Тело(ТелоПеред);
	ПерехватчикПосле = Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипыПерехватчиковМетода.После)
		.Тело(ТелоПосле);
	ПерехватчикИсключения = Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипыПерехватчиковМетода.ПослеВызоваИсключения)
		.Тело(ТелоИсключения);
	Построитель = Новый ПостроительДекоратора(Желудь)
		.Поле(Новый Поле("Декоратор_Трассировка"))
		.Перехватчик(ПерехватчикПеред)
		.Перехватчик(ПерехватчикПосле)
		.Перехватчик(ПерехватчикИсключения);

	Декоратор = Построитель.Построить();
	ЛокальныйРефлектор.УстановитьСвойство(
		Декоратор, "Декоратор_Трассировка", ТабакеркаТрассировки.Достать());

	Возврат Декоратор;

КонецФункции

// Напильник для автоматического создания серверных спанов OpenTelemetry.
//
// Трассировка внедряется табакеркой: пока инструментирование выключено, желудь
// не создаётся, а значит не поднимается и SDK с фоновым экспортом.
//
// Параметры:
//  Трассировка - Табакерка       - Табакерка для отложенного получения ТрассировкаHttpЗапросов
//  ОтелВключен - Булево, Строка  - Признак включения инструментирования (otel.enabled)
//
&Напильник
&Порядок(510)
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин("ТрассировкаHttpЗапросов") Трассировка,
		&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) ОтелВключен)
	ТабакеркаТрассировки = Трассировка;
	Включен = ЭтоВключено(ОтелВключен);
	ЛокальныйРефлектор = Новый Рефлектор();

	ПрозвищеШва = "ОбработчикЗапросовВебСервера";
КонецПроцедуры

// Приводит детальку otel.enabled к булеву.
//
// Из JSON и YAML деталька приходит булевом, а из переменной среды (OTEL_ENABLED=true) -
// строкой: configor отдаёт значения переменных среды как есть, без приведения типа.
// Неявное приведение в "Если Строка Тогда" покрывает только "true", "false" и "истина",
// а на "1" или "yes" выбрасывает "Преобразование к типу 'Булево' не поддерживается" -
// приложение не поднялось бы вовсе, потому что напильник обрабатывает желуди при старте.
//
// Параметры:
//  Значение - Булево, Строка, Неопределено - Значение детальки как его отдал configor.
//
// Возвращаемое значение:
//  Булево - Истина, если инструментирование включено.
//
Функция ЭтоВключено(Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	// Строгая семантика спецификации OTel: включает только явное "true".
	// Любое другое значение - "false", "1", "yes", пустая строка - выключено.
	Возврат НРег(СокрЛП(Строка(Значение))) = "true";

КонецФункции

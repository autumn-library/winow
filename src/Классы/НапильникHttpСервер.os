// Напильник для автоматического создания спанов OpenTelemetry веб-сервера winow.
//
// Оборачивает декоратором два шва. Конвейер запроса - ОбработатьРазобранныйЗапрос()
// и рукопожатие веб-сокета ПринятьВебСокет(): вокруг них открывается SERVER спан
// с HTTP semantic conventions. События соединения веб-сокета - подключение,
// сообщение и отключение: вокруг каждого открывается свой корневой спан
// со ссылкой на спан рукопожатия.

#Использовать autumn-opentelemetry
#Использовать decorator

// Табакерка - отложенное получение ТрассировкаHttpЗапросов. Без табакерки желудь
// создавался бы при старте и тянул бы за собой SDK даже с выключенной трассировкой.
Перем ТабакеркаТрассировки;
// Табакерка - отложенное получение ТрассировкаВебСокетов, по той же причине.
Перем ТабакеркаТрассировкиВебСокетов;
// Рефлектор для установки полей в сгенерированный декоратор.
Перем ЛокальныйРефлектор;
// Признак включения инструментирования напильниками OTel.
Перем Включен;
// Строка - прозвище, которым помечены конвейеры обработки запроса веб-серверов.
// Отбор идёт по прозвищу, а не по именам классов: реализаций сервера несколько,
// и новой достаточно взять то же прозвище, чтобы получить серверный спан.
Перем ПрозвищеШва;
// Строка - прозвище желудя, через который проходят события соединений веб-сокета.
Перем ПрозвищеШваВебСокетов;

Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт

	Если НЕ Включен Тогда
		Возврат Желудь;
	КонецЕсли;

	Прозвища = ОпределениеЖелудя.Прозвища();

	Если Прозвища.Найти(ПрозвищеШва) <> Неопределено Тогда
		Результат = ОбернутьКонвейерЗапроса(Желудь);
	ИначеЕсли Прозвища.Найти(ПрозвищеШваВебСокетов) <> Неопределено Тогда
		Результат = ОбернутьСобытияВебСокета(Желудь);
	Иначе
		Результат = Желудь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Напильник для автоматического создания спанов OpenTelemetry веб-сервера.
//
// Трассировка внедряется табакеркой: пока инструментирование выключено, желудь
// не создаётся, а значит не поднимается и SDK с фоновым экспортом.
//
// Параметры:
//  Трассировка            - Табакерка       - Табакерка для отложенного получения ТрассировкаHttpЗапросов
//  ТрассировкаВебСокетов  - Табакерка       - Табакерка для отложенного получения ТрассировкаВебСокетов
//  ОтелВключен            - Булево, Строка  - Признак включения инструментирования (otel.enabled)
//
&Напильник
&Порядок(510)
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин("ТрассировкаHttpЗапросов") Трассировка,
		&Табакерка &Пластилин("ТрассировкаВебСокетов") ТрассировкаВебСокетов,
		&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) ОтелВключен)
	ТабакеркаТрассировки = Трассировка;
	ТабакеркаТрассировкиВебСокетов = ТрассировкаВебСокетов;
	Включен = ЭтоВключено(ОтелВключен);
	ЛокальныйРефлектор = Новый Рефлектор();

	ПрозвищеШва = "ОбработчикЗапросовВебСервера";
	ПрозвищеШваВебСокетов = "ОбработчикСобытийВебСокета";
КонецПроцедуры

// Вся семантика спана живёт в ТрассировкаHttpЗапросов: в теле декоратора,
// которое задаётся строкой, её не отладить и не покрыть тестами.
//
// Рукопожатие веб-сокета есть только у нативного сервера: прикладной отвечает
// на него в общем конвейере. Перехватчики метода, которого у желудя нет,
// декоратор пропускает.
//
// Параметры:
//  Желудь - ПрикладнойОбработчикЗапросов, НативныйОбработчикЗапросов - Конвейер запроса.
//
// Возвращаемое значение:
//  Произвольный - Декоратор конвейера.
//
Функция ОбернутьКонвейерЗапроса(Желудь)

	ТелоПеред =
		"Декоратор_СостояниеТрассировки = Декоратор_Трассировка.Начать(Запрос);";

	ТелоПосле =
		"Декоратор_Трассировка.Завершить(Декоратор_СостояниеТрассировки,"
		+ " Запрос, Декоратор_ВозвращаемоеИзМетодаЗначение);";

	Построитель = Новый ПостроительДекоратора(Желудь)
		.Поле(Новый Поле("Декоратор_Трассировка"));

	ДобавитьПерехватчики(Построитель, "ОбработатьРазобранныйЗапрос", ТелоПеред, ТелоПосле);
	ДобавитьПерехватчики(Построитель, "ПринятьВебСокет", ТелоПеред, ТелоПосле);

	Декоратор = Построитель.Построить();
	ЛокальныйРефлектор.УстановитьСвойство(
		Декоратор, "Декоратор_Трассировка", ТабакеркаТрассировки.Достать());

	Возврат Декоратор;

КонецФункции

// Семантика спанов событий живёт в ТрассировкаВебСокетов.
//
// Параметры:
//  Желудь - ОбработчикСобытийВебСокета - Шов событий соединений.
//
// Возвращаемое значение:
//  Произвольный - Декоратор шва.
//
Функция ОбернутьСобытияВебСокета(Желудь)

	ТелоПосле = "Декоратор_Трассировка.Завершить(Декоратор_СостояниеТрассировки);";

	Построитель = Новый ПостроительДекоратора(Желудь)
		.Поле(Новый Поле("Декоратор_Трассировка"));

	ДобавитьПерехватчики(Построитель, "ОбработатьПодключение",
		ТелоНачалаСобытия("НачатьПодключение"), ТелоПосле);
	ДобавитьПерехватчики(Построитель, "ОбработатьСообщение",
		ТелоНачалаСобытия("НачатьСообщение"), ТелоПосле);
	ДобавитьПерехватчики(Построитель, "ОбработатьОтключение",
		ТелоНачалаСобытия("НачатьОтключение"), ТелоПосле);

	Декоратор = Построитель.Построить();
	ЛокальныйРефлектор.УстановитьСвойство(
		Декоратор, "Декоратор_Трассировка", ТабакеркаТрассировкиВебСокетов.Достать());

	Возврат Декоратор;

КонецФункции

Функция ТелоНачалаСобытия(ИмяМетодаТрассировки)
	Возврат "Декоратор_СостояниеТрассировки = Декоратор_Трассировка."
		+ ИмяМетодаТрассировки + "(Подключение);";
КонецФункции

// Обе трассировки завершают спан с ошибкой одинаково.
//
// Параметры:
//  Построитель - ПостроительДекоратора - Построитель, в который добавляются перехватчики.
//  ИмяМетода   - Строка - Имя оборачиваемого метода.
//  ТелоПеред   - Строка - Код, открывающий спан.
//  ТелоПосле   - Строка - Код, завершающий спан после успешного вызова.
//
Процедура ДобавитьПерехватчики(Построитель, ИмяМетода, ТелоПеред, ТелоПосле)

	ТелоИсключения =
		"Декоратор_Трассировка.ЗавершитьСОшибкой(Декоратор_СостояниеТрассировки,"
		+ " ИнформацияОбОшибке(), ОписаниеОшибки());";

	ПерехватчикПеред = Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
		.Тело(ТелоПеред);
	ПерехватчикПосле = Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипыПерехватчиковМетода.После)
		.Тело(ТелоПосле);
	ПерехватчикИсключения = Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипыПерехватчиковМетода.ПослеВызоваИсключения)
		.Тело(ТелоИсключения);

	Построитель
		.Перехватчик(ПерехватчикПеред)
		.Перехватчик(ПерехватчикПосле)
		.Перехватчик(ПерехватчикИсключения);

КонецПроцедуры

// Приводит детальку otel.enabled к булеву.
//
// Из JSON и YAML деталька приходит булевом, а из переменной среды (OTEL_ENABLED=true) -
// строкой: configor отдаёт значения переменных среды как есть, без приведения типа.
// Неявное приведение в "Если Строка Тогда" покрывает только "true", "false" и "истина",
// а на "1" или "yes" выбрасывает "Преобразование к типу 'Булево' не поддерживается" -
// приложение не поднялось бы вовсе, потому что напильник обрабатывает желуди при старте.
//
// Параметры:
//  Значение - Булево, Строка, Неопределено - Значение детальки как его отдал configor.
//
// Возвращаемое значение:
//  Булево - Истина, если инструментирование включено.
//
Функция ЭтоВключено(Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	// Строгая семантика спецификации OTel: включает только явное "true".
	// Любое другое значение - "false", "1", "yes", пустая строка - выключено.
	Возврат НРег(СокрЛП(Строка(Значение))) = "true";

КонецФункции

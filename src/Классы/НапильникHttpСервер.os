// Напильник для автоматического создания серверных спанов OpenTelemetry
// при обработке входящих HTTP-запросов в winow.
// Оборачивает ОбработчикЗапросов.СформироватьОтвет() декоратором,
// который извлекает контекст трассировки из заголовков запроса,
// создает SERVER спан с HTTP semantic conventions
// и устанавливает код ответа после обработки.

#Использовать autumn-opentelemetry
#Использовать decorator

// ТрассировкаHttpЗапросов - ведёт серверный спан вокруг обработки запроса.
Перем Трассировка;
// Табакерка для отложенного получения SDK: без неё SDK поднимался бы всегда.
Перем ТабакеркаSdk;
// Рефлектор для установки полей в сгенерированный декоратор.
Перем ЛокальныйРефлектор;
// Признак включения инструментирования напильниками OTel.
Перем Включен;

Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт

	Если НЕ Включен Тогда
		Возврат Желудь;
	КонецЕсли;

	ИмяБина = ОпределениеЖелудя.Имя();

	Если НРег(ИмяБина) <> "обработчикзапросов" Тогда
		Возврат Желудь;
	КонецЕсли;

	Если Трассировка = Неопределено Тогда
		Сдк = ТабакеркаSdk.Достать();
		// Свой трассировщик, а не общий бин ОтелТрассировщик: тот заведён с областью
		// инструментирования autumn-observed, то есть от имени autumn-opentelemetry.
		// Серверные спаны создаёт winow, поэтому и область должна быть его - иначе
		// в бэкенде не отличить их от спанов методов и не выключить по отдельности.
		Трассировка = Новый ТрассировкаHttpЗапросов(
			Сдк.ПолучитьТрассировщик("winow"),
			Сдк.Пропагаторы());
	КонецЕсли;

	// Вся семантика спана живёт в ТрассировкаHttpЗапросов: в теле декоратора,
	// которое задаётся строкой, её не отладить и не покрыть тестами.
	ТелоПеред =
		"Декоратор_СостояниеТрассировки = Декоратор_Трассировка.Начать(Запрос);";

	ТелоПосле =
		"Декоратор_Трассировка.Завершить(Декоратор_СостояниеТрассировки,"
		+ " Запрос, Декоратор_ВозвращаемоеИзМетодаЗначение);";

	ТелоИсключения =
		"Декоратор_Трассировка.ЗавершитьСОшибкой(Декоратор_СостояниеТрассировки,"
		+ " ИнформацияОбОшибке(), ОписаниеОшибки());";

	ИмяМетода = "СформироватьОтвет";
	ПерехватчикПеред = Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
		.Тело(ТелоПеред);
	ПерехватчикПосле = Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипыПерехватчиковМетода.После)
		.Тело(ТелоПосле);
	ПерехватчикИсключения = Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипыПерехватчиковМетода.ПослеВызоваИсключения)
		.Тело(ТелоИсключения);
	Построитель = Новый ПостроительДекоратора(Желудь)
		.Поле(Новый Поле("Декоратор_Трассировка"))
		.Перехватчик(ПерехватчикПеред)
		.Перехватчик(ПерехватчикПосле)
		.Перехватчик(ПерехватчикИсключения);

	Декоратор = Построитель.Построить();
	ЛокальныйРефлектор.УстановитьСвойство(Декоратор, "Декоратор_Трассировка", Трассировка);

	Возврат Декоратор;

КонецФункции

// Напильник для автоматического создания серверных спанов OpenTelemetry.
//
// SDK внедряется табакеркой: пока инструментирование выключено, бин не создаётся,
// а значит не поднимается и сам SDK с фоновым экспортом.
//
// Параметры:
//  ОтелSdk     - Табакерка - Табакерка для отложенного получения SDK OTel
//  ОтелВключен - Булево    - Признак включения инструментирования (otel.enabled)
//
&Напильник
&Порядок(510)
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин("ОтелSdk") ОтелSdk,
		&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) ОтелВключен)
	ТабакеркаSdk = ОтелSdk;
	Включен = ОтелВключен;
	ЛокальныйРефлектор = Новый Рефлектор();
КонецПроцедуры

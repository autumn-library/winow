#Использовать collectionos

// СписокКопированиеПриЗаписи Из Структура - соединения с полями Идентификатор, Топик,
// Соединение, ИдСоединения и КонтекстТрассировки, см. ОбработчикСерверныхСобытий.
// Соединения добавляются и удаляются из параллельных потоков - потоков Kestrel у нативного
// сервера и фоновых заданий у прикладного, - пока рассылки и контроль соединений ищут
// в пуле получателей. Читают пул гораздо чаще, чем меняют,
// поэтому список с копированием при записи: чтение идёт по снимку без блокировки,
// а изменение атомарно.
Перем ПулСоединений;
Перем Подписки; // ПодпискиСерверныхСобытий - получают события открытия и закрытия соединений

&ЛогВебСервера
Перем Лог; // ошибки закрытия соединений

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ПодпискиСерверныхСобытий)
	Подписки = ПодпискиСерверныхСобытий;
	ПулСоединений = Новый СписокКопированиеПриЗаписи();
КонецПроцедуры

// Параметры:
//  Топик - Строка - Топик соединений.
//
// Возвращаемое значение:
//  Число - Количество соединений топика.
//
Функция Количество(Топик) Экспорт
	Возврат ПолучитьСоединенияПоТопику(Топик).Количество();
КонецФункции

// Возвращаемое значение:
//  Массив Из Структура - Снимок пула, см. ПолучитьСоединенияСОтбором.
//
Функция ПулСоединений() Экспорт
	Возврат ПулСоединений.ВМассив();
КонецФункции

// Параметры:
//  Соединение    - TCPСоединение, СоединениеСерверныхСобытийНативное - Принятое соединение.
//  Идентификатор - Строка - Идентификатор сессии клиента.
//  Топик         - Строка - Топик, на который подключился клиент.
//  КонтекстТрассировки - ОтелКонтекстСпана, Неопределено - Контекст серверного спана подключения:
//                        на него ссылаются спаны событий соединения.
//
Процедура Добавить(Соединение, Идентификатор, Топик, КонтекстТрассировки = Неопределено) Экспорт

	ДанныеСоединения = Новый Структура("Идентификатор, Топик, Соединение, ИдСоединения, КонтекстТрассировки");
	ДанныеСоединения.Идентификатор = Идентификатор;
	ДанныеСоединения.Топик = Топик;
	ДанныеСоединения.Соединение = Соединение;
	ДанныеСоединения.ИдСоединения = Строка(Новый УникальныйИдентификатор());
	ДанныеСоединения.КонтекстТрассировки = КонтекстТрассировки;

	ПулСоединений.Добавить(ДанныеСоединения);

	Подписки.СобытиеОткрытия(ДанныеСоединения);

КонецПроцедуры

// Параметры:
//  Идентификатор - Строка - Идентификатор сессии клиента.
//  Топик         - Строка - Топик соединений.
//
Процедура Удалить(Идентификатор, Топик) Экспорт
	Для Каждого ДанныеСоединения Из ПолучитьСоединениеПоИдентификатору(Топик, Идентификатор) Цикл
		УдалитьСтрокуПула(ДанныеСоединения);
	КонецЦикла;
КонецПроцедуры

// Параметры:
//  Соединение - TCPСоединение, СоединениеСерверныхСобытийНативное - Удаляемое соединение.
//
Процедура УдалитьСоединение(Соединение) Экспорт
	Для Каждого ДанныеСоединения Из ПолучитьСоединенияСОтбором(Новый Структура("Соединение", Соединение)) Цикл
		УдалитьСтрокуПула(ДанныеСоединения);
	КонецЦикла;
КонецПроцедуры

// Закрывает все соединения и удаляет их из пула: так останавливается сервер. Нативный
// без этого ждал бы завершения обработчиков запросов на серверные события, а у прикладного
// клиенты остались бы подключены к остановленному серверу.
Процедура ЗакрытьВсеСоединения() Экспорт
	Для Каждого ДанныеСоединения Из ПулСоединений Цикл
		УдалитьСтрокуПула(ДанныеСоединения);
	КонецЦикла;
КонецПроцедуры

// Параметры:
//  ИдСоединения - Строка - Идентификатор соединения.
//
Процедура УдалитьСтрокуПулаПоИдСоединения(ИдСоединения) Экспорт
	Для Каждого ДанныеСоединения Из ПолучитьСоединениеПоИдСоединения(ИдСоединения) Цикл
		УдалитьСтрокуПула(ДанныеСоединения);
	КонецЦикла;
КонецПроцедуры

// Закрывает соединение и удаляет его из пула. Соединение могли удалить из другого
// потока одновременно с этим: о закрытии оповещает только тот, кто удалил его из пула.
//
// Параметры:
//  СтрокаСоединения - Структура - Соединение из пула, см. ПолучитьСоединенияСОтбором.
//
Процедура УдалитьСтрокуПула(СтрокаСоединения) Экспорт

	Удалено = ПулСоединений.Удалить(СтрокаСоединения);

	ЗакрытьСоединениеВПопытке(СтрокаСоединения.Соединение);
	ОсвободитьОбъект(СтрокаСоединения.Соединение);

	Если Удалено Тогда
		Подписки.СобытиеЗакрытия(СтрокаСоединения);
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Топик - Строка - Топик соединений.
//
// Возвращаемое значение:
//  Массив Из Структура - Соединения топика, см. ПолучитьСоединенияСОтбором.
//
Функция ПолучитьСоединенияПоТопику(Топик) Экспорт
	Возврат ПолучитьСоединенияСОтбором(Новый Структура("Топик", Топик));
КонецФункции

// Параметры:
//  Топик                 - Строка - Топик соединений.
//  СписокИдентификаторов - Массив Из Строка - Идентификаторы соединений.
//
// Возвращаемое значение:
//  Массив Из Структура - Соединения топика из списка, см. ПолучитьСоединенияСОтбором.
//
Функция ПолучитьСоединенияПоТопикуСпискуИдентификаторов(Топик, СписокИдентификаторов) Экспорт
	Результат = Новый Массив();
	Для Каждого ДанныеСоединения Из ПолучитьСоединенияПоТопику(Топик) Цикл
		Если СписокИдентификаторов.Найти(ДанныеСоединения.ИдСоединения) <> Неопределено Тогда
			Результат.Добавить(ДанныеСоединения);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Параметры:
//  Топик                           - Строка - Топик соединений.
//  СписокИсключенийИдентификаторов - Массив Из Строка - Идентификаторы исключаемых соединений.
//
// Возвращаемое значение:
//  Массив Из Структура - Соединения топика не из списка, см. ПолучитьСоединенияСОтбором.
//
Функция ПолучитьСоединенияПоТопикуКромеСпискаИдентификаторов(Топик, СписокИсключенийИдентификаторов) Экспорт
	Результат = Новый Массив();
	Для Каждого ДанныеСоединения Из ПолучитьСоединенияПоТопику(Топик) Цикл
		Если СписокИсключенийИдентификаторов.Найти(ДанныеСоединения.ИдСоединения) = Неопределено Тогда
			Результат.Добавить(ДанныеСоединения);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Параметры:
//  Топик         - Строка - Топик соединений.
//  Идентификатор - Строка - Идентификатор сессии клиента.
//
// Возвращаемое значение:
//  Массив Из Структура - Соединения клиента в топике, см. ПолучитьСоединенияСОтбором.
//
Функция ПолучитьСоединениеПоИдентификатору(Топик, Идентификатор) Экспорт
	Возврат ПолучитьСоединенияСОтбором(Новый Структура("Топик, Идентификатор", Топик, Идентификатор));
КонецФункции

// Параметры:
//  ИдСоединения - Строка - Идентификатор соединения.
//
// Возвращаемое значение:
//  Массив Из Структура - Соединение с этим идентификатором, см. ПолучитьСоединенияСОтбором.
//
Функция ПолучитьСоединениеПоИдСоединения(ИдСоединения) Экспорт
	Возврат ПолучитьСоединенияСОтбором(Новый Структура("ИдСоединения", ИдСоединения));
КонецФункции

// Параметры:
//  Отбор - Структура - Значения полей соединения, которым должны соответствовать найденные соединения.
//
// Возвращаемое значение:
//  Массив Из Структура - Соединения из снимка пула:
//   * Идентификатор - Строка - Идентификатор сессии клиента.
//   * Топик         - Строка - Топик, на который подключился клиент.
//   * Соединение    - TCPСоединение, СоединениеСерверныхСобытийНативное - Соединение клиента.
//   * ИдСоединения  - Строка - Идентификатор соединения.
//
Функция ПолучитьСоединенияСОтбором(Отбор) Экспорт
	Соединения = Новый Массив();
	// обход идёт по снимку пула: без блокировки и без копирования
	Для Каждого ДанныеСоединения Из ПулСоединений Цикл
		Если СоответствуетОтбору(ДанныеСоединения, Отбор) Тогда
			Соединения.Добавить(ДанныеСоединения);
		КонецЕсли;
	КонецЦикла;
	Возврат Соединения;
КонецФункции

Функция СоответствуетОтбору(ДанныеСоединения, Отбор)
	Соответствует = Истина;
	Для Каждого Условие Из Отбор Цикл
		Соответствует = Соответствует И ДанныеСоединения[Условие.Ключ] = Условие.Значение;
	КонецЦикла;
	Возврат Соответствует;
КонецФункции

// Ошибка закрытия не важна: соединение и так удаляется из пула.
//
// Параметры:
//  Соединение - TCPСоединение, СоединениеСерверныхСобытийНативное - Закрываемое соединение.
//
Процедура ЗакрытьСоединениеВПопытке(Соединение) Экспорт
	Попытка
		Соединение.Закрыть();
	Исключение
		Лог.Отладка("Не удалось закрыть SSE соединение: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

#Использовать autumn
#Использовать autumn-logos

// Регистрирует служебные маршруты документации при запуске приложения.
//
// Адреса настраиваемые, поэтому объявить их аннотациями на контроллере нельзя -
// они становятся известны только из деталек. Отсюда и регистрация кодом, и
// отдельный желудь: КонтроллерOpenApi отвечает за содержимое ответов, а этот -
// за то, по каким адресам они доступны.
//
// Ничего не делает, пока не включена деталька winow.openapi.Включено: генерация
// спецификации по умолчанию выключена, чтобы не менять поведение существующих
// приложений.

&Лог("winow.openapi")
// Логгер регистратора служебных маршрутов OpenAPI.
Перем Лог;

&Пластилин
// Маршрутизатор веб-сервера.
Перем Маршрутизатор;

&Пластилин
// Контроллер, отдающий спецификацию и страницу Swagger UI.
Перем КонтроллерOpenApi;

&Пластилин
// Генератор спецификации. Он же владеет адресами документации: держать их
// вторым набором настроек здесь означало бы риск расхождения.
Перем ГенераторOpenApi;

&Деталька(Значение = "winow.openapi.Включено", ЗначениеПоУмолчанию = Ложь)
// Признак включения генерации спецификации и Swagger UI.
Перем Включено;

&Рогатка
Процедура ПриСозданииОбъекта()

КонецПроцедуры

// Регистрирует служебные маршруты при запуске приложения, если генерация включена
// настройкой winow.openapi.Включено.
Процедура ПриЗапускеПриложения() Экспорт

	Если Включено Тогда
		ЗарегистрироватьМаршруты();
	КонецЕсли;

КонецПроцедуры

// Регистрирует служебные маршруты спецификации (JSON и YAML) и страницы Swagger UI.
Процедура ЗарегистрироватьМаршруты() Экспорт

	// Спецификации нужен запрос: по его заголовкам определяется базовый адрес API.
	ПараметрыСпецификации = Новый Массив();
	ПараметрыСпецификации.Добавить("Ответ");
	ПараметрыСпецификации.Добавить("Запрос");

	// Странице запрос нужен по той же причине, что и спецификации: по заголовкам
	// прокси она узнаёт, под каким префиксом опубликована.
	ПараметрыСтраницы = Новый Массив();
	ПараметрыСтраницы.Добавить("Ответ");
	ПараметрыСтраницы.Добавить("Запрос");

	АдресJson = ГенераторOpenApi.АдресСпецификацииJson();
	АдресYaml = ГенераторOpenApi.АдресСпецификацииYaml();
	АдресСтраницы = ГенераторOpenApi.АдресСтраницыSwaggerUI();

	// Совпадение адресов ловить отдельно не нужно: повторную регистрацию
	// того же пути отклонит ЗарегистрироватьМаршрут.
	ЗарегистрироватьМаршрут(АдресJson, "ОтдатьСпецификациюJson", ПараметрыСпецификации);
	ЗарегистрироватьМаршрут(АдресYaml, "ОтдатьСпецификациюYaml", ПараметрыСпецификации);
	ЗарегистрироватьМаршрут(АдресСтраницы, "ОтдатьSwaggerUI", ПараметрыСтраницы);

	Сообщение = СтрШаблон(
		"Swagger UI доступен по адресу %1, спецификация OpenAPI - по адресам %2 и %3",
		АдресСтраницы,
		АдресJson,
		АдресYaml);
	Лог.Информация(Сообщение);

КонецПроцедуры

Процедура ЗарегистрироватьМаршрут(Путь, ИмяМетода, ПараметрыМетода)

	Действие = Маршрутизатор.ОписаниеТочкиМаршрута();
	Действие.АдресКонтроллера = Путь;
	Действие.Желудь = КонтроллерOpenApi;
	Действие.ИмяМетода = ИмяМетода;
	Действие.Параметры = ПараметрыМетода;

	// Занять путь и убедиться, что он был свободен, - одна операция маршрутизатора:
	// порознь между проверкой и записью успевала бы вклиниться другая рогатка.
	Если НЕ Маршрутизатор.ДобавитьМаршрутЕслиСвободен(Путь, Действие) Тогда
		ВызватьИсключение СтрШаблон(
			"winow.openapi: путь %1 уже зарегистрирован другим обработчиком", Путь);
	КонецЕсли;

КонецПроцедуры

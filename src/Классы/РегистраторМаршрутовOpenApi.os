#Использовать autumn
#Использовать autumn-logos

// Логгер регистратора служебных маршрутов OpenAPI.
&Лог("winow.openapi")
Перем Лог;

// Маршрутизатор веб-сервера.
&Пластилин Перем Маршрутизатор;
// Контроллер, отдающий спецификацию и страницу Swagger UI.
&Пластилин Перем КонтроллерOpenApi;

// Признак включения генерации спецификации и Swagger UI.
&Деталька(Значение = "winow.openapi.Включено", ЗначениеПоУмолчанию = Ложь)
Перем Включено;

// Путь, по которому отдается страница Swagger UI.
&Деталька(Значение = "winow.openapi.БазовыйПуть", ЗначениеПоУмолчанию = "/swagger")
Перем БазовыйПуть;

// Путь, по которому отдается JSON спецификации.
&Деталька(Значение = "winow.openapi.ПутьСпецификации", ЗначениеПоУмолчанию = "/swagger/openapi.json")
Перем ПутьСпецификации;

&Рогатка
Процедура ПриСозданииОбъекта()

КонецПроцедуры

// Регистрирует служебные маршруты при запуске приложения, если генерация включена
// настройкой winow.openapi.Включено.
Процедура ПриЗапускеПриложения() Экспорт

	Если Включено Тогда
		ЗарегистрироватьМаршруты();
	КонецЕсли;

КонецПроцедуры

// Регистрирует служебные маршруты OpenAPI (JSON спецификации) и страницы Swagger UI.
Процедура ЗарегистрироватьМаршруты() Экспорт

	Если БазовыйПуть = ПутьСпецификации Тогда
		ВызватьИсключение "winow.openapi: БазовыйПуть и ПутьСпецификации должны различаться";
	КонецЕсли;

	ЗарегистрироватьМаршрут(ПутьСпецификации, "ОтдатьСпецификацию");
	ЗарегистрироватьМаршрут(БазовыйПуть, "ОтдатьSwaggerUI");

	Лог.Информация(СтрШаблон(
		"Swagger UI доступен по адресу %1, спецификация OpenAPI - по адресу %2",
		БазовыйПуть,
		ПутьСпецификации));

КонецПроцедуры

Процедура ЗарегистрироватьМаршрут(Путь, ИмяМетода)

	Если МаршрутЗанят(Путь) Тогда
		ВызватьИсключение СтрШаблон(
			"winow.openapi: путь %1 уже зарегистрирован другим обработчиком", Путь);
	КонецЕсли;

	ПараметрыМетода = Новый Массив();
	ПараметрыМетода.Добавить("Ответ");

	Действие = Маршрутизатор.ОписаниеТочкиМаршрута();
	Действие.АдресКонтроллера = Путь;
	Действие.Желудь = КонтроллерOpenApi;
	Действие.ИмяМетода = ИмяМетода;
	Действие.Параметры = ПараметрыМетода;
	Действие.ВыводитьШаблонКонтрола = Ложь;

	Маршрутизатор.ДобавитьМаршрут(Путь, Действие);

КонецПроцедуры

Функция МаршрутЗанят(Путь)
	Обработчик = Маршрутизатор.НайтиОбработчикИПараметрыПоПолномуПути(Путь);
	Возврат ЗначениеЗаполнено(Обработчик.Действие);
КонецФункции

#Использовать autumn
#Использовать autumn-logos

&Лог("winow.openapi")
Перем Лог;

&Пластилин Перем Маршрутизатор;
&Пластилин Перем КонтроллерOpenApi;
&Пластилин Перем Настройки;

&Желудь
Процедура ПриСозданииОбъекта()

КонецПроцедуры

// Регистрирует служебные маршруты OpenAPI/Swagger UI, если генерация включена
// настройкой winow.OpenApi.Включено.
Процедура ЗарегистрироватьМаршруты() Экспорт

	Если НЕ Настройки.OpenApiВключено Тогда
		Возврат;
	КонецЕсли;

	ЗарегистрироватьМаршрут(Настройки.OpenApiПутьСпецификации, "ОтдатьСпецификацию");
	ЗарегистрироватьМаршрут(Настройки.OpenApiБазовыйПуть, "ОтдатьSwaggerUI");

	Лог.Информация(СтрШаблон(
		"Swagger UI доступен по адресу %1, спецификация OpenAPI - по адресу %2",
		Настройки.OpenApiБазовыйПуть,
		Настройки.OpenApiПутьСпецификации));

КонецПроцедуры

Процедура ЗарегистрироватьМаршрут(Путь, ИмяМетода)

	Действие = Маршрутизатор.ОписаниеТочкиМаршрута();
	Действие.АдресКонтроллера = Путь;
	Действие.Желудь = КонтроллерOpenApi;
	Действие.ИмяМетода = ИмяМетода;
	Действие.Параметры = Новый Массив();
	Действие.Параметры.Добавить("Ответ");
	Действие.ВыводитьШаблонКонтрола = Ложь;

	Маршрутизатор.ДобавитьМаршрут(Путь, Действие);

КонецПроцедуры

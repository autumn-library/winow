#Использовать semaphore

// Подписка на соединение нативного веб-сервера.
//
// Kestrel закрывает веб-сокет, как только обработчик запроса вернёт управление,
// поэтому сообщения читаются в потоке запроса, а не в фоновом задании,
// как у ПодпискаНаВебСокетПрикладная: ЗапуститьОбработкуСообщений возвращает
// управление только после закрытия соединения.
//
// Кадры собирает и разбирает Kestrel, поэтому подписка работает с готовыми
// сообщениями.

Перем _БрокерСообщенийВебСокетов;
Перем _СоединенияВебСокетов;
Перем _Лог;

Перем _Идентификатор;
Перем _Соединение;
Перем _Топик;
Перем _Включена;

// Семафор - сериализует отправку: ВебСокет не допускает двух одновременных отправок,
// а сообщения в одно соединение могут рассылать обработчики разных клиентов.
Перем _СемафорОтправки;

// Число - размер буфера чтения, байты. Сообщение длиннее приходит в несколько приёмов.
Перем _РазмерБуфера;

// Перечисления нативного сервера получаются через Вычислить: прикладной сервер
// работает и на OneScript 1.x, где таких перечислений нет и модуль бы не скомпилировался.
Перем СостояниеОткрыт;
Перем СостояниеЗапросЗакрытияПринят;
Перем ТипТекст;
Перем ТипЗакрытие;
Перем СтатусНормальноеЗакрытие;

&Желудь
&Характер("Компанейский")
&ОсобоеОбращение(ОтключитьВсеНапильники = Истина)
Процедура ПриСозданииОбъекта(&Пластилин БрокерСообщенийВебСокетов,
							&Пластилин СоединенияВебСокетов)
	_СоединенияВебСокетов = СоединенияВебСокетов;
	_БрокерСообщенийВебСокетов = БрокерСообщенийВебСокетов;
	_Лог = Логирование.ПолучитьЛог("oscript.lib.winow");
	_Включена = Ложь;
	_СемафорОтправки = Новый Семафор();
	_РазмерБуфера = 4096;

	СостояниеОткрыт = Вычислить("СостояниеВебСокета.Открыт");
	СостояниеЗапросЗакрытияПринят = Вычислить("СостояниеВебСокета.ЗапросЗакрытияПринят");
	ТипТекст = Вычислить("ТипСообщенияВебСокета.Текст");
	ТипЗакрытие = Вычислить("ТипСообщенияВебСокета.Закрытие");
	СтатусНормальноеЗакрытие = Вычислить("СтатусЗакрытияВебСокета.НормальноеЗакрытие");
КонецПроцедуры

// Параметры:
//  Соединение    - ВебСокет - Принятое соединение.
//  Идентификатор - Строка - Идентификатор сессии клиента.
//  Топик         - Строка - Путь, по которому подключился клиент.
//
Процедура Подписатся(Соединение, Идентификатор, Топик) Экспорт
	_Идентификатор = Идентификатор;
	_Соединение = Соединение;
	_Топик = Топик;
	_Включена = Истина;
КонецПроцедуры

// Закрывает соединение со стороны сервера. Ожидающее чтение получит ответный
// кадр закрытия от клиента, и ЗапуститьОбработкуСообщений завершится.
Процедура Отписаться() Экспорт
	_Включена = Ложь;
	ЗакрытьСоединение();
КонецПроцедуры

// Прерывает соединение, не дожидаясь ответа клиента: так останавливается сервер.
Процедура ПрерватьСоединение() Экспорт
	_Включена = Ложь;
	// Метод ВебСокет.Прервать совпадает с ключевым словом, поэтому вызывается по английскому имени
	_Соединение.Abort();
КонецПроцедуры

Процедура ОтправитьСообщение(Сообщение) Экспорт
	_СемафорОтправки.Захватить();
	Попытка
		_Соединение.ОтправитьСтроку(Сообщение);
	Исключение
		_СемафорОтправки.Освободить();
		_Лог.Ошибка("Не удалось отправить сообщение в WS соединение: " + ОписаниеОшибки());
		ЗакрытьСоединение();
		Возврат;
	КонецПопытки;
	_СемафорОтправки.Освободить();
КонецПроцедуры

// Читает сообщения, пока соединение открыто. Возвращает управление после
// закрытия соединения - так обработчик запроса удерживает веб-сокет открытым.
Процедура ЗапуститьОбработкуСообщений() Экспорт
	Если _Соединение = Неопределено Тогда
		ВызватьИсключение "Не инициализировано соединение, невозможно запустить обработку сообщений";
	КонецЕсли;

	_БрокерСообщенийВебСокетов.ПриПодключении(_Топик, _Идентификатор);

	Попытка
		ОбработкаСообщений();
	Исключение
		// Клиент оборвал соединение, не отправив кадр закрытия.
		_Лог.Отладка("WS соединение прервано: " + ОписаниеОшибки());
	КонецПопытки;

	ЗакрытьСоединение();
	Отключить();
КонецПроцедуры

Процедура ОбработкаСообщений()

	Буфер = Новый БуферДвоичныхДанных(_РазмерБуфера);

	Пока _Включена И _Соединение.Состояние = СостояниеОткрыт Цикл

		Части = Новый Массив();
		Пока Истина Цикл
			Результат = _Соединение.Получить(Буфер);
			Если Результат.ТипСообщения = ТипЗакрытие Тогда
				Возврат;
			КонецЕсли;
			Части.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер.Прочитать(0, Результат.Количество)));
			Если Результат.КонецСообщения Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		// Двоичные сообщения брокер не обрабатывает и у прикладного сервера.
		Если Результат.ТипСообщения = ТипТекст Тогда
			Сообщение = ПолучитьСтрокуИзДвоичныхДанных(СоединитьДвоичныеДанные(Части));
			_БрокерСообщенийВебСокетов.ВходящееТекстовоеСообщение(_Идентификатор, _Топик, Сообщение);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Отправляет клиенту кадр закрытия, если соединение ещё не закрыто:
// в ответ на кадр клиента или по инициативе сервера.
Процедура ЗакрытьСоединение()
	_СемафорОтправки.Захватить();

	Состояние = _Соединение.Состояние;
	Если Состояние = СостояниеОткрыт Или Состояние = СостояниеЗапросЗакрытияПринят Тогда
		Попытка
			_Соединение.ЗакрытьВыходнойПоток(СтатусНормальноеЗакрытие, "");
		Исключение
			_Лог.Отладка("Не удалось закрыть WS соединение: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	_СемафорОтправки.Освободить();
КонецПроцедуры

Процедура Отключить()
	_СоединенияВебСокетов.УдалитьСоединение(_Соединение);
	_БрокерСообщенийВебСокетов.ПриОтключении(_Топик, _Идентификатор);
КонецПроцедуры

#Использовать opentelemetry

// Ведёт спаны OpenTelemetry событий соединений серверных событий (SSE): подключения
// и отключения клиента и отправки события клиентам.
//
// Модель та же, что у веб-сокетов (см. ТрассировкаВебСокетов): долгоживущее соединение
// не держит один спан на всё время жизни. Подключение - обычный короткий серверный
// HTTP-спан, который закрывается, как только поток событий открыт.
//
// Подключение и отключение начинают свою трассировку и ссылаются линком на спан
// подключения. Отправку события вызывает прикладной код, поэтому её спан - дочерний
// текущему, а на каждое соединение-получатель он ссылается линком на спан его подключения.
//
// Имя спана строится, как в messaging semantic conventions, из операции и назначения:
// "send /sse/news". Назначение - топик: это зарегистрированный путь, а не конкретный адрес,
// поэтому кардинальность имени низкая.
// https://opentelemetry.io/docs/specs/semconv/messaging/messaging-spans/

// ОтелТрассировщик - создаёт спаны событий. Область инструментирования та же,
// что у серверных HTTP-спанов: спаны создаёт winow.
Перем Трассировщик;

// Параметры:
//  ОтелSdk - ОтелSdk - SDK OpenTelemetry.
//
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин("ОтелSdk") ОтелSdk)
	Трассировщик = ОтелSdk.ПолучитьТрассировщик("winow");
КонецПроцедуры

// Открывает спан обработки подключения клиента.
//
// Параметры:
//  Подключение - Структура - Описание соединения, см. ОбработчикСерверныхСобытий.
//
// Возвращаемое значение:
//  Структура - Состояние трассировки события, которое нужно передать в Завершить:
//   * Спан         - ОтелСпан - Спан события.
//   * ОбластьСпана - ОтелТокенКонтекста - Токен активности спана.
//
Функция НачатьПодключение(Подключение) Экспорт
	Возврат НачатьСобытиеСоединения("connect", Подключение);
КонецФункции

// Открывает спан обработки отключения клиента.
//
// Параметры:
//  Подключение - Структура - Описание соединения, см. ОбработчикСерверныхСобытий.
//
// Возвращаемое значение:
//  Структура - Состояние трассировки события, см. НачатьПодключение.
//
Функция НачатьОтключение(Подключение) Экспорт
	Возврат НачатьСобытиеСоединения("disconnect", Подключение);
КонецФункции

// Открывает спан отправки события клиентам.
//
// Параметры:
//  Топик      - Строка - Топик получателей; пустой, если получателей не нашлось.
//  Получатели - Массив Из Структура - Соединения, которым уходит событие, см. ОбработчикСерверныхСобытий.
//
// Возвращаемое значение:
//  Структура - Состояние трассировки события, см. НачатьПодключение.
//
Функция НачатьОтправку(Топик, Получатели) Экспорт

	Линки = Новый Массив();
	Для Каждого Получатель Из Получатели Цикл
		ДобавитьЛинкНаПодключение(Линки, Получатель);
	КонецЦикла;

	Спан = Трассировщик.НачатьСпан(ИмяСпана("send", Топик), ОтелВидСпана.Производитель(),
		АтрибутыТопика(Топик), Линки);

	Возврат СделатьТекущим(Спан);

КонецФункции

// Завершает спан после успешной обработки события.
//
// Параметры:
//  Состояние - Структура - Результат вызова НачатьПодключение, НачатьОтключение или НачатьОтправку.
//
Процедура Завершить(Состояние) Экспорт
	ЗакрытьОбласть(Состояние);
КонецПроцедуры

// Завершает спан после исключения в обработчике события.
//
// Параметры:
//  Состояние          - Структура - Результат вызова НачатьПодключение, НачатьОтключение или НачатьОтправку.
//  ИнформацияОбОшибке - ИнформацияОбОшибке - Информация о возникшем исключении.
//  ОписаниеОшибки     - Строка - Краткое описание ошибки.
//
Процедура ЗавершитьСОшибкой(Состояние, ИнформацияОбОшибке, ОписаниеОшибки) Экспорт

	Спан = Состояние.Спан;
	Спан.ЗаписатьИсключение(ИнформацияОбОшибке);
	Спан.УстановитьСтатус(ОтелКодСтатуса.Ошибка(), ОписаниеОшибки);

	ЗакрытьОбласть(Состояние);

КонецПроцедуры

// Спан корневой, даже если обработчик вызван внутри чужого активного спана:
// событие соединения ему не дочернее.
//
// Параметры:
//  Операция    - Строка - Операция события: connect или disconnect.
//  Подключение - Структура - Описание соединения, см. ОбработчикСерверныхСобытий.
//
// Возвращаемое значение:
//  Структура - Состояние трассировки события, см. НачатьПодключение.
//
Функция НачатьСобытиеСоединения(Операция, Подключение)

	Линки = Новый Массив();
	ДобавитьЛинкНаПодключение(Линки, Подключение);

	Спан = Трассировщик.НачатьКорневойСпан(ИмяСпана(Операция, Подключение.Топик), ОтелВидСпана.Внутренний(),
		АтрибутыТопика(Подключение.Топик), Линки);

	Возврат СделатьТекущим(Спан);

КонецФункции

Функция ИмяСпана(Операция, Топик)
	Возврат ?(ЗначениеЗаполнено(Топик), Операция + " " + Топик, Операция);
КонецФункции

// Топик - зарегистрированный путь, поэтому он же и маршрут.
//
// Параметры:
//  Топик - Строка - Топик соединения.
//
// Возвращаемое значение:
//  Соответствие - Атрибуты спана.
//
Функция АтрибутыТопика(Топик)

	Атрибуты = Новый Соответствие();
	Если ЗначениеЗаполнено(Топик) Тогда
		Атрибуты.Вставить("url.path", Топик);
		Атрибуты.Вставить("http.route", Топик);
	КонецЕсли;

	Возврат Атрибуты;

КонецФункции

// Подключение могло пройти без трассировки, тогда ссылаться не на что.
//
// Параметры:
//  Линки       - Массив Из ОтелЛинк - Куда добавить линк.
//  Подключение - Структура - Описание соединения, см. ОбработчикСерверныхСобытий.
//
Процедура ДобавитьЛинкНаПодключение(Линки, Подключение)

	КонтекстПодключения = Подключение.КонтекстТрассировки;
	Если КонтекстПодключения <> Неопределено И КонтекстПодключения.Валиден() Тогда
		Линки.Добавить(Новый ОтелЛинк(КонтекстПодключения));
	КонецЕсли;

КонецПроцедуры

// Спан становится текущим, чтобы спаны, которые заводит обработчик, стали его дочерними.
//
// Параметры:
//  Спан - ОтелСпан - Открытый спан события.
//
// Возвращаемое значение:
//  Структура - Состояние трассировки события, см. НачатьПодключение.
//
Функция СделатьТекущим(Спан)

	Состояние = Новый Структура("Спан, ОбластьСпана");
	Состояние.Спан = Спан;
	Состояние.ОбластьСпана = Спан.СделатьТекущим();

	Возврат Состояние;

КонецФункции

// Порядок обратен открытию: сначала область спана, затем сам спан.
//
// Параметры:
//  Состояние - Структура - Состояние трассировки события, см. НачатьПодключение.
//
Процедура ЗакрытьОбласть(Состояние)
	Состояние.ОбластьСпана.Закрыть();
	Состояние.Спан.Завершить();
КонецПроцедуры

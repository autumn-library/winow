
&Деталька(Значение = "winow.Порт", ЗначениеПоУмолчанию = 3333)
Перем Порт Экспорт;

&Деталька(Значение = "winow.ИмяХоста", ЗначениеПоУмолчанию = "localhost")
Перем ИмяХоста Экспорт;

&Деталька(Значение = "winow.ИспользоватьПрикладнойСервер", ЗначениеПоУмолчанию = Ложь)
Перем ИспользоватьПрикладнойСервер Экспорт;

&Деталька(Значение = "winow.ИнтервалПроверкиСоединенийСерверныхСобытий", ЗначениеПоУмолчанию = 5000)
Перем ИнтервалПроверкиСоединенийСерверныхСобытий Экспорт;

&Деталька(Значение = "winow.КаталогСПриложениями", ЗначениеПоУмолчанию = "./app")
Перем КаталогСПриложениями Экспорт;

&Деталька("winow.КаталогиСФайлами")
Перем КаталогиСФайлами Экспорт;

&Деталька(Значение = "winow.АвтоматическиПриводитьОбъектыКСтруктуре", ЗначениеПоУмолчанию = Истина)
Перем АвтоматическиПриводитьОбъектыКСтруктуре Экспорт;

&Деталька(Значение = "winow.ЗадержкаПередЧтениемСокета", ЗначениеПоУмолчанию = 0)
Перем ЗадержкаПередЧтениемСокета Экспорт;

&Деталька(Значение = "winow.ЗадержкаПередЗакрытиемСокета", ЗначениеПоУмолчанию = 0)
Перем ЗадержкаПередЗакрытиемСокета Экспорт;

&Деталька(Значение = "winow.РазмерБуфера", ЗначениеПоУмолчанию = 1024)
Перем РазмерБуфера Экспорт;

// Автогенерация спецификации OpenAPI и страницы Swagger UI.
// По умолчанию выключено, чтобы не менять поведение существующих приложений.
&Деталька(Значение = "winow.OpenApi.Включено", ЗначениеПоУмолчанию = Ложь)
Перем OpenApiВключено Экспорт;

// Путь, по которому отдается страница Swagger UI.
&Деталька(Значение = "winow.OpenApi.БазовыйПуть", ЗначениеПоУмолчанию = "/swagger")
Перем OpenApiБазовыйПуть Экспорт;

// Путь, по которому отдается JSON со спецификацией OpenAPI.
&Деталька(Значение = "winow.OpenApi.ПутьСпецификации", ЗначениеПоУмолчанию = "/swagger/openapi.json")
Перем OpenApiПутьСпецификации Экспорт;

// Заголовок, версия и описание API в блоке info спецификации.
&Деталька(Значение = "winow.OpenApi.Заголовок", ЗначениеПоУмолчанию = "winow API")
Перем OpenApiЗаголовок Экспорт;

&Деталька(Значение = "winow.OpenApi.Версия", ЗначениеПоУмолчанию = "1.0.0")
Перем OpenApiВерсия Экспорт;

&Деталька(Значение = "winow.OpenApi.Описание", ЗначениеПоУмолчанию = "")
Перем OpenApiОписание Экспорт;

// Базовый URL, откуда страница Swagger UI берет статические ресурсы (js/css).
// По умолчанию используется публичный CDN. Можно указать путь до локальных файлов,
// которые отдаются через winow.КаталогиСФайлами, чтобы работать офлайн.
&Деталька(Значение = "winow.OpenApi.РесурсыSwaggerUI", ЗначениеПоУмолчанию = "https://cdn.jsdelivr.net/npm/swagger-ui-dist@5")
Перем OpenApiРесурсыSwaggerUI Экспорт;

&Желудь
Процедура ПриСозданииОбъекта()

КонецПроцедуры








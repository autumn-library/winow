&Пластилин Перем Маршрутизатор;
&Пластилин Перем ФабрикаОтветов;
&Пластилин Перем МенеджерСессий;
&Пластилин Перем МенеджерОтображений;
&Пластилин Перем МенеджерДоступа;
&Пластилин Перем Поделка;
&Пластилин Перем КонструкторыПараметров;

&ЛогВебСервера 
Перем Лог;

Перем Рефлектор;

&Желудь
Процедура ПриСозданииОбъекта()
	Рефлектор = Новый Рефлектор();
КонецПроцедуры

Функция СформироватьОтвет(Запрос) Экспорт	

	ОбработчикИПараметры = Маршрутизатор.НайтиОбработчикИПараметрыПоПолномуПути(Запрос.Путь);

	Запрос.ПараметрыПорядковые = ОбработчикИПараметры.Параметры;

	Если ЗначениеЗаполнено(ОбработчикИПараметры.Действие) Тогда

		Запрос.ШаблонМаршрута = ОбработчикИПараметры.Действие.ШаблонПути;

		Отказ = ОтказВДоступе(Запрос, ОбработчикИПараметры.Действие);

		Если Отказ = Неопределено Тогда
			Ответ = АвторизованныйОтвет(Запрос, Запрос.Сессия, ОбработчикИПараметры);
		Иначе
			Ответ = Отказ;
		КонецЕсли;

	Иначе

		Ответ = ФабрикаОтветов.НовыйОтвет404();
		Ответ.Модель = Новый Структура();
		Ответ.Модель.Вставить("КодСостояния", 404);
		Ответ.Модель.Вставить("ТекстСообщения", "Страница не найдена");
		Ответ.Модель.Вставить("Запрос", Запрос);
		Ответ.ОбработатьМодель();

	КонецЕсли;
	
	Ответ.ИдентификаторЗапроса = Запрос.Идентификатор;
	Возврат Ответ; 

КонецФункции

// Проверяет доступ к точке маршрута, на которую открывается веб-сокет. Обработчиком
// сообщений веб-сокета служит точка маршрута топика, поэтому без проверки при подключении
// клиент вызывал бы её в обход ролей.
//
// Параметры:
//  Запрос - ВходящийЗапрос - Запрос рукопожатия с заполненной сессией.
//
// Возвращаемое значение:
//  Неопределено - соединение можно открыть.
//  Ответ - Ответ 401 или 403, который нужно отправить вместо рукопожатия.
//
Функция ОтказВДоступеКВебСокету(Запрос) Экспорт

	ОбработчикИПараметры = Маршрутизатор.НайтиОбработчикИПараметрыПоПолномуПути(Запрос.Путь);

	Если НЕ ЗначениеЗаполнено(ОбработчикИПараметры.Действие) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Отказ = ОтказВДоступе(Запрос, ОбработчикИПараметры.Действие);
	Если Отказ <> Неопределено Тогда
		Отказ.ИдентификаторЗапроса = Запрос.Идентификатор;
	КонецЕсли;

	Возврат Отказ;

КонецФункции

// Параметры:
//  Запрос   - ВходящийЗапрос - Запрос с заполненной сессией. При входе по токену в сессию записывается логин.
//  Действие - Структура - Описание точки маршрута, см. Маршрутизатор.ОписаниеТочкиМаршрута.
//
// Возвращаемое значение:
//  Неопределено - точка маршрута доступна.
//  Ответ - Ответ 401 с запросом авторизации или 403.
//
Функция ОтказВДоступе(Запрос, Действие)

	Если НЕ МенеджерДоступа.ТочкаМаршрутаИмеетРоли(Действие) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сессия = Запрос.Сессия;
	ДействиеДоступно = Ложь;
	ЗапроситьТокен = Ложь;

	Если ЗначениеЗаполнено(Сессия.Логин) Тогда
		ДействиеДоступно = МенеджерДоступа.ТочкаМаршрутаДоступна(Сессия.Логин, Действие);

	ИначеЕсли Запрос.Заголовки["Authorization"] = Неопределено Тогда
		ЗапроситьТокен = Истина;

	Иначе
		ДанныеАвторизации = РазобратьАвторизационныеДанные(Запрос.Заголовки["Authorization"]);

		Если ЗначениеЗаполнено(ДанныеАвторизации.Логин)
				И ЗначениеЗаполнено(ДанныеАвторизации.Токен)
				И МенеджерДоступа.ТокенВалидный(ДанныеАвторизации.Логин, ДанныеАвторизации.Токен) Тогда
			Сессия.Логин = ДанныеАвторизации.Логин;
			ДействиеДоступно = МенеджерДоступа.ТочкаМаршрутаДоступна(Сессия.Логин, Действие);
		Иначе
			ЗапроситьТокен = Истина;
		КонецЕсли;

	КонецЕсли;

	Если ДействиеДоступно Тогда
		Отказ = Неопределено;
	ИначеЕсли ЗапроситьТокен Тогда
		Отказ = ФабрикаОтветов.НовыйОтвет401();
		Отказ.Заголовки["WWW-Authenticate"] = "Basic";
	Иначе
		Отказ = ФабрикаОтветов.НовыйОтвет403();
	КонецЕсли;

	Возврат Отказ;

КонецФункции

Функция РазобратьАвторизационныеДанные(знач СтрокаЗаголовкаАвторизациии)
	Возврат МенеджерДоступа.ПолучитьАвторизационныеДанныеПоСтрокеЗаголовка(СтрокаЗаголовкаАвторизациии);
КонецФункции

Функция АвторизованныйОтвет(Запрос, Сессия, ОбработчикИПараметры)

	Ответ = ФабрикаОтветов.НовыйОтвет();
	Ответ.ИдентификаторЗапроса = Запрос.Идентификатор;
	Ответ.Куки.Добавить(МенеджерСессий.ИмяКукаСессии(), Сессия.Идентификатор());

	Отображене = МенеджерОтображений.ПолучитьОтображениеДействия(ОбработчикИПараметры.Действие);
	Если ЗначениеЗаполнено(Отображене) Тогда
		Ответ.УстановитьТекстШаблона(Отображене);
	КонецЕсли;

	Попытка
		Запрос.ПодготовитьТело(ОбработчикИПараметры.Действие.Параметры.Найти("ТелоЗапросаПоток") <> Неопределено);
		ПараметрыТочкиМаршрута = КонструкторыПараметров.СформироватьПараметрыТочкиМаршрута(
														ОбработчикИПараметры.Действие,
														ОбработчикИПараметры.Действие.Параметры,
														ОбработчикИПараметры.Действие.ТипТелаЗапроса,
														Запрос,
														Ответ,
														Сессия);

		Рефлектор.ВызватьМетод(	ОбработчикИПараметры.Действие.Желудь, 
								ОбработчикИПараметры.Действие.ИмяМетода, 
								ПараметрыТочкиМаршрута);
		Ответ.ОбработатьМодель();
		ОбработатьШаблонКонтрола(Ответ, ОбработчикИПараметры.Действие, Запрос, Сессия);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Лог.Ошибка(ТекстОшибки);
		Ответ.ЗакрытьТело();
		Ответ = ФабрикаОтветов.НовыйОтвет500();
		Ответ.Модель = Новый Структура();
		Ответ.Модель.Вставить("КодСостояния", 500);
		Ответ.Модель.Вставить("ТекстСообщения", ТекстОшибки);
		Ответ.Модель.Вставить("Запрос", Запрос);
		Ответ.ОбработатьМодель();
	КонецПопытки;	

	Возврат Ответ;

КонецФункции

Процедура ОбработатьШаблонКонтрола(Ответ, Действие, Запрос, Сессия)
	Если Не ЗначениеЗаполнено(Действие.Шаблон) ИЛИ Действие.ВыводитьШаблонКонтрола = Ложь Тогда
		Возврат;
	КонецЕсли;
	Массив = Новый Массив();
	Массив.Добавить(МенеджерОтображений.ПолучитьОтображение(Действие.Шаблон));
	Шаблон = Поделка.НайтиЖелудь("Шаблон", Массив);

	Если ЗначениеЗаполнено(Действие.МетодШаблона) Тогда

		ПараметрыМетода = КонструкторыПараметров.СформироватьПараметрыТочкиМаршрута(
														Действие,
														Действие.ПараметрыШаблона,
														Действие.ТипТелаЗапроса,
														Запрос,
														Ответ,
														Сессия);

		Модель = Рефлектор.ВызватьМетод(Действие.Желудь, 
										Действие.МетодШаблона,
										ПараметрыМетода);
	Иначе
		Модель = Неопределено;
	КонецЕсли;

	ТекстКонтрола = Шаблон.СформироватьТекст(Модель);

	Ответ.ТелоТекст = СтрЗаменить(ТекстКонтрола, "@Контент", Ответ.ТелоТекст); 
	
КонецПроцедуры


&Пластилин Перем Настройки;
&Пластилин Перем ПрикладнойОбработчикЗапросов;
&Пластилин Перем СоединенияВебСокетов;
&Пластилин Перем СоединенияСерверныхСобытий;

&Желудь
Процедура ПриСозданииОбъекта()
	
КонецПроцедуры

Функция ПринятьСоединение(Соединение, ДвоичныеДанныеЗапроса) Экспорт

	// Разбор и обработка - два отдельных вызова: вокруг обработки открывается
	// серверный спан OpenTelemetry, и заголовки для контекста трассировки
	// к этому моменту уже должны быть разобраны.
	Запрос = ПрикладнойОбработчикЗапросов.РазобратьЗапрос(ДвоичныеДанныеЗапроса, Соединение.УдаленныйУзел);

	Результат = ПрикладнойОбработчикЗапросов.ОбработатьРазобранныйЗапрос(Запрос);

	Если Результат.ЗакрыватьСоединение = Ложь Тогда
		СохранитьСоединение(Соединение, Результат, Запрос);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура СохранитьСоединение(Соединение, Результат, Запрос)

	Если Результат.ТипСоединения = "ВС" Тогда
		СоединенияВебСокетов.Добавить(Соединение, Запрос);
	ИначеЕсли Результат.ТипСоединения = "СС" Тогда
		СоединенияСерверныхСобытий.Добавить(Соединение, Результат.Идентификатор, Результат.Топик);
	КонецЕсли;

КонецПроцедуры
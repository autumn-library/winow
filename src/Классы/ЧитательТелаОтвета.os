// Читает тело ответа порциями для отправки: из потока или из файла, который
// ещё дописывается. Во втором случае ждёт новых байтов: ФайловыйПоток видит
// дописанное, файла может ещё не быть - его создаёт тот, кто дописывает.
// Прогресс - рост файла на диске: на Windows писатель держит файл монопольно,
// и открыть его удаётся только после закрытия.

Перем Поток;
Перем Чтение;
Перем ПутьФайла;
Перем Длина;
Перем Отправлено;
Перем РазмерНаДиске;
Перем РазмерПорции;
Перем ТаймаутМс;
Перем ПустыеДанные;

// Параметры:
//  Ответ              - Ответ - ответ winow, у которого тело уходит потоком.
//  РазмерПорцииПотока - Число - байт в порции.
//  ТаймаутОжиданияМс  - Число - сколько ждать дописывания файла без прогресса.
//
Процедура ПриСозданииОбъекта(Ответ, РазмерПорцииПотока, ТаймаутОжиданияМс)
	РазмерПорции = РазмерПорцииПотока;
	ТаймаутМс = ТаймаутОжиданияМс;
	ПустыеДанные = ПолучитьДвоичныеДанныеИзСтроки("");
	Отправлено = 0;
	РазмерНаДиске = 0;
	Длина = Ответ.ДлинаТелаПотоком();
	Если Ответ.ДлинаТела <> Неопределено И Ответ.ТелоФайл <> Неопределено Тогда
		ПутьФайла = Ответ.ТелоФайл;
		ОткрытьЕслиЕсть();
	Иначе
		Открыть(Ответ.ТелоПоток);
	КонецЕсли;
КонецПроцедуры

Функция Длина() Экспорт
	Возврат Длина;
КонецФункции

// Очередная порция; пустые данные - тело отдано целиком.
Функция ПрочитатьПорцию() Экспорт
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока Отправлено < Длина Цикл
		Порция = ПрочитатьИзПотока();
		Если Порция.Размер() > 0 Тогда
			Отправлено = Отправлено + Порция.Размер();
			Возврат Порция;
		КонецЕсли;
		Если ПутьФайла = Неопределено Тогда
			ВызватьИсключение "Поток тела ответа закончился раньше объявленной длины";
		КонецЕсли;
		Если ФайлВырос() Тогда
			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ИначеЕсли ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало > ТаймаутМс Тогда
			ВызватьИсключение СтрШаблон("Файл %1 не дописан за %2 мс", ПутьФайла, ТаймаутМс);
		КонецЕсли;
		Приостановить(20);
		Если Поток = Неопределено Тогда
			ОткрытьЕслиЕсть();
		КонецЕсли;
	КонецЦикла;
	Возврат ПустыеДанные;
КонецФункции

Функция ФайлВырос()
	Файл = Новый Файл(ПутьФайла);
	Размер = ?(Файл.Существует(), Файл.Размер(), 0);
	Вырос = Размер > РазмерНаДиске;
	РазмерНаДиске = Макс(Размер, РазмерНаДиске);
	Возврат Вырос;
КонецФункции

Процедура Закрыть() Экспорт
	Если Поток <> Неопределено Тогда
		Поток.Закрыть();
		Поток = Неопределено;
		Чтение = Неопределено;
	КонецЕсли;
КонецПроцедуры

Функция ПрочитатьИзПотока()
	Если Чтение = Неопределено Тогда
		Возврат ПустыеДанные;
	КонецЕсли;
	Возврат Чтение.Прочитать(Мин(РазмерПорции, Длина - Отправлено)).ПолучитьДвоичныеДанные();
КонецФункции

Процедура Открыть(НовыйПоток)
	Поток = НовыйПоток;
	Чтение = Новый ЧтениеДанных(Поток);
КонецПроцедуры

// Занятый писателем файл - ещё не готов: попытка повторится после паузы.
Процедура ОткрытьЕслиЕсть()
	Файл = Новый Файл(ПутьФайла);
	Если Не Файл.Существует() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Открыть(Новый ФайловыйПоток(ПутьФайла, РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение));
	Исключение
		Поток = Неопределено;
	КонецПопытки;
КонецПроцедуры

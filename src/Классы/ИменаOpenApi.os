#Использовать autumn

#Область ОписаниеПеременных

// Соответствие Из Строка - строчная кириллическая буква и её латинская замена.
// Единственное состояние желудя, и оно неизменяемое: выданные имена принадлежат
// не желудю, а сборке, см. СборкаСпецификации.
Перем Транслитерация;

// Число - позиция символа, следующего за первым. Первый символ разбирается
// отдельно там, где нужно сохранить регистр или отбросить крайний знак.
Перем ПозицияПослеПервогоСимвола;

// Строка - запасная основа имени операции, если от исходного не осталось
// ни одного пригодного символа.
Перем ЗапаснаяОсноваОперации;

// Строка - то же для имени схемы.
Перем ЗапаснаяОсноваСхемы;

// Строка - разделитель между HTTP-методом и путём в идентификаторе операции.
Перем РазделительЧастейИдентификатора;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выдаёт имена, которыми документ спецификации OpenAPI называет свои части:
// идентификаторы операций и имена схем в components.
//
// Оба имени строятся одинаково - транслитерацией с отбрасыванием недопустимых
// символов, - поэтому и живут в одном желуде: две реализации одного правила
// рано или поздно разъехались бы.
//
// Транслитерация нужна потому, что адреса маршрутов и имена классов в winow
// кириллические, а спецификация ограничивает и то, и другое латиницей:
// operationId становится именем функции в сгенерированном клиенте, а ключи
// components обязаны совпадать с ^[a-zA-Z0-9._-]+$.
//
// Уникальность у имён своя на каждый вид: операции и схемы живут в разных
// пространствах имён документа, и совпадение имени операции с именем схемы
// ничему не мешает. Внутри же своего вида имя должно быть одно: разные исходные
// имена дают одинаковую латиницу, и на этот случай к повторному добавляется
// числовой суффикс.
&Желудь
Процедура ПриСозданииОбъекта()

	ПозицияПослеПервогоСимвола = 2;
	ЗапаснаяОсноваОперации = "operation";
	ЗапаснаяОсноваСхемы = "schema";
	РазделительЧастейИдентификатора = "_";

	ЗаполнитьТранслитерацию();

КонецПроцедуры

// Возвращает идентификатор операции.
//
// Идентификатор складывается из метода и пути - того, что потребитель API
// действительно вызывает. Имя метода контроллера в него не входит: это деталь
// реализации сервера, и переименование процедуры не должно менять имя функции
// в сгенерированном клиенте.
//
// Пара "метод и путь" уникальна по построению документа: в объекте paths один
// элемент на путь и одна операция на метод внутри него. Поэтому уникальность
// обеспечивать не приходится - достаточно её не потерять при транслитерации.
//
// Параметры:
//   Сборка    - СборкаСпецификации - состояние собираемого документа.
//   HTTPМетод - Строка - метод операции.
//   Путь      - Строка - путь операции в спецификации.
//
// Возвращаемое значение:
//   Строка - идентификатор, уникальный в пределах собираемого документа.
Функция ИдентификаторОперации(Сборка, HTTPМетод, Путь) Экспорт

	ИсходноеИмя = HTTPМетод + РазделительЧастейИдентификатора + Путь;
	Основа = ОчиститьОтНедопустимого(Транслитерировать(ИсходноеИмя));

	Возврат СделатьУникальным(Сборка.ВыданныеИдентификаторы(), Основа, ЗапаснаяОсноваОперации);

КонецФункции

// Возвращает идентификатор операции по имени, названному автором.
//
// Имя всё равно проходит транслитерацию и проверку на уникальность: в документе
// operationId обязан быть уникален и записан латиницей независимо от того,
// выведен он или объявлен.
//
// Параметры:
//   Сборка - СборкаСпецификации - состояние собираемого документа.
//   Имя    - Строка - имя, объявленное автором.
//
// Возвращаемое значение:
//   Строка - идентификатор, уникальный в пределах собираемого документа.
Функция ИдентификаторПоИмени(Сборка, Имя) Экспорт

	Основа = ОчиститьОтНедопустимого(Транслитерировать(Имя));

	Возврат СделатьУникальным(Сборка.ВыданныеИдентификаторы(), Основа, ЗапаснаяОсноваОперации);

КонецФункции

// Возвращает имя схемы типа в разделе components.
//
// Параметры:
//   Сборка      - СборкаСпецификации - состояние собираемого документа.
//   ТипЗначения - Тип - пользовательский тип.
//
// Возвращаемое значение:
//   Строка - имя схемы, уникальное в пределах собираемого документа.
Функция ИмяСхемы(Сборка, ТипЗначения) Экспорт

	ВыданноеИмя = Сборка.ИменаТипов().Получить(ТипЗначения);

	Если ВыданноеИмя <> Неопределено Тогда
		Возврат ВыданноеИмя;
	КонецЕсли;

	Основа = ОчиститьОтНедопустимого(Транслитерировать(Строка(ТипЗначения)));
	Имя = СделатьУникальным(Сборка.ВыданныеИменаСхем(), Основа, ЗапаснаяОсноваСхемы);

	Сборка.ИменаТипов().Вставить(ТипЗначения, Имя);

	Возврат Имя;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает имя, ещё не выданное в этой сборке.
//
// Первая выдача остаётся без суффикса: у подавляющего большинства имён основа
// не повторяется, и суффикс был бы лишним шумом.
//
// Параметры:
//   Реестр          - Соответствие Из Число - выданные имена и число их выдач.
//   Основа          - Строка - желаемое имя.
//   ЗапаснаяОснова  - Строка - имя, если от желаемого ничего не осталось.
//
// Возвращаемое значение:
//   Строка - имя, уникальное в пределах реестра.
Функция СделатьУникальным(Реестр, Знач Основа, ЗапаснаяОснова)

	// Транслитерация может не оставить ни одного пригодного символа - скажем,
	// у пути из одних разделителей. Пустое имя недопустимо, поэтому берётся
	// запасное: оно всё равно станет уникальным за счёт суффикса.
	Если НЕ ЗначениеЗаполнено(Основа) Тогда
		Основа = ЗапаснаяОснова;
	КонецЕсли;

	ЧислоВыдач = Реестр.Получить(Основа);

	Если ЧислоВыдач = Неопределено Тогда
		Реестр.Вставить(Основа, 1);
		Возврат Основа;
	КонецЕсли;

	ЧислоВыдач = ЧислоВыдач + 1;
	Реестр.Вставить(Основа, ЧислоВыдач);

	// Нумерация суффиксов начинается с единицы: первая выдача без суффикса,
	// вторая - _1, третья - _2.
	НомерСуффикса = ЧислоВыдач - 1;

	Возврат Основа + РазделительЧастейИдентификатора + Формат(НомерСуффикса, "ЧГ=0");

КонецФункции

// Заменяет кириллические буквы латинскими, остальные символы оставляет как есть.
//
// Параметры:
//   Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//   Строка - текст с заменёнными буквами.
Функция Транслитерировать(Текст)

	Результат = "";

	Для Индекс = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Индекс, 1);
		Замена = Транслитерация.Получить(НРег(Символ));

		Если Замена = Неопределено Тогда
			Результат = Результат + Символ;
		ИначеЕсли Символ = НРег(Символ) Тогда
			Результат = Результат + Замена;
		Иначе
			// Прописная буква сохраняет регистр: имена методов и классов пишутся
			// с прописной, и в имени это удобно видеть.
			ПерваяБуква = ВРег(Лев(Замена, 1));
			Результат = Результат + ПерваяБуква + Сред(Замена, ПозицияПослеПервогоСимвола);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Оставляет только символы, пригодные и для имени метода, и для ключа
// components. Идущие подряд подчерки схлопываются, крайние убираются:
// разделители пути и служебные символы иначе дают длинные вереницы подчерков.
//
// Параметры:
//   Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//   Строка - текст из допустимых символов.
Функция ОчиститьОтНедопустимого(Текст)

	Результат = "";
	ПредыдущийБылПодчерком = Ложь;

	Для Индекс = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Индекс, 1);

		Если ЭтоДопустимыйСимвол(Символ) И Символ <> РазделительЧастейИдентификатора Тогда
			Результат = Результат + Символ;
			ПредыдущийБылПодчерком = Ложь;
		ИначеЕсли НЕ ПредыдущийБылПодчерком Тогда
			Результат = Результат + РазделительЧастейИдентификатора;
			ПредыдущийБылПодчерком = Истина;
		Иначе
			// Подчерк подряд за подчерком отбрасывается: вереница разделителей
			// имени не помогает.
			Продолжить;
		КонецЕсли;

	КонецЦикла;

	Возврат УбратьКрайниеПодчерки(Результат);

КонецФункции

// Убирает подчерки в начале и в конце имени.
//
// Параметры:
//   Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//   Строка - текст без крайних подчерков.
Функция УбратьКрайниеПодчерки(Текст)

	Результат = Текст;

	Пока СтрНачинаетсяС(Результат, РазделительЧастейИдентификатора) Цикл
		Результат = Сред(Результат, ПозицияПослеПервогоСимвола);
	КонецЦикла;

	Пока СтрЗаканчиваетсяНа(Результат, РазделительЧастейИдентификатора) Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, годится ли символ для имени в спецификации.
//
// Параметры:
//   Символ - Строка - проверяемый символ.
//
// Возвращаемое значение:
//   Булево - Истина, если символ допустим.
Функция ЭтоДопустимыйСимвол(Символ)

	Возврат (Символ >= "a" И Символ <= "z")
		ИЛИ (Символ >= "A" И Символ <= "Z")
		ИЛИ (Символ >= "0" И Символ <= "9")
		ИЛИ Символ = РазделительЧастейИдентификатора;

КонецФункции

// Заполняет таблицу замен кириллических букв латинскими.
Процедура ЗаполнитьТранслитерацию()

	Транслитерация = Новый Соответствие();

	ДобавитьЗамену("а", "a");
	ДобавитьЗамену("б", "b");
	ДобавитьЗамену("в", "v");
	ДобавитьЗамену("г", "g");
	ДобавитьЗамену("д", "d");
	ДобавитьЗамену("е", "e");
	ДобавитьЗамену("ё", "e");
	ДобавитьЗамену("ж", "zh");
	ДобавитьЗамену("з", "z");
	ДобавитьЗамену("и", "i");
	ДобавитьЗамену("й", "y");
	ДобавитьЗамену("к", "k");
	ДобавитьЗамену("л", "l");
	ДобавитьЗамену("м", "m");
	ДобавитьЗамену("н", "n");
	ДобавитьЗамену("о", "o");
	ДобавитьЗамену("п", "p");
	ДобавитьЗамену("р", "r");
	ДобавитьЗамену("с", "s");
	ДобавитьЗамену("т", "t");
	ДобавитьЗамену("у", "u");
	ДобавитьЗамену("ф", "f");
	ДобавитьЗамену("х", "h");
	ДобавитьЗамену("ц", "ts");
	ДобавитьЗамену("ч", "ch");
	ДобавитьЗамену("ш", "sh");
	ДобавитьЗамену("щ", "sch");
	ДобавитьЗамену("ъ", "");
	ДобавитьЗамену("ы", "y");
	ДобавитьЗамену("ь", "");
	ДобавитьЗамену("э", "e");
	ДобавитьЗамену("ю", "yu");
	ДобавитьЗамену("я", "ya");

КонецПроцедуры

// Добавляет одну замену в таблицу транслитерации.
//
// Параметры:
//   Буква  - Строка - строчная кириллическая буква.
//   Замена - Строка - латинская замена, возможно пустая.
Процедура ДобавитьЗамену(Буква, Замена)

	Транслитерация.Вставить(Буква, Замена);

КонецПроцедуры

#КонецОбласти

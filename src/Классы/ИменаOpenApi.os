#Использовать autumn

// Выдаёт имена, которыми документ спецификации OpenAPI называет свои части:
// идентификаторы операций и имена схем в components.
//
// Оба имени строятся одинаково - транслитерацией с отбрасыванием недопустимых
// символов, - поэтому и живут в одном желуде: две реализации одного правила
// рано или поздно разъехались бы.
//
// Транслитерация нужна потому, что адреса маршрутов и имена классов в winow
// кириллические, а спецификация ограничивает и то, и другое латиницей:
// operationId становится именем функции в сгенерированном клиенте, а ключи
// components обязаны совпадать с ^[a-zA-Z0-9._-]+$.
//
// Уникальность у имён своя на каждый вид: операции и схемы живут в разных
// пространствах имён документа, и совпадение имени операции с именем схемы
// ничему не мешает. Внутри же своего вида имя должно быть одно: разные исходные
// имена дают одинаковую латиницу, и на этот случай к повторному добавляется
// числовой суффикс.

// Соответствие Из Строка - строчная кириллическая буква и её латинская замена.
Перем Транслитерация;

// Соответствие Из Строка - выданные идентификаторы операций и число их выдач.
Перем ВыданныеИдентификаторы;

// Соответствие Из Строка - выданные имена схем и число их выдач.
Перем ВыданныеИменаСхем;

// Соответствие Из Тип - имя схемы, уже выданное типу. Одному типу - одно имя,
// сколько бы раз его ни спросили: иначе ссылка разъехалась бы со схемой.
Перем ИменаТипов;

&Желудь
Процедура ПриСозданииОбъекта()

	ЗаполнитьТранслитерацию();
	Очистить();

КонецПроцедуры

// Забывает выданные имена. Вызывается перед сборкой новой спецификации, иначе
// суффиксы копились бы от документа к документу.
Процедура Очистить() Экспорт

	ВыданныеИдентификаторы = Новый Соответствие();
	ВыданныеИменаСхем = Новый Соответствие();
	ИменаТипов = Новый Соответствие();

КонецПроцедуры

// Возвращает идентификатор операции.
//
// Идентификатор складывается из метода и пути - того, что потребитель API
// действительно вызывает. Имя метода контроллера в него не входит: это деталь
// реализации сервера, и переименование процедуры не должно менять имя функции
// в сгенерированном клиенте.
//
// Пара "метод и путь" уникальна по построению документа: в объекте paths один
// элемент на путь и одна операция на метод внутри него. Поэтому уникальность
// обеспечивать не приходится - достаточно её не потерять при транслитерации.
//
// Параметры:
//   HTTPМетод - Строка - метод операции.
//   Путь      - Строка - путь операции в спецификации.
//
// Возвращаемое значение:
//   Строка - идентификатор, уникальный в пределах текущей спецификации.
Функция ИдентификаторОперации(HTTPМетод, Путь) Экспорт

	Основа = ОчиститьОтНедопустимого(Транслитерировать(HTTPМетод + "_" + Путь));

	Возврат СделатьУникальным(ВыданныеИдентификаторы, Основа, "operation");

КонецФункции

// Возвращает имя схемы типа в разделе components.
//
// Параметры:
//   ТипЗначения - Тип - пользовательский тип.
//
// Возвращаемое значение:
//   Строка - имя схемы, уникальное в пределах текущей спецификации.
Функция ИмяСхемы(ТипЗначения) Экспорт

	ВыданноеИмя = ИменаТипов.Получить(ТипЗначения);

	Если ВыданноеИмя <> Неопределено Тогда
		Возврат ВыданноеИмя;
	КонецЕсли;

	Основа = ОчиститьОтНедопустимого(Транслитерировать(Строка(ТипЗначения)));
	Имя = СделатьУникальным(ВыданныеИменаСхем, Основа, "schema");

	ИменаТипов.Вставить(ТипЗначения, Имя);

	Возврат Имя;

КонецФункции

// Первая выдача остаётся без суффикса: у подавляющего большинства имён основа
// не повторяется, и суффикс был бы лишним шумом.
Функция СделатьУникальным(Реестр, Знач Основа, ЗапаснаяОснова)

	// Транслитерация может не оставить ни одного пригодного символа - скажем,
	// у пути из одних разделителей. Пустое имя недопустимо, поэтому берётся
	// запасное: оно всё равно станет уникальным за счёт суффикса.
	Если НЕ ЗначениеЗаполнено(Основа) Тогда
		Основа = ЗапаснаяОснова;
	КонецЕсли;

	ЧислоВыдач = Реестр.Получить(Основа);

	Если ЧислоВыдач = Неопределено Тогда
		Реестр.Вставить(Основа, 1);
		Возврат Основа;
	КонецЕсли;

	ЧислоВыдач = ЧислоВыдач + 1;
	Реестр.Вставить(Основа, ЧислоВыдач);

	// Нумерация суффиксов начинается с единицы: первая выдача без суффикса,
	// вторая - _1, третья - _2.
	Возврат Основа + "_" + Формат(ЧислоВыдач - 1, "ЧГ=0");

КонецФункции

Функция Транслитерировать(Текст)

	Результат = "";

	Для Индекс = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Индекс, 1);
		Замена = Транслитерация.Получить(НРег(Символ));

		Если Замена = Неопределено Тогда
			Результат = Результат + Символ;
		ИначеЕсли Символ = НРег(Символ) Тогда
			Результат = Результат + Замена;
		Иначе
			// Прописная буква сохраняет регистр: имена методов и классов пишутся
			// с прописной, и в имени это удобно видеть.
			Результат = Результат + ВРег(Лев(Замена, 1)) + Сред(Замена, 2);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Оставляет только символы, пригодные и для имени метода, и для ключа
// components. Идущие подряд подчёркивания схлопываются, крайние убираются:
// разделители пути и служебные символы иначе дают длинные вереницы подчёркиваний.
Функция ОчиститьОтНедопустимого(Текст)

	Результат = "";
	ПредыдущийПодчёркивание = Ложь;

	Для Индекс = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Индекс, 1);

		Если ЭтоДопустимыйСимвол(Символ) И Символ <> "_" Тогда
			Результат = Результат + Символ;
			ПредыдущийПодчёркивание = Ложь;
		ИначеЕсли НЕ ПредыдущийПодчёркивание Тогда
			Результат = Результат + "_";
			ПредыдущийПодчёркивание = Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат УбратьКрайниеПодчёркивания(Результат);

КонецФункции

Функция УбратьКрайниеПодчёркивания(Текст)

	Результат = Текст;

	Пока СтрНачинаетсяС(Результат, "_") Цикл
		Результат = Сред(Результат, 2);
	КонецЦикла;

	Пока СтрЗаканчиваетсяНа(Результат, "_") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоДопустимыйСимвол(Символ)
	Возврат (Символ >= "a" И Символ <= "z")
		ИЛИ (Символ >= "A" И Символ <= "Z")
		ИЛИ (Символ >= "0" И Символ <= "9")
		ИЛИ Символ = "_";
КонецФункции

Процедура ЗаполнитьТранслитерацию()

	Транслитерация = Новый Соответствие();

	ДобавитьЗамену("а", "a"); ДобавитьЗамену("б", "b"); ДобавитьЗамену("в", "v");
	ДобавитьЗамену("г", "g"); ДобавитьЗамену("д", "d"); ДобавитьЗамену("е", "e");
	ДобавитьЗамену("ё", "e"); ДобавитьЗамену("ж", "zh"); ДобавитьЗамену("з", "z");
	ДобавитьЗамену("и", "i"); ДобавитьЗамену("й", "y"); ДобавитьЗамену("к", "k");
	ДобавитьЗамену("л", "l"); ДобавитьЗамену("м", "m"); ДобавитьЗамену("н", "n");
	ДобавитьЗамену("о", "o"); ДобавитьЗамену("п", "p"); ДобавитьЗамену("р", "r");
	ДобавитьЗамену("с", "s"); ДобавитьЗамену("т", "t"); ДобавитьЗамену("у", "u");
	ДобавитьЗамену("ф", "f"); ДобавитьЗамену("х", "h"); ДобавитьЗамену("ц", "ts");
	ДобавитьЗамену("ч", "ch"); ДобавитьЗамену("ш", "sh"); ДобавитьЗамену("щ", "sch");
	ДобавитьЗамену("ъ", ""); ДобавитьЗамену("ы", "y"); ДобавитьЗамену("ь", "");
	ДобавитьЗамену("э", "e"); ДобавитьЗамену("ю", "yu"); ДобавитьЗамену("я", "ya");

КонецПроцедуры

Процедура ДобавитьЗамену(Буква, Замена)
	Транслитерация.Вставить(Буква, Замена);
КонецПроцедуры

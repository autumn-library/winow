#Использовать opentelemetry

// Ведёт спаны OpenTelemetry событий веб-сокета: подключения, входящего сообщения
// и отключения клиента.
//
// По рекомендациям OpenTelemetry долгоживущее соединение не держит один спан
// на всё время жизни: такой спан не попал бы в бэкенд, пока соединение открыто,
// а все сообщения клиента слились бы в одну бесконечную трассировку. Поэтому
// рукопожатие - обычный короткий серверный HTTP-спан, а каждое событие начинает
// свою трассировку и ссылается линком на спан рукопожатия.
//
// Имя спана строится, как в messaging semantic conventions, из операции
// и назначения: "process /chat/{Комната}". Назначение - шаблон маршрута,
// а не путь: у имени спана должна быть низкая кардинальность.
// https://opentelemetry.io/docs/specs/semconv/messaging/messaging-spans/

// ОтелТрассировщик - создаёт спаны событий. Область инструментирования та же,
// что у серверных HTTP-спанов: спаны создаёт winow.
Перем Трассировщик;

// Строка - значение атрибута network.protocol.name.
Перем ИмяПротокола;

// Параметры:
//  ОтелSdk - ОтелSdk - SDK OpenTelemetry.
//
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин("ОтелSdk") ОтелSdk)
	Трассировщик = ОтелSdk.ПолучитьТрассировщик("winow");
	ИмяПротокола = "websocket";
КонецПроцедуры

// Открывает спан обработки подключения клиента.
//
// Параметры:
//  Подключение - Структура - Описание соединения, см. СоединенияВебСокетов.ОписаниеПодключения.
//
// Возвращаемое значение:
//  Структура - Состояние трассировки события, которое нужно передать в Завершить:
//   * Спан         - ОтелСпан - Спан события.
//   * ОбластьСпана - ОтелТокенКонтекста - Токен активности спана.
//
Функция НачатьПодключение(Подключение) Экспорт
	Возврат Начать("connect", ОтелВидСпана.Внутренний(), Подключение);
КонецФункции

// Открывает спан обработки входящего сообщения клиента.
//
// Параметры:
//  Подключение - Структура - Описание соединения, см. СоединенияВебСокетов.ОписаниеПодключения.
//
// Возвращаемое значение:
//  Структура - Состояние трассировки события, см. НачатьПодключение.
//
Функция НачатьСообщение(Подключение) Экспорт
	Возврат Начать("process", ОтелВидСпана.Потребитель(), Подключение);
КонецФункции

// Открывает спан обработки отключения клиента.
//
// Параметры:
//  Подключение - Структура - Описание соединения, см. СоединенияВебСокетов.ОписаниеПодключения.
//
// Возвращаемое значение:
//  Структура - Состояние трассировки события, см. НачатьПодключение.
//
Функция НачатьОтключение(Подключение) Экспорт
	Возврат Начать("disconnect", ОтелВидСпана.Внутренний(), Подключение);
КонецФункции

// Завершает спан после успешной обработки события.
//
// Параметры:
//  Состояние - Структура - Результат вызова НачатьПодключение, НачатьСообщение или НачатьОтключение.
//
Процедура Завершить(Состояние) Экспорт
	ЗакрытьОбласть(Состояние);
КонецПроцедуры

// Завершает спан после исключения в обработчике события.
//
// Параметры:
//  Состояние          - Структура - Результат вызова НачатьПодключение, НачатьСообщение или НачатьОтключение.
//  ИнформацияОбОшибке - ИнформацияОбОшибке - Информация о возникшем исключении.
//  ОписаниеОшибки     - Строка - Краткое описание ошибки.
//
Процедура ЗавершитьСОшибкой(Состояние, ИнформацияОбОшибке, ОписаниеОшибки) Экспорт

	Спан = Состояние.Спан;
	Спан.ЗаписатьИсключение(ИнформацияОбОшибке);
	Спан.УстановитьСтатус(ОтелКодСтатуса.Ошибка(), ОписаниеОшибки);

	ЗакрытьОбласть(Состояние);

КонецПроцедуры

// Спан корневой, даже если обработчик вызван внутри чужого активного спана:
// событие клиента ему не дочернее. Спан становится текущим, чтобы спаны,
// которые заводит обработчик, стали его дочерними.
Функция Начать(Операция, ВидСпана, Подключение)

	Атрибуты = Новый Соответствие();
	Атрибуты.Вставить("network.protocol.name", ИмяПротокола);
	Атрибуты.Вставить("url.path", Подключение.Топик);

	Если ЗначениеЗаполнено(Подключение.ШаблонМаршрута) Тогда
		Атрибуты.Вставить("http.route", Подключение.ШаблонМаршрута);
		ИмяСпана = Операция + " " + Подключение.ШаблонМаршрута;
	Иначе
		ИмяСпана = Операция;
	КонецЕсли;

	Спан = Трассировщик.НачатьКорневойСпан(ИмяСпана, ВидСпана, Атрибуты, ЛинкиНаРукопожатие(Подключение));

	Состояние = Новый Структура("Спан, ОбластьСпана");
	Состояние.Спан = Спан;
	Состояние.ОбластьСпана = Спан.СделатьТекущим();

	Возврат Состояние;

КонецФункции

// Рукопожатие могло пройти без трассировки, тогда ссылаться не на что.
Функция ЛинкиНаРукопожатие(Подключение)

	Линки = Новый Массив();

	КонтекстРукопожатия = Подключение.КонтекстТрассировки;
	Если КонтекстРукопожатия <> Неопределено И КонтекстРукопожатия.Валиден() Тогда
		Линки.Добавить(Новый ОтелЛинк(КонтекстРукопожатия));
	КонецЕсли;

	Возврат Линки;

КонецФункции

// Порядок обратен открытию: сначала область спана, затем сам спан.
Процедура ЗакрытьОбласть(Состояние)
	Состояние.ОбластьСпана.Закрыть();
	Состояние.Спан.Завершить();
КонецПроцедуры

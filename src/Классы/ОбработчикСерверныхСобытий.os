// Вызывает обработчики подключения и отключения клиента серверных событий (SSE)
// и отправляет события клиентам.
//
// Это шов для трассировки: напильник находит желудь по прозвищу и открывает
// спан вокруг каждого события. Пул соединений, подписки и брокер сами напильниками
// не обрабатываются, поэтому события идут через отдельный желудь.
//
// Исключения обработчиков подключения и отключения не гасятся: их записывает в спан
// трассировка. Обработчики выполняются в фоновых заданиях и соединение не рвут.
//
// Подключение - описание соединения из пула соединений, см. СоединенияСерверныхСобытий:
//  Структура:
//   * Идентификатор       - Строка - Идентификатор сессии клиента.
//   * Топик               - Строка - Топик, на который подключился клиент.
//   * Соединение          - TCPСоединение, СоединениеСерверныхСобытийНативное - Соединение с клиентом.
//   * ИдСоединения        - Строка - Идентификатор соединения.
//   * КонтекстТрассировки - ОтелКонтекстСпана, Неопределено - Контекст спана подключения.

&Желудь
&Прозвище("ОбработчикСерверныхСобытий")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

// Параметры:
//  Подключение - Структура - Описание соединения, см. описание модуля.
//  Обработчик  - Действие - Обработчик подключения топика.
//
Процедура ОбработатьПодключение(Подключение, Обработчик) Экспорт
	Обработчик.Выполнить(Подключение.Идентификатор, Подключение.ИдСоединения);
КонецПроцедуры

// Параметры:
//  Подключение - Структура - Описание соединения, см. описание модуля.
//  Обработчик  - Действие - Обработчик отключения топика.
//
Процедура ОбработатьОтключение(Подключение, Обработчик) Экспорт
	Обработчик.Выполнить(Подключение.Идентификатор, Подключение.ИдСоединения);
КонецПроцедуры

// Ошибка отправки одному клиенту не обрывает рассылку остальным: отвалившееся
// соединение уберёт из пула контроль соединений.
//
// Параметры:
//  Топик      - Строка - Топик получателей; пустой, если получателей не нашлось.
//                        Нужен трассировке: по нему именуется спан отправки.
//  Получатели - Массив Из Структура - Соединения, которым уходит событие, см. описание модуля.
//  Сообщение  - СерверноеСобытие - Отправляемое событие.
//
Процедура ОтправитьСобытие(Топик, Получатели, Сообщение) Экспорт // BSLLS:UnusedParameters-off

	ДанныеСобытия = ПолучитьДвоичныеДанныеИзСтроки(Сообщение.Сформировать());

	Для Каждого Получатель Из Получатели Цикл
		ОтправитьВПопытке(Получатель.Соединение, ДанныеСобытия);
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Соединение - TCPСоединение, СоединениеСерверныхСобытийНативное - Соединение с клиентом.
//  Данные     - ДвоичныеДанные - Отправляемые данные.
//
// Возвращаемое значение:
//  Булево - Истина, если данные отправлены.
//
Функция ОтправитьВПопытке(Соединение, Данные) Экспорт
	Попытка
		Соединение.ОтправитьДвоичныеДанные(Данные);
		Отправлено = Истина;
	Исключение
		Отправлено = Ложь;
	КонецПопытки;
	Возврат Отправлено;
КонецФункции

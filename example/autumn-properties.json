{
    "winow": {
        "Порт": 3333,
        "ИмяХоста": "localhost",
        "АвтоСтарт": true,
        "ИспользоватьПрикладнойСервер": true,
        "КаталогСПриложениями": "./hwapp",
        "КаталогиСФайлами": {
            "/images": "./hwapp/files"
        }
    },
    "otel": {
        "enabled": true,
        "service": {
            "name": "мой-сервис"
        },
        "exporter": {
            "otlp": {
                "protocol": "grpc"
            }
        },
        "metric": {
            "export": {
                "interval": "10000"
            }
        }
    },
    "logos": {
        "logger": {
            "rootLogger": {
                "level": "DEBUG",
                "appenders": [
                    "otel",
                    "console"
                ]
            }
        },
        "appender": {
            "otel": {
                "type": "ОтелАппендерLogos",
                "level": "DEBUG"
            },
            "console": {
                "type": "ВыводЛогаВКонсоль",
                "level": "DEBUG"
            }
        }
    }
}

#Использовать jason

// Витрина возможностей генератора спецификации OpenAPI.
//
// Остальные контроллеры примера показывают возможности самого веб-сервера, а
// этот - то, чем описывается API: сводки, теги, коды ответов со схемами,
// явные HTTP-методы, пометки устаревания, типизированные параметры и тела.

&Пластилин
Перем СериализаторJson;

// Группа контроллера относится ко всем его точкам маршрута, поэтому на методах
// её повторять не нужно - там указывают только дополнительные группы.
&Группа("Каталог", Описание = "Товары, поставщики и поиск по каталогу")
&Контроллер("/catalog")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

// Типизированные параметры строки запроса с ограничениями: тип, границы и
// список допустимых значений попадают в схему параметра.
&ТочкаМаршрута("")
&Операция(Сводка = "Страница каталога")
&Возвращает(Тип = "СтраницаКаталога", Описание = "Страница найденных товаров")
Процедура СтраницаТоваров(Ответ,
	&Тип("Число") &Минимум(1) &Максимум(100) Лимит,
	&Тип("Строка") &ОдинИз("книги", "музыка", "техника") Категория) Экспорт

	Страница = Новый СтраницаКаталога();
	Страница.Товары = Новый Массив();
	Страница.Товары.Добавить(ОбразецТовара());
	Страница.Всего = 1;

	ОтдатьJson(Ответ, Страница);

КонецПроцедуры

// Две аннотации &Возвращает - два кода состояния, и у каждого своя схема тела.
&ТочкаМаршрута("{Артикул}")
&Операция(Сводка = "Товар по артикулу",
	Описание = "Ищет товар в каталоге по артикулу. Если товара нет, отвечает 404.")
&Возвращает(Тип = "ТоварКаталога", Описание = "Найденный товар")
&Возвращает(Тип = "ОшибкаКаталога", Код = 404, Описание = "Товар не найден")
Процедура ТоварПоАртикулу(Ответ, Артикул) Экспорт

	Если Артикул <> "AB-1234" Тогда
		ОтдатьОшибку(Ответ, 404, "not_found", "Товар с артикулом " + Артикул + " не найден");
		Возврат;
	КонецЕсли;

	ОтдатьJson(Ответ, ОбразецТовара());

КонецПроцедуры

// Типизированное тело запроса: схема тела - ссылка на components/schemas,
// а метод post выводится сам, раз точка маршрута читает тело.
&ТочкаМаршрута("create")
&Операция(Сводка = "Завести товар")
&Возвращает(Тип = "ТоварКаталога", Код = 201, Описание = "Товар заведён")
&Возвращает(Тип = "ОшибкаКаталога", Код = 422, Описание = "Товар не прошёл проверку")
Процедура ЗавестиТовар(Ответ, &Заполнено &Тип("ТоварКаталога") ТелоЗапросаОбъект) Экспорт

	Если НЕ ЗначениеЗаполнено(ТелоЗапросаОбъект.Наименование) Тогда
		ОтдатьОшибку(Ответ, 422, "name_required", "Наименование товара обязательно");
		Возврат;
	КонецЕсли;

	Ответ.УстановитьСостояние(201);
	ОтдатьJson(Ответ, ТелоЗапросаОбъект);

КонецПроцедуры

// Метод, который сам бы не вывелся: замена товара целиком - это put.
&ТочкаМаршрута("{Артикул}/replace", Метод = "put")
&Операция(Сводка = "Заменить товар целиком")
&Возвращает(Тип = "ТоварКаталога", Описание = "Заменённый товар")
Процедура ЗаменитьТовар(Ответ, Артикул, &Заполнено &Тип("ТоварКаталога") ТелоЗапросаОбъект) Экспорт

	ТелоЗапросаОбъект.Артикул = Артикул;
	ОтдатьJson(Ответ, ТелоЗапросаОбъект);

КонецПроцедуры

&ТочкаМаршрута("{Артикул}/remove", Метод = "delete")
&Операция(Сводка = "Удалить товар")
&Возвращает(Код = 204, Описание = "Товар удалён")
&Возвращает(Тип = "ОшибкаКаталога", Код = 404, Описание = "Товар не найден")
Процедура УдалитьТовар(Ответ, Артикул) Экспорт

	Если Артикул <> "AB-1234" Тогда
		ОтдатьОшибку(Ответ, 404, "not_found", "Товар с артикулом " + Артикул + " не найден");
		Возврат;
	КонецЕсли;

	Ответ.УстановитьСостояние(204);

КонецПроцедуры

// Устаревшей может быть и вся операция, и отдельный её параметр: Swagger UI
// покажет и то, и другое зачёркнутым.
&ТочкаМаршрута("search")
&Операция(Сводка = "Поиск товаров")
&Устарело("Используйте GET /catalog с параметром Категория")
&Возвращает(Тип = "СтраницаКаталога", Описание = "Страница найденных товаров")
Процедура ПоискТоваров(Ответ,
	&Тип("Строка") Фраза,
	&Устарело("Используйте Фраза") &Тип("Строка") Подстрока) Экспорт

	Страница = Новый СтраницаКаталога();
	Страница.Товары = Новый Массив();
	Страница.Всего = 0;

	ОтдатьJson(Ответ, Страница);

КонецПроцедуры

// Роли добавляют в спецификацию схему безопасности basicAuth и ответы 401 и 403.
// Двоичное тело описывается типом содержимого application/octet-stream.
&ТочкаМаршрута("import")
&Группа("Обслуживание", Описание = "Операции для администраторов каталога")
&Операция(Сводка = "Загрузить каталог файлом")
&Роли("Администраторы")
&Возвращает(Код = 202, Тип = "Строка", ТипСодержимого = "text/plain", Описание = "Файл принят в обработку")
Процедура ЗагрузитьКаталог(Ответ, &Заполнено ДвоичныеДанныеЗапроса) Экспорт

	Ответ.УстановитьСостояние(202);
	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = "Принято байт: " + Формат(ДвоичныеДанныеЗапроса.Размер(), "ЧГ=0; ЧН=0");

КонецПроцедуры

// Одна операция может входить сразу в несколько групп документации.
&ТочкаМаршрута("report")
&Группа("Отчёты", Описание = "Выгрузки и сводные отчёты")
&Операция(Сводка = "Сводка по каталогу")
&Возвращает(Тип = "СтраницаКаталога", Описание = "Сводные данные каталога")
Процедура СводкаПоКаталогу(Ответ) Экспорт

	Страница = Новый СтраницаКаталога();
	Страница.Товары = Новый Массив();
	Страница.Товары.Добавить(ОбразецТовара());
	Страница.Всего = 1;

	ОтдатьJson(Ответ, Страница);

КонецПроцедуры

// Ответ-коллекция без обёртки: тип элементов нигде не хранится, поэтому назван
// параметром Элемент - в схеме он ляжет в items.
&ТочкаМаршрута("all")
&Операция(Сводка = "Все товары списком")
&Возвращает(Тип = "Массив", Элемент = "ТоварКаталога", Описание = "Список товаров")
Процедура ВсеТовары(Ответ) Экспорт

	Товары = Новый Массив();
	Товары.Добавить(ОбразецТовара());

	ОтдатьJson(Ответ, Товары);

КонецПроцедуры

// Ответ не в JSON: тип содержимого объявляется, а заголовок точка маршрута
// ставит сама - из объявления он пока не заполняется.
// Группу можно назвать и параметром операции - это вторая форма той же записи.
&ТочкаМаршрута("export")
&Операция(Сводка = "Выгрузка каталога в CSV", Группы = "Отчёты")
&Возвращает(Тип = "Строка", ТипСодержимого = "text/csv", Описание = "Строки каталога")
Процедура ВыгрузитьКаталог(Ответ) Экспорт

	Товар = ОбразецТовара();

	Ответ.Заголовки["Content-Type"] = "text/csv; charset=utf-8";
	Ответ.ТелоТекст = "article;name;price" + Символы.ПС
		+ СтрШаблон("%1;%2;%3", Товар.Артикул, Товар.Наименование, Формат(Товар.Цена, "ЧГ=0; ЧН=0"));

КонецПроцедуры

Функция ОбразецТовара()

	Поставщик = Новый ПоставщикКаталога();
	Поставщик.Наименование = "ООО Ромашка";
	Поставщик.Почта = "sales@romashka.example";
	Поставщик.Сайт = "https://romashka.example";

	Товар = Новый ТоварКаталога();
	Товар.Идентификатор = "3f2504e0-4f89-11d3-9a0c-0305e82c3301";
	Товар.Артикул = "AB-1234";
	Товар.Наименование = "Наушники";
	Товар.Категория = "техника";
	Товар.Цена = 4990;
	Товар.РазмерУпаковки = 10;
	Товар.Метки = Новый Массив();
	Товар.Метки.Добавить("хит");
	Товар.Поставщик = Поставщик;

	Возврат Товар;

КонецФункции

Процедура ОтдатьJson(Ответ, Объект)

	Ответ.УстановитьТипКонтента("json");
	Ответ.ТелоТекст = СериализаторJson.Сериализовать(Объект);

КонецПроцедуры

Процедура ОтдатьОшибку(Ответ, КодСостояния, Код, Сообщение)

	Ошибка = Новый ОшибкаКаталога();
	Ошибка.Код = Код;
	Ошибка.Сообщение = Сообщение;

	Ответ.УстановитьСостояние(КодСостояния);
	ОтдатьJson(Ответ, Ошибка);

КонецПроцедуры

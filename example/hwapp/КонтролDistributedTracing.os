#Использовать opentelemetry
#Использовать 1connector

&Пластилин
Перем СериализаторJson;

&Лог
Перем Лог;

Перем Трассировщик;
Перем Пропагаторы;

// Контроллер для демонстрации distributed tracing.
// SERVER спан создается автоматически силами winow (НапильникHttpСервер).
// &Контроллер включает &Наблюдаемый - методы автоматически получают INTERNAL спаны.
// /tracing/start - создает CLIENT спан, отправляет POST JSON на сервис-обработки (порт 3334).

&Контроллер("/tracing")
Процедура ПриСозданииОбъекта(&Пластилин ОтелSdk)
	Трассировщик = ОтелSdk.ПолучитьТрассировщик("distributed-tracing-demo");
	Пропагаторы = ОтелSdk.Пропагаторы();
КонецПроцедуры

// GET /tracing/start - точка входа в цепочку distributed tracing.
// Создает CLIENT спан для исходящего HTTP-вызова,
// внедряет контекст трассировки в заголовки и отправляет POST JSON
// на отдельный микросервис сервис-обработки (порт 3334).
&Сводка("Начать цепочку распределённой трассировки")
&ТочкаМаршрута("start")
Процедура НачатьЦепочку(Ответ) Экспорт
	
	КлиентскийСпан = Трассировщик.НачатьСпан("Вызываю POST /tracing/process", ОтелВидСпана.Клиент());
	КлиентскийСпан.УстановитьАтрибут("http.request.method", "POST");
	КлиентскийСпан.УстановитьАтрибут("server.address", "localhost");
	КлиентскийСпан.УстановитьАтрибут("server.port", 3334);
	КлиентскийСпан.УстановитьАтрибут("url.full", "http://localhost:3334/tracing/process");
	ОбластьКлиента = КлиентскийСпан.СделатьТекущим();
	
	Попытка
		
		ЗаголовкиЗапроса = Новый Соответствие();
		Пропагаторы.Внедрить(ОтелКонтекст.Текущий(), ЗаголовкиЗапроса);
		
		Лог.Информация("Отправляем запрос с traceparent=" + ЗаголовкиЗапроса["traceparent"]);
		
		ДопПараметры = Новый Структура("Заголовки", ЗаголовкиЗапроса);
		
		ЗапросТрассировки = Новый ЗапросТрассировки();
		ЗапросТрассировки.Сервис = "distributed-tracing-demo";
		ЗапросТрассировки.Действие = "process";
		ЗапросТрассировки.Значение = 42;
		
		ЗаголовкиЗапроса.Вставить("Content-Type", "application/json");
		ТелоСтрока = СериализаторJson.Сериализовать(ЗапросТрассировки);
		
		РезультатHTTP = КоннекторHTTP.Post("http://localhost:3334/tracing/process", ТелоСтрока, , ДопПараметры);
		
		КлиентскийСпан.УстановитьАтрибут("http.response.status_code", РезультатHTTP.КодСостояния);
		Лог.Информация("Получен ответ: " + РезультатHTTP.КодСостояния);
		
		ОбластьКлиента.Закрыть();
		КлиентскийСпан.Завершить();
		
	Исключение
		
		КлиентскийСпан.ЗаписатьИсключение(ИнформацияОбОшибке());
		КлиентскийСпан.УстановитьСтатус(ОтелКодСтатуса.Ошибка(), ОписаниеОшибки());
		ОбластьКлиента.Закрыть();
		КлиентскийСпан.Завершить();
		ВызватьИсключение;
		
	КонецПопытки;
	
	Ответ.УстановитьТипКонтента("json");
	Ответ.ТелоТекст = РезультатHTTP.Текст();
	
КонецПроцедуры
